{
  "schema_version": "0.7.0",
  "profile_id": "portable_gltf",
  "job_id": "geometry_showcase",
  "asset_kind": "static_environment",
  "primary_format": "glb",
  "units": "meters",
  "up_axis": "+Y",
  "forward_axis": "-Z",
  "pivot_policy": "keep",
  "lod": {
    "enabled": true,
    "preserve_lod0": true,
    "targets": [
      {
        "level": 1,
        "target_triangle_ratio": 0.6,
        "minimum_silhouette_iou": 0.98
      },
      {
        "level": 2,
        "target_triangle_ratio": 0.3,
        "minimum_silhouette_iou": 0.95
      }
    ]
  },
  "collision": {
    "strategy": "compound",
    "max_hulls_per_object": 8,
    "max_triangles_per_object": 256
  },
  "uv": {
    "preserve_uv0": true,
    "generate_uv0_if_missing": true,
    "generate_uv1": true,
    "maximum_overlap_fraction": 0.01,
    "target_texel_density_px_m": null,
    "minimum_padding_px": 4
  },
  "textures": {
    "preserve_raw_channels": true,
    "packing": "gltf_orm",
    "maximum_resolution": 4096
  },
  "consolidation": {
    "mode": "by_semantic_group",
    "maximum_objects_per_batch": 64,
    "spatial_cell_size_m": 25.0,
    "remove_loose_geometry": true,
    "deduplicate_material_slots": true,
    "deduplicate_exact_colliders": true,
    "detect_exact_instances": true,
    "detect_overlap_candidates": true,
    "overlap_pair_limit": 5000
  },
  "budgets": {
    "enforcement": "warning",
    "max_lod0_render_objects": null,
    "max_lod0_material_slots": null,
    "max_lod0_estimated_draw_calls": null,
    "max_lod0_triangles": null,
    "max_collider_triangles": null,
    "max_overlap_candidates": null
  },
  "notes": [
    "Engine-neutral glTF 2.0 metallic-roughness package.",
    "LOD and collision artifacts remain separate from the canonical Blender scene.",
    "V0.7.3 batches only equal semantic/material families and retains provenance."
  ]
}
