{
  "additionalProperties": false,
  "description": "Record destination changes only after an approved import plan is applied.",
  "properties": {
    "schema_version": {
      "const": "0.9.0",
      "default": "0.9.0",
      "title": "Schema Version",
      "type": "string"
    },
    "receipt_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Receipt Id",
      "type": "string"
    },
    "import_plan_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Import Plan Sha256",
      "type": "string"
    },
    "handoff_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Handoff Manifest Sha256",
      "type": "string"
    },
    "changed_files": {
      "items": {
        "type": "string"
      },
      "title": "Changed Files",
      "type": "array"
    },
    "imported_semantic_ids": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
        "type": "string"
      },
      "title": "Imported Semantic Ids",
      "type": "array"
    },
    "imported_material_ids": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
        "type": "string"
      },
      "title": "Imported Material Ids",
      "type": "array"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    },
    "completed_at": {
      "format": "date-time",
      "title": "Completed At",
      "type": "string"
    }
  },
  "required": [
    "receipt_id",
    "import_plan_sha256",
    "handoff_manifest_sha256",
    "completed_at"
  ],
  "title": "DestinationImportReceipt",
  "type": "object"
}
