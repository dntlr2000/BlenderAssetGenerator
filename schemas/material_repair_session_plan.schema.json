{
  "$defs": {
    "ExactArtifact": {
      "additionalProperties": false,
      "description": "Bind one contained job-relative artifact by exact bytes and media type.",
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "pattern": "^[a-z][a-z0-9_]{1,95}$",
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "byte_size": {
          "minimum": 0,
          "title": "Byte Size",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 127,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "path",
        "sha256",
        "byte_size",
        "media_type"
      ],
      "title": "ExactArtifact",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Plan a new material-only session without migrating or changing geometry.",
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "workflow_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Workflow Id",
      "type": "string"
    },
    "dispatch_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Dispatch Id",
      "type": "string"
    },
    "session_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Session Id",
      "type": "string"
    },
    "producer": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Producer",
      "type": "string"
    },
    "producer_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Producer Version",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "plan_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Plan Id",
      "type": "string"
    },
    "repair_attempt_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Repair Attempt Id",
      "type": "string"
    },
    "source_session_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Source Session Id",
      "type": "string"
    },
    "source_binding": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "source_binding_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Binding Sha256",
      "type": "string"
    },
    "preflight_request": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "geometry_reused": {
      "const": true,
      "default": true,
      "title": "Geometry Reused",
      "type": "boolean"
    },
    "geometry_write_allowed": {
      "const": false,
      "default": false,
      "title": "Geometry Write Allowed",
      "type": "boolean"
    },
    "automatic_migration": {
      "const": false,
      "default": false,
      "title": "Automatic Migration",
      "type": "boolean"
    },
    "old_session_resumable": {
      "const": false,
      "default": false,
      "title": "Old Session Resumable",
      "type": "boolean"
    },
    "run_stop_boundary": {
      "const": "approval_pending",
      "default": "approval_pending",
      "title": "Run Stop Boundary",
      "type": "string"
    },
    "synthetic_authority_allowed": {
      "const": false,
      "default": false,
      "title": "Synthetic Authority Allowed",
      "type": "boolean"
    },
    "synthetic_approval_allowed": {
      "const": false,
      "default": false,
      "title": "Synthetic Approval Allowed",
      "type": "boolean"
    },
    "controller_before_approval_allowed": {
      "const": false,
      "default": false,
      "title": "Controller Before Approval Allowed",
      "type": "boolean"
    },
    "canonical_write_before_approval_allowed": {
      "const": false,
      "default": false,
      "title": "Canonical Write Before Approval Allowed",
      "type": "boolean"
    },
    "destination_write_allowed": {
      "const": false,
      "default": false,
      "title": "Destination Write Allowed",
      "type": "boolean"
    },
    "required_steps": {
      "items": {
        "enum": [
          "verify_geometry",
          "prepare_material_candidate",
          "collect_closure",
          "rebind_graph",
          "run_preflight",
          "shadow_compile",
          "neutral_preview",
          "request_material_approval",
          "controller_exact_adoption",
          "host_promotion",
          "material_phase_receipt",
          "quality_boundary"
        ],
        "type": "string"
      },
      "minItems": 1,
      "title": "Required Steps",
      "type": "array"
    }
  },
  "required": [
    "job_id",
    "workflow_id",
    "dispatch_id",
    "session_id",
    "producer",
    "producer_version",
    "created_at",
    "plan_id",
    "repair_attempt_id",
    "source_session_id",
    "source_binding",
    "source_binding_sha256",
    "preflight_request",
    "required_steps"
  ],
  "title": "MaterialRepairSessionPlan",
  "type": "object"
}
