{
  "$defs": {
    "AuthoredUVInspection": {
      "additionalProperties": false,
      "description": "Bind a fixed Blender 5.0.1 read-only inspection to exact blend bytes.",
      "properties": {
        "schema_version": {
          "const": "0.1.0",
          "default": "0.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "kind": {
          "const": "authored_uv_inspection",
          "default": "authored_uv_inspection",
          "title": "Kind",
          "type": "string"
        },
        "uv_method": {
          "const": "validated_authored_uv_v1",
          "default": "validated_authored_uv_v1",
          "title": "Uv Method",
          "type": "string"
        },
        "blender_version": {
          "const": "5.0.1",
          "title": "Blender Version",
          "type": "string"
        },
        "blend_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Blend Sha256",
          "type": "string"
        },
        "stage": {
          "enum": [
            "source",
            "target"
          ],
          "title": "Stage",
          "type": "string"
        },
        "objects": {
          "items": {
            "$ref": "#/$defs/UVSnapshot"
          },
          "maxItems": 256,
          "minItems": 1,
          "title": "Objects",
          "type": "array"
        }
      },
      "required": [
        "blender_version",
        "blend_sha256",
        "stage",
        "objects"
      ],
      "title": "AuthoredUVInspection",
      "type": "object"
    },
    "UVIdentity": {
      "additionalProperties": false,
      "description": "Bind ordered geometry to its exact derived object and source material.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "semantic_id": {
          "title": "Semantic Id",
          "type": "string"
        },
        "source_object": {
          "title": "Source Object",
          "type": "string"
        },
        "asset_role": {
          "enum": [
            "render",
            "lod"
          ],
          "title": "Asset Role",
          "type": "string"
        },
        "lod_level": {
          "maximum": 8,
          "minimum": 0,
          "title": "Lod Level",
          "type": "integer"
        },
        "material_id": {
          "title": "Material Id",
          "type": "string"
        },
        "source_material_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Material Fingerprint",
          "type": "string"
        }
      },
      "required": [
        "name",
        "semantic_id",
        "source_object",
        "asset_role",
        "lod_level",
        "material_id",
        "source_material_fingerprint"
      ],
      "title": "UVIdentity",
      "type": "object"
    },
    "UVMeasurement": {
      "additionalProperties": false,
      "description": "Describe an exhaustive exact triangle-interior scan, never a skipped scan.",
      "properties": {
        "loop_count": {
          "minimum": 0,
          "title": "Loop Count",
          "type": "integer"
        },
        "triangle_count": {
          "minimum": 0,
          "title": "Triangle Count",
          "type": "integer"
        },
        "uv_minimum": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Uv Minimum",
          "type": "array"
        },
        "uv_maximum": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Uv Maximum",
          "type": "array"
        },
        "uv_fingerprint_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Uv Fingerprint Sha256",
          "type": "string"
        },
        "topology_fingerprint_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Topology Fingerprint Sha256",
          "type": "string"
        },
        "layout_fingerprint_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Layout Fingerprint Sha256",
          "type": "string"
        },
        "degenerate_triangle_count": {
          "const": 0,
          "title": "Degenerate Triangle Count",
          "type": "integer"
        },
        "overlap_pair_count": {
          "const": 0,
          "title": "Overlap Pair Count",
          "type": "integer"
        },
        "candidate_pair_count": {
          "minimum": 0,
          "title": "Candidate Pair Count",
          "type": "integer"
        },
        "broadphase_pair_count": {
          "minimum": 0,
          "title": "Broadphase Pair Count",
          "type": "integer"
        },
        "sweep_axis": {
          "enum": [
            0,
            1
          ],
          "title": "Sweep Axis",
          "type": "integer"
        },
        "complete": {
          "const": true,
          "title": "Complete",
          "type": "boolean"
        }
      },
      "required": [
        "loop_count",
        "triangle_count",
        "uv_minimum",
        "uv_maximum",
        "uv_fingerprint_sha256",
        "topology_fingerprint_sha256",
        "layout_fingerprint_sha256",
        "degenerate_triangle_count",
        "overlap_pair_count",
        "candidate_pair_count",
        "broadphase_pair_count",
        "sweep_axis",
        "complete"
      ],
      "title": "UVMeasurement",
      "type": "object"
    },
    "UVObjectProof": {
      "additionalProperties": false,
      "description": "Bind one object's source and stored affine target with complete measured scans.",
      "properties": {
        "schema_version": {
          "const": "0.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "method": {
          "const": "validated_authored_uv_v1",
          "title": "Method",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/UVMeasurement"
        },
        "target": {
          "$ref": "#/$defs/UVMeasurement"
        },
        "target_bounds": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Target Bounds",
          "type": "array"
        },
        "mapping_target_bounds": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Mapping Target Bounds",
          "type": "array"
        },
        "orientation_preserved": {
          "const": true,
          "title": "Orientation Preserved",
          "type": "boolean"
        },
        "actual_target_matches_reconstruction": {
          "const": true,
          "title": "Actual Target Matches Reconstruction",
          "type": "boolean"
        },
        "source_snapshot_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Snapshot Sha256",
          "type": "string"
        },
        "target_snapshot_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Target Snapshot Sha256",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "method",
        "source",
        "target",
        "target_bounds",
        "mapping_target_bounds",
        "orientation_preserved",
        "actual_target_matches_reconstruction",
        "source_snapshot_sha256",
        "target_snapshot_sha256"
      ],
      "title": "UVObjectProof",
      "type": "object"
    },
    "UVSampling": {
      "additionalProperties": false,
      "description": "Record the measured named layer used by every supported UV consumer.",
      "properties": {
        "node_name": {
          "title": "Node Name",
          "type": "string"
        },
        "node_type": {
          "enum": [
            "UVMAP",
            "NORMAL_MAP",
            "TEX_IMAGE",
            "TEX_COORD"
          ],
          "title": "Node Type",
          "type": "string"
        },
        "selection": {
          "enum": [
            "uv_map",
            "normal_map",
            "image_vector",
            "texture_coordinate_uv"
          ],
          "title": "Selection",
          "type": "string"
        },
        "uv_set": {
          "title": "Uv Set",
          "type": "string"
        }
      },
      "required": [
        "node_name",
        "node_type",
        "selection",
        "uv_set"
      ],
      "title": "UVSampling",
      "type": "object"
    },
    "UVSnapshot": {
      "additionalProperties": false,
      "description": "Retain full ordered native corner storage and topology without rounding.",
      "properties": {
        "identity": {
          "$ref": "#/$defs/UVIdentity"
        },
        "vertices": {
          "items": {
            "maxItems": 3,
            "minItems": 3,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "maxItems": 500000,
          "minItems": 1,
          "title": "Vertices",
          "type": "array"
        },
        "matrix_world": {
          "items": {
            "maxItems": 4,
            "minItems": 4,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "title": "Matrix World",
          "type": "array"
        },
        "polygons": {
          "items": {
            "items": {
              "minimum": 0,
              "type": "integer"
            },
            "type": "array"
          },
          "maxItems": 250000,
          "minItems": 1,
          "title": "Polygons",
          "type": "array"
        },
        "polygon_materials": {
          "items": {
            "minimum": 0,
            "type": "integer"
          },
          "title": "Polygon Materials",
          "type": "array"
        },
        "loops": {
          "items": {
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 500000,
          "minItems": 3,
          "title": "Loops",
          "type": "array"
        },
        "polygon_loops": {
          "items": {
            "items": {
              "minimum": 0,
              "type": "integer"
            },
            "type": "array"
          },
          "title": "Polygon Loops",
          "type": "array"
        },
        "triangles": {
          "items": {
            "maxItems": 3,
            "minItems": 3,
            "prefixItems": [
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "minimum": 0,
                "type": "integer"
              }
            ],
            "type": "array"
          },
          "maxItems": 250000,
          "minItems": 1,
          "title": "Triangles",
          "type": "array"
        },
        "uv_layers": {
          "additionalProperties": {
            "items": {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            "type": "array"
          },
          "title": "Uv Layers",
          "type": "object"
        },
        "source_uv_set": {
          "title": "Source Uv Set",
          "type": "string"
        },
        "sampling": {
          "items": {
            "$ref": "#/$defs/UVSampling"
          },
          "title": "Sampling",
          "type": "array"
        },
        "active_uv_set": {
          "title": "Active Uv Set",
          "type": "string"
        },
        "render_uv_set": {
          "title": "Render Uv Set",
          "type": "string"
        }
      },
      "required": [
        "identity",
        "vertices",
        "matrix_world",
        "polygons",
        "polygon_materials",
        "loops",
        "polygon_loops",
        "triangles",
        "uv_layers",
        "source_uv_set",
        "sampling",
        "active_uv_set",
        "render_uv_set"
      ],
      "title": "UVSnapshot",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Bind recomputable snapshots to one conversion; this is not render attestation.",
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "kind": {
      "const": "authored_uv_proof",
      "default": "authored_uv_proof",
      "title": "Kind",
      "type": "string"
    },
    "uv_method": {
      "const": "validated_authored_uv_v1",
      "default": "validated_authored_uv_v1",
      "title": "Uv Method",
      "type": "string"
    },
    "conversion_plan_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Conversion Plan Sha256",
      "type": "string"
    },
    "source_snapshot_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Snapshot Sha256",
      "type": "string"
    },
    "optimized_blend_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Optimized Blend Sha256",
      "type": "string"
    },
    "portable_blend_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Portable Blend Sha256",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/AuthoredUVInspection"
    },
    "target": {
      "$ref": "#/$defs/AuthoredUVInspection"
    },
    "objects": {
      "items": {
        "$ref": "#/$defs/UVObjectProof"
      },
      "maxItems": 256,
      "minItems": 1,
      "title": "Objects",
      "type": "array"
    },
    "attestation": {
      "const": "host_recomputed_and_blender_reopened_not_cryptographic_attestation",
      "default": "host_recomputed_and_blender_reopened_not_cryptographic_attestation",
      "title": "Attestation",
      "type": "string"
    }
  },
  "required": [
    "conversion_plan_sha256",
    "source_snapshot_sha256",
    "optimized_blend_sha256",
    "portable_blend_sha256",
    "source",
    "target",
    "objects"
  ],
  "title": "AuthoredUVProof",
  "type": "object"
}
