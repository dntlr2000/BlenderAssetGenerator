{
  "$defs": {
    "AQV2Artifact": {
      "additionalProperties": false,
      "description": "Bind one immutable job-contained artifact to exact bytes and role.",
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "byte_size": {
          "exclusiveMinimum": 0,
          "title": "Byte Size",
          "type": "integer"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "path",
        "sha256",
        "byte_size"
      ],
      "title": "AQV2Artifact",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Freeze the exact quality-approved canonical authoring source before delivery.",
  "properties": {
    "schema_version": {
      "const": "0.2.0",
      "default": "0.2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "contract_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Contract Id",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "workflow_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Workflow Id",
      "type": "string"
    },
    "dispatch_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Dispatch Id",
      "type": "string"
    },
    "session_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Session Id",
      "type": "string"
    },
    "input_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Sha256",
      "type": "string"
    },
    "source_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Fingerprint",
      "type": "string"
    },
    "producer": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Producer",
      "type": "string"
    },
    "producer_version": {
      "const": "0.2.0",
      "default": "0.2.0",
      "title": "Producer Version",
      "type": "string"
    },
    "provenance": {
      "items": {
        "$ref": "#/$defs/AQV2Artifact"
      },
      "minItems": 1,
      "title": "Provenance",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "freeze_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Freeze Id",
      "type": "string"
    },
    "scene_spec": {
      "$ref": "#/$defs/AQV2Artifact"
    },
    "authoring_blend": {
      "$ref": "#/$defs/AQV2Artifact"
    },
    "build_provenance": {
      "$ref": "#/$defs/AQV2Artifact"
    },
    "integrated_quality_report": {
      "$ref": "#/$defs/AQV2Artifact"
    },
    "quality_evidence": {
      "items": {
        "$ref": "#/$defs/AQV2Artifact"
      },
      "minItems": 1,
      "title": "Quality Evidence",
      "type": "array"
    },
    "material_plan": {
      "$ref": "#/$defs/AQV2Artifact"
    },
    "shader_recipes": {
      "items": {
        "$ref": "#/$defs/AQV2Artifact"
      },
      "title": "Shader Recipes",
      "type": "array"
    },
    "texture_manifests": {
      "items": {
        "$ref": "#/$defs/AQV2Artifact"
      },
      "title": "Texture Manifests",
      "type": "array"
    },
    "geometry_payloads": {
      "items": {
        "$ref": "#/$defs/AQV2Artifact"
      },
      "title": "Geometry Payloads",
      "type": "array"
    },
    "geometry_intent_survival": {
      "$ref": "#/$defs/AQV2Artifact"
    },
    "geometry_candidate_validation_receipt": {
      "$ref": "#/$defs/AQV2Artifact"
    },
    "material_phase_receipt": {
      "$ref": "#/$defs/AQV2Artifact"
    },
    "quality_status": {
      "const": "passed",
      "default": "passed",
      "title": "Quality Status",
      "type": "string"
    },
    "canonical_unchanged_at_freeze": {
      "const": true,
      "default": true,
      "title": "Canonical Unchanged At Freeze",
      "type": "boolean"
    },
    "v07_source_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "V07 Source Fingerprint",
      "type": "string"
    },
    "frozen_source_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Frozen Source Sha256",
      "type": "string"
    }
  },
  "required": [
    "contract_id",
    "job_id",
    "workflow_id",
    "dispatch_id",
    "session_id",
    "input_sha256",
    "source_fingerprint",
    "producer",
    "provenance",
    "created_at",
    "freeze_id",
    "scene_spec",
    "authoring_blend",
    "build_provenance",
    "integrated_quality_report",
    "quality_evidence",
    "material_plan",
    "shader_recipes",
    "texture_manifests",
    "geometry_payloads",
    "geometry_intent_survival",
    "geometry_candidate_validation_receipt",
    "material_phase_receipt",
    "v07_source_fingerprint",
    "frozen_source_sha256"
  ],
  "title": "QualityApprovedSourceFreeze",
  "type": "object"
}
