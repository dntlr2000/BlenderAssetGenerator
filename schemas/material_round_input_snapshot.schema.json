{
  "$defs": {
    "AutonomyArtifact": {
      "additionalProperties": false,
      "description": "Bind one contained artifact to its repository-relative path and exact bytes.",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "title": "AutonomyArtifact",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Freeze every mutable V0.8 material-authoring input before candidate creation.",
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "contract_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Contract Id",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "workflow_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Workflow Id",
      "type": "string"
    },
    "dispatch_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Dispatch Id",
      "type": "string"
    },
    "input_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Sha256",
      "type": "string"
    },
    "source_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Fingerprint",
      "type": "string"
    },
    "producer": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Producer",
      "type": "string"
    },
    "producer_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Producer Version",
      "type": "string"
    },
    "provenance": {
      "items": {
        "$ref": "#/$defs/AutonomyArtifact"
      },
      "minItems": 1,
      "title": "Provenance",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "snapshot_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Snapshot Id",
      "type": "string"
    },
    "session_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Session Id",
      "type": "string"
    },
    "round_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Round Id",
      "type": "string"
    },
    "round_index": {
      "maximum": 3,
      "minimum": 1,
      "title": "Round Index",
      "type": "integer"
    },
    "candidate_limit": {
      "maximum": 3,
      "minimum": 1,
      "title": "Candidate Limit",
      "type": "integer"
    },
    "production_assignment": {
      "$ref": "#/$defs/AutonomyArtifact"
    },
    "workflow_plan": {
      "$ref": "#/$defs/AutonomyArtifact"
    },
    "source_authored_plan_path": {
      "title": "Source Authored Plan Path",
      "type": "string"
    },
    "source_authored_plan_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Authored Plan Sha256",
      "type": "string"
    },
    "material_plan_snapshot": {
      "$ref": "#/$defs/AutonomyArtifact"
    },
    "baseline_material_plan": {
      "anyOf": [
        {
          "$ref": "#/$defs/AutonomyArtifact"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "previous_ranking": {
      "anyOf": [
        {
          "$ref": "#/$defs/AutonomyArtifact"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "scene_spec_snapshot": {
      "$ref": "#/$defs/AutonomyArtifact"
    },
    "source_dependencies": {
      "items": {
        "$ref": "#/$defs/AutonomyArtifact"
      },
      "title": "Source Dependencies",
      "type": "array"
    }
  },
  "required": [
    "contract_id",
    "job_id",
    "workflow_id",
    "dispatch_id",
    "input_sha256",
    "source_fingerprint",
    "producer",
    "producer_version",
    "provenance",
    "created_at",
    "snapshot_id",
    "session_id",
    "round_id",
    "round_index",
    "candidate_limit",
    "production_assignment",
    "workflow_plan",
    "source_authored_plan_path",
    "source_authored_plan_sha256",
    "material_plan_snapshot",
    "scene_spec_snapshot"
  ],
  "title": "MaterialRoundInputSnapshot",
  "type": "object"
}
