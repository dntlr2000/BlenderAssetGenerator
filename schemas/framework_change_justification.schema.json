{
  "$defs": {
    "ApprovalArtifact": {
      "additionalProperties": false,
      "description": "Bind one non-empty job-contained artifact to a normalized path and exact bytes.",
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "byte_size": {
          "exclusiveMinimum": 0,
          "title": "Byte Size",
          "type": "integer"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "path",
        "sha256",
        "byte_size"
      ],
      "title": "ApprovalArtifact",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Classify a failure before permitting reusable public framework changes.",
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "contract_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Contract Id",
      "type": "string"
    },
    "justification_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Justification Id",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "workflow_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Workflow Id",
      "type": "string"
    },
    "dispatch_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Dispatch Id",
      "type": "string"
    },
    "session_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Session Id",
      "type": "string"
    },
    "root_authorization": {
      "$ref": "#/$defs/ApprovalArtifact"
    },
    "policy_profile": {
      "$ref": "#/$defs/ApprovalArtifact"
    },
    "approval_envelope": {
      "$ref": "#/$defs/ApprovalArtifact"
    },
    "classification": {
      "enum": [
        "framework_invariant_violation",
        "reusable_missing_capability",
        "job_local_candidate_error",
        "reference_specific_ambiguity"
      ],
      "title": "Classification",
      "type": "string"
    },
    "issue_summary": {
      "maxLength": 1600,
      "minLength": 1,
      "title": "Issue Summary",
      "type": "string"
    },
    "generic_fixture_kinds": {
      "items": {
        "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
        "type": "string"
      },
      "title": "Generic Fixture Kinds",
      "type": "array"
    },
    "affected_job_ids": {
      "items": {
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
        "type": "string"
      },
      "title": "Affected Job Ids",
      "type": "array"
    },
    "violated_invariant_ids": {
      "items": {
        "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
        "type": "string"
      },
      "title": "Violated Invariant Ids",
      "type": "array"
    },
    "evidence_artifacts": {
      "items": {
        "$ref": "#/$defs/ApprovalArtifact"
      },
      "minItems": 1,
      "title": "Evidence Artifacts",
      "type": "array"
    },
    "public_framework_change_allowed": {
      "title": "Public Framework Change Allowed",
      "type": "boolean"
    },
    "new_public_schema_allowed": {
      "title": "New Public Schema Allowed",
      "type": "boolean"
    },
    "new_public_cli_allowed": {
      "title": "New Public Cli Allowed",
      "type": "boolean"
    },
    "new_approval_type_allowed": {
      "title": "New Approval Type Allowed",
      "type": "boolean"
    },
    "job_local_candidate_fix_required": {
      "title": "Job Local Candidate Fix Required",
      "type": "boolean"
    },
    "decision_reasons": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Decision Reasons",
      "type": "array"
    },
    "producer": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Producer",
      "type": "string"
    },
    "producer_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Producer Version",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "approval_count_effect": {
      "enum": [
        "reduces",
        "maintains",
        "increases"
      ],
      "title": "Approval Count Effect",
      "type": "string"
    },
    "approval_count_justification": {
      "maxLength": 1200,
      "minLength": 1,
      "title": "Approval Count Justification",
      "type": "string"
    }
  },
  "required": [
    "contract_id",
    "justification_id",
    "job_id",
    "workflow_id",
    "dispatch_id",
    "session_id",
    "root_authorization",
    "policy_profile",
    "approval_envelope",
    "classification",
    "issue_summary",
    "generic_fixture_kinds",
    "affected_job_ids",
    "violated_invariant_ids",
    "evidence_artifacts",
    "public_framework_change_allowed",
    "new_public_schema_allowed",
    "new_public_cli_allowed",
    "new_approval_type_allowed",
    "job_local_candidate_fix_required",
    "decision_reasons",
    "producer",
    "created_at",
    "approval_count_effect",
    "approval_count_justification"
  ],
  "title": "FrameworkChangeJustification",
  "type": "object"
}
