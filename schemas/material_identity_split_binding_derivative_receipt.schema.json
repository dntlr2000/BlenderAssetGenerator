{
  "$defs": {
    "ExactArtifact": {
      "additionalProperties": false,
      "description": "Bind one contained job-relative artifact by exact bytes and media type.",
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "pattern": "^[a-z][a-z0-9_]{1,95}$",
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "byte_size": {
          "minimum": 0,
          "title": "Byte Size",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 127,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "path",
        "sha256",
        "byte_size",
        "media_type"
      ],
      "title": "ExactArtifact",
      "type": "object"
    },
    "MaterialIdentitySplitBindingDerivativeEntry": {
      "additionalProperties": false,
      "description": "Bind one geometry-identical mesh payload whose material slot alone changed.",
      "properties": {
        "object_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Object Id",
          "type": "string"
        },
        "source_material_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Source Material Id",
          "type": "string"
        },
        "new_material_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "New Material Id",
          "type": "string"
        },
        "source_payload": {
          "$ref": "#/$defs/ExactArtifact"
        },
        "derivative_payload": {
          "$ref": "#/$defs/ExactArtifact"
        },
        "vertices_unchanged": {
          "const": true,
          "default": true,
          "title": "Vertices Unchanged",
          "type": "boolean"
        },
        "faces_unchanged": {
          "const": true,
          "default": true,
          "title": "Faces Unchanged",
          "type": "boolean"
        },
        "topology_unchanged": {
          "const": true,
          "default": true,
          "title": "Topology Unchanged",
          "type": "boolean"
        },
        "uv_unchanged": {
          "const": true,
          "default": true,
          "title": "Uv Unchanged",
          "type": "boolean"
        },
        "material_slots_only": {
          "const": true,
          "default": true,
          "title": "Material Slots Only",
          "type": "boolean"
        }
      },
      "required": [
        "object_id",
        "source_material_id",
        "new_material_id",
        "source_payload",
        "derivative_payload"
      ],
      "title": "MaterialIdentitySplitBindingDerivativeEntry",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Prove isolated mesh derivatives alter only exact material-slot identities.",
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "workflow_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Workflow Id",
      "type": "string"
    },
    "dispatch_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Dispatch Id",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Run Id",
      "type": "string"
    },
    "producer": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Producer",
      "type": "string"
    },
    "producer_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Producer Version",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "receipt_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Receipt Id",
      "type": "string"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/MaterialIdentitySplitBindingDerivativeEntry"
      },
      "minItems": 1,
      "title": "Entries",
      "type": "array"
    },
    "canonical_geometry_payload_overwrite": {
      "const": false,
      "default": false,
      "title": "Canonical Geometry Payload Overwrite",
      "type": "boolean"
    },
    "status": {
      "const": "passed",
      "default": "passed",
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "job_id",
    "workflow_id",
    "dispatch_id",
    "run_id",
    "producer",
    "producer_version",
    "created_at",
    "receipt_id",
    "entries"
  ],
  "title": "MaterialIdentitySplitMaterialBindingDerivativeReceipt",
  "type": "object"
}
