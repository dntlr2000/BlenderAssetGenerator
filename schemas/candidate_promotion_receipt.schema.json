{
  "$defs": {
    "AutonomyArtifact": {
      "additionalProperties": false,
      "description": "Bind one contained artifact to its repository-relative path and exact bytes.",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "title": "AutonomyArtifact",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Bind one best-known candidate to an atomic canonical SceneSpec promotion.",
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "contract_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Contract Id",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "workflow_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Workflow Id",
      "type": "string"
    },
    "dispatch_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Dispatch Id",
      "type": "string"
    },
    "input_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Sha256",
      "type": "string"
    },
    "source_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Fingerprint",
      "type": "string"
    },
    "producer": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Producer",
      "type": "string"
    },
    "producer_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Producer Version",
      "type": "string"
    },
    "provenance": {
      "items": {
        "$ref": "#/$defs/AutonomyArtifact"
      },
      "minItems": 1,
      "title": "Provenance",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "receipt_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Receipt Id",
      "type": "string"
    },
    "session_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Session Id",
      "type": "string"
    },
    "candidate_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Candidate Id",
      "type": "string"
    },
    "candidate_evaluation": {
      "$ref": "#/$defs/AutonomyArtifact"
    },
    "candidate_manifest": {
      "$ref": "#/$defs/AutonomyArtifact"
    },
    "candidate_modeling_plan": {
      "$ref": "#/$defs/AutonomyArtifact"
    },
    "candidate_scene_spec": {
      "$ref": "#/$defs/AutonomyArtifact"
    },
    "policy_authorization": {
      "$ref": "#/$defs/AutonomyArtifact"
    },
    "previous_modeling_plan_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Previous Modeling Plan Sha256"
    },
    "previous_scene_spec_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Previous Scene Spec Sha256"
    },
    "canonical_modeling_plan": {
      "$ref": "#/$defs/AutonomyArtifact"
    },
    "canonical_scene_spec": {
      "$ref": "#/$defs/AutonomyArtifact"
    },
    "archived_modeling_plan_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Archived Modeling Plan Path"
    },
    "archived_scene_spec_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Archived Scene Spec Path"
    },
    "canonical_writer": {
      "const": "controller_only",
      "default": "controller_only",
      "title": "Canonical Writer",
      "type": "string"
    }
  },
  "required": [
    "contract_id",
    "job_id",
    "workflow_id",
    "dispatch_id",
    "input_sha256",
    "source_fingerprint",
    "producer",
    "producer_version",
    "provenance",
    "created_at",
    "receipt_id",
    "session_id",
    "candidate_id",
    "candidate_evaluation",
    "candidate_manifest",
    "candidate_modeling_plan",
    "candidate_scene_spec",
    "policy_authorization",
    "canonical_modeling_plan",
    "canonical_scene_spec"
  ],
  "title": "CandidatePromotionReceipt",
  "type": "object"
}
