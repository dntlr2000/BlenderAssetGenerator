{
  "$defs": {
    "ControllerArtifact": {
      "additionalProperties": false,
      "description": "Bind one controller input or output to exact job-contained bytes.",
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "role": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Role",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "byte_size": {
          "exclusiveMinimum": 0,
          "title": "Byte Size",
          "type": "integer"
        }
      },
      "required": [
        "artifact_id",
        "role",
        "path",
        "sha256",
        "byte_size"
      ],
      "title": "ControllerArtifact",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Freeze one bounded controller call and its isolated input/output contract.",
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "contract_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Contract Id",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "workflow_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Workflow Id",
      "type": "string"
    },
    "dispatch_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Dispatch Id",
      "type": "string"
    },
    "session_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Session Id",
      "type": "string"
    },
    "input_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Sha256",
      "type": "string"
    },
    "source_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Fingerprint",
      "type": "string"
    },
    "producer": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Producer",
      "type": "string"
    },
    "producer_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Producer Version",
      "type": "string"
    },
    "provenance": {
      "items": {
        "$ref": "#/$defs/ControllerArtifact"
      },
      "minItems": 1,
      "title": "Provenance",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "execution_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Execution Id",
      "type": "string"
    },
    "controller_kind": {
      "enum": [
        "desktop_in_session",
        "fake_for_tests",
        "optional_codex_app_server"
      ],
      "title": "Controller Kind",
      "type": "string"
    },
    "assignment": {
      "$ref": "#/$defs/ControllerArtifact"
    },
    "immutable_inputs": {
      "items": {
        "$ref": "#/$defs/ControllerArtifact"
      },
      "minItems": 1,
      "title": "Immutable Inputs",
      "type": "array"
    },
    "tool_profile": {
      "$ref": "#/$defs/ControllerArtifact"
    },
    "output_root": {
      "title": "Output Root",
      "type": "string"
    },
    "allowed_output_paths": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Allowed Output Paths",
      "type": "array"
    },
    "expected_output_sha256": {
      "additionalProperties": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Expected Output Sha256",
      "type": "object"
    },
    "timeout_seconds": {
      "default": 900,
      "maximum": 3600,
      "minimum": 1,
      "title": "Timeout Seconds",
      "type": "integer"
    },
    "canonical_write_authority": {
      "const": "supervisor_only",
      "default": "supervisor_only",
      "title": "Canonical Write Authority",
      "type": "string"
    },
    "invocation_budget": {
      "const": 1,
      "default": 1,
      "title": "Invocation Budget",
      "type": "integer"
    }
  },
  "required": [
    "contract_id",
    "job_id",
    "workflow_id",
    "dispatch_id",
    "session_id",
    "input_sha256",
    "source_fingerprint",
    "producer",
    "provenance",
    "created_at",
    "execution_id",
    "controller_kind",
    "assignment",
    "immutable_inputs",
    "tool_profile",
    "output_root",
    "allowed_output_paths"
  ],
  "title": "ControllerExecutionRequest",
  "type": "object"
}
