{
  "$defs": {
    "CodexImageArtifact": {
      "additionalProperties": false,
      "description": "Bind one non-empty job-contained file to exact bytes and media semantics.",
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "byte_size": {
          "exclusiveMinimum": 0,
          "title": "Byte Size",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "path",
        "sha256",
        "byte_size",
        "media_type"
      ],
      "title": "CodexImageArtifact",
      "type": "object"
    },
    "CodexImageDimensions": {
      "additionalProperties": false,
      "description": "Describe one bounded raster size without assuming a provider-specific API shape.",
      "properties": {
        "width": {
          "maximum": 2048,
          "minimum": 64,
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "maximum": 2048,
          "minimum": 64,
          "title": "Height",
          "type": "integer"
        }
      },
      "required": [
        "width",
        "height"
      ],
      "title": "CodexImageDimensions",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Freeze bounded generation, candidate, refinement, size, and elapsed-time limits.",
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "contract_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Contract Id",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "workflow_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Workflow Id",
      "type": "string"
    },
    "dispatch_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Dispatch Id",
      "type": "string"
    },
    "session_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Session Id",
      "type": "string"
    },
    "profile_id": {
      "const": "autonomous_static_prop_v2_codex_imagegen",
      "default": "autonomous_static_prop_v2_codex_imagegen",
      "title": "Profile Id",
      "type": "string"
    },
    "provider_id": {
      "const": "codex_builtin_gpt_image_v1",
      "default": "codex_builtin_gpt_image_v1",
      "title": "Provider Id",
      "type": "string"
    },
    "input_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Sha256",
      "type": "string"
    },
    "source_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Fingerprint",
      "type": "string"
    },
    "producer": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Producer",
      "type": "string"
    },
    "producer_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Producer Version",
      "type": "string"
    },
    "provenance": {
      "items": {
        "$ref": "#/$defs/CodexImageArtifact"
      },
      "minItems": 1,
      "title": "Provenance",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "budget_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Budget Id",
      "type": "string"
    },
    "max_total_generations": {
      "default": 4,
      "maximum": 4,
      "minimum": 1,
      "title": "Max Total Generations",
      "type": "integer"
    },
    "max_candidates": {
      "default": 3,
      "maximum": 3,
      "minimum": 1,
      "title": "Max Candidates",
      "type": "integer"
    },
    "max_edits_or_refinements": {
      "default": 1,
      "maximum": 1,
      "minimum": 0,
      "title": "Max Edits Or Refinements",
      "type": "integer"
    },
    "max_generations_per_assignment": {
      "default": 3,
      "maximum": 3,
      "minimum": 1,
      "title": "Max Generations Per Assignment",
      "type": "integer"
    },
    "draft_quality": {
      "const": "low",
      "default": "low",
      "title": "Draft Quality",
      "type": "string"
    },
    "final_quality": {
      "const": "medium",
      "default": "medium",
      "title": "Final Quality",
      "type": "string"
    },
    "max_draft_size": {
      "$ref": "#/$defs/CodexImageDimensions"
    },
    "max_final_size": {
      "$ref": "#/$defs/CodexImageDimensions"
    },
    "timeout_per_assignment_seconds": {
      "default": 900,
      "maximum": 3600,
      "minimum": 30,
      "title": "Timeout Per Assignment Seconds",
      "type": "integer"
    },
    "max_total_elapsed_seconds": {
      "default": 3600,
      "maximum": 14400,
      "minimum": 30,
      "title": "Max Total Elapsed Seconds",
      "type": "integer"
    },
    "immutable": {
      "const": true,
      "default": true,
      "title": "Immutable",
      "type": "boolean"
    },
    "automatic_expansion": {
      "const": false,
      "default": false,
      "title": "Automatic Expansion",
      "type": "boolean"
    }
  },
  "required": [
    "contract_id",
    "job_id",
    "workflow_id",
    "dispatch_id",
    "session_id",
    "input_sha256",
    "source_fingerprint",
    "producer",
    "provenance",
    "created_at",
    "budget_id"
  ],
  "title": "CodexImageGenerationBudget",
  "type": "object"
}
