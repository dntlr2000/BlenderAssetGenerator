{
  "$defs": {
    "CodexImageArtifact": {
      "additionalProperties": false,
      "description": "Bind one non-empty job-contained file to exact bytes and media semantics.",
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "byte_size": {
          "exclusiveMinimum": 0,
          "title": "Byte Size",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "path",
        "sha256",
        "byte_size",
        "media_type"
      ],
      "title": "CodexImageArtifact",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Bind one exact failed-promotion retry without reopening its source journal.",
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "contract_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Contract Id",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "workflow_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Workflow Id",
      "type": "string"
    },
    "dispatch_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Dispatch Id",
      "type": "string"
    },
    "session_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Session Id",
      "type": "string"
    },
    "profile_id": {
      "const": "autonomous_static_prop_v2_codex_imagegen",
      "default": "autonomous_static_prop_v2_codex_imagegen",
      "title": "Profile Id",
      "type": "string"
    },
    "provider_id": {
      "const": "codex_builtin_gpt_image_v1",
      "default": "codex_builtin_gpt_image_v1",
      "title": "Provider Id",
      "type": "string"
    },
    "input_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Sha256",
      "type": "string"
    },
    "source_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Fingerprint",
      "type": "string"
    },
    "producer": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Producer",
      "type": "string"
    },
    "producer_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Producer Version",
      "type": "string"
    },
    "provenance": {
      "items": {
        "$ref": "#/$defs/CodexImageArtifact"
      },
      "minItems": 1,
      "title": "Provenance",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "immutable": {
      "const": true,
      "default": true,
      "title": "Immutable",
      "type": "boolean"
    },
    "retry_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Retry Id",
      "type": "string"
    },
    "retry_plan": {
      "$ref": "#/$defs/CodexImageArtifact"
    },
    "approval": {
      "$ref": "#/$defs/CodexImageArtifact"
    },
    "source_aq_state": {
      "$ref": "#/$defs/CodexImageArtifact"
    },
    "source_failed_material_loop_state": {
      "$ref": "#/$defs/CodexImageArtifact"
    },
    "source_failed_material_loop_terminal": {
      "$ref": "#/$defs/CodexImageArtifact"
    },
    "source_bridge_plan": {
      "$ref": "#/$defs/CodexImageArtifact"
    },
    "source_controller_input": {
      "$ref": "#/$defs/CodexImageArtifact"
    },
    "source_controller_request": {
      "$ref": "#/$defs/CodexImageArtifact"
    },
    "source_controller_result": {
      "$ref": "#/$defs/CodexImageArtifact"
    },
    "corrected_material_plan": {
      "$ref": "#/$defs/CodexImageArtifact"
    },
    "corrected_material_graph": {
      "$ref": "#/$defs/CodexImageArtifact"
    },
    "v05_bridge_receipt": {
      "$ref": "#/$defs/CodexImageArtifact"
    },
    "exact_adoption_preflight": {
      "$ref": "#/$defs/CodexImageArtifact"
    },
    "canonical_geometry_blend_snapshot": {
      "$ref": "#/$defs/CodexImageArtifact"
    },
    "implementation_snapshots": {
      "items": {
        "$ref": "#/$defs/CodexImageArtifact"
      },
      "maxItems": 5,
      "minItems": 3,
      "title": "Implementation Snapshots",
      "type": "array"
    },
    "status": {
      "const": "prepared",
      "default": "prepared",
      "title": "Status",
      "type": "string"
    },
    "reuse_controller_result": {
      "const": true,
      "default": true,
      "title": "Reuse Controller Result",
      "type": "boolean"
    },
    "new_controller_invocation_allowed": {
      "const": false,
      "default": false,
      "title": "New Controller Invocation Allowed",
      "type": "boolean"
    },
    "geometry_changed": {
      "const": false,
      "default": false,
      "title": "Geometry Changed",
      "type": "boolean"
    },
    "semantic_ids_changed": {
      "const": false,
      "default": false,
      "title": "Semantic Ids Changed",
      "type": "boolean"
    },
    "material_ids_changed": {
      "const": false,
      "default": false,
      "title": "Material Ids Changed",
      "type": "boolean"
    },
    "imagegen_evidence_changed": {
      "const": false,
      "default": false,
      "title": "Imagegen Evidence Changed",
      "type": "boolean"
    },
    "destination_write_performed": {
      "const": false,
      "default": false,
      "title": "Destination Write Performed",
      "type": "boolean"
    }
  },
  "required": [
    "contract_id",
    "job_id",
    "workflow_id",
    "dispatch_id",
    "session_id",
    "input_sha256",
    "source_fingerprint",
    "producer",
    "provenance",
    "created_at",
    "retry_id",
    "retry_plan",
    "approval",
    "source_aq_state",
    "source_failed_material_loop_state",
    "source_failed_material_loop_terminal",
    "source_bridge_plan",
    "source_controller_input",
    "source_controller_request",
    "source_controller_result",
    "corrected_material_plan",
    "corrected_material_graph",
    "v05_bridge_receipt",
    "exact_adoption_preflight",
    "canonical_geometry_blend_snapshot",
    "implementation_snapshots"
  ],
  "title": "ImageMaterialPromotionRetryReceipt",
  "type": "object"
}
