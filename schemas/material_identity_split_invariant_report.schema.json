{
  "$defs": {
    "ExactArtifact": {
      "additionalProperties": false,
      "description": "Bind one contained job-relative artifact by exact bytes and media type.",
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "pattern": "^[a-z][a-z0-9_]{1,95}$",
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "byte_size": {
          "minimum": 0,
          "title": "Byte Size",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 127,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "path",
        "sha256",
        "byte_size",
        "media_type"
      ],
      "title": "ExactArtifact",
      "type": "object"
    },
    "MaterialIdentitySplitCheck": {
      "additionalProperties": false,
      "description": "Record one deterministic preapproval or invariant check result.",
      "properties": {
        "check_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Check Id",
          "type": "string"
        },
        "category": {
          "enum": [
            "canonical",
            "candidate",
            "diff",
            "clone",
            "assignment",
            "blender",
            "geometry",
            "topology",
            "transform",
            "uv",
            "reference"
          ],
          "title": "Category",
          "type": "string"
        },
        "status": {
          "enum": [
            "passed",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "message": {
          "maxLength": 1200,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "check_id",
        "category",
        "status",
        "message"
      ],
      "title": "MaterialIdentitySplitCheck",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Prove exact clone, assignment, geometry, topology, transform, UV, and scope invariants.",
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "workflow_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Workflow Id",
      "type": "string"
    },
    "dispatch_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Dispatch Id",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Run Id",
      "type": "string"
    },
    "producer": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Producer",
      "type": "string"
    },
    "producer_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Producer Version",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "report_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Report Id",
      "type": "string"
    },
    "request": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "shadow_receipt": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "status": {
      "enum": [
        "passed",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "checks": {
      "items": {
        "$ref": "#/$defs/MaterialIdentitySplitCheck"
      },
      "minItems": 1,
      "title": "Checks",
      "type": "array"
    },
    "scene_change_count": {
      "minimum": 0,
      "title": "Scene Change Count",
      "type": "integer"
    },
    "modeling_plan_change_count": {
      "minimum": 0,
      "title": "Modeling Plan Change Count",
      "type": "integer"
    },
    "forbidden_change_count": {
      "minimum": 0,
      "title": "Forbidden Change Count",
      "type": "integer"
    },
    "clone_equivalence_passed": {
      "title": "Clone Equivalence Passed",
      "type": "boolean"
    },
    "assignment_exclusivity_passed": {
      "title": "Assignment Exclusivity Passed",
      "type": "boolean"
    },
    "object_ids_unchanged": {
      "title": "Object Ids Unchanged",
      "type": "boolean"
    },
    "geometry_unchanged": {
      "title": "Geometry Unchanged",
      "type": "boolean"
    },
    "topology_unchanged": {
      "title": "Topology Unchanged",
      "type": "boolean"
    },
    "transforms_unchanged": {
      "title": "Transforms Unchanged",
      "type": "boolean"
    },
    "dimensions_unchanged": {
      "title": "Dimensions Unchanged",
      "type": "boolean"
    },
    "uv_unchanged": {
      "title": "Uv Unchanged",
      "type": "boolean"
    },
    "reference_scope_unchanged": {
      "title": "Reference Scope Unchanged",
      "type": "boolean"
    },
    "target_subject_unchanged": {
      "title": "Target Subject Unchanged",
      "type": "boolean"
    },
    "content_scope_unchanged": {
      "title": "Content Scope Unchanged",
      "type": "boolean"
    },
    "material_assignments_match_plan": {
      "title": "Material Assignments Match Plan",
      "type": "boolean"
    }
  },
  "required": [
    "job_id",
    "workflow_id",
    "dispatch_id",
    "run_id",
    "producer",
    "producer_version",
    "created_at",
    "report_id",
    "request",
    "shadow_receipt",
    "status",
    "checks",
    "scene_change_count",
    "modeling_plan_change_count",
    "forbidden_change_count",
    "clone_equivalence_passed",
    "assignment_exclusivity_passed",
    "object_ids_unchanged",
    "geometry_unchanged",
    "topology_unchanged",
    "transforms_unchanged",
    "dimensions_unchanged",
    "uv_unchanged",
    "reference_scope_unchanged",
    "target_subject_unchanged",
    "content_scope_unchanged",
    "material_assignments_match_plan"
  ],
  "title": "MaterialIdentitySplitInvariantReport",
  "type": "object"
}
