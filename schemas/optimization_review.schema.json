{
  "$defs": {
    "CollisionOptimizationReview": {
      "additionalProperties": false,
      "description": "Expose the exact collider policy and its bounded pre-execution estimate.",
      "properties": {
        "strategy": {
          "enum": [
            "none",
            "box",
            "sphere",
            "capsule",
            "convex_hull",
            "compound",
            "mesh_proxy"
          ],
          "title": "Strategy",
          "type": "string"
        },
        "semantic_family_count": {
          "minimum": 0,
          "title": "Semantic Family Count",
          "type": "integer"
        },
        "source_object_count": {
          "minimum": 0,
          "title": "Source Object Count",
          "type": "integer"
        },
        "estimated_collider_count": {
          "minimum": 0,
          "title": "Estimated Collider Count",
          "type": "integer"
        },
        "estimated_triangle_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimated Triangle Count"
        },
        "maximum_triangle_ceiling": {
          "minimum": 0,
          "title": "Maximum Triangle Ceiling",
          "type": "integer"
        },
        "max_hulls_per_object": {
          "maximum": 64,
          "minimum": 1,
          "title": "Max Hulls Per Object",
          "type": "integer"
        },
        "max_triangles_per_object": {
          "minimum": 4,
          "title": "Max Triangles Per Object",
          "type": "integer"
        },
        "include_in_package": {
          "title": "Include In Package",
          "type": "boolean"
        },
        "recommendation": {
          "enum": [
            "disabled_by_profile",
            "manual_review"
          ],
          "title": "Recommendation",
          "type": "string"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Reasons",
          "type": "array"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        }
      },
      "required": [
        "strategy",
        "semantic_family_count",
        "source_object_count",
        "estimated_collider_count",
        "maximum_triangle_ceiling",
        "max_hulls_per_object",
        "max_triangles_per_object",
        "include_in_package",
        "recommendation",
        "reasons"
      ],
      "title": "CollisionOptimizationReview",
      "type": "object"
    },
    "ConsolidationPolicy": {
      "additionalProperties": false,
      "description": "Control safe derived-object cleanup and semantic-preserving batching.",
      "properties": {
        "mode": {
          "default": "none",
          "enum": [
            "none",
            "by_semantic_group",
            "by_spatial_cell"
          ],
          "title": "Mode",
          "type": "string"
        },
        "maximum_objects_per_batch": {
          "default": 64,
          "maximum": 1024,
          "minimum": 2,
          "title": "Maximum Objects Per Batch",
          "type": "integer"
        },
        "spatial_cell_size_m": {
          "default": 25.0,
          "exclusiveMinimum": 0,
          "title": "Spatial Cell Size M",
          "type": "number"
        },
        "remove_loose_geometry": {
          "default": true,
          "title": "Remove Loose Geometry",
          "type": "boolean"
        },
        "deduplicate_material_slots": {
          "default": true,
          "title": "Deduplicate Material Slots",
          "type": "boolean"
        },
        "deduplicate_exact_colliders": {
          "default": true,
          "title": "Deduplicate Exact Colliders",
          "type": "boolean"
        },
        "detect_exact_instances": {
          "default": true,
          "title": "Detect Exact Instances",
          "type": "boolean"
        },
        "detect_overlap_candidates": {
          "default": true,
          "title": "Detect Overlap Candidates",
          "type": "boolean"
        },
        "overlap_pair_limit": {
          "default": 5000,
          "maximum": 100000,
          "minimum": 1,
          "title": "Overlap Pair Limit",
          "type": "integer"
        }
      },
      "title": "ConsolidationPolicy",
      "type": "object"
    },
    "CostBudgetPolicy": {
      "additionalProperties": false,
      "description": "Declare optional engine-neutral static-asset cost ceilings.",
      "properties": {
        "enforcement": {
          "default": "warning",
          "enum": [
            "warning",
            "fail"
          ],
          "title": "Enforcement",
          "type": "string"
        },
        "max_lod0_render_objects": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Lod0 Render Objects"
        },
        "max_lod0_material_slots": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Lod0 Material Slots"
        },
        "max_lod0_estimated_draw_calls": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Lod0 Estimated Draw Calls"
        },
        "max_lod0_triangles": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Lod0 Triangles"
        },
        "max_collider_triangles": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Collider Triangles"
        },
        "max_overlap_candidates": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Overlap Candidates"
        }
      },
      "title": "CostBudgetPolicy",
      "type": "object"
    },
    "HashedArtifact": {
      "additionalProperties": false,
      "description": "Bind one stable artifact identity to a job-relative path and SHA-256 digest.",
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "scene_spec",
            "external_asset_manifest",
            "external_source",
            "external_dependency",
            "external_intake_plan",
            "external_intake_approval",
            "external_normalization_evidence",
            "blend",
            "geometry_payload",
            "material_plan",
            "texture_manifest",
            "asset_profile",
            "optimization_plan",
            "preflight_report",
            "lod_manifest",
            "collision_manifest",
            "uv_manifest",
            "asset_cost_report",
            "texture_pack_manifest",
            "lod_mesh",
            "collider_mesh",
            "uv_preview",
            "packed_texture",
            "package_manifest",
            "package_file",
            "roundtrip_inventory",
            "other"
          ],
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*//)[^\\u0000]+$",
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "path",
        "sha256"
      ],
      "title": "HashedArtifact",
      "type": "object"
    },
    "LODLevelReview": {
      "additionalProperties": false,
      "description": "Summarize one configured derived LOD level before optimization begins.",
      "properties": {
        "level": {
          "maximum": 8,
          "minimum": 1,
          "title": "Level",
          "type": "integer"
        },
        "target_triangle_ratio": {
          "exclusiveMaximum": 1,
          "exclusiveMinimum": 0,
          "title": "Target Triangle Ratio",
          "type": "number"
        },
        "minimum_silhouette_iou": {
          "maximum": 1,
          "minimum": 0,
          "title": "Minimum Silhouette Iou",
          "type": "number"
        },
        "estimated_triangle_ceiling": {
          "minimum": 0,
          "title": "Estimated Triangle Ceiling",
          "type": "integer"
        },
        "estimated_object_count": {
          "minimum": 0,
          "title": "Estimated Object Count",
          "type": "integer"
        }
      },
      "required": [
        "level",
        "target_triangle_ratio",
        "minimum_silhouette_iou",
        "estimated_triangle_ceiling",
        "estimated_object_count"
      ],
      "title": "LODLevelReview",
      "type": "object"
    },
    "LODOptimizationReview": {
      "additionalProperties": false,
      "description": "Expose the exact profile LOD policy and its estimated derived cost.",
      "properties": {
        "enabled": {
          "title": "Enabled",
          "type": "boolean"
        },
        "preserve_lod0": {
          "const": true,
          "default": true,
          "title": "Preserve Lod0",
          "type": "boolean"
        },
        "semantic_family_count": {
          "minimum": 0,
          "title": "Semantic Family Count",
          "type": "integer"
        },
        "source_object_count": {
          "minimum": 0,
          "title": "Source Object Count",
          "type": "integer"
        },
        "source_triangle_count": {
          "minimum": 0,
          "title": "Source Triangle Count",
          "type": "integer"
        },
        "levels": {
          "items": {
            "$ref": "#/$defs/LODLevelReview"
          },
          "title": "Levels",
          "type": "array"
        },
        "recommendation": {
          "enum": [
            "disabled_by_profile",
            "manual_review"
          ],
          "title": "Recommendation",
          "type": "string"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Reasons",
          "type": "array"
        },
        "unverified_checks": {
          "items": {
            "enum": [
              "silhouette_iou",
              "runtime_switching"
            ],
            "type": "string"
          },
          "title": "Unverified Checks",
          "type": "array"
        }
      },
      "required": [
        "enabled",
        "semantic_family_count",
        "source_object_count",
        "source_triangle_count",
        "recommendation",
        "reasons"
      ],
      "title": "LODOptimizationReview",
      "type": "object"
    },
    "SourceProvenance": {
      "additionalProperties": false,
      "description": "Freeze canonical geometry, build, material, and texture inputs for one V0.7 run.",
      "properties": {
        "source_kind": {
          "default": "scene_spec",
          "enum": [
            "scene_spec",
            "external_static_asset"
          ],
          "title": "Source Kind",
          "type": "string"
        },
        "scene_spec": {
          "anyOf": [
            {
              "$ref": "#/$defs/HashedArtifact"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "external_asset_manifest": {
          "anyOf": [
            {
              "$ref": "#/$defs/HashedArtifact"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "external_source_artifacts": {
          "items": {
            "$ref": "#/$defs/HashedArtifact"
          },
          "title": "External Source Artifacts",
          "type": "array"
        },
        "blend": {
          "$ref": "#/$defs/HashedArtifact"
        },
        "source_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Fingerprint",
          "type": "string"
        },
        "build_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Build Fingerprint",
          "type": "string"
        },
        "geometry_payloads": {
          "items": {
            "$ref": "#/$defs/HashedArtifact"
          },
          "title": "Geometry Payloads",
          "type": "array"
        },
        "material_plan": {
          "anyOf": [
            {
              "$ref": "#/$defs/HashedArtifact"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "texture_manifests": {
          "items": {
            "$ref": "#/$defs/HashedArtifact"
          },
          "title": "Texture Manifests",
          "type": "array"
        }
      },
      "required": [
        "blend",
        "source_fingerprint",
        "build_fingerprint"
      ],
      "title": "SourceProvenance",
      "type": "object"
    },
    "SourceQualitySummary": {
      "additionalProperties": false,
      "description": "Carry exact fast-preview quality warnings into the V0.7 approval boundary.",
      "properties": {
        "report_artifact": {
          "$ref": "#/$defs/HashedArtifact"
        },
        "quality_status": {
          "enum": [
            "passed",
            "needs_revision",
            "unscorable"
          ],
          "title": "Quality Status",
          "type": "string"
        },
        "overall_direct_score": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Overall Direct Score"
        },
        "primary_silhouette_score": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Primary Silhouette Score"
        },
        "primary_high_findings": {
          "items": {
            "type": "string"
          },
          "title": "Primary High Findings",
          "type": "array"
        },
        "supporting_high_findings": {
          "items": {
            "type": "string"
          },
          "title": "Supporting High Findings",
          "type": "array"
        },
        "decorative_warnings": {
          "items": {
            "type": "string"
          },
          "title": "Decorative Warnings",
          "type": "array"
        },
        "environment_findings": {
          "items": {
            "type": "string"
          },
          "title": "Environment Findings",
          "type": "array"
        },
        "standard_workflow_recommended": {
          "title": "Standard Workflow Recommended",
          "type": "boolean"
        },
        "qa_run_id": {
          "minLength": 1,
          "title": "Qa Run Id",
          "type": "string"
        },
        "source_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Fingerprint",
          "type": "string"
        },
        "build_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Build Fingerprint",
          "type": "string"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        }
      },
      "required": [
        "report_artifact",
        "quality_status",
        "standard_workflow_recommended",
        "qa_run_id",
        "source_fingerprint",
        "build_fingerprint"
      ],
      "title": "SourceQualitySummary",
      "type": "object"
    },
    "TexturePolicy": {
      "additionalProperties": false,
      "description": "Preserve raw PBR channels while defining an optional portable packing layout.",
      "properties": {
        "preserve_raw_channels": {
          "const": true,
          "default": true,
          "title": "Preserve Raw Channels",
          "type": "boolean"
        },
        "packing": {
          "default": "raw_channels",
          "enum": [
            "raw_channels",
            "gltf_orm",
            "none"
          ],
          "title": "Packing",
          "type": "string"
        },
        "maximum_resolution": {
          "default": 4096,
          "maximum": 8192,
          "minimum": 1,
          "title": "Maximum Resolution",
          "type": "integer"
        }
      },
      "title": "TexturePolicy",
      "type": "object"
    },
    "UVPolicy": {
      "additionalProperties": false,
      "description": "Control preservation, generation, and validation of material and lightmap UVs.",
      "properties": {
        "preserve_uv0": {
          "const": true,
          "default": true,
          "title": "Preserve Uv0",
          "type": "boolean"
        },
        "generate_uv0_if_missing": {
          "default": true,
          "title": "Generate Uv0 If Missing",
          "type": "boolean"
        },
        "generate_uv1": {
          "default": true,
          "title": "Generate Uv1",
          "type": "boolean"
        },
        "maximum_overlap_fraction": {
          "default": 0.01,
          "maximum": 1,
          "minimum": 0,
          "title": "Maximum Overlap Fraction",
          "type": "number"
        },
        "target_texel_density_px_m": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Texel Density Px M"
        },
        "minimum_padding_px": {
          "default": 4,
          "minimum": 0,
          "title": "Minimum Padding Px",
          "type": "integer"
        }
      },
      "title": "UVPolicy",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Present exact V0.7 LOD and collider defaults before any derived mutation.",
  "properties": {
    "schema_version": {
      "const": "0.7.0",
      "default": "0.7.0",
      "title": "Schema Version",
      "type": "string"
    },
    "review_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Review Id",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Run Id",
      "type": "string"
    },
    "profile_id": {
      "enum": [
        "portable_gltf",
        "fbx_interchange",
        "obj_legacy"
      ],
      "title": "Profile Id",
      "type": "string"
    },
    "primary_format": {
      "enum": [
        "glb",
        "fbx",
        "obj"
      ],
      "title": "Primary Format",
      "type": "string"
    },
    "profile_artifact": {
      "$ref": "#/$defs/HashedArtifact"
    },
    "preflight_report": {
      "$ref": "#/$defs/HashedArtifact"
    },
    "source": {
      "$ref": "#/$defs/SourceProvenance"
    },
    "source_quality": {
      "anyOf": [
        {
          "$ref": "#/$defs/SourceQualitySummary"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "plan_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Plan Sha256",
      "type": "string"
    },
    "units": {
      "const": "meters",
      "default": "meters",
      "title": "Units",
      "type": "string"
    },
    "up_axis": {
      "const": "+Y",
      "default": "+Y",
      "title": "Up Axis",
      "type": "string"
    },
    "forward_axis": {
      "const": "-Z",
      "default": "-Z",
      "title": "Forward Axis",
      "type": "string"
    },
    "pivot_policy": {
      "default": "keep",
      "enum": [
        "keep",
        "bounds_center",
        "base_center"
      ],
      "title": "Pivot Policy",
      "type": "string"
    },
    "lod": {
      "$ref": "#/$defs/LODOptimizationReview"
    },
    "collision": {
      "$ref": "#/$defs/CollisionOptimizationReview"
    },
    "consolidation_mode": {
      "enum": [
        "none",
        "by_semantic_group",
        "by_spatial_cell"
      ],
      "title": "Consolidation Mode",
      "type": "string"
    },
    "consolidation": {
      "$ref": "#/$defs/ConsolidationPolicy"
    },
    "uv": {
      "$ref": "#/$defs/UVPolicy"
    },
    "textures": {
      "$ref": "#/$defs/TexturePolicy"
    },
    "budgets": {
      "$ref": "#/$defs/CostBudgetPolicy"
    },
    "status": {
      "const": "awaiting_user_approval",
      "default": "awaiting_user_approval",
      "title": "Status",
      "type": "string"
    },
    "decision_required": {
      "const": true,
      "default": true,
      "title": "Decision Required",
      "type": "boolean"
    },
    "available_decisions": {
      "items": {
        "enum": [
          "approve",
          "revise_asset",
          "revise_profile",
          "cancel"
        ],
        "type": "string"
      },
      "title": "Available Decisions",
      "type": "array"
    },
    "recommended_decision": {
      "anyOf": [
        {
          "enum": [
            "approve",
            "revise_asset",
            "revise_profile",
            "cancel"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Recommended Decision"
    },
    "decision_reason": {
      "anyOf": [
        {
          "maxLength": 1000,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Decision Reason"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "canonical_unchanged": {
      "const": true,
      "default": true,
      "title": "Canonical Unchanged",
      "type": "boolean"
    }
  },
  "required": [
    "review_id",
    "job_id",
    "run_id",
    "profile_id",
    "primary_format",
    "profile_artifact",
    "preflight_report",
    "source",
    "plan_sha256",
    "lod",
    "collision",
    "consolidation_mode",
    "created_at"
  ],
  "title": "OptimizationReview",
  "type": "object"
}
