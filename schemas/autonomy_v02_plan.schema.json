{
  "$defs": {
    "AQV2Artifact": {
      "additionalProperties": false,
      "description": "Bind one immutable job-contained artifact to exact bytes and role.",
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "byte_size": {
          "exclusiveMinimum": 0,
          "title": "Byte Size",
          "type": "integer"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "path",
        "sha256",
        "byte_size"
      ],
      "title": "AQV2Artifact",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Bind one v2 supervisor to existing standard production and exact phase profiles.",
  "properties": {
    "schema_version": {
      "const": "0.2.0",
      "default": "0.2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "contract_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Contract Id",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "workflow_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Workflow Id",
      "type": "string"
    },
    "dispatch_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Dispatch Id",
      "type": "string"
    },
    "session_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Session Id",
      "type": "string"
    },
    "input_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Sha256",
      "type": "string"
    },
    "source_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Fingerprint",
      "type": "string"
    },
    "producer": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Producer",
      "type": "string"
    },
    "producer_version": {
      "const": "0.2.0",
      "default": "0.2.0",
      "title": "Producer Version",
      "type": "string"
    },
    "provenance": {
      "items": {
        "$ref": "#/$defs/AQV2Artifact"
      },
      "minItems": 1,
      "title": "Provenance",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "plan_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Plan Id",
      "type": "string"
    },
    "profile": {
      "$ref": "#/$defs/AQV2Artifact"
    },
    "root_authorization": {
      "$ref": "#/$defs/AQV2Artifact"
    },
    "budget": {
      "$ref": "#/$defs/AQV2Artifact"
    },
    "production_dispatch_plan": {
      "$ref": "#/$defs/AQV2Artifact"
    },
    "production_controller_plan": {
      "$ref": "#/$defs/AQV2Artifact"
    },
    "phase_tool_profiles": {
      "items": {
        "$ref": "#/$defs/AQV2Artifact"
      },
      "minItems": 1,
      "title": "Phase Tool Profiles",
      "type": "array"
    },
    "requested_delivery_profiles": {
      "items": {
        "enum": [
          "review_only",
          "portable_gltf",
          "portable_fbx"
        ],
        "type": "string"
      },
      "minItems": 1,
      "title": "Requested Delivery Profiles",
      "type": "array"
    },
    "canonical_writer": {
      "const": "supervisor_only",
      "default": "supervisor_only",
      "title": "Canonical Writer",
      "type": "string"
    },
    "automatic_user_approval": {
      "const": false,
      "default": false,
      "title": "Automatic User Approval",
      "type": "boolean"
    },
    "action_limit": {
      "default": 64,
      "maximum": 128,
      "minimum": 1,
      "title": "Action Limit",
      "type": "integer"
    }
  },
  "required": [
    "contract_id",
    "job_id",
    "workflow_id",
    "dispatch_id",
    "session_id",
    "input_sha256",
    "source_fingerprint",
    "producer",
    "provenance",
    "created_at",
    "plan_id",
    "profile",
    "root_authorization",
    "budget",
    "production_dispatch_plan",
    "production_controller_plan",
    "phase_tool_profiles",
    "requested_delivery_profiles"
  ],
  "title": "AutonomyPlanV2",
  "type": "object"
}
