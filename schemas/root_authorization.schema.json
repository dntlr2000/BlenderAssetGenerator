{
  "$defs": {
    "AutonomyArtifact": {
      "additionalProperties": false,
      "description": "Bind one contained artifact to its repository-relative path and exact bytes.",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "title": "AutonomyArtifact",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Bind one initial user request to a fixed autonomy scope and immutable budget.",
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "contract_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Contract Id",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "workflow_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Workflow Id",
      "type": "string"
    },
    "dispatch_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Dispatch Id",
      "type": "string"
    },
    "input_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Sha256",
      "type": "string"
    },
    "source_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Fingerprint",
      "type": "string"
    },
    "producer": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Producer",
      "type": "string"
    },
    "producer_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Producer Version",
      "type": "string"
    },
    "provenance": {
      "items": {
        "$ref": "#/$defs/AutonomyArtifact"
      },
      "minItems": 1,
      "title": "Provenance",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "authorization_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Authorization Id",
      "type": "string"
    },
    "authorization_source": {
      "const": "initial_user_request",
      "default": "initial_user_request",
      "title": "Authorization Source",
      "type": "string"
    },
    "original_request_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Original Request Sha256",
      "type": "string"
    },
    "production_launch_or_binding": {
      "$ref": "#/$defs/AutonomyArtifact"
    },
    "primary_reference": {
      "$ref": "#/$defs/AutonomyArtifact"
    },
    "autonomy_profile": {
      "$ref": "#/$defs/AutonomyArtifact"
    },
    "reference_content_scope": {
      "const": "primary_object_only",
      "default": "primary_object_only",
      "title": "Reference Content Scope",
      "type": "string"
    },
    "target_subject": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Target Subject",
      "type": "string"
    },
    "output_profile": {
      "const": "portable_gltf",
      "default": "portable_gltf",
      "title": "Output Profile",
      "type": "string"
    },
    "allowed_gate_kinds": {
      "items": {
        "enum": [
          "generic_proxy_review",
          "generic_detail_review",
          "material_swatch_acknowledgement",
          "structural_candidate_promotion",
          "bounded_convergence_plan",
          "bounded_convergence_candidate",
          "material_candidate_promotion",
          "qa_review_acknowledgement",
          "optimization_plan",
          "final_package_acknowledgement",
          "destination_handoff_envelope_plan"
        ],
        "type": "string"
      },
      "minItems": 1,
      "title": "Allowed Gate Kinds",
      "type": "array"
    },
    "prohibited_scopes": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Prohibited Scopes",
      "type": "array"
    },
    "budget": {
      "$ref": "#/$defs/AutonomyArtifact"
    },
    "status": {
      "default": "active",
      "enum": [
        "active",
        "expired",
        "cancelled"
      ],
      "title": "Status",
      "type": "string"
    },
    "expires_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expires At"
    },
    "cancelled_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cancelled At"
    }
  },
  "required": [
    "contract_id",
    "job_id",
    "workflow_id",
    "dispatch_id",
    "input_sha256",
    "source_fingerprint",
    "producer",
    "producer_version",
    "provenance",
    "created_at",
    "authorization_id",
    "original_request_sha256",
    "production_launch_or_binding",
    "primary_reference",
    "autonomy_profile",
    "target_subject",
    "allowed_gate_kinds",
    "prohibited_scopes",
    "budget"
  ],
  "title": "RootAuthorization",
  "type": "object"
}
