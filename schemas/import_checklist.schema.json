{
  "$defs": {
    "ImportChecklistItem": {
      "additionalProperties": false,
      "description": "Define one ordered, approval-aware destination import checkpoint.",
      "properties": {
        "order": {
          "maximum": 100,
          "minimum": 1,
          "title": "Order",
          "type": "integer"
        },
        "item_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Item Id",
          "type": "string"
        },
        "title": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "instruction": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Instruction",
          "type": "string"
        },
        "gate": {
          "enum": [
            "pre_plan",
            "plan",
            "approval",
            "apply",
            "validate"
          ],
          "title": "Gate",
          "type": "string"
        }
      },
      "required": [
        "order",
        "item_id",
        "title",
        "instruction",
        "gate"
      ],
      "title": "ImportChecklistItem",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Require destination analysis and user approval before any project mutation.",
  "properties": {
    "schema_version": {
      "const": "0.9.0",
      "default": "0.9.0",
      "title": "Schema Version",
      "type": "string"
    },
    "handoff_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Handoff Id",
      "type": "string"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/ImportChecklistItem"
      },
      "minItems": 1,
      "title": "Items",
      "type": "array"
    },
    "required_plan_output": {
      "const": "import_plan.json",
      "default": "import_plan.json",
      "title": "Required Plan Output",
      "type": "string"
    },
    "required_receipt_output": {
      "const": "import_receipt.json",
      "default": "import_receipt.json",
      "title": "Required Receipt Output",
      "type": "string"
    },
    "required_validation_output": {
      "const": "import_validation.json",
      "default": "import_validation.json",
      "title": "Required Validation Output",
      "type": "string"
    },
    "user_approval_required_before_apply": {
      "const": true,
      "default": true,
      "title": "User Approval Required Before Apply",
      "type": "boolean"
    }
  },
  "required": [
    "handoff_id",
    "items"
  ],
  "title": "ImportChecklist",
  "type": "object"
}
