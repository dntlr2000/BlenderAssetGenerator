{
  "$defs": {
    "CodexImageArtifact": {
      "additionalProperties": false,
      "description": "Bind one non-empty job-contained file to exact bytes and media semantics.",
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "byte_size": {
          "exclusiveMinimum": 0,
          "title": "Byte Size",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "path",
        "sha256",
        "byte_size",
        "media_type"
      ],
      "title": "CodexImageArtifact",
      "type": "object"
    },
    "CodexImageChannelDerivationV021": {
      "additionalProperties": false,
      "description": "Bind one raw output channel to a direct or local deterministic decision.",
      "properties": {
        "channel": {
          "enum": [
            "base_color",
            "roughness",
            "metallic",
            "normal",
            "height",
            "occlusion",
            "opacity",
            "emission"
          ],
          "title": "Channel",
          "type": "string"
        },
        "provenance_kind": {
          "enum": [
            "codex_generated_direct",
            "local_deterministic_derivation",
            "local_exact_text_composition",
            "local_constant"
          ],
          "title": "Provenance Kind",
          "type": "string"
        },
        "algorithm_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Algorithm Id",
          "type": "string"
        },
        "algorithm_version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Algorithm Version",
          "type": "string"
        },
        "source_sha256": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Sha256",
          "type": "array"
        },
        "parameters": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "string"
              }
            ]
          },
          "title": "Parameters",
          "type": "object"
        },
        "parameters_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Parameters Sha256",
          "type": "string"
        },
        "output": {
          "$ref": "#/$defs/ExactArtifact"
        },
        "width": {
          "maximum": 4096,
          "minimum": 1,
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "maximum": 4096,
          "minimum": 1,
          "title": "Height",
          "type": "integer"
        },
        "color_space": {
          "enum": [
            "srgb",
            "non_color",
            "linear"
          ],
          "title": "Color Space",
          "type": "string"
        },
        "uv_identity": {
          "$ref": "#/$defs/UVIdentity"
        },
        "normal_convention": {
          "anyOf": [
            {
              "const": "opengl_y_plus",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Normal Convention"
        }
      },
      "required": [
        "channel",
        "provenance_kind",
        "algorithm_id",
        "algorithm_version",
        "source_sha256",
        "parameters",
        "parameters_sha256",
        "output",
        "width",
        "height",
        "color_space",
        "uv_identity"
      ],
      "title": "CodexImageChannelDerivationV021",
      "type": "object"
    },
    "CodexImageMaterialQualityV021": {
      "additionalProperties": false,
      "description": "Store deterministic image suitability checks without claiming human review.",
      "properties": {
        "decoded": {
          "title": "Decoded",
          "type": "boolean"
        },
        "dimensions_match": {
          "title": "Dimensions Match",
          "type": "boolean"
        },
        "spatial_standard_deviation": {
          "maximum": 1,
          "minimum": 0,
          "title": "Spatial Standard Deviation",
          "type": "number"
        },
        "offset_edge_rmse": {
          "maximum": 1,
          "minimum": 0,
          "title": "Offset Edge Rmse",
          "type": "number"
        },
        "detected_grain_axis": {
          "enum": [
            "x",
            "y",
            "none",
            "ambiguous"
          ],
          "title": "Detected Grain Axis",
          "type": "string"
        },
        "grain_axis_matches": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Grain Axis Matches"
        },
        "direct_role_allowed": {
          "const": true,
          "default": true,
          "title": "Direct Role Allowed",
          "type": "boolean"
        },
        "local_derivations_source_bound": {
          "const": true,
          "default": true,
          "title": "Local Derivations Source Bound",
          "type": "boolean"
        },
        "human_reviewed": {
          "const": false,
          "default": false,
          "title": "Human Reviewed",
          "type": "boolean"
        },
        "outcome": {
          "enum": [
            "passed",
            "review_required",
            "failed"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        }
      },
      "required": [
        "decoded",
        "dimensions_match",
        "spatial_standard_deviation",
        "offset_edge_rmse",
        "detected_grain_axis",
        "outcome"
      ],
      "title": "CodexImageMaterialQualityV021",
      "type": "object"
    },
    "CodexImageMaterialSourceV021": {
      "additionalProperties": false,
      "description": "Describe the exact selected raster and its only permitted direct semantic role.",
      "properties": {
        "artifact": {
          "$ref": "#/$defs/ExactArtifact"
        },
        "width": {
          "maximum": 8192,
          "minimum": 1,
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "maximum": 8192,
          "minimum": 1,
          "title": "Height",
          "type": "integer"
        },
        "direct_role": {
          "enum": [
            "base_color",
            "decal_rgb",
            "emission",
            "opacity_source"
          ],
          "title": "Direct Role",
          "type": "string"
        },
        "color_space": {
          "enum": [
            "srgb",
            "non_color",
            "linear"
          ],
          "title": "Color Space",
          "type": "string"
        },
        "license_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "License Id",
          "type": "string"
        },
        "rights_status": {
          "enum": [
            "user_provided",
            "project_owned",
            "licensed",
            "public_domain",
            "unknown"
          ],
          "title": "Rights Status",
          "type": "string"
        },
        "provenance": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Provenance",
          "type": "string"
        }
      },
      "required": [
        "artifact",
        "width",
        "height",
        "direct_role",
        "color_space",
        "license_id",
        "rights_status",
        "provenance"
      ],
      "title": "CodexImageMaterialSourceV021",
      "type": "object"
    },
    "ExactArtifact": {
      "additionalProperties": false,
      "description": "Bind one non-empty job-contained file to its exact bytes and role.",
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "maxLength": 96,
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "byte_size": {
          "exclusiveMinimum": 0,
          "title": "Byte Size",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "path",
        "sha256",
        "byte_size",
        "media_type"
      ],
      "title": "ExactArtifact",
      "type": "object"
    },
    "ExactTextCompositionReceiptV021": {
      "additionalProperties": false,
      "description": "Record whether exact text was locally rasterized without inventing content.",
      "properties": {
        "evidence": {
          "enum": [
            "exact_user_text",
            "unknown_text",
            "inferred_placeholder"
          ],
          "title": "Evidence",
          "type": "string"
        },
        "rendered": {
          "title": "Rendered",
          "type": "boolean"
        },
        "text_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text Sha256"
        },
        "font": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExactArtifact"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "output": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExactArtifact"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "glyph_count": {
          "minimum": 0,
          "title": "Glyph Count",
          "type": "integer"
        },
        "algorithm_id": {
          "const": "project_local_exact_text_composition_v1",
          "title": "Algorithm Id",
          "type": "string"
        }
      },
      "required": [
        "evidence",
        "rendered",
        "glyph_count",
        "algorithm_id"
      ],
      "title": "ExactTextCompositionReceiptV021",
      "type": "object"
    },
    "UVIdentity": {
      "additionalProperties": false,
      "description": "Bind the current UV identity to an exact stale-detecting evidence artifact.",
      "properties": {
        "schema_version": {
          "const": "0.1.0",
          "default": "0.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "semantic_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Semantic Id",
          "type": "string"
        },
        "uv_set": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Uv Set",
          "type": "string"
        },
        "uv_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Uv Fingerprint",
          "type": "string"
        },
        "ordered_polygon_corner_count": {
          "minimum": 3,
          "title": "Ordered Polygon Corner Count",
          "type": "integer"
        },
        "texel_density_px_m": {
          "exclusiveMinimum": 0,
          "title": "Texel Density Px M",
          "type": "number"
        },
        "evidence": {
          "$ref": "#/$defs/ExactArtifact"
        }
      },
      "required": [
        "semantic_id",
        "uv_set",
        "uv_fingerprint",
        "ordered_polygon_corner_count",
        "texel_density_px_m",
        "evidence"
      ],
      "title": "UVIdentity",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Describe a normalized-source material candidate without claiming 0.2.1 output.",
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "contract_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Contract Id",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "workflow_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Workflow Id",
      "type": "string"
    },
    "dispatch_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Dispatch Id",
      "type": "string"
    },
    "session_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Session Id",
      "type": "string"
    },
    "profile_id": {
      "const": "autonomous_static_prop_v2_codex_imagegen",
      "default": "autonomous_static_prop_v2_codex_imagegen",
      "title": "Profile Id",
      "type": "string"
    },
    "provider_id": {
      "const": "codex_builtin_gpt_image_v1",
      "default": "codex_builtin_gpt_image_v1",
      "title": "Provider Id",
      "type": "string"
    },
    "input_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Sha256",
      "type": "string"
    },
    "source_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Fingerprint",
      "type": "string"
    },
    "producer": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Producer",
      "type": "string"
    },
    "producer_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Producer Version",
      "type": "string"
    },
    "provenance": {
      "items": {
        "$ref": "#/$defs/CodexImageArtifact"
      },
      "minItems": 1,
      "title": "Provenance",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "immutable": {
      "const": true,
      "default": true,
      "title": "Immutable",
      "type": "boolean"
    },
    "manifest_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Manifest Id",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Run Id",
      "type": "string"
    },
    "material_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Material Id",
      "type": "string"
    },
    "strategy": {
      "enum": [
        "codex_generated_base_color_v1",
        "codex_generated_decal_v1",
        "codex_generated_emission_v1",
        "codex_generated_procedural_hybrid_v1"
      ],
      "title": "Strategy",
      "type": "string"
    },
    "material_family": {
      "enum": [
        "uniform_fallback",
        "user_image_pbr",
        "signage_decal",
        "planar_reference_patch",
        "wood",
        "metal",
        "emissive",
        "crystal"
      ],
      "title": "Material Family",
      "type": "string"
    },
    "request": {
      "$ref": "#/$defs/CodexImageArtifact"
    },
    "base_request_artifact": {
      "$ref": "#/$defs/CodexImageArtifact"
    },
    "normalization_plan": {
      "$ref": "#/$defs/CodexImageArtifact"
    },
    "normalization_receipt": {
      "$ref": "#/$defs/CodexImageArtifact"
    },
    "selected_source": {
      "$ref": "#/$defs/CodexImageMaterialSourceV021"
    },
    "effective_source": {
      "$ref": "#/$defs/CodexImageMaterialSourceV021"
    },
    "derivation_policy_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Derivation Policy Sha256",
      "type": "string"
    },
    "channels": {
      "items": {
        "$ref": "#/$defs/CodexImageChannelDerivationV021"
      },
      "minItems": 1,
      "title": "Channels",
      "type": "array"
    },
    "exact_text": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExactTextCompositionReceiptV021"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "quality": {
      "$ref": "#/$defs/CodexImageMaterialQualityV021"
    },
    "status": {
      "enum": [
        "candidate_ready",
        "review_required"
      ],
      "title": "Status",
      "type": "string"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "staging_only": {
      "const": true,
      "default": true,
      "title": "Staging Only",
      "type": "boolean"
    },
    "canonical_v05_unchanged": {
      "const": true,
      "default": true,
      "title": "Canonical V05 Unchanged",
      "type": "boolean"
    },
    "canonical_write_performed": {
      "const": false,
      "default": false,
      "title": "Canonical Write Performed",
      "type": "boolean"
    },
    "destination_write_performed": {
      "const": false,
      "default": false,
      "title": "Destination Write Performed",
      "type": "boolean"
    },
    "actual_codex_imagegen_execution_verified": {
      "const": false,
      "default": false,
      "title": "Actual Codex Imagegen Execution Verified",
      "type": "boolean"
    },
    "blender_compilation_status": {
      "const": "not_run",
      "default": "not_run",
      "title": "Blender Compilation Status",
      "type": "string"
    }
  },
  "required": [
    "contract_id",
    "job_id",
    "workflow_id",
    "dispatch_id",
    "session_id",
    "input_sha256",
    "source_fingerprint",
    "producer",
    "provenance",
    "created_at",
    "manifest_id",
    "run_id",
    "material_id",
    "strategy",
    "material_family",
    "request",
    "base_request_artifact",
    "normalization_plan",
    "normalization_receipt",
    "selected_source",
    "effective_source",
    "derivation_policy_sha256",
    "channels",
    "quality",
    "status"
  ],
  "title": "CodexImageNormalizedAuthoredMaterialManifestV010",
  "type": "object"
}
