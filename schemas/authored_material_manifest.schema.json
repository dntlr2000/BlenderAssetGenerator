{
  "$defs": {
    "AuthoredChannel": {
      "additionalProperties": false,
      "description": "Bind one run-owned raw PBR output and the exact evidence that produced it.",
      "properties": {
        "channel": {
          "enum": [
            "base_color",
            "roughness",
            "metallic",
            "normal",
            "height",
            "occlusion",
            "opacity",
            "emission"
          ],
          "title": "Channel",
          "type": "string"
        },
        "artifact": {
          "$ref": "#/$defs/ExactArtifact"
        },
        "width": {
          "maximum": 8192,
          "minimum": 1,
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "maximum": 8192,
          "minimum": 1,
          "title": "Height",
          "type": "integer"
        },
        "color_space": {
          "enum": [
            "srgb",
            "non_color",
            "linear"
          ],
          "title": "Color Space",
          "type": "string"
        },
        "uv_identity": {
          "$ref": "#/$defs/UVIdentity"
        },
        "source_artifact_sha256": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Source Artifact Sha256",
          "type": "array"
        },
        "normal_convention": {
          "anyOf": [
            {
              "const": "opengl_y_plus",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Normal Convention"
        }
      },
      "required": [
        "channel",
        "artifact",
        "width",
        "height",
        "color_space",
        "uv_identity"
      ],
      "title": "AuthoredChannel",
      "type": "object"
    },
    "ExactArtifact": {
      "additionalProperties": false,
      "description": "Bind one non-empty job-contained file to its exact bytes and role.",
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "maxLength": 96,
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "byte_size": {
          "exclusiveMinimum": 0,
          "title": "Byte Size",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "path",
        "sha256",
        "byte_size",
        "media_type"
      ],
      "title": "ExactArtifact",
      "type": "object"
    },
    "MasterMaterialIntent": {
      "additionalProperties": false,
      "description": "Describe Blender master intent separately from portable approximation claims.",
      "properties": {
        "shader_family": {
          "enum": [
            "uniform_fallback",
            "user_image_pbr",
            "signage_decal",
            "planar_reference_patch",
            "wood",
            "metal",
            "emissive",
            "crystal"
          ],
          "title": "Shader Family",
          "type": "string"
        },
        "features": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Features",
          "type": "array"
        },
        "blender_compilation_status": {
          "default": "not_run",
          "enum": [
            "not_run",
            "passed",
            "failed"
          ],
          "title": "Blender Compilation Status",
          "type": "string"
        },
        "blender_fixture": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExactArtifact"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "portable_approximation": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Portable Approximation",
          "type": "string"
        },
        "known_losses": {
          "items": {
            "type": "string"
          },
          "title": "Known Losses",
          "type": "array"
        }
      },
      "required": [
        "shader_family",
        "features",
        "portable_approximation"
      ],
      "title": "MasterMaterialIntent",
      "type": "object"
    },
    "PreviewEvidenceState": {
      "additionalProperties": false,
      "description": "Record neutral and reference preview states without conflating their authority.",
      "properties": {
        "neutral_studio_status": {
          "enum": [
            "not_run",
            "passed",
            "failed"
          ],
          "title": "Neutral Studio Status",
          "type": "string"
        },
        "neutral_studio_artifact": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExactArtifact"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reference_matched_status": {
          "enum": [
            "not_requested",
            "not_run",
            "passed",
            "failed"
          ],
          "title": "Reference Matched Status",
          "type": "string"
        },
        "reference_matched_artifact": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExactArtifact"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "neutral_studio_required_for_quality": {
          "const": true,
          "default": true,
          "title": "Neutral Studio Required For Quality",
          "type": "boolean"
        },
        "reference_matched_never_sufficient_alone": {
          "const": true,
          "default": true,
          "title": "Reference Matched Never Sufficient Alone",
          "type": "boolean"
        }
      },
      "required": [
        "neutral_studio_status",
        "reference_matched_status"
      ],
      "title": "PreviewEvidenceState",
      "type": "object"
    },
    "ResolutionSelection": {
      "additionalProperties": false,
      "description": "Record the selected tier, scale basis, budget clamp, and authorization state.",
      "properties": {
        "selector_input_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Selector Input Sha256",
          "type": "string"
        },
        "selected_pixels": {
          "enum": [
            256,
            512,
            1024,
            2048,
            4096,
            8192
          ],
          "title": "Selected Pixels",
          "type": "integer"
        },
        "unclamped_target_pixels": {
          "exclusiveMinimum": 0,
          "title": "Unclamped Target Pixels",
          "type": "number"
        },
        "scale_context_recommendation": {
          "exclusiveMinimum": 0,
          "title": "Scale Context Recommendation",
          "type": "integer"
        },
        "budget_limited": {
          "title": "Budget Limited",
          "type": "boolean"
        },
        "high_resolution_authorized": {
          "title": "High Resolution Authorized",
          "type": "boolean"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Reasons",
          "type": "array"
        }
      },
      "required": [
        "selector_input_sha256",
        "selected_pixels",
        "unclamped_target_pixels",
        "scale_context_recommendation",
        "budget_limited",
        "high_resolution_authorized",
        "reasons"
      ],
      "title": "ResolutionSelection",
      "type": "object"
    },
    "ScaleContextBinding": {
      "additionalProperties": false,
      "description": "Bind and summarize one exact AssetScaleContext 0.1.0 artifact.",
      "properties": {
        "artifact": {
          "$ref": "#/$defs/ExactArtifact"
        },
        "asset_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Asset Id",
          "type": "string"
        },
        "source_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Fingerprint",
          "type": "string"
        },
        "shortest_dimension_m": {
          "exclusiveMinimum": 0,
          "title": "Shortest Dimension M",
          "type": "number"
        },
        "longest_dimension_m": {
          "exclusiveMinimum": 0,
          "title": "Longest Dimension M",
          "type": "number"
        },
        "target_texel_density_px_m": {
          "exclusiveMinimum": 0,
          "title": "Target Texel Density Px M",
          "type": "number"
        }
      },
      "required": [
        "artifact",
        "asset_id",
        "source_fingerprint",
        "shortest_dimension_m",
        "longest_dimension_m",
        "target_texel_density_px_m"
      ],
      "title": "ScaleContextBinding",
      "type": "object"
    },
    "UVIdentity": {
      "additionalProperties": false,
      "description": "Bind the current UV identity to an exact stale-detecting evidence artifact.",
      "properties": {
        "schema_version": {
          "const": "0.1.0",
          "default": "0.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "semantic_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Semantic Id",
          "type": "string"
        },
        "uv_set": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Uv Set",
          "type": "string"
        },
        "uv_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Uv Fingerprint",
          "type": "string"
        },
        "ordered_polygon_corner_count": {
          "minimum": 3,
          "title": "Ordered Polygon Corner Count",
          "type": "integer"
        },
        "texel_density_px_m": {
          "exclusiveMinimum": 0,
          "title": "Texel Density Px M",
          "type": "number"
        },
        "evidence": {
          "$ref": "#/$defs/ExactArtifact"
        }
      },
      "required": [
        "semantic_id",
        "uv_set",
        "uv_fingerprint",
        "ordered_polygon_corner_count",
        "texel_density_px_m",
        "evidence"
      ],
      "title": "UVIdentity",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Record exact run-owned channels, scale, preview separation, and limitations.",
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "manifest_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Manifest Id",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "workflow_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Workflow Id",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Run Id",
      "type": "string"
    },
    "material_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Material Id",
      "type": "string"
    },
    "strategy": {
      "enum": [
        "uniform_portable_fallback_v1",
        "user_image_pbr_v1",
        "localized_decal_v1",
        "planar_reference_patch_v1",
        "procedural_wood_v1",
        "procedural_metal_v1",
        "emissive_pattern_v1",
        "crystal_portable_approximation_v1"
      ],
      "title": "Strategy",
      "type": "string"
    },
    "material_family": {
      "enum": [
        "uniform_fallback",
        "user_image_pbr",
        "signage_decal",
        "planar_reference_patch",
        "wood",
        "metal",
        "emissive",
        "crystal"
      ],
      "title": "Material Family",
      "type": "string"
    },
    "request": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "source_v05_contracts": {
      "items": {
        "$ref": "#/$defs/ExactArtifact"
      },
      "minItems": 1,
      "title": "Source V05 Contracts",
      "type": "array"
    },
    "scale_context": {
      "$ref": "#/$defs/ScaleContextBinding"
    },
    "resolution": {
      "$ref": "#/$defs/ResolutionSelection"
    },
    "channels": {
      "items": {
        "$ref": "#/$defs/AuthoredChannel"
      },
      "title": "Channels",
      "type": "array"
    },
    "master_intent": {
      "$ref": "#/$defs/MasterMaterialIntent"
    },
    "preview_evidence": {
      "$ref": "#/$defs/PreviewEvidenceState"
    },
    "source_to_output_provenance_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source To Output Provenance Sha256",
      "type": "string"
    },
    "status": {
      "enum": [
        "completed",
        "review_required",
        "unverified"
      ],
      "title": "Status",
      "type": "string"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "canonical_v05_unchanged": {
      "const": true,
      "default": true,
      "title": "Canonical V05 Unchanged",
      "type": "boolean"
    },
    "destination_write_performed": {
      "const": false,
      "default": false,
      "title": "Destination Write Performed",
      "type": "boolean"
    },
    "runtime_parity_verified": {
      "const": false,
      "default": false,
      "title": "Runtime Parity Verified",
      "type": "boolean"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "manifest_id",
    "job_id",
    "workflow_id",
    "run_id",
    "material_id",
    "strategy",
    "material_family",
    "request",
    "source_v05_contracts",
    "scale_context",
    "resolution",
    "channels",
    "master_intent",
    "preview_evidence",
    "source_to_output_provenance_sha256",
    "status",
    "created_at"
  ],
  "title": "AuthoredMaterialManifest",
  "type": "object"
}
