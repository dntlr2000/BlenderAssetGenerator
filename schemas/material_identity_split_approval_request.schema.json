{
  "$defs": {
    "ExactArtifact": {
      "additionalProperties": false,
      "description": "Bind one contained job-relative artifact by exact bytes and media type.",
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "pattern": "^[a-z][a-z0-9_]{1,95}$",
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "byte_size": {
          "minimum": 0,
          "title": "Byte Size",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 127,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "path",
        "sha256",
        "byte_size",
        "media_type"
      ],
      "title": "ExactArtifact",
      "type": "object"
    },
    "MaterialIdentitySplitAssignment": {
      "additionalProperties": false,
      "description": "Bind one object to one material before or after the guarded split.",
      "properties": {
        "object_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Object Id",
          "type": "string"
        },
        "material_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Material Id",
          "type": "string"
        }
      },
      "required": [
        "object_id",
        "material_id"
      ],
      "title": "MaterialIdentitySplitAssignment",
      "type": "object"
    },
    "MaterialIdentitySplitCanonicalPreconditions": {
      "additionalProperties": false,
      "description": "Bind exact canonical bytes, absence, reference, scope, and UV preconditions.",
      "properties": {
        "scene_spec": {
          "$ref": "#/$defs/ExactArtifact"
        },
        "modeling_plan": {
          "$ref": "#/$defs/ExactArtifact"
        },
        "blend": {
          "$ref": "#/$defs/ExactArtifact"
        },
        "material_plan_absence": {
          "$ref": "#/$defs/ExactArtifact"
        },
        "root_authorization": {
          "$ref": "#/$defs/ExactArtifact"
        },
        "primary_reference": {
          "$ref": "#/$defs/ExactArtifact"
        },
        "content_scope_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Scope Sha256",
          "type": "string"
        },
        "target_subject": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Target Subject",
          "type": "string"
        },
        "uv_layout_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Uv Layout Fingerprint",
          "type": "string"
        }
      },
      "required": [
        "scene_spec",
        "modeling_plan",
        "blend",
        "material_plan_absence",
        "root_authorization",
        "primary_reference",
        "content_scope_sha256",
        "target_subject",
        "uv_layout_fingerprint"
      ],
      "title": "MaterialIdentitySplitCanonicalPreconditions",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Present one exact narrow scope change for a future explicit user decision.",
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "workflow_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Workflow Id",
      "type": "string"
    },
    "dispatch_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Dispatch Id",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Run Id",
      "type": "string"
    },
    "producer": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Producer",
      "type": "string"
    },
    "producer_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Producer Version",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "approval_request_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Approval Request Id",
      "type": "string"
    },
    "plan": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "candidate_scene_spec": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "candidate_modeling_plan": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "scene_diff_allowlist": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "modeling_plan_diff_report": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "approval_impact_report": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "preapproval_report": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "shadow_build_receipt": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "invariant_report": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "geometry_uv_unchanged_report": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "surface_detail_material_mapping": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "changed_assignments": {
      "items": {
        "$ref": "#/$defs/MaterialIdentitySplitAssignment"
      },
      "minItems": 1,
      "title": "Changed Assignments",
      "type": "array"
    },
    "retained_assignments": {
      "items": {
        "$ref": "#/$defs/MaterialIdentitySplitAssignment"
      },
      "minItems": 1,
      "title": "Retained Assignments",
      "type": "array"
    },
    "preconditions": {
      "$ref": "#/$defs/MaterialIdentitySplitCanonicalPreconditions"
    },
    "channel_reconciliation": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "current_material_closure": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "latest_framework_failure": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "approval_scope": {
      "const": "material_identity_split",
      "default": "material_identity_split",
      "title": "Approval Scope",
      "type": "string"
    },
    "satisfies_required_approval": {
      "const": "root_scope",
      "default": "root_scope",
      "title": "Satisfies Required Approval",
      "type": "string"
    },
    "status": {
      "const": "eligible_for_explicit_user_scope_approval",
      "default": "eligible_for_explicit_user_scope_approval",
      "title": "Status",
      "type": "string"
    },
    "is_user_approval": {
      "const": false,
      "default": false,
      "title": "Is User Approval",
      "type": "boolean"
    }
  },
  "required": [
    "job_id",
    "workflow_id",
    "dispatch_id",
    "run_id",
    "producer",
    "producer_version",
    "created_at",
    "approval_request_id",
    "plan",
    "candidate_scene_spec",
    "candidate_modeling_plan",
    "scene_diff_allowlist",
    "modeling_plan_diff_report",
    "approval_impact_report",
    "preapproval_report",
    "shadow_build_receipt",
    "invariant_report",
    "geometry_uv_unchanged_report",
    "surface_detail_material_mapping",
    "changed_assignments",
    "retained_assignments",
    "preconditions",
    "channel_reconciliation",
    "current_material_closure",
    "latest_framework_failure"
  ],
  "title": "MaterialIdentitySplitApprovalRequest",
  "type": "object"
}
