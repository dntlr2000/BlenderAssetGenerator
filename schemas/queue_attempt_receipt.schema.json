{
  "additionalProperties": false,
  "description": "Preserve one immutable queue dispatch attempt and observed workflow outcome.",
  "properties": {
    "schema_version": {
      "const": "0.9.0",
      "default": "0.9.0",
      "title": "Schema Version",
      "type": "string"
    },
    "receipt_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Receipt Id",
      "type": "string"
    },
    "entry_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Entry Id",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "workflow_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Workflow Id",
      "type": "string"
    },
    "attempt_number": {
      "maximum": 1000,
      "minimum": 1,
      "title": "Attempt Number",
      "type": "integer"
    },
    "retry_failed": {
      "default": false,
      "title": "Retry Failed",
      "type": "boolean"
    },
    "workflow_status_before": {
      "anyOf": [
        {
          "maxLength": 64,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Workflow Status Before"
    },
    "workflow_status_after": {
      "anyOf": [
        {
          "maxLength": 64,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Workflow Status After"
    },
    "outcome": {
      "enum": [
        "advanced",
        "waiting",
        "completed",
        "failed",
        "cancelled"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "error_type": {
      "anyOf": [
        {
          "maxLength": 256,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Type"
    },
    "error_message": {
      "anyOf": [
        {
          "maxLength": 4000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Message"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "completed_at": {
      "format": "date-time",
      "title": "Completed At",
      "type": "string"
    }
  },
  "required": [
    "receipt_id",
    "entry_id",
    "job_id",
    "workflow_id",
    "attempt_number",
    "outcome",
    "started_at",
    "completed_at"
  ],
  "title": "QueueAttemptReceipt",
  "type": "object"
}
