{
  "$defs": {
    "CollisionEntry": {
      "additionalProperties": false,
      "description": "Describe one primitive or mesh collision proxy owned by a semantic object.",
      "properties": {
        "collider_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Collider Id",
          "type": "string"
        },
        "target_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Target Id",
          "type": "string"
        },
        "strategy": {
          "enum": [
            "box",
            "sphere",
            "capsule",
            "convex_hull",
            "mesh_proxy"
          ],
          "title": "Strategy",
          "type": "string"
        },
        "location": {
          "default": [
            0.0,
            0.0,
            0.0
          ],
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Location",
          "type": "array"
        },
        "rotation_deg": {
          "default": [
            0.0,
            0.0,
            0.0
          ],
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Rotation Deg",
          "type": "array"
        },
        "dimensions": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Dimensions",
          "type": "array"
        },
        "mesh": {
          "anyOf": [
            {
              "$ref": "#/$defs/HashedArtifact"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "hull_count": {
          "default": 1,
          "minimum": 1,
          "title": "Hull Count",
          "type": "integer"
        },
        "triangle_count": {
          "default": 0,
          "minimum": 0,
          "title": "Triangle Count",
          "type": "integer"
        }
      },
      "required": [
        "collider_id",
        "target_id",
        "strategy",
        "dimensions"
      ],
      "title": "CollisionEntry",
      "type": "object"
    },
    "HashedArtifact": {
      "additionalProperties": false,
      "description": "Bind one stable artifact identity to a job-relative path and SHA-256 digest.",
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "scene_spec",
            "blend",
            "geometry_payload",
            "material_plan",
            "texture_manifest",
            "asset_profile",
            "optimization_plan",
            "preflight_report",
            "lod_manifest",
            "collision_manifest",
            "uv_manifest",
            "asset_cost_report",
            "texture_pack_manifest",
            "lod_mesh",
            "collider_mesh",
            "uv_preview",
            "packed_texture",
            "package_manifest",
            "package_file",
            "roundtrip_inventory",
            "other"
          ],
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*//)[^\\u0000]+$",
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "path",
        "sha256"
      ],
      "title": "HashedArtifact",
      "type": "object"
    },
    "SourceProvenance": {
      "additionalProperties": false,
      "description": "Freeze canonical geometry, build, material, and texture inputs for one V0.7 run.",
      "properties": {
        "scene_spec": {
          "$ref": "#/$defs/HashedArtifact"
        },
        "blend": {
          "$ref": "#/$defs/HashedArtifact"
        },
        "source_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Fingerprint",
          "type": "string"
        },
        "build_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Build Fingerprint",
          "type": "string"
        },
        "geometry_payloads": {
          "items": {
            "$ref": "#/$defs/HashedArtifact"
          },
          "title": "Geometry Payloads",
          "type": "array"
        },
        "material_plan": {
          "anyOf": [
            {
              "$ref": "#/$defs/HashedArtifact"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "texture_manifests": {
          "items": {
            "$ref": "#/$defs/HashedArtifact"
          },
          "title": "Texture Manifests",
          "type": "array"
        }
      },
      "required": [
        "scene_spec",
        "blend",
        "source_fingerprint",
        "build_fingerprint"
      ],
      "title": "SourceProvenance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Record stable semantic ownership for all derived collision proxies.",
  "properties": {
    "schema_version": {
      "const": "0.7.0",
      "default": "0.7.0",
      "title": "Schema Version",
      "type": "string"
    },
    "manifest_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Manifest Id",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Run Id",
      "type": "string"
    },
    "profile_id": {
      "enum": [
        "portable_gltf",
        "fbx_interchange",
        "obj_legacy"
      ],
      "title": "Profile Id",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/SourceProvenance"
    },
    "strategy": {
      "enum": [
        "none",
        "box",
        "sphere",
        "capsule",
        "convex_hull",
        "compound",
        "mesh_proxy"
      ],
      "title": "Strategy",
      "type": "string"
    },
    "status": {
      "default": "planned",
      "enum": [
        "planned",
        "complete",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/CollisionEntry"
      },
      "title": "Entries",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "completed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Completed At"
    },
    "canonical_unchanged": {
      "const": true,
      "default": true,
      "title": "Canonical Unchanged",
      "type": "boolean"
    },
    "errors": {
      "items": {
        "type": "string"
      },
      "title": "Errors",
      "type": "array"
    },
    "notes": {
      "items": {
        "type": "string"
      },
      "title": "Notes",
      "type": "array"
    }
  },
  "required": [
    "manifest_id",
    "job_id",
    "run_id",
    "profile_id",
    "source",
    "strategy",
    "created_at"
  ],
  "title": "CollisionManifest",
  "type": "object"
}
