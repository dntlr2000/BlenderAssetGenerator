{
  "$defs": {
    "ExactArtifact": {
      "additionalProperties": false,
      "description": "Bind one contained job-relative artifact by exact bytes and media type.",
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "pattern": "^[a-z][a-z0-9_]{1,95}$",
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "byte_size": {
          "minimum": 0,
          "title": "Byte Size",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 127,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "path",
        "sha256",
        "byte_size",
        "media_type"
      ],
      "title": "ExactArtifact",
      "type": "object"
    },
    "MaterialIdentitySplitCanonicalPreconditions": {
      "additionalProperties": false,
      "description": "Bind exact canonical bytes, absence, reference, scope, and UV preconditions.",
      "properties": {
        "scene_spec": {
          "$ref": "#/$defs/ExactArtifact"
        },
        "modeling_plan": {
          "$ref": "#/$defs/ExactArtifact"
        },
        "blend": {
          "$ref": "#/$defs/ExactArtifact"
        },
        "material_plan_absence": {
          "$ref": "#/$defs/ExactArtifact"
        },
        "root_authorization": {
          "$ref": "#/$defs/ExactArtifact"
        },
        "primary_reference": {
          "$ref": "#/$defs/ExactArtifact"
        },
        "content_scope_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Scope Sha256",
          "type": "string"
        },
        "target_subject": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Target Subject",
          "type": "string"
        },
        "uv_layout_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Uv Layout Fingerprint",
          "type": "string"
        }
      },
      "required": [
        "scene_spec",
        "modeling_plan",
        "blend",
        "material_plan_absence",
        "root_authorization",
        "primary_reference",
        "content_scope_sha256",
        "target_subject",
        "uv_layout_fingerprint"
      ],
      "title": "MaterialIdentitySplitCanonicalPreconditions",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Bind one AQ policy authorization to the same guarded paired transaction.",
  "properties": {
    "schema_version": {
      "const": "0.3.0",
      "default": "0.3.0",
      "title": "Schema Version",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "workflow_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Workflow Id",
      "type": "string"
    },
    "dispatch_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Dispatch Id",
      "type": "string"
    },
    "session_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Session Id",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Run Id",
      "type": "string"
    },
    "producer": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Producer",
      "type": "string"
    },
    "producer_version": {
      "const": "0.3.0",
      "default": "0.3.0",
      "title": "Producer Version",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "intent_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Intent Id",
      "type": "string"
    },
    "transaction_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Transaction Id",
      "type": "string"
    },
    "policy_authorization": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "approval_request": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "plan": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "candidate_scene_spec": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "candidate_modeling_plan": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "scene_diff_allowlist": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "modeling_plan_diff_report": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "preapproval_report": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "shadow_build_receipt": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "invariant_report": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "preconditions": {
      "$ref": "#/$defs/MaterialIdentitySplitCanonicalPreconditions"
    },
    "expected_scene_spec_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Expected Scene Spec Sha256",
      "type": "string"
    },
    "expected_modeling_plan_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Expected Modeling Plan Sha256",
      "type": "string"
    },
    "expected_material_assignment_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Expected Material Assignment Sha256",
      "type": "string"
    },
    "authority_kind": {
      "const": "aq_v2_routine_policy_authorization",
      "default": "aq_v2_routine_policy_authorization",
      "title": "Authority Kind",
      "type": "string"
    },
    "policy_authorization_is_user_approval": {
      "const": false,
      "default": false,
      "title": "Policy Authorization Is User Approval",
      "type": "boolean"
    },
    "user_approval_created": {
      "const": false,
      "default": false,
      "title": "User Approval Created",
      "type": "boolean"
    },
    "retry_allowance": {
      "const": 1,
      "default": 1,
      "title": "Retry Allowance",
      "type": "integer"
    },
    "rollback_policy": {
      "const": "exact_archives_required",
      "default": "exact_archives_required",
      "title": "Rollback Policy",
      "type": "string"
    }
  },
  "required": [
    "job_id",
    "workflow_id",
    "dispatch_id",
    "session_id",
    "run_id",
    "producer",
    "created_at",
    "intent_id",
    "transaction_id",
    "policy_authorization",
    "approval_request",
    "plan",
    "candidate_scene_spec",
    "candidate_modeling_plan",
    "scene_diff_allowlist",
    "modeling_plan_diff_report",
    "preapproval_report",
    "shadow_build_receipt",
    "invariant_report",
    "preconditions",
    "expected_scene_spec_sha256",
    "expected_modeling_plan_sha256",
    "expected_material_assignment_sha256"
  ],
  "title": "MaterialIdentitySplitPolicyApplyIntent",
  "type": "object"
}
