{
  "$defs": {
    "ActivationArtifact": {
      "additionalProperties": false,
      "description": "Bind one repository-contained activation artifact to exact immutable bytes.",
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "byte_size": {
          "exclusiveMinimum": 0,
          "title": "Byte Size",
          "type": "integer"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "path",
        "sha256",
        "byte_size"
      ],
      "title": "ActivationArtifact",
      "type": "object"
    },
    "ActivationCampaignOutcomeIndexRecord": {
      "additionalProperties": false,
      "description": "Record whether one registered terminal contributes a campaign asset unit.",
      "properties": {
        "outcome_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Outcome Id",
          "type": "string"
        },
        "job_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Job Id",
          "type": "string"
        },
        "session_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Session Id",
          "type": "string"
        },
        "skill_run_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Skill Run Id",
          "type": "string"
        },
        "primary_reference_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Primary Reference Sha256",
          "type": "string"
        },
        "terminal_class": {
          "enum": [
            "production_delivery",
            "usable_review_terminal",
            "blocked",
            "failed",
            "cancelled",
            "nonterminal"
          ],
          "title": "Terminal Class",
          "type": "string"
        },
        "eligibility_report": {
          "$ref": "#/$defs/ActivationArtifact"
        },
        "eligible": {
          "title": "Eligible",
          "type": "boolean"
        },
        "counted": {
          "title": "Counted",
          "type": "boolean"
        },
        "production_package_verified": {
          "title": "Production Package Verified",
          "type": "boolean"
        },
        "exclusion_reasons": {
          "items": {
            "$ref": "#/$defs/ActivationExclusion"
          },
          "title": "Exclusion Reasons",
          "type": "array"
        }
      },
      "required": [
        "outcome_id",
        "job_id",
        "session_id",
        "skill_run_id",
        "primary_reference_sha256",
        "terminal_class",
        "eligibility_report",
        "eligible",
        "counted",
        "production_package_verified",
        "exclusion_reasons"
      ],
      "title": "ActivationCampaignOutcomeIndexRecord",
      "type": "object"
    },
    "ActivationCampaignReferenceGroup": {
      "additionalProperties": false,
      "description": "Deduplicate eligible campaign outcomes by exact primary-reference bytes.",
      "properties": {
        "primary_reference_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Primary Reference Sha256",
          "type": "string"
        },
        "outcome_ids": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Outcome Ids",
          "type": "array"
        },
        "eligible_representative": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Eligible Representative"
        },
        "status": {
          "enum": [
            "counted",
            "excluded",
            "ambiguous"
          ],
          "title": "Status",
          "type": "string"
        },
        "counted_asset_units": {
          "enum": [
            0,
            1
          ],
          "title": "Counted Asset Units",
          "type": "integer"
        },
        "production_package_units": {
          "enum": [
            0,
            1
          ],
          "title": "Production Package Units",
          "type": "integer"
        }
      },
      "required": [
        "primary_reference_sha256",
        "outcome_ids",
        "status",
        "counted_asset_units",
        "production_package_units"
      ],
      "title": "ActivationCampaignReferenceGroup",
      "type": "object"
    },
    "ActivationExclusion": {
      "additionalProperties": false,
      "description": "Record one deterministic machine-readable reason a candidate is not counted.",
      "properties": {
        "code": {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "title": "Code",
          "type": "string"
        },
        "detail": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Detail",
          "type": "string"
        }
      },
      "required": [
        "code",
        "detail"
      ],
      "title": "ActivationExclusion",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Count normal AQ outcomes separately from strict production-package candidates.",
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "contract_status": {
      "const": "disabled_experimental",
      "default": "disabled_experimental",
      "title": "Contract Status",
      "type": "string"
    },
    "index_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Index Id",
      "type": "string"
    },
    "index_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Index Sha256",
      "type": "string"
    },
    "authoritative_registry": {
      "$ref": "#/$defs/ActivationArtifact"
    },
    "source_activation_baseline": {
      "$ref": "#/$defs/ActivationArtifact"
    },
    "source_activation_baseline_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Source Activation Baseline Id",
      "type": "string"
    },
    "source_activation_baseline_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Activation Baseline Sha256",
      "type": "string"
    },
    "records": {
      "items": {
        "$ref": "#/$defs/ActivationCampaignOutcomeIndexRecord"
      },
      "title": "Records",
      "type": "array"
    },
    "reference_groups": {
      "items": {
        "$ref": "#/$defs/ActivationCampaignReferenceGroup"
      },
      "title": "Reference Groups",
      "type": "array"
    },
    "distinct_successful_asset_count": {
      "minimum": 0,
      "title": "Distinct Successful Asset Count",
      "type": "integer"
    },
    "production_delivery_count": {
      "minimum": 0,
      "title": "Production Delivery Count",
      "type": "integer"
    },
    "usable_review_terminal_count": {
      "minimum": 0,
      "title": "Usable Review Terminal Count",
      "type": "integer"
    },
    "production_package_count": {
      "minimum": 0,
      "title": "Production Package Count",
      "type": "integer"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    }
  },
  "required": [
    "index_id",
    "index_sha256",
    "authoritative_registry",
    "source_activation_baseline",
    "source_activation_baseline_id",
    "source_activation_baseline_sha256",
    "records",
    "reference_groups",
    "distinct_successful_asset_count",
    "production_delivery_count",
    "usable_review_terminal_count",
    "production_package_count",
    "generated_at"
  ],
  "title": "ActivationCampaignOutcomeIndex",
  "type": "object"
}
