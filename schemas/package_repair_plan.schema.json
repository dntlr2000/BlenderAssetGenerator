{
  "$defs": {
    "AutonomyArtifact": {
      "additionalProperties": false,
      "description": "Bind one contained artifact to its repository-relative path and exact bytes.",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "title": "AutonomyArtifact",
      "type": "object"
    },
    "BudgetUsage": {
      "additionalProperties": false,
      "description": "Count consumed actions without changing the authorized budget.",
      "properties": {
        "initial_candidates": {
          "default": 0,
          "minimum": 0,
          "title": "Initial Candidates",
          "type": "integer"
        },
        "structural_rounds": {
          "default": 0,
          "minimum": 0,
          "title": "Structural Rounds",
          "type": "integer"
        },
        "parametric_convergence_iterations": {
          "default": 0,
          "minimum": 0,
          "title": "Parametric Convergence Iterations",
          "type": "integer"
        },
        "material_rounds": {
          "default": 0,
          "minimum": 0,
          "title": "Material Rounds",
          "type": "integer"
        },
        "package_repairs": {
          "default": 0,
          "minimum": 0,
          "title": "Package Repairs",
          "type": "integer"
        },
        "total_blender_builds": {
          "default": 0,
          "minimum": 0,
          "title": "Total Blender Builds",
          "type": "integer"
        },
        "total_quality_evaluations": {
          "default": 0,
          "minimum": 0,
          "title": "Total Quality Evaluations",
          "type": "integer"
        },
        "canonical_promotions": {
          "default": 0,
          "minimum": 0,
          "title": "Canonical Promotions",
          "type": "integer"
        },
        "total_actions": {
          "default": 0,
          "minimum": 0,
          "title": "Total Actions",
          "type": "integer"
        }
      },
      "title": "BudgetUsage",
      "type": "object"
    },
    "ProductionResourceDelta": {
      "additionalProperties": false,
      "description": "Describe resource counters that must be reserved before one host step.",
      "properties": {
        "total_blender_builds": {
          "default": 0,
          "maximum": 2,
          "minimum": 0,
          "title": "Total Blender Builds",
          "type": "integer"
        },
        "total_quality_evaluations": {
          "default": 0,
          "maximum": 2,
          "minimum": 0,
          "title": "Total Quality Evaluations",
          "type": "integer"
        },
        "package_repairs": {
          "default": 0,
          "maximum": 1,
          "minimum": 0,
          "title": "Package Repairs",
          "type": "integer"
        }
      },
      "title": "ProductionResourceDelta",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Authorize one derived-only deterministic package repair under an exact budget.",
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "contract_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Contract Id",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "workflow_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Workflow Id",
      "type": "string"
    },
    "dispatch_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Dispatch Id",
      "type": "string"
    },
    "input_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Sha256",
      "type": "string"
    },
    "source_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Fingerprint",
      "type": "string"
    },
    "producer": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Producer",
      "type": "string"
    },
    "producer_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Producer Version",
      "type": "string"
    },
    "provenance": {
      "items": {
        "$ref": "#/$defs/AutonomyArtifact"
      },
      "minItems": 1,
      "title": "Provenance",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "session_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Session Id",
      "type": "string"
    },
    "failure": {
      "$ref": "#/$defs/AutonomyArtifact"
    },
    "profile_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Profile Id",
      "type": "string"
    },
    "package_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Package Id",
      "type": "string"
    },
    "repair_index": {
      "maximum": 2,
      "minimum": 1,
      "title": "Repair Index",
      "type": "integer"
    },
    "actions": {
      "items": {
        "enum": [
          "rebuild_portable_material_conversion",
          "rebuild_package",
          "reexport_package",
          "rerun_clean_import_roundtrip"
        ],
        "type": "string"
      },
      "maxItems": 4,
      "minItems": 1,
      "title": "Actions",
      "type": "array"
    },
    "delta": {
      "$ref": "#/$defs/ProductionResourceDelta"
    },
    "budget_before": {
      "$ref": "#/$defs/BudgetUsage"
    },
    "budget_after": {
      "$ref": "#/$defs/BudgetUsage"
    },
    "canonical_input_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Canonical Input Fingerprint",
      "type": "string"
    },
    "canonical_mutation_allowed": {
      "const": false,
      "default": false,
      "title": "Canonical Mutation Allowed",
      "type": "boolean"
    },
    "requires_clean_import_roundtrip": {
      "const": true,
      "default": true,
      "title": "Requires Clean Import Roundtrip",
      "type": "boolean"
    },
    "max_attempts": {
      "const": 1,
      "default": 1,
      "title": "Max Attempts",
      "type": "integer"
    }
  },
  "required": [
    "contract_id",
    "job_id",
    "workflow_id",
    "dispatch_id",
    "input_sha256",
    "source_fingerprint",
    "producer",
    "producer_version",
    "provenance",
    "created_at",
    "session_id",
    "failure",
    "profile_id",
    "package_id",
    "repair_index",
    "actions",
    "delta",
    "budget_before",
    "budget_after",
    "canonical_input_fingerprint"
  ],
  "title": "PackageRepairPlan",
  "type": "object"
}
