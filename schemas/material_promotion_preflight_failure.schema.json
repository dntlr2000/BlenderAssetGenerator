{
  "$defs": {
    "ExactArtifact": {
      "additionalProperties": false,
      "description": "Bind one contained job-relative artifact by exact bytes and media type.",
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "pattern": "^[a-z][a-z0-9_]{1,95}$",
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "byte_size": {
          "minimum": 0,
          "title": "Byte Size",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 127,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "path",
        "sha256",
        "byte_size",
        "media_type"
      ],
      "title": "ExactArtifact",
      "type": "object"
    },
    "MaterialClosureIssue": {
      "additionalProperties": false,
      "description": "Record one deterministic closure or preflight validation finding.",
      "properties": {
        "code": {
          "pattern": "^[A-Z][A-Z0-9_]{2,95}$",
          "title": "Code",
          "type": "string"
        },
        "message": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "entry_id": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entry Id"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "MaterialClosureIssue",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Stop before approval, controller execution, budgets, or canonical side effects.",
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "workflow_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Workflow Id",
      "type": "string"
    },
    "dispatch_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Dispatch Id",
      "type": "string"
    },
    "session_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Session Id",
      "type": "string"
    },
    "producer": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Producer",
      "type": "string"
    },
    "producer_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Producer Version",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "failure_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Failure Id",
      "type": "string"
    },
    "request": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "closure": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExactArtifact"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "status": {
      "const": "failed",
      "default": "failed",
      "title": "Status",
      "type": "string"
    },
    "issues": {
      "items": {
        "$ref": "#/$defs/MaterialClosureIssue"
      },
      "minItems": 1,
      "title": "Issues",
      "type": "array"
    },
    "framework_failure_report_path": {
      "title": "Framework Failure Report Path",
      "type": "string"
    },
    "recommendations": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Recommendations",
      "type": "array"
    },
    "approval_created": {
      "const": false,
      "default": false,
      "title": "Approval Created",
      "type": "boolean"
    },
    "technical_retry_approval_created": {
      "const": false,
      "default": false,
      "title": "Technical Retry Approval Created",
      "type": "boolean"
    },
    "controller_invocations_consumed": {
      "const": 0,
      "default": 0,
      "title": "Controller Invocations Consumed",
      "type": "integer"
    },
    "canonical_promotions_consumed": {
      "const": 0,
      "default": 0,
      "title": "Canonical Promotions Consumed",
      "type": "integer"
    },
    "appearance_revisions_consumed": {
      "const": 0,
      "default": 0,
      "title": "Appearance Revisions Consumed",
      "type": "integer"
    },
    "canonical_write_performed": {
      "const": false,
      "default": false,
      "title": "Canonical Write Performed",
      "type": "boolean"
    }
  },
  "required": [
    "job_id",
    "workflow_id",
    "dispatch_id",
    "session_id",
    "producer",
    "producer_version",
    "created_at",
    "failure_id",
    "request",
    "issues",
    "framework_failure_report_path",
    "recommendations"
  ],
  "title": "MaterialPromotionPreflightFailure",
  "type": "object"
}
