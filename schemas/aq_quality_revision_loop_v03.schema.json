{
  "$defs": {
    "FidelityArtifact": {
      "additionalProperties": false,
      "description": "Bind a contained artifact to its immutable bytes, not a mutable latest pointer.",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "title": "FidelityArtifact",
      "type": "object"
    },
    "FidelityBudgetEpochV01": {
      "additionalProperties": false,
      "description": "Freeze one additive allowance with exact history, object counts and route costs.",
      "properties": {
        "schema_version": {
          "const": "0.1.0",
          "default": "0.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "contract_kind": {
          "const": "fidelity_budget_epoch",
          "default": "fidelity_budget_epoch",
          "title": "Contract Kind",
          "type": "string"
        },
        "profile_status": {
          "const": "disabled_experimental",
          "default": "disabled_experimental",
          "title": "Profile Status",
          "type": "string"
        },
        "epoch_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Epoch Id",
          "type": "string"
        },
        "job_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
          "title": "Job Id",
          "type": "string"
        },
        "reference_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Reference Sha256",
          "type": "string"
        },
        "prior_history": {
          "items": {
            "$ref": "#/$defs/FidelityHistoryEntryV01"
          },
          "title": "Prior History",
          "type": "array"
        },
        "prior_usage": {
          "$ref": "#/$defs/FidelityLifetimeUsageV01"
        },
        "initial_object_limit": {
          "maximum": 48,
          "minimum": 1,
          "title": "Initial Object Limit",
          "type": "integer"
        },
        "correction_object_limit": {
          "maximum": 48,
          "minimum": 1,
          "title": "Correction Object Limit",
          "type": "integer"
        },
        "structural_rounds": {
          "default": 3,
          "maximum": 3,
          "minimum": 0,
          "title": "Structural Rounds",
          "type": "integer"
        },
        "parametric_rounds": {
          "default": 0,
          "maximum": 2,
          "minimum": 0,
          "title": "Parametric Rounds",
          "type": "integer"
        },
        "material_corrections": {
          "default": 2,
          "maximum": 2,
          "minimum": 0,
          "title": "Material Corrections",
          "type": "integer"
        },
        "strategy_switch_limit": {
          "const": 1,
          "default": 1,
          "title": "Strategy Switch Limit",
          "type": "integer"
        },
        "same_input_technical_retries": {
          "const": 1,
          "default": 1,
          "title": "Same Input Technical Retries",
          "type": "integer"
        },
        "human_approval_authority": {
          "const": false,
          "default": false,
          "title": "Human Approval Authority",
          "type": "boolean"
        },
        "historical_budget_mutation": {
          "const": false,
          "default": false,
          "title": "Historical Budget Mutation",
          "type": "boolean"
        },
        "destination_write": {
          "const": false,
          "default": false,
          "title": "Destination Write",
          "type": "boolean"
        }
      },
      "required": [
        "epoch_id",
        "job_id",
        "reference_sha256",
        "prior_history",
        "prior_usage",
        "initial_object_limit",
        "correction_object_limit"
      ],
      "title": "FidelityBudgetEpochV01",
      "type": "object"
    },
    "FidelityHistoryEntryV01": {
      "additionalProperties": false,
      "description": "Bind the full session JSON inventory and validated counters without reopening it.",
      "properties": {
        "job_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
          "title": "Job Id",
          "type": "string"
        },
        "session_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Session Id",
          "type": "string"
        },
        "session_evidence_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Session Evidence Sha256",
          "type": "string"
        },
        "last_state_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Last State Sha256",
          "type": "string"
        },
        "budget_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Budget Sha256",
          "type": "string"
        },
        "status": {
          "minLength": 1,
          "title": "Status",
          "type": "string"
        },
        "next_action": {
          "minLength": 1,
          "title": "Next Action",
          "type": "string"
        },
        "funded_epoch": {
          "title": "Funded Epoch",
          "type": "boolean"
        },
        "epoch_id": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Epoch Id"
        },
        "usage": {
          "$ref": "#/$defs/FidelityLifetimeUsageV01"
        }
      },
      "required": [
        "job_id",
        "session_id",
        "session_evidence_sha256",
        "last_state_sha256",
        "budget_sha256",
        "status",
        "next_action",
        "funded_epoch",
        "usage"
      ],
      "title": "FidelityHistoryEntryV01",
      "type": "object"
    },
    "FidelityLifetimeUsageV01": {
      "additionalProperties": false,
      "description": "Keep observed or already reserved work visible across reference-identical sessions.",
      "properties": {
        "structural": {
          "default": 0,
          "minimum": 0,
          "title": "Structural",
          "type": "integer"
        },
        "local": {
          "default": 0,
          "minimum": 0,
          "title": "Local",
          "type": "integer"
        },
        "strategy_switches": {
          "default": 0,
          "minimum": 0,
          "title": "Strategy Switches",
          "type": "integer"
        },
        "blender_builds": {
          "default": 0,
          "minimum": 0,
          "title": "Blender Builds",
          "type": "integer"
        },
        "preflight_blender_runs": {
          "default": 0,
          "minimum": 0,
          "title": "Preflight Blender Runs",
          "type": "integer"
        },
        "quality_evaluations": {
          "default": 0,
          "minimum": 0,
          "title": "Quality Evaluations",
          "type": "integer"
        },
        "promotions": {
          "default": 0,
          "minimum": 0,
          "title": "Promotions",
          "type": "integer"
        }
      },
      "title": "FidelityLifetimeUsageV01",
      "type": "object"
    },
    "RevisionCostV01": {
      "additionalProperties": false,
      "description": "Reserve actual stage costs before effects; a structural round is not a build budget.",
      "properties": {
        "materializations": {
          "default": 0,
          "minimum": 0,
          "title": "Materializations",
          "type": "integer"
        },
        "builds": {
          "default": 0,
          "minimum": 0,
          "title": "Builds",
          "type": "integer"
        },
        "qa_runs": {
          "default": 0,
          "minimum": 0,
          "title": "Qa Runs",
          "type": "integer"
        },
        "closure_runs": {
          "default": 0,
          "minimum": 0,
          "title": "Closure Runs",
          "type": "integer"
        },
        "diagnostic_views": {
          "default": 0,
          "minimum": 0,
          "title": "Diagnostic Views",
          "type": "integer"
        },
        "promotions": {
          "default": 0,
          "minimum": 0,
          "title": "Promotions",
          "type": "integer"
        }
      },
      "title": "RevisionCostV01",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Bind the same finite funding epoch as the root, including exact per-route reserves.",
  "properties": {
    "schema_version": {
      "const": "0.3.0",
      "default": "0.3.0",
      "title": "Schema Version",
      "type": "string"
    },
    "contract_kind": {
      "const": "aq_quality_revision_loop",
      "default": "aq_quality_revision_loop",
      "title": "Contract Kind",
      "type": "string"
    },
    "profile_status": {
      "const": "disabled_experimental",
      "default": "disabled_experimental",
      "title": "Profile Status",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "session_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Session Id",
      "type": "string"
    },
    "root_authorization": {
      "$ref": "#/$defs/FidelityArtifact"
    },
    "approval_envelope": {
      "$ref": "#/$defs/FidelityArtifact"
    },
    "hypothesis": {
      "$ref": "#/$defs/FidelityArtifact"
    },
    "initial_state": {
      "$ref": "#/$defs/FidelityArtifact"
    },
    "structural_revision_limit": {
      "default": 3,
      "maximum": 3,
      "minimum": 0,
      "title": "Structural Revision Limit",
      "type": "integer"
    },
    "local_revision_limit": {
      "default": 2,
      "maximum": 2,
      "minimum": 0,
      "title": "Local Revision Limit",
      "type": "integer"
    },
    "same_input_technical_retries": {
      "const": 1,
      "default": 1,
      "title": "Same Input Technical Retries",
      "type": "integer"
    },
    "plateau_length": {
      "const": 2,
      "default": 2,
      "title": "Plateau Length",
      "type": "integer"
    },
    "strategy_switch_limit": {
      "const": 1,
      "default": 1,
      "title": "Strategy Switch Limit",
      "type": "integer"
    },
    "cost_limit": {
      "$ref": "#/$defs/RevisionCostV01"
    },
    "allow_disabled_experimental": {
      "const": true,
      "title": "Allow Disabled Experimental",
      "type": "boolean"
    },
    "execution_lifetime": {
      "const": "current_codex_task",
      "default": "current_codex_task",
      "title": "Execution Lifetime",
      "type": "string"
    },
    "human_approval_authority": {
      "const": false,
      "default": false,
      "title": "Human Approval Authority",
      "type": "boolean"
    },
    "destination_write": {
      "const": false,
      "default": false,
      "title": "Destination Write",
      "type": "boolean"
    },
    "routing_policy": {
      "const": "causal_v2",
      "default": "causal_v2",
      "title": "Routing Policy",
      "type": "string"
    },
    "initial_pipeline_reserve": {
      "$ref": "#/$defs/RevisionCostV01"
    },
    "funding": {
      "$ref": "#/$defs/FidelityBudgetEpochV01"
    }
  },
  "required": [
    "job_id",
    "session_id",
    "root_authorization",
    "approval_envelope",
    "hypothesis",
    "initial_state",
    "cost_limit",
    "allow_disabled_experimental",
    "initial_pipeline_reserve",
    "funding"
  ],
  "title": "AQQualityRevisionLoopV03",
  "type": "object"
}
