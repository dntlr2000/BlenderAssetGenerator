{
  "$defs": {
    "SkillArtifact": {
      "additionalProperties": false,
      "description": "Bind one job-relative immutable artifact to its exact bytes.",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "title": "SkillArtifact",
      "type": "object"
    },
    "StandardManualGuardedRerouteBinding": {
      "additionalProperties": false,
      "description": "Bind one untouched ineligible child to its manual guarded replacement.",
      "properties": {
        "reroute_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Reroute Id",
          "type": "string"
        },
        "reroute_sequence": {
          "maximum": 8,
          "minimum": 1,
          "title": "Reroute Sequence",
          "type": "integer"
        },
        "reroute_kind": {
          "const": "manual_guarded_correction",
          "default": "manual_guarded_correction",
          "title": "Reroute Kind",
          "type": "string"
        },
        "source_stage_binding": {
          "$ref": "#/$defs/SkillArtifact"
        },
        "source_workflow_state": {
          "$ref": "#/$defs/SkillArtifact"
        },
        "cancelled_workflow_state": {
          "$ref": "#/$defs/SkillArtifact"
        },
        "cancellation_receipt": {
          "$ref": "#/$defs/SkillArtifact"
        },
        "reroute_reason": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Reroute Reason",
          "type": "string"
        },
        "technical_failure": {
          "const": true,
          "default": true,
          "title": "Technical Failure",
          "type": "boolean"
        },
        "user_approval_requested": {
          "const": false,
          "default": false,
          "title": "User Approval Requested",
          "type": "boolean"
        },
        "canonical_write_authority": {
          "const": false,
          "default": false,
          "title": "Canonical Write Authority",
          "type": "boolean"
        },
        "approval_authority": {
          "const": false,
          "default": false,
          "title": "Approval Authority",
          "type": "boolean"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "reroute_id",
        "reroute_sequence",
        "source_stage_binding",
        "source_workflow_state",
        "cancelled_workflow_state",
        "cancellation_receipt",
        "reroute_reason",
        "created_at"
      ],
      "title": "StandardManualGuardedRerouteBinding",
      "type": "object"
    },
    "StandardTechnicalRecoveryBinding": {
      "additionalProperties": false,
      "description": "Bind one failed Standard child to a guarded geometry continuation.",
      "properties": {
        "recovery_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Recovery Id",
          "type": "string"
        },
        "recovery_sequence": {
          "maximum": 8,
          "minimum": 1,
          "title": "Recovery Sequence",
          "type": "integer"
        },
        "recovery_kind": {
          "const": "guarded_geometry_continuation",
          "default": "guarded_geometry_continuation",
          "title": "Recovery Kind",
          "type": "string"
        },
        "failed_stage_binding": {
          "$ref": "#/$defs/SkillArtifact"
        },
        "failed_workflow_state": {
          "$ref": "#/$defs/SkillArtifact"
        },
        "failed_execution_receipt": {
          "$ref": "#/$defs/SkillArtifact"
        },
        "failed_step_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Failed Step Id",
          "type": "string"
        },
        "failed_input_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Failed Input Fingerprint",
          "type": "string"
        },
        "failure_reason_code": {
          "const": "host_failure",
          "default": "host_failure",
          "title": "Failure Reason Code",
          "type": "string"
        },
        "canonical_scene_spec_snapshot": {
          "$ref": "#/$defs/SkillArtifact"
        },
        "recovery_reason": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Recovery Reason",
          "type": "string"
        },
        "technical_failure": {
          "const": true,
          "default": true,
          "title": "Technical Failure",
          "type": "boolean"
        },
        "user_approval_requested": {
          "const": false,
          "default": false,
          "title": "User Approval Requested",
          "type": "boolean"
        },
        "canonical_write_authority": {
          "const": false,
          "default": false,
          "title": "Canonical Write Authority",
          "type": "boolean"
        },
        "approval_authority": {
          "const": false,
          "default": false,
          "title": "Approval Authority",
          "type": "boolean"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "recovery_id",
        "recovery_sequence",
        "failed_stage_binding",
        "failed_workflow_state",
        "failed_execution_receipt",
        "failed_step_id",
        "failed_input_fingerprint",
        "canonical_scene_spec_snapshot",
        "recovery_reason",
        "created_at"
      ],
      "title": "StandardTechnicalRecoveryBinding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Bind one Standard composite stage to one immutable V0.8 child workflow.",
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "binding_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Binding Id",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Run Id",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "ordinal": {
      "maximum": 32,
      "minimum": 1,
      "title": "Ordinal",
      "type": "integer"
    },
    "stage_kind": {
      "enum": [
        "geometry",
        "material",
        "qa",
        "portable"
      ],
      "title": "Stage Kind",
      "type": "string"
    },
    "skill_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Skill Id",
      "type": "string"
    },
    "workflow_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Workflow Id",
      "type": "string"
    },
    "workflow_plan": {
      "$ref": "#/$defs/SkillArtifact"
    },
    "technical_recovery": {
      "anyOf": [
        {
          "$ref": "#/$defs/StandardTechnicalRecoveryBinding"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "technical_reroute": {
      "anyOf": [
        {
          "$ref": "#/$defs/StandardManualGuardedRerouteBinding"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "created_reason": {
      "maxLength": 1000,
      "minLength": 1,
      "title": "Created Reason",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "binding_id",
    "run_id",
    "job_id",
    "ordinal",
    "stage_kind",
    "skill_id",
    "workflow_id",
    "workflow_plan",
    "created_reason",
    "created_at"
  ],
  "title": "StandardCompositeStageBinding",
  "type": "object"
}
