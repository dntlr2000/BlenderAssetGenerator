{
  "$defs": {
    "SkillArtifact": {
      "additionalProperties": false,
      "description": "Bind one job-relative immutable artifact to its exact bytes.",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "title": "SkillArtifact",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Bind one Standard composite stage to one immutable V0.8 child workflow.",
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "binding_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Binding Id",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Run Id",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "ordinal": {
      "maximum": 32,
      "minimum": 1,
      "title": "Ordinal",
      "type": "integer"
    },
    "stage_kind": {
      "enum": [
        "geometry",
        "material",
        "qa",
        "portable"
      ],
      "title": "Stage Kind",
      "type": "string"
    },
    "skill_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Skill Id",
      "type": "string"
    },
    "workflow_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Workflow Id",
      "type": "string"
    },
    "workflow_plan": {
      "$ref": "#/$defs/SkillArtifact"
    },
    "created_reason": {
      "maxLength": 1000,
      "minLength": 1,
      "title": "Created Reason",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "binding_id",
    "run_id",
    "job_id",
    "ordinal",
    "stage_kind",
    "skill_id",
    "workflow_id",
    "workflow_plan",
    "created_reason",
    "created_at"
  ],
  "title": "StandardCompositeStageBinding",
  "type": "object"
}
