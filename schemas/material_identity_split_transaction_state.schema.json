{
  "$defs": {
    "ExactArtifact": {
      "additionalProperties": false,
      "description": "Bind one contained job-relative artifact by exact bytes and media type.",
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "pattern": "^[a-z][a-z0-9_]{1,95}$",
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "byte_size": {
          "minimum": 0,
          "title": "Byte Size",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 127,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "path",
        "sha256",
        "byte_size",
        "media_type"
      ],
      "title": "ExactArtifact",
      "type": "object"
    },
    "MaterialIdentitySplitCanonicalPreconditions": {
      "additionalProperties": false,
      "description": "Bind exact canonical bytes, absence, reference, scope, and UV preconditions.",
      "properties": {
        "scene_spec": {
          "$ref": "#/$defs/ExactArtifact"
        },
        "modeling_plan": {
          "$ref": "#/$defs/ExactArtifact"
        },
        "blend": {
          "$ref": "#/$defs/ExactArtifact"
        },
        "material_plan_absence": {
          "$ref": "#/$defs/ExactArtifact"
        },
        "root_authorization": {
          "$ref": "#/$defs/ExactArtifact"
        },
        "primary_reference": {
          "$ref": "#/$defs/ExactArtifact"
        },
        "content_scope_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Scope Sha256",
          "type": "string"
        },
        "target_subject": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Target Subject",
          "type": "string"
        },
        "uv_layout_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Uv Layout Fingerprint",
          "type": "string"
        }
      },
      "required": [
        "scene_spec",
        "modeling_plan",
        "blend",
        "material_plan_absence",
        "root_authorization",
        "primary_reference",
        "content_scope_sha256",
        "target_subject",
        "uv_layout_fingerprint"
      ],
      "title": "MaterialIdentitySplitCanonicalPreconditions",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Journal one append-only state in a guarded identity-split transaction.",
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "workflow_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Workflow Id",
      "type": "string"
    },
    "dispatch_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Dispatch Id",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Run Id",
      "type": "string"
    },
    "producer": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Producer",
      "type": "string"
    },
    "producer_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Producer Version",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "transaction_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Transaction Id",
      "type": "string"
    },
    "sequence": {
      "minimum": 0,
      "title": "Sequence",
      "type": "integer"
    },
    "previous_state": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExactArtifact"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "state": {
      "enum": [
        "planned",
        "preapproval_running",
        "preapproval_failed",
        "eligible_for_explicit_user_scope_approval",
        "approval_consumed",
        "archives_written",
        "scene_spec_replaced",
        "modeling_plan_replaced",
        "blender_rebuilt",
        "invariants_verified",
        "committed",
        "rollback_started",
        "rolled_back",
        "recovery_required"
      ],
      "title": "State",
      "type": "string"
    },
    "plan": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "preapproval_request": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExactArtifact"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "approval_request": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExactArtifact"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "apply_intent": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExactArtifact"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "approval_consumption": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExactArtifact"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "canonical_observation": {
      "$ref": "#/$defs/MaterialIdentitySplitCanonicalPreconditions"
    },
    "archives": {
      "items": {
        "$ref": "#/$defs/ExactArtifact"
      },
      "title": "Archives",
      "type": "array"
    },
    "performed_actions": {
      "items": {
        "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
        "type": "string"
      },
      "title": "Performed Actions",
      "type": "array"
    },
    "allowed_next_actions": {
      "items": {
        "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
        "type": "string"
      },
      "title": "Allowed Next Actions",
      "type": "array"
    },
    "technical_retry_count": {
      "default": 0,
      "maximum": 1,
      "minimum": 0,
      "title": "Technical Retry Count",
      "type": "integer"
    },
    "blocked_reason": {
      "anyOf": [
        {
          "maxLength": 1200,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Blocked Reason"
    }
  },
  "required": [
    "job_id",
    "workflow_id",
    "dispatch_id",
    "run_id",
    "producer",
    "producer_version",
    "created_at",
    "transaction_id",
    "sequence",
    "state",
    "plan",
    "canonical_observation"
  ],
  "title": "MaterialIdentitySplitTransactionState",
  "type": "object"
}
