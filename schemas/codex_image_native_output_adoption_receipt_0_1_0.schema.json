{
  "$defs": {
    "CodexImageArtifact": {
      "additionalProperties": false,
      "description": "Bind one non-empty job-contained file to exact bytes and media semantics.",
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "byte_size": {
          "exclusiveMinimum": 0,
          "title": "Byte Size",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "path",
        "sha256",
        "byte_size",
        "media_type"
      ],
      "title": "CodexImageArtifact",
      "type": "object"
    },
    "MaterialLoopRasterSize": {
      "additionalProperties": false,
      "description": "Describe one bounded native or material raster size.",
      "properties": {
        "width": {
          "maximum": 8192,
          "minimum": 1,
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "maximum": 8192,
          "minimum": 1,
          "title": "Height",
          "type": "integer"
        }
      },
      "required": [
        "width",
        "height"
      ],
      "title": "MaterialLoopRasterSize",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Bind one native controller PNG before any core 0.1 size validation.",
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "contract_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Contract Id",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "workflow_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Workflow Id",
      "type": "string"
    },
    "dispatch_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Dispatch Id",
      "type": "string"
    },
    "session_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Session Id",
      "type": "string"
    },
    "profile_id": {
      "const": "autonomous_static_prop_v2_codex_imagegen",
      "default": "autonomous_static_prop_v2_codex_imagegen",
      "title": "Profile Id",
      "type": "string"
    },
    "provider_id": {
      "const": "codex_builtin_gpt_image_v1",
      "default": "codex_builtin_gpt_image_v1",
      "title": "Provider Id",
      "type": "string"
    },
    "input_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Sha256",
      "type": "string"
    },
    "source_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Fingerprint",
      "type": "string"
    },
    "producer": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Producer",
      "type": "string"
    },
    "producer_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Producer Version",
      "type": "string"
    },
    "provenance": {
      "items": {
        "$ref": "#/$defs/CodexImageArtifact"
      },
      "minItems": 1,
      "title": "Provenance",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "immutable": {
      "const": true,
      "default": true,
      "title": "Immutable",
      "type": "boolean"
    },
    "native_output_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Native Output Id",
      "type": "string"
    },
    "assignment": {
      "$ref": "#/$defs/CodexImageArtifact"
    },
    "assignment_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Assignment Id",
      "type": "string"
    },
    "ordinal": {
      "maximum": 2,
      "minimum": 0,
      "title": "Ordinal",
      "type": "integer"
    },
    "output_role": {
      "enum": [
        "base_color",
        "decal_rgb",
        "emission",
        "opacity_source"
      ],
      "title": "Output Role",
      "type": "string"
    },
    "expected_assignment_size": {
      "$ref": "#/$defs/MaterialLoopRasterSize"
    },
    "native_size": {
      "$ref": "#/$defs/MaterialLoopRasterSize"
    },
    "original_image": {
      "$ref": "#/$defs/CodexImageArtifact"
    },
    "source_mode": {
      "enum": [
        "L",
        "LA",
        "RGB",
        "RGBA",
        "P"
      ],
      "title": "Source Mode",
      "type": "string"
    },
    "source_has_alpha": {
      "title": "Source Has Alpha",
      "type": "boolean"
    },
    "source_icc_profile_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Icc Profile Sha256"
    },
    "source_format": {
      "const": "png",
      "default": "png",
      "title": "Source Format",
      "type": "string"
    },
    "status": {
      "const": "adopted",
      "default": "adopted",
      "title": "Status",
      "type": "string"
    },
    "original_source_path_persisted": {
      "const": false,
      "default": false,
      "title": "Original Source Path Persisted",
      "type": "boolean"
    },
    "source_preserved": {
      "const": true,
      "default": true,
      "title": "Source Preserved",
      "type": "boolean"
    },
    "canonical_write_performed": {
      "const": false,
      "default": false,
      "title": "Canonical Write Performed",
      "type": "boolean"
    },
    "destination_write_performed": {
      "const": false,
      "default": false,
      "title": "Destination Write Performed",
      "type": "boolean"
    },
    "human_reviewed": {
      "const": false,
      "default": false,
      "title": "Human Reviewed",
      "type": "boolean"
    }
  },
  "required": [
    "contract_id",
    "job_id",
    "workflow_id",
    "dispatch_id",
    "session_id",
    "input_sha256",
    "source_fingerprint",
    "producer",
    "provenance",
    "created_at",
    "native_output_id",
    "assignment",
    "assignment_id",
    "ordinal",
    "output_role",
    "expected_assignment_size",
    "native_size",
    "original_image",
    "source_mode",
    "source_has_alpha"
  ],
  "title": "CodexImageNativeOutputAdoptionReceipt",
  "type": "object"
}
