{
  "additionalProperties": false,
  "description": "Consume one exact existing Standard approval for a fixed two-file transaction.",
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "workflow_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Workflow Id",
      "type": "string"
    },
    "binding_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Binding Sha256",
      "type": "string"
    },
    "before": {
      "additionalProperties": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "maxProperties": 2,
      "minProperties": 2,
      "propertyNames": {
        "enum": [
          "analysis/scene_spec.json",
          "analysis/modeling_plan.json"
        ]
      },
      "title": "Before",
      "type": "object"
    },
    "after": {
      "additionalProperties": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "maxProperties": 2,
      "minProperties": 2,
      "propertyNames": {
        "enum": [
          "analysis/scene_spec.json",
          "analysis/modeling_plan.json"
        ]
      },
      "title": "After",
      "type": "object"
    },
    "evidence": {
      "additionalProperties": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Evidence",
      "type": "object"
    },
    "report_before_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Report Before Sha256"
    }
  },
  "required": [
    "job_id",
    "workflow_id",
    "binding_sha256",
    "before",
    "after",
    "evidence",
    "report_before_sha256"
  ],
  "title": "PairedTransactionIntent",
  "type": "object"
}
