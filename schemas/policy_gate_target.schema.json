{
  "$defs": {
    "AutonomyArtifact": {
      "additionalProperties": false,
      "description": "Bind one contained artifact to its repository-relative path and exact bytes.",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "title": "AutonomyArtifact",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Freeze the exact workflow boundary evaluated by one policy authorization.",
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "contract_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Contract Id",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "workflow_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Workflow Id",
      "type": "string"
    },
    "dispatch_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Dispatch Id",
      "type": "string"
    },
    "input_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Sha256",
      "type": "string"
    },
    "source_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Fingerprint",
      "type": "string"
    },
    "producer": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Producer",
      "type": "string"
    },
    "producer_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Producer Version",
      "type": "string"
    },
    "provenance": {
      "items": {
        "$ref": "#/$defs/AutonomyArtifact"
      },
      "minItems": 1,
      "title": "Provenance",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "target_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Target Id",
      "type": "string"
    },
    "session_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Session Id",
      "type": "string"
    },
    "workflow_step_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Workflow Step Id",
      "type": "string"
    },
    "workflow_input_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Workflow Input Fingerprint",
      "type": "string"
    },
    "gate_kind": {
      "enum": [
        "generic_proxy_review",
        "generic_detail_review",
        "material_swatch_acknowledgement",
        "structural_candidate_promotion",
        "bounded_convergence_plan",
        "bounded_convergence_candidate",
        "material_candidate_promotion",
        "qa_review_acknowledgement",
        "optimization_plan",
        "final_package_acknowledgement",
        "destination_handoff_envelope_plan"
      ],
      "title": "Gate Kind",
      "type": "string"
    },
    "workflow_plan": {
      "$ref": "#/$defs/AutonomyArtifact"
    },
    "dependency_completion_fingerprints": {
      "additionalProperties": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Dependency Completion Fingerprints",
      "type": "object"
    },
    "dependency_artifacts": {
      "items": {
        "$ref": "#/$defs/AutonomyArtifact"
      },
      "title": "Dependency Artifacts",
      "type": "array"
    },
    "requested_decision": {
      "const": "authorize_exact_routine_gate",
      "default": "authorize_exact_routine_gate",
      "title": "Requested Decision",
      "type": "string"
    }
  },
  "required": [
    "contract_id",
    "job_id",
    "workflow_id",
    "dispatch_id",
    "input_sha256",
    "source_fingerprint",
    "producer",
    "producer_version",
    "provenance",
    "created_at",
    "target_id",
    "session_id",
    "workflow_step_id",
    "workflow_input_fingerprint",
    "gate_kind",
    "workflow_plan"
  ],
  "title": "PolicyGateTarget",
  "type": "object"
}
