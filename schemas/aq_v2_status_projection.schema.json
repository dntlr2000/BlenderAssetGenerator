{
  "$defs": {
    "ExactArtifact": {
      "additionalProperties": false,
      "description": "Bind one contained job-relative artifact by exact bytes and media type.",
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "pattern": "^[a-z][a-z0-9_]{1,95}$",
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "byte_size": {
          "minimum": 0,
          "title": "Byte Size",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 127,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "path",
        "sha256",
        "byte_size",
        "media_type"
      ],
      "title": "ExactArtifact",
      "type": "object"
    },
    "MaterialCanonicalSnapshot": {
      "additionalProperties": false,
      "description": "Capture the exact canonical material baseline and latest lifecycle evidence.",
      "properties": {
        "schema_version": {
          "const": "0.1.0",
          "default": "0.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "job_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
          "title": "Job Id",
          "type": "string"
        },
        "workflow_id": {
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
          "title": "Workflow Id",
          "type": "string"
        },
        "dispatch_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Dispatch Id",
          "type": "string"
        },
        "session_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Session Id",
          "type": "string"
        },
        "producer": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Producer",
          "type": "string"
        },
        "producer_version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Producer Version",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "snapshot_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Snapshot Id",
          "type": "string"
        },
        "scene_spec": {
          "$ref": "#/$defs/ExactArtifact"
        },
        "modeling_plan": {
          "$ref": "#/$defs/ExactArtifact"
        },
        "material_plan": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExactArtifact"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "material_plan_absence": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExactArtifact"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "blend": {
          "$ref": "#/$defs/ExactArtifact"
        },
        "build_provenance": {
          "$ref": "#/$defs/ExactArtifact"
        },
        "build_provenance_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Build Provenance Fingerprint",
          "type": "string"
        },
        "latest_material_promotion_receipt": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExactArtifact"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "latest_rollback_receipt": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExactArtifact"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "active_candidate_closure": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExactArtifact"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "job_id",
        "workflow_id",
        "dispatch_id",
        "session_id",
        "producer",
        "producer_version",
        "created_at",
        "snapshot_id",
        "scene_spec",
        "modeling_plan",
        "blend",
        "build_provenance",
        "build_provenance_fingerprint"
      ],
      "title": "MaterialCanonicalSnapshot",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Present raw AQ and companion material/canonical state without hiding mismatch.",
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "workflow_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Workflow Id",
      "type": "string"
    },
    "dispatch_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Dispatch Id",
      "type": "string"
    },
    "session_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Session Id",
      "type": "string"
    },
    "producer": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Producer",
      "type": "string"
    },
    "producer_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Producer Version",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "projection_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Projection Id",
      "type": "string"
    },
    "top_level_state": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "top_level_phase": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Top Level Phase",
      "type": "string"
    },
    "top_level_status": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Top Level Status",
      "type": "string"
    },
    "top_level_next_action": {
      "maxLength": 96,
      "minLength": 1,
      "title": "Top Level Next Action",
      "type": "string"
    },
    "material_attempt": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExactArtifact"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "material_attempt_state": {
      "anyOf": [
        {
          "enum": [
            "collecting_closure",
            "closure_failed",
            "rebinding",
            "preflighting",
            "preflight_failed",
            "approval_pending",
            "controller_pending",
            "controller_completed",
            "promoting",
            "promotion_succeeded",
            "rollback_started",
            "rollback_completed",
            "rollback_failed",
            "quality_pending",
            "blocked",
            "cancelled"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Material Attempt State"
    },
    "canonical_snapshot": {
      "$ref": "#/$defs/MaterialCanonicalSnapshot"
    },
    "active_closure": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExactArtifact"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "latest_preflight": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExactArtifact"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "pending_approval": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExactArtifact"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "latest_controller_result": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExactArtifact"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "latest_promotion_receipt": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExactArtifact"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "latest_rollback_receipt": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExactArtifact"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "blocked_retry": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExactArtifact"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "retry_supersession_receipt": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExactArtifact"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "controller_invocation_count": {
      "minimum": 0,
      "title": "Controller Invocation Count",
      "type": "integer"
    },
    "canonical_promotion_count": {
      "minimum": 0,
      "title": "Canonical Promotion Count",
      "type": "integer"
    },
    "rollback_count": {
      "minimum": 0,
      "title": "Rollback Count",
      "type": "integer"
    },
    "consistency_report": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "state_consistent": {
      "title": "State Consistent",
      "type": "boolean"
    },
    "combined_status": {
      "enum": [
        "current",
        "approval_pending",
        "review_required",
        "completed",
        "partial",
        "failed",
        "blocked",
        "cancelled",
        "inconsistent"
      ],
      "title": "Combined Status",
      "type": "string"
    }
  },
  "required": [
    "job_id",
    "workflow_id",
    "dispatch_id",
    "session_id",
    "producer",
    "producer_version",
    "created_at",
    "projection_id",
    "top_level_state",
    "top_level_phase",
    "top_level_status",
    "top_level_next_action",
    "canonical_snapshot",
    "controller_invocation_count",
    "canonical_promotion_count",
    "rollback_count",
    "consistency_report",
    "state_consistent",
    "combined_status"
  ],
  "title": "AQV2StatusProjection",
  "type": "object"
}
