{
  "$defs": {
    "AutonomyArtifact": {
      "additionalProperties": false,
      "description": "Bind one contained artifact to its repository-relative path and exact bytes.",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "title": "AutonomyArtifact",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Describe controller-only files required for one isolated initial candidate.",
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "contract_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Contract Id",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "workflow_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Workflow Id",
      "type": "string"
    },
    "dispatch_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Dispatch Id",
      "type": "string"
    },
    "input_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Sha256",
      "type": "string"
    },
    "source_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Fingerprint",
      "type": "string"
    },
    "producer": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Producer",
      "type": "string"
    },
    "producer_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Producer Version",
      "type": "string"
    },
    "provenance": {
      "items": {
        "$ref": "#/$defs/AutonomyArtifact"
      },
      "minItems": 1,
      "title": "Provenance",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "assignment_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Assignment Id",
      "type": "string"
    },
    "session_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Session Id",
      "type": "string"
    },
    "candidate_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Candidate Id",
      "type": "string"
    },
    "candidate_index": {
      "maximum": 4,
      "minimum": 1,
      "title": "Candidate Index",
      "type": "integer"
    },
    "candidate_phase": {
      "default": "initial",
      "enum": [
        "initial",
        "structural",
        "parametric"
      ],
      "title": "Candidate Phase",
      "type": "string"
    },
    "round_index": {
      "default": 0,
      "maximum": 5,
      "minimum": 0,
      "title": "Round Index",
      "type": "integer"
    },
    "reference_evidence": {
      "$ref": "#/$defs/AutonomyArtifact"
    },
    "camera_hypothesis_set": {
      "$ref": "#/$defs/AutonomyArtifact"
    },
    "workflow_modeling_plan": {
      "anyOf": [
        {
          "$ref": "#/$defs/AutonomyArtifact"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "workflow_scene_spec": {
      "anyOf": [
        {
          "$ref": "#/$defs/AutonomyArtifact"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "baseline_evaluation": {
      "anyOf": [
        {
          "$ref": "#/$defs/AutonomyArtifact"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "output_root": {
      "title": "Output Root",
      "type": "string"
    },
    "required_outputs": {
      "items": {
        "type": "string"
      },
      "minItems": 3,
      "title": "Required Outputs",
      "type": "array"
    },
    "scene_spec_v03_output": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Scene Spec V03 Output"
    },
    "authoring_prompt_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Authoring Prompt Sha256",
      "type": "string"
    },
    "canonical_write_authority": {
      "const": "controller_only",
      "default": "controller_only",
      "title": "Canonical Write Authority",
      "type": "string"
    },
    "advisor_write_authority": {
      "const": "none",
      "default": "none",
      "title": "Advisor Write Authority",
      "type": "string"
    }
  },
  "required": [
    "contract_id",
    "job_id",
    "workflow_id",
    "dispatch_id",
    "input_sha256",
    "source_fingerprint",
    "producer",
    "producer_version",
    "provenance",
    "created_at",
    "assignment_id",
    "session_id",
    "candidate_id",
    "candidate_index",
    "reference_evidence",
    "camera_hypothesis_set",
    "output_root",
    "required_outputs",
    "authoring_prompt_sha256"
  ],
  "title": "CandidateAuthoringAssignment",
  "type": "object"
}
