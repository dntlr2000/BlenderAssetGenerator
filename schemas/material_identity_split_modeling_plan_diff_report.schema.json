{
  "$defs": {
    "ExactArtifact": {
      "additionalProperties": false,
      "description": "Bind one contained job-relative artifact by exact bytes and media type.",
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "pattern": "^[a-z][a-z0-9_]{1,95}$",
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "byte_size": {
          "minimum": 0,
          "title": "Byte Size",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 127,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "path",
        "sha256",
        "byte_size",
        "media_type"
      ],
      "title": "ExactArtifact",
      "type": "object"
    },
    "MaterialIdentitySplitModelingPlanChange": {
      "additionalProperties": false,
      "description": "Declare one allowed ModelingPlan surface-detail target material replacement.",
      "properties": {
        "detail_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Detail Id",
          "type": "string"
        },
        "parent_object_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Parent Object Id",
          "type": "string"
        },
        "source_material_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Source Material Id",
          "type": "string"
        },
        "new_material_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "New Material Id",
          "type": "string"
        },
        "required_channels": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Required Channels",
          "type": "array"
        }
      },
      "required": [
        "detail_id",
        "parent_object_id",
        "source_material_id",
        "new_material_id",
        "required_channels"
      ],
      "title": "MaterialIdentitySplitModelingPlanChange",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Prove that a candidate ModelingPlan contains only declared paired replacements.",
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "workflow_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Workflow Id",
      "type": "string"
    },
    "dispatch_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Dispatch Id",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Run Id",
      "type": "string"
    },
    "producer": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Producer",
      "type": "string"
    },
    "producer_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Producer Version",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "report_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Report Id",
      "type": "string"
    },
    "plan": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "canonical_modeling_plan": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "candidate_modeling_plan": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "allowed_changes": {
      "items": {
        "$ref": "#/$defs/MaterialIdentitySplitModelingPlanChange"
      },
      "minItems": 1,
      "title": "Allowed Changes",
      "type": "array"
    },
    "actual_change_count": {
      "minimum": 1,
      "title": "Actual Change Count",
      "type": "integer"
    },
    "forbidden_change_count": {
      "const": 0,
      "default": 0,
      "title": "Forbidden Change Count",
      "type": "integer"
    },
    "preserved_detail_channels": {
      "patternProperties": {
        "^[a-z0-9][a-z0-9._-]{0,127}$": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
            "type": "string"
          },
          "type": "array"
        }
      },
      "title": "Preserved Detail Channels",
      "type": "object"
    },
    "exact_match": {
      "const": true,
      "default": true,
      "title": "Exact Match",
      "type": "boolean"
    }
  },
  "required": [
    "job_id",
    "workflow_id",
    "dispatch_id",
    "run_id",
    "producer",
    "producer_version",
    "created_at",
    "report_id",
    "plan",
    "canonical_modeling_plan",
    "candidate_modeling_plan",
    "allowed_changes",
    "actual_change_count"
  ],
  "title": "MaterialIdentitySplitModelingPlanDiffReport",
  "type": "object"
}
