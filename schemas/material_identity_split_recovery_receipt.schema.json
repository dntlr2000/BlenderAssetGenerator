{
  "$defs": {
    "ExactArtifact": {
      "additionalProperties": false,
      "description": "Bind one contained job-relative artifact by exact bytes and media type.",
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "pattern": "^[a-z][a-z0-9_]{1,95}$",
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "byte_size": {
          "minimum": 0,
          "title": "Byte Size",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 127,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "path",
        "sha256",
        "byte_size",
        "media_type"
      ],
      "title": "ExactArtifact",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Record deterministic recovery without consuming approval or creating a new intent.",
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "workflow_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Workflow Id",
      "type": "string"
    },
    "dispatch_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Dispatch Id",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Run Id",
      "type": "string"
    },
    "producer": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Producer",
      "type": "string"
    },
    "producer_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Producer Version",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "receipt_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Receipt Id",
      "type": "string"
    },
    "transaction_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Transaction Id",
      "type": "string"
    },
    "apply_intent": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "approval_consumption": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "starting_state": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "terminal_state": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "outcome": {
      "enum": [
        "committed",
        "rolled_back",
        "recovery_required"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "technical_retry_count": {
      "maximum": 1,
      "minimum": 0,
      "title": "Technical Retry Count",
      "type": "integer"
    },
    "approval_reconsumed": {
      "const": false,
      "default": false,
      "title": "Approval Reconsumed",
      "type": "boolean"
    },
    "new_apply_intent_created": {
      "const": false,
      "default": false,
      "title": "New Apply Intent Created",
      "type": "boolean"
    }
  },
  "required": [
    "job_id",
    "workflow_id",
    "dispatch_id",
    "run_id",
    "producer",
    "producer_version",
    "created_at",
    "receipt_id",
    "transaction_id",
    "apply_intent",
    "approval_consumption",
    "starting_state",
    "terminal_state",
    "outcome",
    "technical_retry_count"
  ],
  "title": "MaterialIdentitySplitRecoveryReceipt",
  "type": "object"
}
