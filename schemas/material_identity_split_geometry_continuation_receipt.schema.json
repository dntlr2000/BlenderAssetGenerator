{
  "$defs": {
    "ExactArtifact": {
      "additionalProperties": false,
      "description": "Bind one contained job-relative artifact by exact bytes and media type.",
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "pattern": "^[a-z][a-z0-9_]{1,95}$",
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "byte_size": {
          "minimum": 0,
          "title": "Byte Size",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 127,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "path",
        "sha256",
        "byte_size",
        "media_type"
      ],
      "title": "ExactArtifact",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Prove prior approved geometry survives a committed material-only identity split.",
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "workflow_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Workflow Id",
      "type": "string"
    },
    "dispatch_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Dispatch Id",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Run Id",
      "type": "string"
    },
    "producer": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Producer",
      "type": "string"
    },
    "producer_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Producer Version",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "receipt_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Receipt Id",
      "type": "string"
    },
    "previous_geometry_approval": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "previous_geometry_validation": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "apply_intent": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "apply_receipt": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "post_scene_spec": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "post_modeling_plan": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "post_blend": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "invariant_report": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "canonical_scene_inventory": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "canonical_build_provenance": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "material_plan_absence": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "canonical_snapshot": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "reference_authorization": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "content_scope_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Scope Sha256",
      "type": "string"
    },
    "identity_split_diff": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "geometry_approval_reclassified": {
      "const": false,
      "default": false,
      "title": "Geometry Approval Reclassified",
      "type": "boolean"
    },
    "geometry_continuity_passed": {
      "const": true,
      "default": true,
      "title": "Geometry Continuity Passed",
      "type": "boolean"
    }
  },
  "required": [
    "job_id",
    "workflow_id",
    "dispatch_id",
    "run_id",
    "producer",
    "producer_version",
    "created_at",
    "receipt_id",
    "previous_geometry_approval",
    "previous_geometry_validation",
    "apply_intent",
    "apply_receipt",
    "post_scene_spec",
    "post_modeling_plan",
    "post_blend",
    "invariant_report",
    "canonical_scene_inventory",
    "canonical_build_provenance",
    "material_plan_absence",
    "canonical_snapshot",
    "reference_authorization",
    "content_scope_sha256",
    "identity_split_diff"
  ],
  "title": "MaterialIdentitySplitGeometryContinuationReceipt",
  "type": "object"
}
