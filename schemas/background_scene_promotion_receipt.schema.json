{
  "additionalProperties": false,
  "description": "Bind one optional refined candidate to the exact canonical promotion event.",
  "properties": {
    "schema_version": {
      "const": "0.8.0",
      "default": "0.8.0",
      "title": "Schema Version",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "workflow_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Workflow Id",
      "type": "string"
    },
    "input_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Fingerprint",
      "type": "string"
    },
    "initial_candidate_path": {
      "title": "Initial Candidate Path",
      "type": "string"
    },
    "initial_candidate_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Initial Candidate Sha256",
      "type": "string"
    },
    "selected_candidate_path": {
      "title": "Selected Candidate Path",
      "type": "string"
    },
    "selected_candidate_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Selected Candidate Sha256",
      "type": "string"
    },
    "selected_attempt_index": {
      "maximum": 2,
      "minimum": 0,
      "title": "Selected Attempt Index",
      "type": "integer"
    },
    "previous_canonical_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Previous Canonical Sha256",
      "type": "string"
    },
    "new_canonical_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "New Canonical Sha256",
      "type": "string"
    },
    "canonical_changed": {
      "title": "Canonical Changed",
      "type": "boolean"
    },
    "archived_scene_spec_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Archived Scene Spec Path"
    },
    "role_map_path": {
      "title": "Role Map Path",
      "type": "string"
    },
    "role_map_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Role Map Sha256",
      "type": "string"
    },
    "promoted_at": {
      "format": "date-time",
      "title": "Promoted At",
      "type": "string"
    }
  },
  "required": [
    "job_id",
    "workflow_id",
    "input_fingerprint",
    "initial_candidate_path",
    "initial_candidate_sha256",
    "selected_candidate_path",
    "selected_candidate_sha256",
    "selected_attempt_index",
    "previous_canonical_sha256",
    "new_canonical_sha256",
    "canonical_changed",
    "role_map_path",
    "role_map_sha256",
    "promoted_at"
  ],
  "title": "BackgroundScenePromotionReceipt",
  "type": "object"
}
