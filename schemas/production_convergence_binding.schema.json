{
  "$defs": {
    "ProductionArtifact": {
      "additionalProperties": false,
      "description": "Bind one contained production artifact to a normalized path and exact digest.",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "title": "ProductionArtifact",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Bind one production dispatch to an exact V0.6 convergence plan and baseline.",
  "properties": {
    "schema_version": {
      "const": "0.9.0",
      "default": "0.9.0",
      "title": "Schema Version",
      "type": "string"
    },
    "binding_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Binding Id",
      "type": "string"
    },
    "dispatch_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Dispatch Id",
      "type": "string"
    },
    "controller_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Controller Id",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "workflow_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Workflow Id",
      "type": "string"
    },
    "workflow_state_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Workflow State Fingerprint",
      "type": "string"
    },
    "initial_qa_run_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Initial Qa Run Id",
      "type": "string"
    },
    "initial_qa_report": {
      "$ref": "#/$defs/ProductionArtifact"
    },
    "convergence_session_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Convergence Session Id",
      "type": "string"
    },
    "convergence_plan": {
      "$ref": "#/$defs/ProductionArtifact"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "binding_id",
    "dispatch_id",
    "controller_id",
    "job_id",
    "workflow_id",
    "workflow_state_fingerprint",
    "initial_qa_run_id",
    "initial_qa_report",
    "convergence_session_id",
    "convergence_plan",
    "created_at"
  ],
  "title": "ProductionConvergenceBinding",
  "type": "object"
}
