{
  "$defs": {
    "ControllerArtifact": {
      "additionalProperties": false,
      "description": "Bind one controller input or output to exact job-contained bytes.",
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "role": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Role",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "byte_size": {
          "exclusiveMinimum": 0,
          "title": "Byte Size",
          "type": "integer"
        }
      },
      "required": [
        "artifact_id",
        "role",
        "path",
        "sha256",
        "byte_size"
      ],
      "title": "ControllerArtifact",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Declare a hash-bound, phase-specific tool and filesystem authority ceiling.",
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "contract_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Contract Id",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "workflow_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Workflow Id",
      "type": "string"
    },
    "dispatch_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Dispatch Id",
      "type": "string"
    },
    "session_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Session Id",
      "type": "string"
    },
    "input_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Sha256",
      "type": "string"
    },
    "source_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Fingerprint",
      "type": "string"
    },
    "producer": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Producer",
      "type": "string"
    },
    "producer_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Producer Version",
      "type": "string"
    },
    "provenance": {
      "items": {
        "$ref": "#/$defs/ControllerArtifact"
      },
      "minItems": 1,
      "title": "Provenance",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "profile_id": {
      "enum": [
        "reference_readonly",
        "geometry_authoring",
        "material_authoring",
        "quality_readonly",
        "delivery",
        "handoff_plan",
        "admin_audit"
      ],
      "title": "Profile Id",
      "type": "string"
    },
    "allowed_tools": {
      "items": {
        "type": "string"
      },
      "title": "Allowed Tools",
      "type": "array"
    },
    "forbidden_tools": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Forbidden Tools",
      "type": "array"
    },
    "allowed_input_roles": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Allowed Input Roles",
      "type": "array"
    },
    "allowed_output_paths": {
      "items": {
        "type": "string"
      },
      "title": "Allowed Output Paths",
      "type": "array"
    },
    "canonical_write_authority": {
      "const": "supervisor_only",
      "default": "supervisor_only",
      "title": "Canonical Write Authority",
      "type": "string"
    },
    "network_access": {
      "const": "denied",
      "default": "denied",
      "title": "Network Access",
      "type": "string"
    },
    "destination_project_write": {
      "const": false,
      "default": false,
      "title": "Destination Project Write",
      "type": "boolean"
    },
    "sandbox_attestation": {
      "default": "repository_path_validation_only",
      "enum": [
        "repository_path_validation_only",
        "supporting_client_enforced"
      ],
      "title": "Sandbox Attestation",
      "type": "string"
    }
  },
  "required": [
    "contract_id",
    "job_id",
    "workflow_id",
    "dispatch_id",
    "session_id",
    "input_sha256",
    "source_fingerprint",
    "producer",
    "provenance",
    "created_at",
    "profile_id",
    "allowed_tools",
    "forbidden_tools",
    "allowed_input_roles",
    "allowed_output_paths"
  ],
  "title": "PhaseToolProfile",
  "type": "object"
}
