{
  "$defs": {
    "CodexGeneratedFile": {
      "additionalProperties": false,
      "description": "Describe one generated raster in the assignment-declared staging file set.",
      "properties": {
        "candidate_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Candidate Id",
          "type": "string"
        },
        "ordinal": {
          "maximum": 2,
          "minimum": 0,
          "title": "Ordinal",
          "type": "integer"
        },
        "output_role": {
          "enum": [
            "base_color",
            "decal_rgb",
            "emission",
            "opacity_source"
          ],
          "title": "Output Role",
          "type": "string"
        },
        "artifact": {
          "$ref": "#/$defs/CodexImageArtifact"
        },
        "width": {
          "maximum": 2048,
          "minimum": 64,
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "maximum": 2048,
          "minimum": 64,
          "title": "Height",
          "type": "integer"
        },
        "image_format": {
          "const": "png",
          "default": "png",
          "title": "Image Format",
          "type": "string"
        },
        "alpha_present": {
          "title": "Alpha Present",
          "type": "boolean"
        }
      },
      "required": [
        "candidate_id",
        "ordinal",
        "output_role",
        "artifact",
        "width",
        "height",
        "alpha_present"
      ],
      "title": "CodexGeneratedFile",
      "type": "object"
    },
    "CodexImageArtifact": {
      "additionalProperties": false,
      "description": "Bind one non-empty job-contained file to exact bytes and media semantics.",
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "byte_size": {
          "exclusiveMinimum": 0,
          "title": "Byte Size",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "path",
        "sha256",
        "byte_size",
        "media_type"
      ],
      "title": "CodexImageArtifact",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Record one bounded controller completion without granting adoption authority.",
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "contract_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Contract Id",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "workflow_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Workflow Id",
      "type": "string"
    },
    "dispatch_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Dispatch Id",
      "type": "string"
    },
    "session_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Session Id",
      "type": "string"
    },
    "profile_id": {
      "const": "autonomous_static_prop_v2_codex_imagegen",
      "default": "autonomous_static_prop_v2_codex_imagegen",
      "title": "Profile Id",
      "type": "string"
    },
    "provider_id": {
      "const": "codex_builtin_gpt_image_v1",
      "default": "codex_builtin_gpt_image_v1",
      "title": "Provider Id",
      "type": "string"
    },
    "input_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Sha256",
      "type": "string"
    },
    "source_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Fingerprint",
      "type": "string"
    },
    "producer": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Producer",
      "type": "string"
    },
    "producer_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Producer Version",
      "type": "string"
    },
    "provenance": {
      "items": {
        "$ref": "#/$defs/CodexImageArtifact"
      },
      "minItems": 1,
      "title": "Provenance",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "completion_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Completion Id",
      "type": "string"
    },
    "assignment": {
      "$ref": "#/$defs/CodexImageArtifact"
    },
    "assignment_payload_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Assignment Payload Sha256",
      "type": "string"
    },
    "controller_kind": {
      "enum": [
        "desktop_in_session",
        "fake_for_tests"
      ],
      "title": "Controller Kind",
      "type": "string"
    },
    "execution_scope": {
      "enum": [
        "codex_built_in",
        "deterministic_fake"
      ],
      "title": "Execution Scope",
      "type": "string"
    },
    "source_kind": {
      "enum": [
        "codex_builtin_generated_image",
        "deterministic_fake"
      ],
      "title": "Source Kind",
      "type": "string"
    },
    "source_policy": {
      "const": "controller_allowed_local_root",
      "default": "controller_allowed_local_root",
      "title": "Source Policy",
      "type": "string"
    },
    "source_inventory_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Inventory Sha256",
      "type": "string"
    },
    "generated_files": {
      "items": {
        "$ref": "#/$defs/CodexGeneratedFile"
      },
      "maxItems": 3,
      "title": "Generated Files",
      "type": "array"
    },
    "generation_count": {
      "maximum": 4,
      "minimum": 0,
      "title": "Generation Count",
      "type": "integer"
    },
    "edit_or_refinement_count": {
      "default": 0,
      "maximum": 1,
      "minimum": 0,
      "title": "Edit Or Refinement Count",
      "type": "integer"
    },
    "prompt_echo_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Prompt Echo Sha256",
      "type": "string"
    },
    "failures": {
      "items": {
        "type": "string"
      },
      "title": "Failures",
      "type": "array"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    },
    "controller_executed_at": {
      "format": "date-time",
      "title": "Controller Executed At",
      "type": "string"
    },
    "status": {
      "enum": [
        "completed",
        "partial",
        "failed",
        "cancelled"
      ],
      "title": "Status",
      "type": "string"
    },
    "canonical_unchanged": {
      "const": true,
      "default": true,
      "title": "Canonical Unchanged",
      "type": "boolean"
    },
    "human_reviewed": {
      "const": false,
      "default": false,
      "title": "Human Reviewed",
      "type": "boolean"
    }
  },
  "required": [
    "contract_id",
    "job_id",
    "workflow_id",
    "dispatch_id",
    "session_id",
    "input_sha256",
    "source_fingerprint",
    "producer",
    "provenance",
    "created_at",
    "completion_id",
    "assignment",
    "assignment_payload_sha256",
    "controller_kind",
    "execution_scope",
    "source_kind",
    "source_inventory_sha256",
    "generation_count",
    "prompt_echo_sha256",
    "controller_executed_at",
    "status"
  ],
  "title": "CodexImageGenerationCompletion",
  "type": "object"
}
