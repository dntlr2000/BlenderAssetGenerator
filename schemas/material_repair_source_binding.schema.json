{
  "$defs": {
    "ExactArtifact": {
      "additionalProperties": false,
      "description": "Bind one contained job-relative artifact by exact bytes and media type.",
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "pattern": "^[a-z][a-z0-9_]{1,95}$",
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "byte_size": {
          "minimum": 0,
          "title": "Byte Size",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 127,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "path",
        "sha256",
        "byte_size",
        "media_type"
      ],
      "title": "ExactArtifact",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Bind a new material-only repair to exact reusable geometry and source evidence.",
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "workflow_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Workflow Id",
      "type": "string"
    },
    "dispatch_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Dispatch Id",
      "type": "string"
    },
    "session_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Session Id",
      "type": "string"
    },
    "producer": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Producer",
      "type": "string"
    },
    "producer_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Producer Version",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "binding_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Binding Id",
      "type": "string"
    },
    "source_session_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Source Session Id",
      "type": "string"
    },
    "scene_spec": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "modeling_plan": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "blend": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "geometry_approval_or_validation": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "latest_successful_rollback_receipt": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExactArtifact"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "material_plan": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExactArtifact"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "material_plan_absence": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExactArtifact"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "primary_reference": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "uv_layout_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Uv Layout Fingerprint",
      "type": "string"
    },
    "target_subject": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Target Subject",
      "type": "string"
    },
    "content_scope_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Scope Sha256",
      "type": "string"
    },
    "framework_failure_report": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "reusable_imagegen_evidence": {
      "items": {
        "$ref": "#/$defs/ExactArtifact"
      },
      "title": "Reusable Imagegen Evidence",
      "type": "array"
    },
    "geometry_reuse_only": {
      "const": true,
      "default": true,
      "title": "Geometry Reuse Only",
      "type": "boolean"
    }
  },
  "required": [
    "job_id",
    "workflow_id",
    "dispatch_id",
    "session_id",
    "producer",
    "producer_version",
    "created_at",
    "binding_id",
    "source_session_id",
    "scene_spec",
    "modeling_plan",
    "blend",
    "geometry_approval_or_validation",
    "primary_reference",
    "uv_layout_fingerprint",
    "target_subject",
    "content_scope_sha256",
    "framework_failure_report"
  ],
  "title": "MaterialRepairSourceBinding",
  "type": "object"
}
