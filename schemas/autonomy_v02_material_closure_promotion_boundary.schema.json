{
  "$defs": {
    "AQV2Artifact": {
      "additionalProperties": false,
      "description": "Bind one immutable job-contained artifact to exact bytes and role.",
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "byte_size": {
          "exclusiveMinimum": 0,
          "title": "Byte Size",
          "type": "integer"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "path",
        "sha256",
        "byte_size"
      ],
      "title": "AQV2Artifact",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Bind one preflighted and user-approved closure to exact controller projections.",
  "properties": {
    "schema_version": {
      "const": "0.2.0",
      "default": "0.2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "contract_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Contract Id",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "workflow_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Workflow Id",
      "type": "string"
    },
    "dispatch_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Dispatch Id",
      "type": "string"
    },
    "session_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Session Id",
      "type": "string"
    },
    "input_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Sha256",
      "type": "string"
    },
    "source_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Fingerprint",
      "type": "string"
    },
    "producer": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Producer",
      "type": "string"
    },
    "producer_version": {
      "const": "0.2.0",
      "default": "0.2.0",
      "title": "Producer Version",
      "type": "string"
    },
    "provenance": {
      "items": {
        "$ref": "#/$defs/AQV2Artifact"
      },
      "minItems": 1,
      "title": "Provenance",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "boundary_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Boundary Id",
      "type": "string"
    },
    "current_state": {
      "$ref": "#/$defs/AQV2Artifact"
    },
    "dependency_closure": {
      "$ref": "#/$defs/AQV2Artifact"
    },
    "dependency_closure_receipt": {
      "$ref": "#/$defs/AQV2Artifact"
    },
    "graph_rebinding_receipt": {
      "$ref": "#/$defs/AQV2Artifact"
    },
    "preflight_report": {
      "$ref": "#/$defs/AQV2Artifact"
    },
    "shadow_compile_receipt": {
      "$ref": "#/$defs/AQV2Artifact"
    },
    "neutral_preview_manifest": {
      "$ref": "#/$defs/AQV2Artifact"
    },
    "appearance_approval": {
      "$ref": "#/$defs/AQV2Artifact"
    },
    "state_consistency_report": {
      "$ref": "#/$defs/AQV2Artifact"
    },
    "candidate_material_plan": {
      "$ref": "#/$defs/AQV2Artifact"
    },
    "rebound_material_graph": {
      "$ref": "#/$defs/AQV2Artifact"
    },
    "immutable_input_sha256": {
      "additionalProperties": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "minProperties": 1,
      "title": "Immutable Input Sha256",
      "type": "object"
    },
    "planned_output_sha256": {
      "additionalProperties": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "minProperties": 2,
      "title": "Planned Output Sha256",
      "type": "object"
    },
    "canonical_scene_spec_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Canonical Scene Spec Sha256",
      "type": "string"
    },
    "canonical_blend_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Canonical Blend Sha256",
      "type": "string"
    },
    "uv_layout_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Uv Layout Fingerprint",
      "type": "string"
    },
    "controller_invocation_limit": {
      "const": 1,
      "default": 1,
      "title": "Controller Invocation Limit",
      "type": "integer"
    },
    "appearance_approval_required": {
      "const": true,
      "default": true,
      "title": "Appearance Approval Required",
      "type": "boolean"
    },
    "controller_may_execute": {
      "const": true,
      "default": true,
      "title": "Controller May Execute",
      "type": "boolean"
    },
    "canonical_write_authority": {
      "const": "material_phase_service_only",
      "default": "material_phase_service_only",
      "title": "Canonical Write Authority",
      "type": "string"
    }
  },
  "required": [
    "contract_id",
    "job_id",
    "workflow_id",
    "dispatch_id",
    "session_id",
    "input_sha256",
    "source_fingerprint",
    "producer",
    "provenance",
    "created_at",
    "boundary_id",
    "current_state",
    "dependency_closure",
    "dependency_closure_receipt",
    "graph_rebinding_receipt",
    "preflight_report",
    "shadow_compile_receipt",
    "neutral_preview_manifest",
    "appearance_approval",
    "state_consistency_report",
    "candidate_material_plan",
    "rebound_material_graph",
    "immutable_input_sha256",
    "planned_output_sha256",
    "canonical_scene_spec_sha256",
    "canonical_blend_sha256",
    "uv_layout_fingerprint"
  ],
  "title": "MaterialClosurePromotionBoundaryV2",
  "type": "object"
}
