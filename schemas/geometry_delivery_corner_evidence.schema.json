{
  "$defs": {
    "DeliveryCornerV02": {
      "additionalProperties": false,
      "description": "Bind full finite world position, UV and unit normal to the same triangle corner.",
      "properties": {
        "position": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Position",
          "type": "array"
        },
        "uv": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Uv",
          "type": "array"
        },
        "normal": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Normal",
          "type": "array"
        }
      },
      "required": [
        "position",
        "uv",
        "normal"
      ],
      "title": "DeliveryCornerV02",
      "type": "object"
    },
    "DeliveryTriangleV02": {
      "additionalProperties": false,
      "description": "Retain a complete face-corner association under one stable object-instance ID.",
      "properties": {
        "semantic_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(#[0-9]+)?$",
          "title": "Semantic Id",
          "type": "string"
        },
        "corners": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "$ref": "#/$defs/DeliveryCornerV02"
            },
            {
              "$ref": "#/$defs/DeliveryCornerV02"
            },
            {
              "$ref": "#/$defs/DeliveryCornerV02"
            }
          ],
          "title": "Corners",
          "type": "array"
        }
      },
      "required": [
        "semantic_id",
        "corners"
      ],
      "title": "DeliveryTriangleV02",
      "type": "object"
    },
    "GeometryEvidenceFingerprintV02": {
      "additionalProperties": false,
      "description": "Represent one available, unavailable, or inapplicable exact evidence channel.",
      "properties": {
        "status": {
          "enum": [
            "available",
            "unavailable",
            "not_applicable"
          ],
          "title": "Status",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Sha256"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason"
        }
      },
      "required": [
        "status",
        "sha256",
        "reason"
      ],
      "title": "GeometryEvidenceFingerprintV02",
      "type": "object"
    },
    "GeometryStageSnapshotV02": {
      "additionalProperties": false,
      "description": "Capture exact structural state at one candidate, canonical, or delivery stage.",
      "properties": {
        "schema_version": {
          "const": "0.1.0",
          "default": "0.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "stage": {
          "enum": [
            "structural_materialization",
            "compiled_candidate",
            "promoted_canonical",
            "optimized_lod0",
            "clean_import_glb",
            "clean_import_fbx"
          ],
          "title": "Stage",
          "type": "string"
        },
        "artifact_path": {
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*//)[^\\u0000]+$",
          "title": "Artifact Path",
          "type": "string"
        },
        "artifact_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Artifact Sha256",
          "type": "string"
        },
        "source_fingerprint_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Fingerprint Sha256",
          "type": "string"
        },
        "build_fingerprint_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Build Fingerprint Sha256",
          "type": "string"
        },
        "semantic_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Semantic Id",
          "type": "string"
        },
        "topology_profile": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Topology Profile",
          "type": "string"
        },
        "vertex_count": {
          "minimum": 0,
          "title": "Vertex Count",
          "type": "integer"
        },
        "face_count": {
          "minimum": 0,
          "title": "Face Count",
          "type": "integer"
        },
        "loop_count": {
          "minimum": 0,
          "title": "Loop Count",
          "type": "integer"
        },
        "evaluated_triangle_count": {
          "minimum": 0,
          "title": "Evaluated Triangle Count",
          "type": "integer"
        },
        "topology_fingerprint": {
          "$ref": "#/$defs/GeometryEvidenceFingerprintV02"
        },
        "surface_equivalence_fingerprint": {
          "$ref": "#/$defs/GeometryEvidenceFingerprintV02"
        },
        "uv_fingerprint": {
          "$ref": "#/$defs/GeometryEvidenceFingerprintV02"
        },
        "material_slots_fingerprint": {
          "$ref": "#/$defs/GeometryEvidenceFingerprintV02"
        },
        "polygon_material_fingerprint": {
          "$ref": "#/$defs/GeometryEvidenceFingerprintV02"
        },
        "split_normal_fingerprint": {
          "$ref": "#/$defs/GeometryEvidenceFingerprintV02"
        },
        "sharp_edge_fingerprint": {
          "$ref": "#/$defs/GeometryEvidenceFingerprintV02"
        },
        "uv_seam_fingerprint": {
          "$ref": "#/$defs/GeometryEvidenceFingerprintV02"
        },
        "crease_fingerprint": {
          "$ref": "#/$defs/GeometryEvidenceFingerprintV02"
        },
        "bevel_fingerprint": {
          "$ref": "#/$defs/GeometryEvidenceFingerprintV02"
        },
        "smoothing_fingerprint": {
          "$ref": "#/$defs/GeometryEvidenceFingerprintV02"
        },
        "modifier_fingerprint": {
          "$ref": "#/$defs/GeometryEvidenceFingerprintV02"
        },
        "custom_attribute_fingerprint": {
          "$ref": "#/$defs/GeometryEvidenceFingerprintV02"
        }
      },
      "required": [
        "stage",
        "artifact_path",
        "artifact_sha256",
        "source_fingerprint_sha256",
        "build_fingerprint_sha256",
        "semantic_id",
        "topology_profile",
        "vertex_count",
        "face_count",
        "loop_count",
        "evaluated_triangle_count",
        "topology_fingerprint",
        "surface_equivalence_fingerprint",
        "uv_fingerprint",
        "material_slots_fingerprint",
        "polygon_material_fingerprint",
        "split_normal_fingerprint",
        "sharp_edge_fingerprint",
        "uv_seam_fingerprint",
        "crease_fingerprint",
        "bevel_fingerprint",
        "smoothing_fingerprint",
        "modifier_fingerprint",
        "custom_attribute_fingerprint"
      ],
      "title": "GeometryStageSnapshotV02",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Capture raw values beside the unchanged exact legacy stage snapshot.",
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "kind": {
      "const": "geometry_delivery_corner_evidence",
      "default": "geometry_delivery_corner_evidence",
      "title": "Kind",
      "type": "string"
    },
    "blender_version": {
      "const": "5.0.1",
      "title": "Blender Version",
      "type": "string"
    },
    "snapshot": {
      "$ref": "#/$defs/GeometryStageSnapshotV02"
    },
    "triangles": {
      "items": {
        "$ref": "#/$defs/DeliveryTriangleV02"
      },
      "maxItems": 1000000,
      "minItems": 1,
      "title": "Triangles",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "blender_version",
    "snapshot",
    "triangles"
  ],
  "title": "GeometryDeliveryCornerEvidenceV02",
  "type": "object"
}
