{
  "$defs": {
    "AssemblyFrame": {
      "additionalProperties": false,
      "description": "Describe the intrinsic 3D axes used to judge one assembled asset.",
      "properties": {
        "root_object_id": {
          "title": "Root Object Id",
          "type": "string"
        },
        "longitudinal_axis": {
          "enum": [
            "X",
            "Y",
            "Z"
          ],
          "title": "Longitudinal Axis",
          "type": "string"
        },
        "lateral_axis": {
          "enum": [
            "X",
            "Y",
            "Z"
          ],
          "title": "Lateral Axis",
          "type": "string"
        },
        "vertical_axis": {
          "enum": [
            "X",
            "Y",
            "Z"
          ],
          "title": "Vertical Axis",
          "type": "string"
        },
        "symmetry": {
          "default": "unknown",
          "enum": [
            "bilateral",
            "asymmetric",
            "unknown"
          ],
          "title": "Symmetry",
          "type": "string"
        },
        "evidence_status": {
          "default": "inferred",
          "enum": [
            "observed",
            "inferred",
            "measured",
            "authored"
          ],
          "title": "Evidence Status",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "confidence": {
          "default": 0.5,
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        }
      },
      "required": [
        "root_object_id",
        "longitudinal_axis",
        "lateral_axis",
        "vertical_axis"
      ],
      "title": "AssemblyFrame",
      "type": "object"
    },
    "AssemblyTolerance": {
      "additionalProperties": false,
      "description": "Define one unambiguous absolute or reference-relative assembly tolerance.",
      "properties": {
        "mode": {
          "default": "relative",
