{
  "additionalProperties": false,
  "description": "Bind one workflow-owned authored candidate to its canonical promotion.",
  "properties": {
    "schema_version": {
      "const": "0.8.0",
      "default": "0.8.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "const": "promoted",
      "default": "promoted",
      "title": "Status",
      "type": "string"
    },
    "ok": {
      "const": true,
      "default": true,
      "title": "Ok",
      "type": "boolean"
    },
    "workflow_id": {
      "title": "Workflow Id",
      "type": "string"
    },
    "job_id": {
      "title": "Job Id",
      "type": "string"
    },
    "step_id": {
      "const": "material.promote",
      "default": "material.promote",
      "title": "Step Id",
      "type": "string"
    },
    "input_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Fingerprint",
      "type": "string"
    },
    "candidate_plan_path": {
      "title": "Candidate Plan Path",
      "type": "string"
    },
    "candidate_plan_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Candidate Plan Sha256",
      "type": "string"
    },
    "candidate_bundle_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Candidate Bundle Sha256",
      "type": "string"
    },
    "previous_canonical_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Previous Canonical Sha256"
    },
    "canonical_plan_path": {
      "const": "analysis/material_plan.json",
      "default": "analysis/material_plan.json",
      "title": "Canonical Plan Path",
      "type": "string"
    },
    "canonical_plan_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Canonical Plan Sha256",
      "type": "string"
    },
    "history_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "History Path"
    },
    "scene_spec_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Scene Spec Sha256",
      "type": "string"
    },
    "dependency_sha256": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Dependency Sha256",
      "type": "object"
    },
    "promoted_at": {
      "format": "date-time",
      "title": "Promoted At",
      "type": "string"
    }
  },
  "required": [
    "workflow_id",
    "job_id",
    "input_fingerprint",
    "candidate_plan_path",
    "candidate_plan_sha256",
    "candidate_bundle_sha256",
    "canonical_plan_sha256",
    "scene_spec_sha256",
    "promoted_at"
  ],
  "title": "MaterialPromotionReceipt",
  "type": "object"
}
