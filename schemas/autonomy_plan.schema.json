{
  "$defs": {
    "AutonomyArtifact": {
      "additionalProperties": false,
      "description": "Bind one contained artifact to its repository-relative path and exact bytes.",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "title": "AutonomyArtifact",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Bind one bounded supervisor plan to an existing standard production dispatch.",
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "contract_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Contract Id",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "workflow_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Workflow Id",
      "type": "string"
    },
    "dispatch_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Dispatch Id",
      "type": "string"
    },
    "input_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Sha256",
      "type": "string"
    },
    "source_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Fingerprint",
      "type": "string"
    },
    "producer": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Producer",
      "type": "string"
    },
    "producer_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Producer Version",
      "type": "string"
    },
    "provenance": {
      "items": {
        "$ref": "#/$defs/AutonomyArtifact"
      },
      "minItems": 1,
      "title": "Provenance",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "session_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Session Id",
      "type": "string"
    },
    "profile": {
      "$ref": "#/$defs/AutonomyArtifact"
    },
    "budget": {
      "$ref": "#/$defs/AutonomyArtifact"
    },
    "root_authorization": {
      "$ref": "#/$defs/AutonomyArtifact"
    },
    "production_dispatch_plan": {
      "$ref": "#/$defs/AutonomyArtifact"
    },
    "production_controller_plan": {
      "$ref": "#/$defs/AutonomyArtifact"
    },
    "underlying_execution_policy": {
      "const": "standard",
      "default": "standard",
      "title": "Underlying Execution Policy",
      "type": "string"
    },
    "reference_content_scope": {
      "const": "primary_object_only",
      "default": "primary_object_only",
      "title": "Reference Content Scope",
      "type": "string"
    },
    "target_subject": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Target Subject",
      "type": "string"
    },
    "output_profile": {
      "const": "portable_gltf",
      "default": "portable_gltf",
      "title": "Output Profile",
      "type": "string"
    },
    "include_destination_handoff_envelope": {
      "default": false,
      "title": "Include Destination Handoff Envelope",
      "type": "boolean"
    },
    "initial_candidate_limit": {
      "default": 3,
      "maximum": 4,
      "minimum": 1,
      "title": "Initial Candidate Limit",
      "type": "integer"
    },
    "max_parallel_read_only_advisors": {
      "default": 3,
      "maximum": 3,
      "minimum": 1,
      "title": "Max Parallel Read Only Advisors",
      "type": "integer"
    },
    "canonical_writer": {
      "const": "controller_only",
      "default": "controller_only",
      "title": "Canonical Writer",
      "type": "string"
    },
    "action_limit": {
      "default": 64,
      "maximum": 128,
      "minimum": 1,
      "title": "Action Limit",
      "type": "integer"
    }
  },
  "required": [
    "contract_id",
    "job_id",
    "workflow_id",
    "dispatch_id",
    "input_sha256",
    "source_fingerprint",
    "producer",
    "producer_version",
    "provenance",
    "created_at",
    "session_id",
    "profile",
    "budget",
    "root_authorization",
    "production_dispatch_plan",
    "production_controller_plan",
    "target_subject"
  ],
  "title": "AutonomyPlan",
  "type": "object"
}
