{
  "$defs": {
    "MaterialResourceCounters": {
      "additionalProperties": false,
      "description": "Keep bounded material-resource limits and consumption in separate categories.",
      "properties": {
        "preflight_blender_runs": {
          "minimum": 0,
          "title": "Preflight Blender Runs",
          "type": "integer"
        },
        "controller_invocations": {
          "minimum": 0,
          "title": "Controller Invocations",
          "type": "integer"
        },
        "canonical_promotions": {
          "minimum": 0,
          "title": "Canonical Promotions",
          "type": "integer"
        },
        "appearance_revisions": {
          "minimum": 0,
          "title": "Appearance Revisions",
          "type": "integer"
        },
        "transient_controller_retries": {
          "default": 0,
          "minimum": 0,
          "title": "Transient Controller Retries",
          "type": "integer"
        }
      },
      "required": [
        "preflight_blender_runs",
        "controller_invocations",
        "canonical_promotions",
        "appearance_revisions"
      ],
      "title": "MaterialResourceCounters",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Separate finite preflight resources from controller, promotion, and art budgets.",
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "workflow_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Workflow Id",
      "type": "string"
    },
    "dispatch_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Dispatch Id",
      "type": "string"
    },
    "session_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Session Id",
      "type": "string"
    },
    "producer": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Producer",
      "type": "string"
    },
    "producer_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Producer Version",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "budget_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Budget Id",
      "type": "string"
    },
    "limits": {
      "$ref": "#/$defs/MaterialResourceCounters"
    },
    "consumed": {
      "$ref": "#/$defs/MaterialResourceCounters"
    },
    "hard_upper_bound": {
      "const": true,
      "default": true,
      "title": "Hard Upper Bound",
      "type": "boolean"
    },
    "automatic_expansion_allowed": {
      "const": false,
      "default": false,
      "title": "Automatic Expansion Allowed",
      "type": "boolean"
    }
  },
  "required": [
    "job_id",
    "workflow_id",
    "dispatch_id",
    "session_id",
    "producer",
    "producer_version",
    "created_at",
    "budget_id",
    "limits",
    "consumed"
  ],
  "title": "MaterialPreflightBudget",
  "type": "object"
}
