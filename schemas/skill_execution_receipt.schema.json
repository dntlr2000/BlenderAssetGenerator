{
  "$defs": {
    "SkillArtifact": {
      "additionalProperties": false,
      "description": "Bind one job-relative immutable artifact to its exact bytes.",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "title": "SkillArtifact",
      "type": "object"
    },
    "UnderlyingExecutionBinding": {
      "additionalProperties": false,
      "description": "Bind one trace event to an existing V0.8 or AQ state machine.",
      "properties": {
        "execution_kind": {
          "enum": [
            "workflow_v08",
            "aq_one_prompt_v01"
          ],
          "title": "Execution Kind",
          "type": "string"
        },
        "execution_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Execution Id",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/SkillArtifact"
        },
        "status": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Status",
          "type": "string"
        },
        "next_action": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next Action"
        }
      },
      "required": [
        "execution_kind",
        "execution_id",
        "state",
        "status"
      ],
      "title": "UnderlyingExecutionBinding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Append one immutable projection of an underlying execution transition.",
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "receipt_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Receipt Id",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Run Id",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "sequence": {
      "minimum": 1,
      "title": "Sequence",
      "type": "integer"
    },
    "route_decision": {
      "$ref": "#/$defs/SkillArtifact"
    },
    "before": {
      "$ref": "#/$defs/UnderlyingExecutionBinding"
    },
    "after": {
      "$ref": "#/$defs/UnderlyingExecutionBinding"
    },
    "outcome": {
      "enum": [
        "advanced",
        "waiting_for_agent",
        "waiting_for_approval",
        "waiting_for_controller",
        "waiting_for_external_revision",
        "completed",
        "blocked",
        "failed",
        "cancelled",
        "slice_exhausted"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "previous_receipt_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Previous Receipt Sha256"
    },
    "canonical_write_authority": {
      "const": false,
      "default": false,
      "title": "Canonical Write Authority",
      "type": "boolean"
    },
    "approval_authority": {
      "const": false,
      "default": false,
      "title": "Approval Authority",
      "type": "boolean"
    },
    "recorded_at": {
      "format": "date-time",
      "title": "Recorded At",
      "type": "string"
    }
  },
  "required": [
    "receipt_id",
    "run_id",
    "job_id",
    "sequence",
    "route_decision",
    "before",
    "after",
    "outcome",
    "recorded_at"
  ],
  "title": "SkillExecutionReceipt",
  "type": "object"
}
