{
  "$defs": {
    "CodexImageArtifact": {
      "additionalProperties": false,
      "description": "Bind one non-empty job-contained file to exact bytes and media semantics.",
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "byte_size": {
          "exclusiveMinimum": 0,
          "title": "Byte Size",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "path",
        "sha256",
        "byte_size",
        "media_type"
      ],
      "title": "CodexImageArtifact",
      "type": "object"
    },
    "ImageGenCropRectangle": {
      "additionalProperties": false,
      "description": "Record one source-pixel crop rectangle using a top-left origin.",
      "properties": {
        "x": {
          "minimum": 0,
          "title": "X",
          "type": "integer"
        },
        "y": {
          "minimum": 0,
          "title": "Y",
          "type": "integer"
        },
        "width": {
          "exclusiveMinimum": 0,
          "maximum": 8192,
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "exclusiveMinimum": 0,
          "maximum": 8192,
          "title": "Height",
          "type": "integer"
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "title": "ImageGenCropRectangle",
      "type": "object"
    },
    "ImageGenPadding": {
      "additionalProperties": false,
      "description": "Record exact output-pixel padding around contain-resized content.",
      "properties": {
        "left": {
          "maximum": 8192,
          "minimum": 0,
          "title": "Left",
          "type": "integer"
        },
        "top": {
          "maximum": 8192,
          "minimum": 0,
          "title": "Top",
          "type": "integer"
        },
        "right": {
          "maximum": 8192,
          "minimum": 0,
          "title": "Right",
          "type": "integer"
        },
        "bottom": {
          "maximum": 8192,
          "minimum": 0,
          "title": "Bottom",
          "type": "integer"
        }
      },
      "required": [
        "left",
        "top",
        "right",
        "bottom"
      ],
      "title": "ImageGenPadding",
      "type": "object"
    },
    "MaterialLoopRasterSize": {
      "additionalProperties": false,
      "description": "Describe one bounded native or material raster size.",
      "properties": {
        "width": {
          "maximum": 8192,
          "minimum": 1,
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "maximum": 8192,
          "minimum": 1,
          "title": "Height",
          "type": "integer"
        }
      },
      "required": [
        "width",
        "height"
      ],
      "title": "MaterialLoopRasterSize",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Freeze a source-preserving native-raster normalization decision.",
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "contract_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Contract Id",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "workflow_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Workflow Id",
      "type": "string"
    },
    "dispatch_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Dispatch Id",
      "type": "string"
    },
    "session_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Session Id",
      "type": "string"
    },
    "profile_id": {
      "const": "autonomous_static_prop_v2_codex_imagegen",
      "default": "autonomous_static_prop_v2_codex_imagegen",
      "title": "Profile Id",
      "type": "string"
    },
    "provider_id": {
      "const": "codex_builtin_gpt_image_v1",
      "default": "codex_builtin_gpt_image_v1",
      "title": "Provider Id",
      "type": "string"
    },
    "input_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Sha256",
      "type": "string"
    },
    "source_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Fingerprint",
      "type": "string"
    },
    "producer": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Producer",
      "type": "string"
    },
    "producer_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Producer Version",
      "type": "string"
    },
    "provenance": {
      "items": {
        "$ref": "#/$defs/CodexImageArtifact"
      },
      "minItems": 1,
      "title": "Provenance",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "immutable": {
      "const": true,
      "default": true,
      "title": "Immutable",
      "type": "boolean"
    },
    "source_image": {
      "$ref": "#/$defs/CodexImageArtifact"
    },
    "output_path": {
      "title": "Output Path",
      "type": "string"
    },
    "source_size": {
      "$ref": "#/$defs/MaterialLoopRasterSize"
    },
    "target_size": {
      "$ref": "#/$defs/MaterialLoopRasterSize"
    },
    "native_output_policy": {
      "default": "preserve_native_then_normalize",
      "enum": [
        "exact_known_size",
        "allowed_size_set",
        "bounded_native_size",
        "preserve_native_then_normalize"
      ],
      "title": "Native Output Policy",
      "type": "string"
    },
    "allowed_native_sizes": {
      "items": {
        "$ref": "#/$defs/MaterialLoopRasterSize"
      },
      "title": "Allowed Native Sizes",
      "type": "array"
    },
    "requested_operation": {
      "enum": [
        "center_crop",
        "contain_pad",
        "tile_crop"
      ],
      "title": "Requested Operation",
      "type": "string"
    },
    "operation": {
      "enum": [
        "pass_through",
        "center_crop",
        "contain_pad",
        "tile_crop",
        "review_required"
      ],
      "title": "Operation",
      "type": "string"
    },
    "crop_rectangle": {
      "anyOf": [
        {
          "$ref": "#/$defs/ImageGenCropRectangle"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "content_size": {
      "anyOf": [
        {
          "$ref": "#/$defs/MaterialLoopRasterSize"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "padding": {
      "anyOf": [
        {
          "$ref": "#/$defs/ImageGenPadding"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "pad_rgba": {
      "default": [
        0,
        0,
        0,
        0
      ],
      "maxItems": 4,
      "minItems": 4,
      "prefixItems": [
        {
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        {
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        {
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        {
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        }
      ],
      "title": "Pad Rgba",
      "type": "array"
    },
    "source_color_space": {
      "enum": [
        "srgb",
        "non_color"
      ],
      "title": "Source Color Space",
      "type": "string"
    },
    "source_mode": {
      "maxLength": 32,
      "minLength": 1,
      "title": "Source Mode",
      "type": "string"
    },
    "source_has_alpha": {
      "title": "Source Has Alpha",
      "type": "boolean"
    },
    "source_icc_profile_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Icc Profile Sha256"
    },
    "alpha_policy": {
      "default": "preserve",
      "enum": [
        "preserve",
        "drop",
        "opaque_add"
      ],
      "title": "Alpha Policy",
      "type": "string"
    },
    "source_aspect_ratio": {
      "exclusiveMinimum": 0.0,
      "maximum": 8192.0,
      "title": "Source Aspect Ratio",
      "type": "number"
    },
    "target_aspect_ratio": {
      "exclusiveMinimum": 0.0,
      "maximum": 8192.0,
      "title": "Target Aspect Ratio",
      "type": "number"
    },
    "aspect_ratio_relative_delta": {
      "maximum": 8192.0,
      "minimum": 0.0,
      "title": "Aspect Ratio Relative Delta",
      "type": "number"
    },
    "maximum_automatic_aspect_delta": {
      "default": 0.35,
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Maximum Automatic Aspect Delta",
      "type": "number"
    },
    "algorithm_id": {
      "const": "pillow_native_normalization_v1",
      "default": "pillow_native_normalization_v1",
      "title": "Algorithm Id",
      "type": "string"
    },
    "resampling": {
      "const": "lanczos",
      "default": "lanczos",
      "title": "Resampling",
      "type": "string"
    },
    "output_media_type": {
      "enum": [
        "image/png",
        "source_media_type"
      ],
      "title": "Output Media Type",
      "type": "string"
    },
    "source_immutable": {
      "const": true,
      "default": true,
      "title": "Source Immutable",
      "type": "boolean"
    },
    "stretch_allowed": {
      "const": false,
      "default": false,
      "title": "Stretch Allowed",
      "type": "boolean"
    }
  },
  "required": [
    "contract_id",
    "job_id",
    "workflow_id",
    "dispatch_id",
    "session_id",
    "input_sha256",
    "source_fingerprint",
    "producer",
    "provenance",
    "created_at",
    "source_image",
    "output_path",
    "source_size",
    "target_size",
    "requested_operation",
    "operation",
    "source_color_space",
    "source_mode",
    "source_has_alpha",
    "source_aspect_ratio",
    "target_aspect_ratio",
    "aspect_ratio_relative_delta",
    "output_media_type"
  ],
  "title": "ImageGenNativeNormalizationPlan",
  "type": "object"
}
