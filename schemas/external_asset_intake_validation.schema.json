  "required": [
    "job_id",
    "plan_id",
    "status",
    "ok",
    "source_current",
    "dependencies_current",
    "approval_current_and_used",
    "contracts_current",
    "normalized_blend_current",
    "embedded_build_current",
    "normalization_receipt_current",
    "semantic_object_count",
    "material_count",
    "checked_at"
