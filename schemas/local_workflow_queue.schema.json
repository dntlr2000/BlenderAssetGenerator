{
  "$defs": {
    "QueueEntry": {
      "additionalProperties": false,
      "description": "Track one existing V0.8 workflow without granting new modeling authority.",
      "properties": {
        "entry_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Entry Id",
          "type": "string"
        },
        "job_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
          "title": "Job Id",
          "type": "string"
        },
        "workflow_id": {
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
          "title": "Workflow Id",
          "type": "string"
        },
        "status": {
          "default": "queued",
          "enum": [
            "queued",
            "running",
            "waiting",
            "completed",
            "failed",
            "cancelled"
          ],
          "title": "Status",
          "type": "string"
        },
        "priority": {
          "default": 50,
          "maximum": 100,
          "minimum": 0,
          "title": "Priority",
          "type": "integer"
        },
        "attempt_count": {
          "default": 0,
          "maximum": 1000,
          "minimum": 0,
          "title": "Attempt Count",
          "type": "integer"
        },
        "max_attempts": {
          "default": 3,
          "maximum": 10,
          "minimum": 1,
          "title": "Max Attempts",
          "type": "integer"
        },
        "retry_failed_once": {
          "default": false,
          "title": "Retry Failed Once",
          "type": "boolean"
        },
        "enqueued_at": {
          "format": "date-time",
          "title": "Enqueued At",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        },
        "started_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Started At"
        },
        "completed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Completed At"
        },
        "lease_id": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lease Id"
        },
        "lease_expires_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lease Expires At"
        },
        "last_workflow_status": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Workflow Status"
        },
        "last_error": {
          "anyOf": [
            {
              "maxLength": 4000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Error"
        }
      },
      "required": [
        "entry_id",
        "job_id",
        "workflow_id",
        "enqueued_at",
        "updated_at"
      ],
      "title": "QueueEntry",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Store a deterministic single-worker queue outside canonical job evidence.",
  "properties": {
    "schema_version": {
      "const": "0.9.0",
      "default": "0.9.0",
      "title": "Schema Version",
      "type": "string"
    },
    "queue_id": {
      "const": "local",
      "default": "local",
      "title": "Queue Id",
      "type": "string"
    },
    "revision": {
      "default": 0,
      "minimum": 0,
      "title": "Revision",
      "type": "integer"
    },
    "max_concurrency": {
      "const": 1,
      "default": 1,
      "title": "Max Concurrency",
      "type": "integer"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/QueueEntry"
      },
      "title": "Entries",
      "type": "array"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "updated_at"
  ],
  "title": "LocalWorkflowQueue",
  "type": "object"
}
