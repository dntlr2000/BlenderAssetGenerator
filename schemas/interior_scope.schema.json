    },
    "request": {
      "default": "",
      "title": "Request",
      "type": "string"
    },
    "allowed_semantic_prefixes": {
      "items": {
        "type": "string"
      },
      "title": "Allowed Semantic Prefixes",
      "type": "array"
    },
    "excluded_semantic_prefixes": {
      "items": {
        "type": "string"
      },
      "title": "Excluded Semantic Prefixes",
      "type": "array"
    },
    "levels": {
      "items": {
        "type": "string"
      },
      "title": "Levels",
      "type": "array"
    },
    "spaces": {
      "items": {
        "type": "string"
      },
      "title": "Spaces",
      "type": "array"
    },
    "furnishing": {
      "default": "none",
      "enum": [
        "none",
        "proxy",
        "detailed"
