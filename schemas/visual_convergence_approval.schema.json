{
  "$defs": {
    "AssemblySanityTerminalEvidence": {
      "additionalProperties": false,
      "description": "Bind one immutable five-view plan, manifest, and report terminal by exact hash.",
      "properties": {
        "run_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$",
          "title": "Run Id",
          "type": "string"
        },
        "plan_path": {
          "title": "Plan Path",
          "type": "string"
        },
        "plan_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Plan Sha256",
          "type": "string"
        },
        "render_manifest_path": {
          "title": "Render Manifest Path",
          "type": "string"
        },
        "render_manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Render Manifest Sha256",
          "type": "string"
        },
        "report_path": {
          "title": "Report Path",
          "type": "string"
        },
        "report_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Report Sha256",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "plan_path",
        "plan_sha256",
        "render_manifest_path",
        "render_manifest_sha256",
        "report_path",
        "report_sha256"
      ],
      "title": "AssemblySanityTerminalEvidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Activate exactly one bounded session by the exact serialized plan SHA-256.",
  "properties": {
    "schema_version": {
      "const": "0.6.0",
      "default": "0.6.0",
      "title": "Schema Version",
      "type": "string"
    },
    "approval_id": {
      "title": "Approval Id",
      "type": "string"
    },
    "session_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$",
      "title": "Session Id",
      "type": "string"
    },
    "job_id": {
      "title": "Job Id",
      "type": "string"
    },
    "plan_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Plan Sha256",
      "type": "string"
    },
    "input_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Fingerprint",
      "type": "string"
    },
    "initial_scene_spec_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Initial Scene Spec Sha256",
      "type": "string"
    },
    "initial_qa_report_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Initial Qa Report Sha256",
      "type": "string"
    },
    "initial_candidates_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Exact approved plan candidate hash. None is accepted only for historical status-only approvals.",
      "title": "Initial Candidates Sha256"
    },
    "initial_build_fingerprint": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Exact approved initial build fingerprint. None is accepted only for historical status-only approvals.",
      "title": "Initial Build Fingerprint"
    },
    "initial_build_provenance_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Exact approved build-provenance snapshot hash. None is accepted only for historical status-only approvals.",
      "title": "Initial Build Provenance Sha256"
    },
    "host_safety_envelope_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Exact approved host-safety-envelope hash. None is accepted only for historical status-only approvals.",
      "title": "Host Safety Envelope Sha256"
    },
    "initial_constraints_present": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Approved initial constraint-contract presence. None is accepted only for historical status-only approvals.",
      "title": "Initial Constraints Present"
    },
    "initial_constraints_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Exact approved initial constraint hash when present; otherwise null.",
      "title": "Initial Constraints Sha256"
    },
    "camera_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Camera Fingerprint",
      "type": "string"
    },
    "structural_multiview_policy": {
      "default": "not_applicable",
      "enum": [
        "not_applicable",
        "spatial_v1_required"
      ],
      "title": "Structural Multiview Policy",
      "type": "string"
    },
    "initial_structural_evidence": {
      "anyOf": [
        {
          "$ref": "#/$defs/AssemblySanityTerminalEvidence"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "authorization_scope": {
      "const": "bounded_visual_convergence",
      "default": "bounded_visual_convergence",
      "title": "Authorization Scope",
      "type": "string"
    },
    "approved_by": {
      "const": "user",
      "default": "user",
      "title": "Approved By",
      "type": "string"
    },
    "approval_note": {
      "minLength": 1,
      "title": "Approval Note",
      "type": "string"
    },
    "approved_at": {
      "title": "Approved At",
      "type": "string"
    },
    "status": {
      "const": "active",
      "default": "active",
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "approval_id",
    "session_id",
    "job_id",
    "plan_sha256",
    "input_fingerprint",
    "initial_scene_spec_sha256",
    "initial_qa_report_sha256",
    "camera_fingerprint",
    "approval_note",
    "approved_at"
  ],
  "title": "VisualConvergenceApproval",
  "type": "object"
}
