{
  "$defs": {
    "ExactArtifact": {
      "additionalProperties": false,
      "description": "Bind one contained job-relative artifact by exact bytes and media type.",
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "pattern": "^[a-z][a-z0-9_]{1,95}$",
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "byte_size": {
          "minimum": 0,
          "title": "Byte Size",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 127,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "path",
        "sha256",
        "byte_size",
        "media_type"
      ],
      "title": "ExactArtifact",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Record one structured fail-closed stop before approval and canonical writes.",
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "workflow_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Workflow Id",
      "type": "string"
    },
    "dispatch_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Dispatch Id",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Run Id",
      "type": "string"
    },
    "producer": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Producer",
      "type": "string"
    },
    "producer_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Producer Version",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "failure_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Failure Id",
      "type": "string"
    },
    "plan": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExactArtifact"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "request": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExactArtifact"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "stage": {
      "enum": [
        "canonical_rehash",
        "candidate_validation",
        "paired_diff",
        "clone_invariant",
        "shadow_build",
        "invariant_validation",
        "approval_request"
      ],
      "title": "Stage",
      "type": "string"
    },
    "code": {
      "pattern": "^[A-Z][A-Z0-9_]{2,95}$",
      "title": "Code",
      "type": "string"
    },
    "message": {
      "maxLength": 1600,
      "minLength": 1,
      "title": "Message",
      "type": "string"
    },
    "status": {
      "const": "preapproval_failed",
      "default": "preapproval_failed",
      "title": "Status",
      "type": "string"
    },
    "approval_request_created": {
      "const": false,
      "default": false,
      "title": "Approval Request Created",
      "type": "boolean"
    },
    "actual_user_approval_created": {
      "const": false,
      "default": false,
      "title": "Actual User Approval Created",
      "type": "boolean"
    },
    "approval_consumption_count": {
      "const": 0,
      "default": 0,
      "title": "Approval Consumption Count",
      "type": "integer"
    },
    "apply_intent_count": {
      "const": 0,
      "default": 0,
      "title": "Apply Intent Count",
      "type": "integer"
    },
    "canonical_write_count": {
      "const": 0,
      "default": 0,
      "title": "Canonical Write Count",
      "type": "integer"
    }
  },
  "required": [
    "job_id",
    "workflow_id",
    "dispatch_id",
    "run_id",
    "producer",
    "producer_version",
    "created_at",
    "failure_id",
    "stage",
    "code",
    "message"
  ],
  "title": "MaterialIdentitySplitPreapprovalFailure",
  "type": "object"
}
