{
  "$defs": {
    "AutonomyArtifact": {
      "additionalProperties": false,
      "description": "Bind one contained artifact to its repository-relative path and exact bytes.",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "title": "AutonomyArtifact",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Authorize one deterministic host candidate inside a session-owned directory.",
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "contract_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Contract Id",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "workflow_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Workflow Id",
      "type": "string"
    },
    "dispatch_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Dispatch Id",
      "type": "string"
    },
    "input_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Sha256",
      "type": "string"
    },
    "source_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Fingerprint",
      "type": "string"
    },
    "producer": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Producer",
      "type": "string"
    },
    "producer_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Producer Version",
      "type": "string"
    },
    "provenance": {
      "items": {
        "$ref": "#/$defs/AutonomyArtifact"
      },
      "minItems": 1,
      "title": "Provenance",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "assignment_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Assignment Id",
      "type": "string"
    },
    "session_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Session Id",
      "type": "string"
    },
    "round_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Round Id",
      "type": "string"
    },
    "candidate_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Candidate Id",
      "type": "string"
    },
    "candidate_index": {
      "maximum": 3,
      "minimum": 1,
      "title": "Candidate Index",
      "type": "integer"
    },
    "strategy": {
      "enum": [
        "faithful_v05",
        "portable_pbr_v05"
      ],
      "title": "Strategy",
      "type": "string"
    },
    "round_input": {
      "$ref": "#/$defs/AutonomyArtifact"
    },
    "output_root": {
      "title": "Output Root",
      "type": "string"
    },
    "required_outputs": {
      "items": {
        "type": "string"
      },
      "minItems": 2,
      "title": "Required Outputs",
      "type": "array"
    },
    "authoring_prompt_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Authoring Prompt Sha256",
      "type": "string"
    },
    "canonical_write_authority": {
      "const": "controller_only",
      "default": "controller_only",
      "title": "Canonical Write Authority",
      "type": "string"
    },
    "deterministic_host_write": {
      "const": true,
      "default": true,
      "title": "Deterministic Host Write",
      "type": "boolean"
    }
  },
  "required": [
    "contract_id",
    "job_id",
    "workflow_id",
    "dispatch_id",
    "input_sha256",
    "source_fingerprint",
    "producer",
    "producer_version",
    "provenance",
    "created_at",
    "assignment_id",
    "session_id",
    "round_id",
    "candidate_id",
    "candidate_index",
    "strategy",
    "round_input",
    "output_root",
    "required_outputs",
    "authoring_prompt_sha256"
  ],
  "title": "MaterialCandidateAssignment",
  "type": "object"
}
