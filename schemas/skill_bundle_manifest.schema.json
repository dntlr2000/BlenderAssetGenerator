{
  "$defs": {
    "SkillArtifact": {
      "additionalProperties": false,
      "description": "Bind one job-relative immutable artifact to its exact bytes.",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "title": "SkillArtifact",
      "type": "object"
    },
    "SkillBundleResource": {
      "additionalProperties": false,
      "description": "Record one live skill resource copied into a run-owned snapshot.",
      "properties": {
        "skill_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Skill Id",
          "type": "string"
        },
        "source_path": {
          "title": "Source Path",
          "type": "string"
        },
        "snapshot_path": {
          "title": "Snapshot Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "skill_id",
        "source_path",
        "snapshot_path",
        "sha256"
      ],
      "title": "SkillBundleResource",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Bind a top-level invocation to its exact transitive skill snapshot.",
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "bundle_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Bundle Id",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Run Id",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "entry_skill_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Entry Skill Id",
      "type": "string"
    },
    "execution_mode": {
      "enum": [
        "standard",
        "aq"
      ],
      "title": "Execution Mode",
      "type": "string"
    },
    "registry_snapshot": {
      "$ref": "#/$defs/SkillArtifact"
    },
    "skill_ids": {
      "items": {
        "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Skill Ids",
      "type": "array"
    },
    "resources": {
      "items": {
        "$ref": "#/$defs/SkillBundleResource"
      },
      "minItems": 1,
      "title": "Resources",
      "type": "array"
    },
    "canonical_write_authority": {
      "const": false,
      "default": false,
      "title": "Canonical Write Authority",
      "type": "boolean"
    },
    "approval_authority": {
      "const": false,
      "default": false,
      "title": "Approval Authority",
      "type": "boolean"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "bundle_id",
    "run_id",
    "job_id",
    "entry_skill_id",
    "execution_mode",
    "registry_snapshot",
    "skill_ids",
    "resources",
    "created_at"
  ],
  "title": "SkillBundleManifest",
  "type": "object"
}
