{
  "$defs": {
    "CandidateRankRecord": {
      "additionalProperties": false,
      "description": "Explain one deterministic candidate position in the lexicographic ordering.",
      "properties": {
        "candidate_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Candidate Id",
          "type": "string"
        },
        "rank": {
          "minimum": 1,
          "title": "Rank",
          "type": "integer"
        },
        "pareto_front": {
          "minimum": 0,
          "title": "Pareto Front",
          "type": "integer"
        },
        "selected": {
          "title": "Selected",
          "type": "boolean"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "candidate_id",
        "rank",
        "pareto_front",
        "selected",
        "reason"
      ],
      "title": "CandidateRankRecord",
      "type": "object"
    },
    "ProducerIdentity": {
      "additionalProperties": false,
      "description": "Identify the exact component and implementation version that emitted evidence.",
      "properties": {
        "name": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Name",
          "type": "string"
        },
        "version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "ProducerIdentity",
      "type": "object"
    },
    "QualityArtifact": {
      "additionalProperties": false,
      "description": "Bind one immutable quality input to its relative path and exact digest.",
      "properties": {
        "artifact_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Kind",
          "type": "string"
        },
        "relative_path": {
          "title": "Relative Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "producer": {
          "$ref": "#/$defs/ProducerIdentity"
        },
        "produced_at": {
          "format": "date-time",
          "title": "Produced At",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "relative_path",
        "sha256",
        "producer",
        "produced_at"
      ],
      "title": "QualityArtifact",
      "type": "object"
    },
    "QualityProvenance": {
      "additionalProperties": false,
      "description": "Freeze the job, workflow, dispatch, source, and exact input artifact identities.",
      "properties": {
        "job_id": {
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
          "title": "Job Id",
          "type": "string"
        },
        "workflow_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Workflow Id",
          "type": "string"
        },
        "dispatch_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Dispatch Id",
          "type": "string"
        },
        "source_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Fingerprint",
          "type": "string"
        },
        "input_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Sha256",
          "type": "string"
        },
        "artifacts": {
          "items": {
            "$ref": "#/$defs/QualityArtifact"
          },
          "minItems": 1,
          "title": "Artifacts",
          "type": "array"
        }
      },
      "required": [
        "job_id",
        "workflow_id",
        "dispatch_id",
        "source_fingerprint",
        "input_sha256",
        "artifacts"
      ],
      "title": "QualityProvenance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Preserve the complete candidate ordering without synthesizing a weighted score.",
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "ranking_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Ranking Id",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "workflow_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Workflow Id",
      "type": "string"
    },
    "dispatch_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Dispatch Id",
      "type": "string"
    },
    "input_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Sha256",
      "type": "string"
    },
    "source_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Fingerprint",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/QualityProvenance"
    },
    "producer": {
      "$ref": "#/$defs/ProducerIdentity"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "selected_candidate_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Selected Candidate Id",
      "type": "string"
    },
    "pareto_candidate_ids": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Pareto Candidate Ids",
      "type": "array"
    },
    "records": {
      "items": {
        "$ref": "#/$defs/CandidateRankRecord"
      },
      "minItems": 1,
      "title": "Records",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "ranking_id",
    "job_id",
    "workflow_id",
    "dispatch_id",
    "input_sha256",
    "source_fingerprint",
    "provenance",
    "producer",
    "created_at",
    "selected_candidate_id",
    "pareto_candidate_ids",
    "records"
  ],
  "title": "CandidateRanking",
  "type": "object"
}
