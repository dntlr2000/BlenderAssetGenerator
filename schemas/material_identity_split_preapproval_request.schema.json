{
  "$defs": {
    "ExactArtifact": {
      "additionalProperties": false,
      "description": "Bind one contained job-relative artifact by exact bytes and media type.",
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "pattern": "^[a-z][a-z0-9_]{1,95}$",
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "byte_size": {
          "minimum": 0,
          "title": "Byte Size",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 127,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "path",
        "sha256",
        "byte_size",
        "media_type"
      ],
      "title": "ExactArtifact",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Request isolated paired validation while explicitly withholding approval authority.",
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "workflow_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Workflow Id",
      "type": "string"
    },
    "dispatch_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Dispatch Id",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Run Id",
      "type": "string"
    },
    "producer": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Producer",
      "type": "string"
    },
    "producer_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Producer Version",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "request_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Request Id",
      "type": "string"
    },
    "plan": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "candidate_scene_spec": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "candidate_modeling_plan": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "scene_diff_allowlist": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "modeling_plan_diff_report": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "canonical_scene_inventory": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "shadow_root": {
      "title": "Shadow Root",
      "type": "string"
    },
    "expected_blender_version": {
      "const": "5.0.1",
      "default": "5.0.1",
      "title": "Expected Blender Version",
      "type": "string"
    },
    "approval_publication_allowed": {
      "const": false,
      "default": false,
      "title": "Approval Publication Allowed",
      "type": "boolean"
    },
    "canonical_write_allowed": {
      "const": false,
      "default": false,
      "title": "Canonical Write Allowed",
      "type": "boolean"
    }
  },
  "required": [
    "job_id",
    "workflow_id",
    "dispatch_id",
    "run_id",
    "producer",
    "producer_version",
    "created_at",
    "request_id",
    "plan",
    "candidate_scene_spec",
    "candidate_modeling_plan",
    "scene_diff_allowlist",
    "modeling_plan_diff_report",
    "canonical_scene_inventory",
    "shadow_root"
  ],
  "title": "MaterialIdentitySplitPreapprovalRequest",
  "type": "object"
}
