{
  "$defs": {
    "ArtifactFreshness": {
      "additionalProperties": false,
      "description": "Separate integrity, currency, and verification for one observed artifact.",
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z0-9][a-z0-9_.-]{0,95}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "integrity": {
          "enum": [
            "valid",
            "corrupt",
            "missing"
          ],
          "title": "Integrity",
          "type": "string"
        },
        "currency": {
          "enum": [
            "current",
            "superseded",
            "unknown"
          ],
          "title": "Currency",
          "type": "string"
        },
        "verification": {
          "enum": [
            "verified",
            "partially_verified",
            "unverified"
          ],
          "title": "Verification",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "path",
        "integrity",
        "currency",
        "verification",
        "reason"
      ],
      "title": "ArtifactFreshness",
      "type": "object"
    },
    "WorkflowStepState": {
      "additionalProperties": false,
      "description": "Track one step without mutating its immutable plan declaration.",
      "properties": {
        "step_id": {
          "pattern": "^[a-z0-9][a-z0-9_.-]{0,95}$",
          "title": "Step Id",
          "type": "string"
        },
        "status": {
          "default": "pending",
          "enum": [
            "pending",
            "ready",
            "running",
            "waiting_for_agent",
            "waiting_for_approval",
            "blocked",
            "complete",
            "stale",
            "failed",
            "cancelled"
          ],
          "title": "Status",
          "type": "string"
        },
        "input_fingerprint": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Fingerprint"
        },
        "completion_fingerprint": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Completion Fingerprint"
        },
        "attempt_count": {
          "default": 0,
          "minimum": 0,
          "title": "Attempt Count",
          "type": "integer"
        },
        "artifacts": {
          "items": {
            "$ref": "#/$defs/ArtifactFreshness"
          },
          "title": "Artifacts",
          "type": "array"
        },
        "approval_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approval Id"
        },
        "started_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Started At"
        },
        "completed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Completed At"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        }
      },
      "required": [
        "step_id"
      ],
      "title": "WorkflowStepState",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Represent reconstructed workflow progress and the next safe action.",
  "properties": {
    "schema_version": {
      "const": "0.8.0",
      "default": "0.8.0",
      "title": "Schema Version",
      "type": "string"
    },
    "workflow_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Workflow Id",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "plan_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Plan Sha256",
      "type": "string"
    },
    "request_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Request Sha256",
      "type": "string"
    },
    "status": {
      "enum": [
        "planned",
        "running",
        "waiting_for_agent",
        "waiting_for_approval",
        "blocked",
        "completed",
        "failed",
        "cancelled"
      ],
      "title": "Status",
      "type": "string"
    },
    "milestone": {
      "enum": [
        "created",
        "analyzed",
        "proxy_ready",
        "geometry_approved",
        "interior_scope_waiting",
        "interior_scope_approved",
        "material_ready",
        "qa_review",
        "portable_ready",
        "completed"
      ],
      "title": "Milestone",
      "type": "string"
    },
    "current_step_id": {
      "anyOf": [
        {
          "pattern": "^[a-z0-9][a-z0-9_.-]{0,95}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Current Step Id"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/WorkflowStepState"
      },
      "title": "Steps",
      "type": "array"
    },
    "next_action": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Next Action"
    },
    "waiting_gate": {
      "anyOf": [
        {
          "enum": [
            "proxy_geometry",
            "detailed_geometry",
            "material_swatches",
            "qa_review",
            "final_package",
            "interior_scope",
            "interior_qa_plan",
            "visual_revision",
            "optimization_plan"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Waiting Gate"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    },
    "cancelled_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cancelled Reason"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "workflow_id",
    "job_id",
    "plan_sha256",
    "request_sha256",
    "status",
    "milestone",
    "steps",
    "created_at",
    "updated_at"
  ],
  "title": "WorkflowState",
  "type": "object"
}
