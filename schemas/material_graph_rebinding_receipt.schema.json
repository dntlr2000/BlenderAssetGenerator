{
  "$defs": {
    "ExactArtifact": {
      "additionalProperties": false,
      "description": "Bind one contained job-relative artifact by exact bytes and media type.",
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "pattern": "^[a-z][a-z0-9_]{1,95}$",
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "byte_size": {
          "minimum": 0,
          "title": "Byte Size",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 127,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "path",
        "sha256",
        "byte_size",
        "media_type"
      ],
      "title": "ExactArtifact",
      "type": "object"
    },
    "MaterialClosureIssue": {
      "additionalProperties": false,
      "description": "Record one deterministic closure or preflight validation finding.",
      "properties": {
        "code": {
          "pattern": "^[A-Z][A-Z0-9_]{2,95}$",
          "title": "Code",
          "type": "string"
        },
        "message": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "entry_id": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entry Id"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "MaterialClosureIssue",
      "type": "object"
    },
    "MaterialGraphRebindingChange": {
      "additionalProperties": false,
      "description": "Describe one paired provenance path/hash replacement by JSON pointer.",
      "properties": {
        "dependency_role": {
          "pattern": "^[a-z][a-z0-9_]{1,95}$",
          "title": "Dependency Role",
          "type": "string"
        },
        "path_pointer": {
          "pattern": "^/(?:[^/~]|~[01])+(?:/(?:[^/~]|~[01])+)*$",
          "title": "Path Pointer",
          "type": "string"
        },
        "hash_pointer": {
          "pattern": "^/(?:[^/~]|~[01])+(?:/(?:[^/~]|~[01])+)*$",
          "title": "Hash Pointer",
          "type": "string"
        },
        "before_path": {
          "title": "Before Path",
          "type": "string"
        },
        "before_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Before Sha256",
          "type": "string"
        },
        "after_path": {
          "title": "After Path",
          "type": "string"
        },
        "after_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "After Sha256",
          "type": "string"
        }
      },
      "required": [
        "dependency_role",
        "path_pointer",
        "hash_pointer",
        "before_path",
        "before_sha256",
        "after_path",
        "after_sha256"
      ],
      "title": "MaterialGraphRebindingChange",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Record the exact path-only graph derivative and complete before/after diff.",
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "workflow_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Workflow Id",
      "type": "string"
    },
    "dispatch_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Dispatch Id",
      "type": "string"
    },
    "session_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Session Id",
      "type": "string"
    },
    "producer": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Producer",
      "type": "string"
    },
    "producer_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Producer Version",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "receipt_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Receipt Id",
      "type": "string"
    },
    "plan": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "source_binding": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "status": {
      "enum": [
        "passed",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "source_graph": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "rebound_graph": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExactArtifact"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "applied_changes": {
      "items": {
        "$ref": "#/$defs/MaterialGraphRebindingChange"
      },
      "title": "Applied Changes",
      "type": "array"
    },
    "unauthorized_fields": {
      "items": {
        "type": "string"
      },
      "title": "Unauthorized Fields",
      "type": "array"
    },
    "semantic_content_unchanged": {
      "title": "Semantic Content Unchanged",
      "type": "boolean"
    },
    "source_graph_unchanged": {
      "const": true,
      "default": true,
      "title": "Source Graph Unchanged",
      "type": "boolean"
    },
    "issues": {
      "items": {
        "$ref": "#/$defs/MaterialClosureIssue"
      },
      "title": "Issues",
      "type": "array"
    }
  },
  "required": [
    "job_id",
    "workflow_id",
    "dispatch_id",
    "session_id",
    "producer",
    "producer_version",
    "created_at",
    "receipt_id",
    "plan",
    "source_binding",
    "status",
    "source_graph",
    "semantic_content_unchanged"
  ],
  "title": "MaterialGraphRebindingReceipt",
  "type": "object"
}
