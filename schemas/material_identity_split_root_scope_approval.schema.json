{
  "$defs": {
    "ExactArtifact": {
      "additionalProperties": false,
      "description": "Bind one contained job-relative artifact by exact bytes and media type.",
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "pattern": "^[a-z][a-z0-9_]{1,95}$",
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "byte_size": {
          "minimum": 0,
          "title": "Byte Size",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 127,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "path",
        "sha256",
        "byte_size",
        "media_type"
      ],
      "title": "ExactArtifact",
      "type": "object"
    },
    "MaterialIdentitySplitCanonicalPreconditions": {
      "additionalProperties": false,
      "description": "Bind exact canonical bytes, absence, reference, scope, and UV preconditions.",
      "properties": {
        "scene_spec": {
          "$ref": "#/$defs/ExactArtifact"
        },
        "modeling_plan": {
          "$ref": "#/$defs/ExactArtifact"
        },
        "blend": {
          "$ref": "#/$defs/ExactArtifact"
        },
        "material_plan_absence": {
          "$ref": "#/$defs/ExactArtifact"
        },
        "root_authorization": {
          "$ref": "#/$defs/ExactArtifact"
        },
        "primary_reference": {
          "$ref": "#/$defs/ExactArtifact"
        },
        "content_scope_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Scope Sha256",
          "type": "string"
        },
        "target_subject": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Target Subject",
          "type": "string"
        },
        "uv_layout_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Uv Layout Fingerprint",
          "type": "string"
        }
      },
      "required": [
        "scene_spec",
        "modeling_plan",
        "blend",
        "material_plan_absence",
        "root_authorization",
        "primary_reference",
        "content_scope_sha256",
        "target_subject",
        "uv_layout_fingerprint"
      ],
      "title": "MaterialIdentitySplitCanonicalPreconditions",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Record one exact user decision over one narrow identity split and nothing broader.",
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "workflow_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Workflow Id",
      "type": "string"
    },
    "dispatch_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Dispatch Id",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Run Id",
      "type": "string"
    },
    "producer": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Producer",
      "type": "string"
    },
    "producer_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Producer Version",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "approval_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Approval Id",
      "type": "string"
    },
    "approval_scope": {
      "const": "material_identity_split",
      "default": "material_identity_split",
      "title": "Approval Scope",
      "type": "string"
    },
    "satisfies_required_approval": {
      "const": "root_scope",
      "default": "root_scope",
      "title": "Satisfies Required Approval",
      "type": "string"
    },
    "decision": {
      "enum": [
        "approved",
        "rejected"
      ],
      "title": "Decision",
      "type": "string"
    },
    "approved_by": {
      "const": "user",
      "default": "user",
      "title": "Approved By",
      "type": "string"
    },
    "explicit_user_decision_observed": {
      "const": true,
      "default": true,
      "title": "Explicit User Decision Observed",
      "type": "boolean"
    },
    "user_decision_text_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "User Decision Text Sha256",
      "type": "string"
    },
    "decision_observed_at": {
      "format": "date-time",
      "title": "Decision Observed At",
      "type": "string"
    },
    "approval_request": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "candidate_scene_spec": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "candidate_modeling_plan": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "scene_diff_allowlist": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "modeling_plan_diff_report": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "preapproval_report": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "shadow_build_receipt": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "invariant_report": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "preconditions": {
      "$ref": "#/$defs/MaterialIdentitySplitCanonicalPreconditions"
    },
    "single_use": {
      "const": true,
      "default": true,
      "title": "Single Use",
      "type": "boolean"
    },
    "exact_candidate_only": {
      "const": true,
      "default": true,
      "title": "Exact Candidate Only",
      "type": "boolean"
    },
    "reference_replacement_allowed": {
      "const": false,
      "default": false,
      "title": "Reference Replacement Allowed",
      "type": "boolean"
    },
    "target_subject_change_allowed": {
      "const": false,
      "default": false,
      "title": "Target Subject Change Allowed",
      "type": "boolean"
    },
    "content_scope_change_allowed": {
      "const": false,
      "default": false,
      "title": "Content Scope Change Allowed",
      "type": "boolean"
    },
    "imagegen_scope_expansion_allowed": {
      "const": false,
      "default": false,
      "title": "Imagegen Scope Expansion Allowed",
      "type": "boolean"
    },
    "object_set_change_allowed": {
      "const": false,
      "default": false,
      "title": "Object Set Change Allowed",
      "type": "boolean"
    },
    "geometry_change_allowed": {
      "const": false,
      "default": false,
      "title": "Geometry Change Allowed",
      "type": "boolean"
    },
    "uv_change_allowed": {
      "const": false,
      "default": false,
      "title": "Uv Change Allowed",
      "type": "boolean"
    },
    "material_plan_promotion_allowed": {
      "const": false,
      "default": false,
      "title": "Material Plan Promotion Allowed",
      "type": "boolean"
    },
    "package_or_destination_write_allowed": {
      "const": false,
      "default": false,
      "title": "Package Or Destination Write Allowed",
      "type": "boolean"
    }
  },
  "required": [
    "job_id",
    "workflow_id",
    "dispatch_id",
    "run_id",
    "producer",
    "producer_version",
    "created_at",
    "approval_id",
    "decision",
    "user_decision_text_sha256",
    "decision_observed_at",
    "approval_request",
    "candidate_scene_spec",
    "candidate_modeling_plan",
    "scene_diff_allowlist",
    "modeling_plan_diff_report",
    "preapproval_report",
    "shadow_build_receipt",
    "invariant_report",
    "preconditions"
  ],
  "title": "MaterialIdentitySplitRootScopeApproval",
  "type": "object"
}
