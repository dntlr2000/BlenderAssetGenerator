{
  "additionalProperties": false,
  "description": "Carry exact Standard vertices, faces, and approved loop UVs without AQ authority.",
  "properties": {
    "payload_kind": {
      "const": "standard_custom_mesh",
      "default": "standard_custom_mesh",
      "title": "Payload Kind",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Job Id",
      "type": "string"
    },
    "object_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Object Id",
      "type": "string"
    },
    "source_scene_spec_path": {
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*//)[^\\u0000]+$",
      "title": "Source Scene Spec Path",
      "type": "string"
    },
    "source_scene_spec_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Scene Spec Sha256",
      "type": "string"
    },
    "source_blend_path": {
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*//)[^\\u0000]+$",
      "title": "Source Blend Path",
      "type": "string"
    },
    "source_blend_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Blend Sha256",
      "type": "string"
    },
    "vertices": {
      "items": {
        "items": {
          "type": "number"
        },
        "maxItems": 3,
        "minItems": 3,
        "type": "array"
      },
      "minItems": 3,
      "title": "Vertices",
      "type": "array"
    },
    "faces": {
      "items": {
        "items": {
          "type": "integer"
        },
        "type": "array"
      },
      "minItems": 1,
      "title": "Faces",
      "type": "array"
    },
    "loop_uvs": {
      "items": {
        "items": {
          "type": "number"
        },
        "maxItems": 2,
        "minItems": 2,
        "type": "array"
      },
      "minItems": 3,
      "title": "Loop Uvs",
      "type": "array"
    },
    "uv_set": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Uv Set",
      "type": "string"
    },
    "source_coordinate_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Coordinate Fingerprint",
      "type": "string"
    },
    "source_vertex_uv_binding_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Vertex Uv Binding Fingerprint",
      "type": "string"
    },
    "ordered_corner_topology_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Ordered Corner Topology Sha256",
      "type": "string"
    }
  },
  "required": [
    "job_id",
    "object_id",
    "source_scene_spec_path",
    "source_scene_spec_sha256",
    "source_blend_path",
    "source_blend_sha256",
    "vertices",
    "faces",
    "loop_uvs",
    "uv_set",
    "source_coordinate_fingerprint",
    "source_vertex_uv_binding_fingerprint",
    "ordered_corner_topology_sha256"
  ],
  "title": "StandardCustomMeshPayload",
  "type": "object"
}
