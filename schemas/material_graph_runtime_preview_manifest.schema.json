{
  "additionalProperties": false,
  "description": "Keep neutral and reference-matched preview evidence explicitly separate.",
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "preview_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Preview Id",
      "type": "string"
    },
    "graph_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Graph Id",
      "type": "string"
    },
    "scope": {
      "enum": [
        "neutral_studio",
        "reference_matched"
      ],
      "title": "Scope",
      "type": "string"
    },
    "rendered": {
      "title": "Rendered",
      "type": "boolean"
    },
    "image_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Image Path"
    },
    "image_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Image Sha256"
    },
    "source_reference_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Reference Path"
    },
    "source_reference_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Reference Sha256"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    }
  },
  "required": [
    "preview_id",
    "graph_id",
    "scope",
    "rendered"
  ],
  "title": "MaterialPreviewManifest",
  "type": "object"
}
