{
  "additionalProperties": false,
  "description": "Record one exact generic workflow-gate approval without authorizing future gates.",
  "properties": {
    "schema_version": {
      "const": "0.8.0",
      "default": "0.8.0",
      "title": "Schema Version",
      "type": "string"
    },
    "approval_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Approval Id",
      "type": "string"
    },
    "workflow_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Workflow Id",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "step_id": {
      "pattern": "^[a-z0-9][a-z0-9_.-]{0,95}$",
      "title": "Step Id",
      "type": "string"
    },
    "gate": {
      "enum": [
        "proxy_geometry",
        "detailed_geometry",
        "material_swatches",
        "qa_review",
        "final_package"
      ],
      "title": "Gate",
      "type": "string"
    },
    "plan_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Plan Sha256",
      "type": "string"
    },
    "artifact_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Artifact Fingerprint",
      "type": "string"
    },
    "approval_note": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Approval Note",
      "type": "string"
    },
    "approved_at": {
      "format": "date-time",
      "title": "Approved At",
      "type": "string"
    },
    "status": {
      "const": "approved",
      "default": "approved",
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "approval_id",
    "workflow_id",
    "job_id",
    "step_id",
    "gate",
    "plan_sha256",
    "artifact_fingerprint",
    "approval_note",
    "approved_at"
  ],
  "title": "WorkflowApproval",
  "type": "object"
}
