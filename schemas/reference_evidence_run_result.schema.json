{
  "$defs": {
    "EvidenceArtifact": {
      "additionalProperties": false,
      "description": "Bind one job-relative evidence artifact to its exact bytes.",
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "media_type": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "byte_size": {
          "minimum": 0,
          "title": "Byte Size",
          "type": "integer"
        }
      },
      "required": [
        "artifact_id",
        "path",
        "sha256",
        "media_type",
        "byte_size"
      ],
      "title": "EvidenceArtifact",
      "type": "object"
    },
    "EvidenceProvenance": {
      "additionalProperties": false,
      "description": "Identify the exact deterministic producer and method for one evidence artifact.",
      "properties": {
        "producer": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Producer",
          "type": "string"
        },
        "producer_version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Producer Version",
          "type": "string"
        },
        "provider": {
          "enum": [
            "pillow",
            "opencv",
            "mixed",
            "advisory"
          ],
          "title": "Provider",
          "type": "string"
        },
        "method": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Method",
          "type": "string"
        },
        "deterministic": {
          "title": "Deterministic",
          "type": "boolean"
        },
        "advisory_only": {
          "default": false,
          "title": "Advisory Only",
          "type": "boolean"
        },
        "parameters": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "string"
              }
            ]
          },
          "title": "Parameters",
          "type": "object"
        }
      },
      "required": [
        "producer",
        "producer_version",
        "provider",
        "method",
        "deterministic"
      ],
      "title": "EvidenceProvenance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Return exact output paths and hashes from one immutable evidence run.",
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Run Id",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "workflow_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Workflow Id",
      "type": "string"
    },
    "dispatch_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Dispatch Id",
      "type": "string"
    },
    "input_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Sha256",
      "type": "string"
    },
    "source_image": {
      "$ref": "#/$defs/EvidenceArtifact"
    },
    "reference_evidence_path": {
      "title": "Reference Evidence Path",
      "type": "string"
    },
    "reference_evidence_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Reference Evidence Sha256",
      "type": "string"
    },
    "camera_hypothesis_set_path": {
      "title": "Camera Hypothesis Set Path",
      "type": "string"
    },
    "camera_hypothesis_set_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Camera Hypothesis Set Sha256",
      "type": "string"
    },
    "summary_path": {
      "title": "Summary Path",
      "type": "string"
    },
    "summary_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Summary Sha256",
      "type": "string"
    },
    "source_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Fingerprint",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/EvidenceProvenance"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "job_id",
    "workflow_id",
    "dispatch_id",
    "input_sha256",
    "source_image",
    "reference_evidence_path",
    "reference_evidence_sha256",
    "camera_hypothesis_set_path",
    "camera_hypothesis_set_sha256",
    "summary_path",
    "summary_sha256",
    "source_fingerprint",
    "provenance",
    "created_at"
  ],
  "title": "ReferenceEvidenceRunResult",
  "type": "object"
}
