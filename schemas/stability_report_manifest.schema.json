{
  "$defs": {
    "StabilityReportSource": {
      "additionalProperties": false,
      "description": "Record one authoritative V0.9 JSON source represented in a PDF report.",
      "properties": {
        "kind": {
          "enum": [
            "environment_probe",
            "workspace_audit"
          ],
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "path",
        "sha256",
        "size_bytes"
      ],
      "title": "StabilityReportSource",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Bind one derived V0.9 PDF to exact privacy-safe machine evidence.",
  "properties": {
    "schema_version": {
      "const": "0.9.0",
      "default": "0.9.0",
      "title": "Schema Version",
      "type": "string"
    },
    "report_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Report Id",
      "type": "string"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "pdf_path": {
      "title": "Pdf Path",
      "type": "string"
    },
    "pdf_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Pdf Sha256",
      "type": "string"
    },
    "source_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Fingerprint",
      "type": "string"
    },
    "font": {
      "maxLength": 260,
      "minLength": 1,
      "title": "Font",
      "type": "string"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/StabilityReportSource"
      },
      "maxItems": 2,
      "minItems": 2,
      "title": "Sources",
      "type": "array"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "report_id",
    "generated_at",
    "pdf_path",
    "pdf_sha256",
    "source_fingerprint",
    "font",
    "sources"
  ],
  "title": "StabilityReportManifest",
  "type": "object"
}
