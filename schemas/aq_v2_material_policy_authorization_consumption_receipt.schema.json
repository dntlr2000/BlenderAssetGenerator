{
  "$defs": {
    "ApprovalArtifact": {
      "additionalProperties": false,
      "description": "Bind one non-empty job-contained artifact to a normalized path and exact bytes.",
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "byte_size": {
          "exclusiveMinimum": 0,
          "title": "Byte Size",
          "type": "integer"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "path",
        "sha256",
        "byte_size"
      ],
      "title": "ApprovalArtifact",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Bind one material controller request to an exact unused AQ policy authority.",
  "properties": {
    "schema_version": {
      "const": "0.3.0",
      "default": "0.3.0",
      "title": "Schema Version",
      "type": "string"
    },
    "contract_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Contract Id",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "workflow_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Workflow Id",
      "type": "string"
    },
    "dispatch_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Dispatch Id",
      "type": "string"
    },
    "session_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Session Id",
      "type": "string"
    },
    "root_authorization": {
      "$ref": "#/$defs/ApprovalArtifact"
    },
    "producer": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Producer",
      "type": "string"
    },
    "producer_version": {
      "const": "0.3.0",
      "default": "0.3.0",
      "title": "Producer Version",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "approval_count_effect": {
      "enum": [
        "reduces",
        "maintains",
        "increases"
      ],
      "title": "Approval Count Effect",
      "type": "string"
    },
    "approval_count_justification": {
      "maxLength": 1200,
      "minLength": 1,
      "title": "Approval Count Justification",
      "type": "string"
    },
    "receipt_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Receipt Id",
      "type": "string"
    },
    "policy_profile": {
      "$ref": "#/$defs/ApprovalArtifact"
    },
    "approval_envelope": {
      "$ref": "#/$defs/ApprovalArtifact"
    },
    "approval_budget": {
      "$ref": "#/$defs/ApprovalArtifact"
    },
    "policy_authorization": {
      "$ref": "#/$defs/ApprovalArtifact"
    },
    "material_policy_boundary": {
      "$ref": "#/$defs/ApprovalArtifact"
    },
    "controller_request": {
      "$ref": "#/$defs/ApprovalArtifact"
    },
    "candidate_material_plan_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Candidate Material Plan Sha256",
      "type": "string"
    },
    "rebound_material_graph_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Rebound Material Graph Sha256",
      "type": "string"
    },
    "closure_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Closure Sha256",
      "type": "string"
    },
    "preflight_report_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Preflight Report Sha256",
      "type": "string"
    },
    "neutral_preview_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Neutral Preview Sha256",
      "type": "string"
    },
    "gate_kind": {
      "const": "material_candidate_promotion",
      "default": "material_candidate_promotion",
      "title": "Gate Kind",
      "type": "string"
    },
    "consumption_ordinal": {
      "const": 1,
      "default": 1,
      "title": "Consumption Ordinal",
      "type": "integer"
    },
    "consumed_once": {
      "const": true,
      "default": true,
      "title": "Consumed Once",
      "type": "boolean"
    },
    "is_user_approval": {
      "const": false,
      "default": false,
      "title": "Is User Approval",
      "type": "boolean"
    },
    "approved_by_user": {
      "const": false,
      "default": false,
      "title": "Approved By User",
      "type": "boolean"
    },
    "user_approval_created": {
      "const": false,
      "default": false,
      "title": "User Approval Created",
      "type": "boolean"
    }
  },
  "required": [
    "contract_id",
    "job_id",
    "workflow_id",
    "dispatch_id",
    "session_id",
    "root_authorization",
    "producer",
    "created_at",
    "approval_count_effect",
    "approval_count_justification",
    "receipt_id",
    "policy_profile",
    "approval_envelope",
    "approval_budget",
    "policy_authorization",
    "material_policy_boundary",
    "controller_request",
    "candidate_material_plan_sha256",
    "rebound_material_graph_sha256",
    "closure_sha256",
    "preflight_report_sha256",
    "neutral_preview_sha256"
  ],
  "title": "MaterialPolicyAuthorizationConsumptionReceiptV03",
  "type": "object"
}
