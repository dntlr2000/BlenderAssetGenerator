{
  "$defs": {
    "ExactArtifact": {
      "additionalProperties": false,
      "description": "Bind one contained job-relative artifact by exact bytes and media type.",
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "pattern": "^[a-z][a-z0-9_]{1,95}$",
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "byte_size": {
          "minimum": 0,
          "title": "Byte Size",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 127,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "path",
        "sha256",
        "byte_size",
        "media_type"
      ],
      "title": "ExactArtifact",
      "type": "object"
    },
    "IncidentStateDiscrepancy": {
      "additionalProperties": false,
      "description": "Record one non-destructive difference between reported and observed incident state.",
      "properties": {
        "field": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Field",
          "type": "string"
        },
        "reported_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reported Value"
        },
        "observed_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Observed Value"
        },
        "observed_evidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExactArtifact"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "significance": {
          "enum": [
            "informational",
            "material",
            "blocking"
          ],
          "title": "Significance",
          "type": "string"
        }
      },
      "required": [
        "field",
        "reported_value",
        "observed_value",
        "significance"
      ],
      "title": "IncidentStateDiscrepancy",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Preserve reported incident facts while selecting only hash-verified current state.",
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "workflow_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Workflow Id",
      "type": "string"
    },
    "dispatch_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Dispatch Id",
      "type": "string"
    },
    "session_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Session Id",
      "type": "string"
    },
    "producer": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Producer",
      "type": "string"
    },
    "producer_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Producer Version",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "report_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Report Id",
      "type": "string"
    },
    "reported_state_source": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExactArtifact"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "observed_state": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "discrepancies": {
      "items": {
        "$ref": "#/$defs/IncidentStateDiscrepancy"
      },
      "minItems": 1,
      "title": "Discrepancies",
      "type": "array"
    },
    "historical_evidence_unchanged": {
      "const": true,
      "default": true,
      "title": "Historical Evidence Unchanged",
      "type": "boolean"
    },
    "pending_retry_executed": {
      "const": false,
      "default": false,
      "title": "Pending Retry Executed",
      "type": "boolean"
    },
    "basis": {
      "const": "latest_hash_verified_observation",
      "default": "latest_hash_verified_observation",
      "title": "Basis",
      "type": "string"
    },
    "has_blocking_discrepancy": {
      "title": "Has Blocking Discrepancy",
      "type": "boolean"
    }
  },
  "required": [
    "job_id",
    "workflow_id",
    "dispatch_id",
    "session_id",
    "producer",
    "producer_version",
    "created_at",
    "report_id",
    "observed_state",
    "discrepancies",
    "has_blocking_discrepancy"
  ],
  "title": "IncidentStateDiscrepancyReport",
  "type": "object"
}
