{
  "$defs": {
    "AQV2Artifact": {
      "additionalProperties": false,
      "description": "Bind one immutable job-contained artifact to exact bytes and role.",
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "byte_size": {
          "exclusiveMinimum": 0,
          "title": "Byte Size",
          "type": "integer"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "path",
        "sha256",
        "byte_size"
      ],
      "title": "AQV2Artifact",
      "type": "object"
    },
    "BudgetUsageV2": {
      "additionalProperties": false,
      "description": "Count consumed AQ v2 work without mutating the immutable budget.",
      "properties": {
        "initial_candidates": {
          "default": 0,
          "minimum": 0,
          "title": "Initial Candidates",
          "type": "integer"
        },
        "structural_rounds": {
          "default": 0,
          "minimum": 0,
          "title": "Structural Rounds",
          "type": "integer"
        },
        "parametric_convergence_iterations": {
          "default": 0,
          "minimum": 0,
          "title": "Parametric Convergence Iterations",
          "type": "integer"
        },
        "material_rounds": {
          "default": 0,
          "minimum": 0,
          "title": "Material Rounds",
          "type": "integer"
        },
        "total_blender_builds": {
          "default": 0,
          "minimum": 0,
          "title": "Total Blender Builds",
          "type": "integer"
        },
        "total_quality_evaluations": {
          "default": 0,
          "minimum": 0,
          "title": "Total Quality Evaluations",
          "type": "integer"
        },
        "controller_invocations": {
          "default": 0,
          "minimum": 0,
          "title": "Controller Invocations",
          "type": "integer"
        },
        "delivery_runs": {
          "default": 0,
          "minimum": 0,
          "title": "Delivery Runs",
          "type": "integer"
        },
        "canonical_promotions": {
          "default": 0,
          "minimum": 0,
          "title": "Canonical Promotions",
          "type": "integer"
        },
        "package_repairs": {
          "default": 0,
          "minimum": 0,
          "title": "Package Repairs",
          "type": "integer"
        },
        "total_actions": {
          "default": 0,
          "minimum": 0,
          "title": "Total Actions",
          "type": "integer"
        }
      },
      "title": "BudgetUsageV2",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Bind successful host promotion to immutable rebuild and compile snapshots.",
  "properties": {
    "schema_version": {
      "const": "0.2.0",
      "default": "0.2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "contract_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Contract Id",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "workflow_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Workflow Id",
      "type": "string"
    },
    "dispatch_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Dispatch Id",
      "type": "string"
    },
    "session_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Session Id",
      "type": "string"
    },
    "input_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Sha256",
      "type": "string"
    },
    "source_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Fingerprint",
      "type": "string"
    },
    "producer": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Producer",
      "type": "string"
    },
    "producer_version": {
      "const": "0.2.0",
      "default": "0.2.0",
      "title": "Producer Version",
      "type": "string"
    },
    "provenance": {
      "items": {
        "$ref": "#/$defs/AQV2Artifact"
      },
      "minItems": 1,
      "title": "Provenance",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "receipt_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Receipt Id",
      "type": "string"
    },
    "status": {
      "const": "promoted",
      "default": "promoted",
      "title": "Status",
      "type": "string"
    },
    "promotion_intent": {
      "$ref": "#/$defs/AQV2Artifact"
    },
    "controller_result": {
      "$ref": "#/$defs/AQV2Artifact"
    },
    "material_plan_candidate": {
      "$ref": "#/$defs/AQV2Artifact"
    },
    "material_graph_spec": {
      "$ref": "#/$defs/AQV2Artifact"
    },
    "material_validation": {
      "$ref": "#/$defs/AQV2Artifact"
    },
    "graph_compile_report": {
      "$ref": "#/$defs/AQV2Artifact"
    },
    "archived_material_plan": {
      "anyOf": [
        {
          "$ref": "#/$defs/AQV2Artifact"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "canonical_material_snapshot": {
      "$ref": "#/$defs/AQV2Artifact"
    },
    "canonical_scene_snapshot": {
      "$ref": "#/$defs/AQV2Artifact"
    },
    "authoring_blend_snapshot": {
      "$ref": "#/$defs/AQV2Artifact"
    },
    "scene_inventory_snapshot": {
      "$ref": "#/$defs/AQV2Artifact"
    },
    "scene_validation_snapshot": {
      "$ref": "#/$defs/AQV2Artifact"
    },
    "build_provenance_snapshot": {
      "$ref": "#/$defs/AQV2Artifact"
    },
    "previous_canonical_material_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Previous Canonical Material Sha256"
    },
    "canonical_material_plan_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Canonical Material Plan Sha256",
      "type": "string"
    },
    "canonical_scene_spec_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Canonical Scene Spec Sha256",
      "type": "string"
    },
    "build_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Build Fingerprint",
      "type": "string"
    },
    "budget_usage_after": {
      "$ref": "#/$defs/BudgetUsageV2"
    },
    "primary_object_only_validated": {
      "const": true,
      "default": true,
      "title": "Primary Object Only Validated",
      "type": "boolean"
    },
    "canonical_scene_unchanged": {
      "const": true,
      "default": true,
      "title": "Canonical Scene Unchanged",
      "type": "boolean"
    },
    "canonical_write_authority": {
      "const": "supervisor_only",
      "default": "supervisor_only",
      "title": "Canonical Write Authority",
      "type": "string"
    }
  },
  "required": [
    "contract_id",
    "job_id",
    "workflow_id",
    "dispatch_id",
    "session_id",
    "input_sha256",
    "source_fingerprint",
    "producer",
    "provenance",
    "created_at",
    "receipt_id",
    "promotion_intent",
    "controller_result",
    "material_plan_candidate",
    "material_graph_spec",
    "material_validation",
    "graph_compile_report",
    "canonical_material_snapshot",
    "canonical_scene_snapshot",
    "authoring_blend_snapshot",
    "scene_inventory_snapshot",
    "scene_validation_snapshot",
    "build_provenance_snapshot",
    "canonical_material_plan_sha256",
    "canonical_scene_spec_sha256",
    "build_fingerprint",
    "budget_usage_after"
  ],
  "title": "MaterialPhaseReceiptV2",
  "type": "object"
}
