{
  "$defs": {
    "AutonomyArtifact": {
      "additionalProperties": false,
      "description": "Bind one contained artifact to its repository-relative path and exact bytes.",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "title": "AutonomyArtifact",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Describe a non-production bundle containing the best reviewable candidate.",
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "contract_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Contract Id",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "workflow_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Workflow Id",
      "type": "string"
    },
    "dispatch_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Dispatch Id",
      "type": "string"
    },
    "input_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Sha256",
      "type": "string"
    },
    "source_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Fingerprint",
      "type": "string"
    },
    "producer": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Producer",
      "type": "string"
    },
    "producer_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Producer Version",
      "type": "string"
    },
    "provenance": {
      "items": {
        "$ref": "#/$defs/AutonomyArtifact"
      },
      "minItems": 1,
      "title": "Provenance",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "bundle_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Bundle Id",
      "type": "string"
    },
    "session_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Session Id",
      "type": "string"
    },
    "status": {
      "const": "review_only",
      "default": "review_only",
      "title": "Status",
      "type": "string"
    },
    "production_ready": {
      "const": false,
      "default": false,
      "title": "Production Ready",
      "type": "boolean"
    },
    "destination_handoff_eligible": {
      "const": false,
      "default": false,
      "title": "Destination Handoff Eligible",
      "type": "boolean"
    },
    "best_candidate_blend": {
      "$ref": "#/$defs/AutonomyArtifact"
    },
    "preview_glb": {
      "$ref": "#/$defs/AutonomyArtifact"
    },
    "representative_renders": {
      "items": {
        "$ref": "#/$defs/AutonomyArtifact"
      },
      "minItems": 1,
      "title": "Representative Renders",
      "type": "array"
    },
    "integrated_quality_report": {
      "$ref": "#/$defs/AutonomyArtifact"
    },
    "unresolved_findings": {
      "$ref": "#/$defs/AutonomyArtifact"
    },
    "iteration_history": {
      "$ref": "#/$defs/AutonomyArtifact"
    },
    "candidate_comparison": {
      "$ref": "#/$defs/AutonomyArtifact"
    },
    "next_manual_actions": {
      "$ref": "#/$defs/AutonomyArtifact"
    },
    "termination_reason": {
      "enum": [
        "quality_target_reached",
        "plateau",
        "duplicate_candidate_state",
        "oscillation_detected",
        "no_eligible_candidates",
        "structural_budget_exhausted",
        "parametric_budget_exhausted",
        "material_budget_exhausted",
        "package_repair_budget_exhausted",
        "global_budget_exhausted",
        "repeated_failure",
        "structural_regression",
        "constraint_regression",
        "unscorable_evidence",
        "restricted_scope_required",
        "stale_or_tampered",
        "cancelled",
        "host_failure",
        "completed_review_bundle"
      ],
      "title": "Termination Reason",
      "type": "string"
    },
    "pdf": {
      "$ref": "#/$defs/AutonomyArtifact"
    },
    "pdf_sidecar": {
      "$ref": "#/$defs/AutonomyArtifact"
    }
  },
  "required": [
    "contract_id",
    "job_id",
    "workflow_id",
    "dispatch_id",
    "input_sha256",
    "source_fingerprint",
    "producer",
    "producer_version",
    "provenance",
    "created_at",
    "bundle_id",
    "session_id",
    "best_candidate_blend",
    "preview_glb",
    "representative_renders",
    "integrated_quality_report",
    "unresolved_findings",
    "iteration_history",
    "candidate_comparison",
    "next_manual_actions",
    "termination_reason",
    "pdf",
    "pdf_sidecar"
  ],
  "title": "ReviewBundleManifest",
  "type": "object"
}
