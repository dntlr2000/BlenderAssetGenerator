{
  "$defs": {
    "AutonomyArtifact": {
      "additionalProperties": false,
      "description": "Bind one contained artifact to its repository-relative path and exact bytes.",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "title": "AutonomyArtifact",
      "type": "object"
    },
    "CandidateMetricVector": {
      "additionalProperties": false,
      "description": "Preserve comparable multi-axis candidate evidence without one canonical score.",
      "properties": {
        "hard_gate_failures": {
          "minimum": 0,
          "title": "Hard Gate Failures",
          "type": "integer"
        },
        "critical_regressions": {
          "minimum": 0,
          "title": "Critical Regressions",
          "type": "integer"
        },
        "reference_fidelity": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference Fidelity"
        },
        "silhouette_iou": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Silhouette Iou"
        },
        "structural_quality": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Structural Quality"
        },
        "material_quality": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Material Quality"
        },
        "production_quality": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Production Quality"
        },
        "change_magnitude": {
          "minimum": 0,
          "title": "Change Magnitude",
          "type": "number"
        }
      },
      "required": [
        "hard_gate_failures",
        "critical_regressions",
        "change_magnitude"
      ],
      "title": "CandidateMetricVector",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Record immutable lexicographic/Pareto evidence for one candidate.",
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "contract_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Contract Id",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "workflow_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Workflow Id",
      "type": "string"
    },
    "dispatch_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Dispatch Id",
      "type": "string"
    },
    "input_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Sha256",
      "type": "string"
    },
    "source_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Fingerprint",
      "type": "string"
    },
    "producer": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Producer",
      "type": "string"
    },
    "producer_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Producer Version",
      "type": "string"
    },
    "provenance": {
      "items": {
        "$ref": "#/$defs/AutonomyArtifact"
      },
      "minItems": 1,
      "title": "Provenance",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "evaluation_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Evaluation Id",
      "type": "string"
    },
    "candidate_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Candidate Id",
      "type": "string"
    },
    "candidate_manifest": {
      "$ref": "#/$defs/AutonomyArtifact"
    },
    "baseline_evaluation": {
      "anyOf": [
        {
          "$ref": "#/$defs/AutonomyArtifact"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "scene_spec_v03_candidate": {
      "anyOf": [
        {
          "$ref": "#/$defs/AutonomyArtifact"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "compiled_scene_spec_candidate": {
      "anyOf": [
        {
          "$ref": "#/$defs/AutonomyArtifact"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "structural_recipes": {
      "items": {
        "$ref": "#/$defs/AutonomyArtifact"
      },
      "title": "Structural Recipes",
      "type": "array"
    },
    "structural_mesh_payloads": {
      "items": {
        "$ref": "#/$defs/AutonomyArtifact"
      },
      "title": "Structural Mesh Payloads",
      "type": "array"
    },
    "structural_materialization_receipts": {
      "items": {
        "$ref": "#/$defs/AutonomyArtifact"
      },
      "title": "Structural Materialization Receipts",
      "type": "array"
    },
    "metrics": {
      "$ref": "#/$defs/CandidateMetricVector"
    },
    "evidence_status": {
      "enum": [
        "scored",
        "unscorable",
        "invalid"
      ],
      "title": "Evidence Status",
      "type": "string"
    },
    "minimum_meaningful_gain": {
      "default": 0.001,
      "exclusiveMinimum": 0,
      "maximum": 1,
      "title": "Minimum Meaningful Gain",
      "type": "number"
    },
    "eligible_for_promotion": {
      "title": "Eligible For Promotion",
      "type": "boolean"
    },
    "ranking_reasons": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Ranking Reasons",
      "type": "array"
    },
    "regression_findings": {
      "items": {
        "type": "string"
      },
      "title": "Regression Findings",
      "type": "array"
    }
  },
  "required": [
    "contract_id",
    "job_id",
    "workflow_id",
    "dispatch_id",
    "input_sha256",
    "source_fingerprint",
    "producer",
    "producer_version",
    "provenance",
    "created_at",
    "evaluation_id",
    "candidate_id",
    "candidate_manifest",
    "metrics",
    "evidence_status",
    "eligible_for_promotion",
    "ranking_reasons"
  ],
  "title": "CandidateEvaluation",
  "type": "object"
}
