{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Validation Report",
  "type": "object",
  "required": ["ok", "errors", "warnings", "metrics"],
  "properties": {
    "ok": {"type": "boolean"},
    "errors": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "metrics": {"type": "object"}
  }
}
