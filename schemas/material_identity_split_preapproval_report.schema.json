{
  "$defs": {
    "ExactArtifact": {
      "additionalProperties": false,
      "description": "Bind one contained job-relative artifact by exact bytes and media type.",
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "pattern": "^[a-z][a-z0-9_]{1,95}$",
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "byte_size": {
          "minimum": 0,
          "title": "Byte Size",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 127,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "path",
        "sha256",
        "byte_size",
        "media_type"
      ],
      "title": "ExactArtifact",
      "type": "object"
    },
    "MaterialIdentitySplitCheck": {
      "additionalProperties": false,
      "description": "Record one deterministic preapproval or invariant check result.",
      "properties": {
        "check_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Check Id",
          "type": "string"
        },
        "category": {
          "enum": [
            "canonical",
            "candidate",
            "diff",
            "clone",
            "assignment",
            "blender",
            "geometry",
            "topology",
            "transform",
            "uv",
            "reference"
          ],
          "title": "Category",
          "type": "string"
        },
        "status": {
          "enum": [
            "passed",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "message": {
          "maxLength": 1200,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "check_id",
        "category",
        "status",
        "message"
      ],
      "title": "MaterialIdentitySplitCheck",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Aggregate strict paired validation without representing user approval.",
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "workflow_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Workflow Id",
      "type": "string"
    },
    "dispatch_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Dispatch Id",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Run Id",
      "type": "string"
    },
    "producer": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Producer",
      "type": "string"
    },
    "producer_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Producer Version",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "report_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Report Id",
      "type": "string"
    },
    "request": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "status": {
      "enum": [
        "passed",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "checks": {
      "items": {
        "$ref": "#/$defs/MaterialIdentitySplitCheck"
      },
      "minItems": 1,
      "title": "Checks",
      "type": "array"
    },
    "shadow_build_receipt": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExactArtifact"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "invariant_report": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExactArtifact"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "approval_request_eligible": {
      "title": "Approval Request Eligible",
      "type": "boolean"
    },
    "actual_user_approval_created": {
      "const": false,
      "default": false,
      "title": "Actual User Approval Created",
      "type": "boolean"
    },
    "approval_consumption_count": {
      "const": 0,
      "default": 0,
      "title": "Approval Consumption Count",
      "type": "integer"
    },
    "apply_intent_count": {
      "const": 0,
      "default": 0,
      "title": "Apply Intent Count",
      "type": "integer"
    },
    "canonical_write_count": {
      "const": 0,
      "default": 0,
      "title": "Canonical Write Count",
      "type": "integer"
    },
    "repair_session_count": {
      "const": 0,
      "default": 0,
      "title": "Repair Session Count",
      "type": "integer"
    },
    "controller_count": {
      "const": 0,
      "default": 0,
      "title": "Controller Count",
      "type": "integer"
    },
    "promotion_count": {
      "const": 0,
      "default": 0,
      "title": "Promotion Count",
      "type": "integer"
    },
    "iq_count": {
      "const": 0,
      "default": 0,
      "title": "Iq Count",
      "type": "integer"
    },
    "package_count": {
      "const": 0,
      "default": 0,
      "title": "Package Count",
      "type": "integer"
    },
    "destination_write_count": {
      "const": 0,
      "default": 0,
      "title": "Destination Write Count",
      "type": "integer"
    }
  },
  "required": [
    "job_id",
    "workflow_id",
    "dispatch_id",
    "run_id",
    "producer",
    "producer_version",
    "created_at",
    "report_id",
    "request",
    "status",
    "checks",
    "approval_request_eligible"
  ],
  "title": "MaterialIdentitySplitPreapprovalReport",
  "type": "object"
}
