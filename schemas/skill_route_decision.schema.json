{
  "$defs": {
    "SkillArtifact": {
      "additionalProperties": false,
      "description": "Bind one job-relative immutable artifact to its exact bytes.",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "title": "SkillArtifact",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Select one snapshotted stage skill from an exact underlying state.",
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "decision_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Decision Id",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Run Id",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "execution_mode": {
      "enum": [
        "standard",
        "aq"
      ],
      "title": "Execution Mode",
      "type": "string"
    },
    "stage_key": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Stage Key",
      "type": "string"
    },
    "selected_skill_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Selected Skill Id",
      "type": "string"
    },
    "bundle_manifest": {
      "$ref": "#/$defs/SkillArtifact"
    },
    "source_state": {
      "$ref": "#/$defs/SkillArtifact"
    },
    "reason": {
      "maxLength": 1000,
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "canonical_write_authority": {
      "const": false,
      "default": false,
      "title": "Canonical Write Authority",
      "type": "boolean"
    },
    "approval_authority": {
      "const": false,
      "default": false,
      "title": "Approval Authority",
      "type": "boolean"
    },
    "decided_at": {
      "format": "date-time",
      "title": "Decided At",
      "type": "string"
    }
  },
  "required": [
    "decision_id",
    "run_id",
    "job_id",
    "execution_mode",
    "stage_key",
    "selected_skill_id",
    "bundle_manifest",
    "source_state",
    "reason",
    "decided_at"
  ],
  "title": "SkillRouteDecision",
  "type": "object"
}
