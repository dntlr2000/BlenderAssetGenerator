{
  "$defs": {
    "ActivationArtifact": {
      "additionalProperties": false,
      "description": "Bind one repository-contained activation artifact to exact immutable bytes.",
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "byte_size": {
          "exclusiveMinimum": 0,
          "title": "Byte Size",
          "type": "integer"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "path",
        "sha256",
        "byte_size"
      ],
      "title": "ActivationArtifact",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Record only the user's exact mandate decision, never acceptance of future artwork.",
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "contract": {
      "$ref": "#/$defs/ActivationArtifact"
    },
    "decision": {
      "const": "approve",
      "default": "approve",
      "title": "Decision",
      "type": "string"
    },
    "exact_user_text": {
      "maxLength": 32768,
      "minLength": 1,
      "title": "Exact User Text",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "future_artifacts_user_approved": {
      "const": false,
      "default": false,
      "title": "Future Artifacts User Approved",
      "type": "boolean"
    }
  },
  "required": [
    "contract",
    "exact_user_text",
    "created_at"
  ],
  "title": "DelegationDecisionV01",
  "type": "object"
}
