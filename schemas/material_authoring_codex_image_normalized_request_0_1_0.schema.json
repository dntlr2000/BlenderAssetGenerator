      "default": "0.1.0",
      "title": "Producer Version",
      "type": "string"
    },
    "provenance": {
      "items": {
        "$ref": "#/$defs/CodexImageArtifact"
      },
      "minItems": 1,
      "title": "Provenance",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "immutable": {
      "const": true,
      "default": true,
      "title": "Immutable",
      "type": "boolean"
    },
    "base_request": {
      "$ref": "#/$defs/CodexImageMaterialAuthoringRequestV021"
    },
    "base_request_artifact": {
      "$ref": "#/$defs/CodexImageArtifact"
    },
    "normalization_plan": {
      "$ref": "#/$defs/CodexImageArtifact"
    },
    "normalization_receipt": {
      "$ref": "#/$defs/CodexImageArtifact"
    },
    "effective_source": {
      "$ref": "#/$defs/CodexImageMaterialSourceV021"
    },
    "run_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Run Id",
      "type": "string"
    },
    "output_root": {
      "title": "Output Root",
      "type": "string"
    },
    "canonical_write_authority": {
      "const": false,
      "default": false,
      "title": "Canonical Write Authority",
      "type": "boolean"
    },
    "destination_write_authority": {
      "const": false,
      "default": false,
      "title": "Destination Write Authority",
      "type": "boolean"
    }
  },
  "required": [
    "contract_id",
    "job_id",
    "workflow_id",
    "dispatch_id",
    "session_id",
    "input_sha256",
    "source_fingerprint",
    "producer",
    "provenance",
    "created_at",
    "base_request",
    "base_request_artifact",
    "normalization_plan",
    "normalization_receipt",
    "effective_source",
    "run_id",
    "output_root"
