{
  "additionalProperties": false,
  "description": "Bind one legacy source and fully authored v2 candidate before explicit apply.",
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "migration_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Migration Id",
      "type": "string"
    },
    "source_path": {
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*//)[^\\u0000]+$",
      "title": "Source Path",
      "type": "string"
    },
    "source_schema_version": {
      "enum": [
        "unversioned",
        "0.1.0"
      ],
      "title": "Source Schema Version",
      "type": "string"
    },
    "source_file_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source File Sha256",
      "type": "string"
    },
    "source_canonical_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Canonical Sha256",
      "type": "string"
    },
    "candidate_path": {
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*//)[^\\u0000]+$",
      "title": "Candidate Path",
      "type": "string"
    },
    "candidate_file_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Candidate File Sha256",
      "type": "string"
    },
    "candidate_canonical_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Candidate Canonical Sha256",
      "type": "string"
    },
    "evidence_status": {
      "enum": [
        "exact_available_evidence",
        "candidate_supplied_gaps"
      ],
      "title": "Evidence Status",
      "type": "string"
    },
    "verified_fields": {
      "items": {
        "type": "string"
      },
      "title": "Verified Fields",
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "canonical_mutation_allowed": {
      "const": false,
      "default": false,
      "title": "Canonical Mutation Allowed",
      "type": "boolean"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "migration_id",
    "source_path",
    "source_schema_version",
    "source_file_sha256",
    "source_canonical_sha256",
    "candidate_path",
    "candidate_file_sha256",
    "candidate_canonical_sha256",
    "evidence_status",
    "verified_fields",
    "limitations",
    "created_at"
  ],
  "title": "MeshPayloadV02MigrationPlan",
  "type": "object"
}
