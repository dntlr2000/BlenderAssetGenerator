{
  "$defs": {
    "ExactArtifact": {
      "additionalProperties": false,
      "description": "Bind one contained job-relative artifact by exact bytes and media type.",
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "pattern": "^[a-z][a-z0-9_]{1,95}$",
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "byte_size": {
          "minimum": 0,
          "title": "Byte Size",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 127,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "path",
        "sha256",
        "byte_size",
        "media_type"
      ],
      "title": "ExactArtifact",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Consume one exact material approval once without mutating its historical bytes.",
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "workflow_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Workflow Id",
      "type": "string"
    },
    "dispatch_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Dispatch Id",
      "type": "string"
    },
    "session_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Session Id",
      "type": "string"
    },
    "producer": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Producer",
      "type": "string"
    },
    "producer_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Producer Version",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "receipt_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Receipt Id",
      "type": "string"
    },
    "approval": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "controller_request": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "approval_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Approval Id",
      "type": "string"
    },
    "candidate_material_plan_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Candidate Material Plan Sha256",
      "type": "string"
    },
    "rebound_material_graph_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Rebound Material Graph Sha256",
      "type": "string"
    },
    "closure_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Closure Sha256",
      "type": "string"
    },
    "preflight_report_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Preflight Report Sha256",
      "type": "string"
    },
    "neutral_preview_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Neutral Preview Sha256",
      "type": "string"
    },
    "consumption_ordinal": {
      "const": 1,
      "default": 1,
      "title": "Consumption Ordinal",
      "type": "integer"
    },
    "consumed_once": {
      "const": true,
      "default": true,
      "title": "Consumed Once",
      "type": "boolean"
    },
    "approval_artifact_unchanged": {
      "const": true,
      "default": true,
      "title": "Approval Artifact Unchanged",
      "type": "boolean"
    },
    "canonical_write_authority": {
      "const": "host_promotion_only",
      "default": "host_promotion_only",
      "title": "Canonical Write Authority",
      "type": "string"
    }
  },
  "required": [
    "job_id",
    "workflow_id",
    "dispatch_id",
    "session_id",
    "producer",
    "producer_version",
    "created_at",
    "receipt_id",
    "approval",
    "controller_request",
    "approval_id",
    "candidate_material_plan_sha256",
    "rebound_material_graph_sha256",
    "closure_sha256",
    "preflight_report_sha256",
    "neutral_preview_sha256"
  ],
  "title": "MaterialAppearanceApprovalConsumptionReceipt",
  "type": "object"
}
