{
  "$defs": {
    "CodexImageArtifact": {
      "additionalProperties": false,
      "description": "Bind one non-empty job-contained file to exact bytes and media semantics.",
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "byte_size": {
          "exclusiveMinimum": 0,
          "title": "Byte Size",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "path",
        "sha256",
        "byte_size",
        "media_type"
      ],
      "title": "CodexImageArtifact",
      "type": "object"
    },
    "CodexImageCompanionCandidateDecision": {
      "additionalProperties": false,
      "description": "Record one candidate's exact companion evidence and selection disposition.",
      "properties": {
        "candidate_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Candidate Id",
          "type": "string"
        },
        "candidate": {
          "$ref": "#/$defs/CodexImageArtifact"
        },
        "reviewed_image": {
          "$ref": "#/$defs/CodexImageArtifact"
        },
        "deterministic_quality_report": {
          "$ref": "#/$defs/CodexImageArtifact"
        },
        "semantic_review": {
          "anyOf": [
            {
              "$ref": "#/$defs/CodexImageArtifact"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "ranking_evidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/CodexImageArtifact"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "precedence_key": {
          "anyOf": [
            {
              "maxItems": 7,
              "minItems": 7,
              "prefixItems": [
                {
                  "type": "integer"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                },
                {
                  "type": "string"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Precedence Key"
        },
        "outcome": {
          "enum": [
            "selected",
            "rejected",
            "ineligible",
            "review_required"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "reason_codes": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Reason Codes",
          "type": "array"
        },
        "human_reviewed": {
          "const": false,
          "default": false,
          "title": "Human Reviewed",
          "type": "boolean"
        }
      },
      "required": [
        "candidate_id",
        "candidate",
        "reviewed_image",
        "deterministic_quality_report",
        "outcome",
        "reason_codes"
      ],
      "title": "CodexImageCompanionCandidateDecision",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Bind companion ranking grounds to one core-compatible selection artifact.",
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "contract_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Contract Id",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "workflow_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Workflow Id",
      "type": "string"
    },
    "dispatch_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Dispatch Id",
      "type": "string"
    },
    "session_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Session Id",
      "type": "string"
    },
    "profile_id": {
      "const": "autonomous_static_prop_v2_codex_imagegen",
      "default": "autonomous_static_prop_v2_codex_imagegen",
      "title": "Profile Id",
      "type": "string"
    },
    "provider_id": {
      "const": "codex_builtin_gpt_image_v1",
      "default": "codex_builtin_gpt_image_v1",
      "title": "Provider Id",
      "type": "string"
    },
    "input_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Sha256",
      "type": "string"
    },
    "source_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Fingerprint",
      "type": "string"
    },
    "producer": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Producer",
      "type": "string"
    },
    "producer_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Producer Version",
      "type": "string"
    },
    "provenance": {
      "items": {
        "$ref": "#/$defs/CodexImageArtifact"
      },
      "minItems": 1,
      "title": "Provenance",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "immutable": {
      "const": true,
      "default": true,
      "title": "Immutable",
      "type": "boolean"
    },
    "receipt_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Receipt Id",
      "type": "string"
    },
    "assignment": {
      "$ref": "#/$defs/CodexImageArtifact"
    },
    "completion": {
      "$ref": "#/$defs/CodexImageArtifact"
    },
    "core_selection": {
      "$ref": "#/$defs/CodexImageArtifact"
    },
    "candidate_count": {
      "maximum": 3,
      "minimum": 2,
      "title": "Candidate Count",
      "type": "integer"
    },
    "decisions": {
      "items": {
        "$ref": "#/$defs/CodexImageCompanionCandidateDecision"
      },
      "maxItems": 3,
      "minItems": 2,
      "title": "Decisions",
      "type": "array"
    },
    "missing_candidate_ids": {
      "items": {
        "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
        "type": "string"
      },
      "title": "Missing Candidate Ids",
      "type": "array"
    },
    "unresolved_candidate_ids": {
      "items": {
        "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
        "type": "string"
      },
      "title": "Unresolved Candidate Ids",
      "type": "array"
    },
    "selected_candidate": {
      "anyOf": [
        {
          "$ref": "#/$defs/CodexImageArtifact"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "selected_quality_report": {
      "anyOf": [
        {
          "$ref": "#/$defs/CodexImageArtifact"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "selected_ranking_evidence": {
      "anyOf": [
        {
          "$ref": "#/$defs/CodexImageArtifact"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "outcome": {
      "enum": [
        "selected",
        "no_eligible_candidate",
        "review_required"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "selection_method": {
      "const": "companion_semantic_precedence_v1",
      "default": "companion_semantic_precedence_v1",
      "title": "Selection Method",
      "type": "string"
    },
    "core_selector_meaning_changed": {
      "const": false,
      "default": false,
      "title": "Core Selector Meaning Changed",
      "type": "boolean"
    },
    "human_reviewed": {
      "const": false,
      "default": false,
      "title": "Human Reviewed",
      "type": "boolean"
    }
  },
  "required": [
    "contract_id",
    "job_id",
    "workflow_id",
    "dispatch_id",
    "session_id",
    "input_sha256",
    "source_fingerprint",
    "producer",
    "provenance",
    "created_at",
    "receipt_id",
    "assignment",
    "completion",
    "core_selection",
    "candidate_count",
    "decisions",
    "outcome"
  ],
  "title": "CodexImageCompanionSelectionReceipt",
  "type": "object"
}
