{
  "$defs": {
    "ProductionArtifact": {
      "additionalProperties": false,
      "description": "Bind one contained production artifact to a normalized path and exact digest.",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "title": "ProductionArtifact",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Issue one exact read-only advisory subtask for the current V0.8 agent step.",
  "properties": {
    "schema_version": {
      "const": "0.9.0",
      "default": "0.9.0",
      "title": "Schema Version",
      "type": "string"
    },
    "assignment_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Assignment Id",
      "type": "string"
    },
    "dispatch_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Dispatch Id",
      "type": "string"
    },
    "controller_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Controller Id",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "workflow_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Workflow Id",
      "type": "string"
    },
    "step_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Step Id",
      "type": "string"
    },
    "workflow_plan_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Workflow Plan Sha256",
      "type": "string"
    },
    "input_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Fingerprint",
      "type": "string"
    },
    "advisory_role": {
      "enum": [
        "reference_reviewer",
        "geometry_reviewer",
        "material_reviewer",
        "qa_reviewer",
        "portable_reviewer",
        "destination_reviewer",
        "general_reviewer"
      ],
      "title": "Advisory Role",
      "type": "string"
    },
    "prompt": {
      "maxLength": 8000,
      "minLength": 1,
      "title": "Prompt",
      "type": "string"
    },
    "read_artifacts": {
      "items": {
        "$ref": "#/$defs/ProductionArtifact"
      },
      "title": "Read Artifacts",
      "type": "array"
    },
    "canonical_write_authority": {
      "const": "controller_only",
      "default": "controller_only",
      "title": "Canonical Write Authority",
      "type": "string"
    },
    "subagent_write_allowlist": {
      "items": {
        "type": "string"
      },
      "maxItems": 0,
      "title": "Subagent Write Allowlist",
      "type": "array"
    },
    "controller_expected_outputs": {
      "items": {
        "type": "string"
      },
      "title": "Controller Expected Outputs",
      "type": "array"
    },
    "issued_at": {
      "format": "date-time",
      "title": "Issued At",
      "type": "string"
    }
  },
  "required": [
    "assignment_id",
    "dispatch_id",
    "controller_id",
    "job_id",
    "workflow_id",
    "step_id",
    "workflow_plan_sha256",
    "input_fingerprint",
    "advisory_role",
    "prompt",
    "issued_at"
  ],
  "title": "DelegatedWorkAssignment",
  "type": "object"
}
