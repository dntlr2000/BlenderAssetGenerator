{
  "additionalProperties": false,
  "description": "Freeze every input used by one direct or image-assisted visual QA run.",
  "properties": {
    "schema_version": {
      "const": "0.6.0",
      "default": "0.6.0",
      "title": "Schema Version",
      "type": "string"
    },
    "job_id": {
      "title": "Job Id",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "mode": {
      "enum": [
        "concept",
        "measured"
      ],
      "title": "Mode",
      "type": "string"
    },
    "reference_path": {
      "title": "Reference Path",
      "type": "string"
    },
    "reference_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Reference Sha256",
      "type": "string"
    },
    "reference_mask_path": {
      "title": "Reference Mask Path",
      "type": "string"
    },
    "reference_mask_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Reference Mask Sha256",
      "type": "string"
    },
    "preview_path": {
      "title": "Preview Path",
      "type": "string"
    },
    "preview_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Preview Sha256",
      "type": "string"
    },
    "render_pass_manifest_path": {
      "title": "Render Pass Manifest Path",
      "type": "string"
    },
    "render_pass_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Render Pass Manifest Sha256",
      "type": "string"
    },
    "scene_spec_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Scene Spec Sha256",
      "type": "string"
    },
    "camera_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Camera Fingerprint",
      "type": "string"
    },
    "include_generated_target": {
      "default": false,
      "title": "Include Generated Target",
      "type": "boolean"
    }
  },
  "required": [
    "job_id",
    "run_id",
    "mode",
    "reference_path",
    "reference_sha256",
    "reference_mask_path",
    "reference_mask_sha256",
    "preview_path",
    "preview_sha256",
    "render_pass_manifest_path",
    "render_pass_manifest_sha256",
    "scene_spec_sha256",
    "camera_fingerprint"
  ],
  "title": "VisualQARequest",
  "type": "object"
}
