{
  "$defs": {
    "ApprovalArtifact": {
      "additionalProperties": false,
      "description": "Bind one non-empty job-contained artifact to a normalized path and exact bytes.",
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "byte_size": {
          "exclusiveMinimum": 0,
          "title": "Byte Size",
          "type": "integer"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "path",
        "sha256",
        "byte_size"
      ],
      "title": "ApprovalArtifact",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Bind a bounded geometry-to-delivery supervisor to one exact approval envelope.",
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "contract_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Contract Id",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "workflow_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Workflow Id",
      "type": "string"
    },
    "dispatch_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Dispatch Id",
      "type": "string"
    },
    "session_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Session Id",
      "type": "string"
    },
    "root_authorization": {
      "$ref": "#/$defs/ApprovalArtifact"
    },
    "policy_profile": {
      "$ref": "#/$defs/ApprovalArtifact"
    },
    "approval_envelope": {
      "$ref": "#/$defs/ApprovalArtifact"
    },
    "producer": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Producer",
      "type": "string"
    },
    "producer_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Producer Version",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "approval_count_effect": {
      "enum": [
        "reduces",
        "maintains",
        "increases"
      ],
      "title": "Approval Count Effect",
      "type": "string"
    },
    "approval_count_justification": {
      "maxLength": 1200,
      "minLength": 1,
      "title": "Approval Count Justification",
      "type": "string"
    },
    "plan_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Plan Id",
      "type": "string"
    },
    "approval_budget": {
      "$ref": "#/$defs/ApprovalArtifact"
    },
    "base_autonomy_plan": {
      "$ref": "#/$defs/ApprovalArtifact"
    },
    "initial_autonomy_state": {
      "$ref": "#/$defs/ApprovalArtifact"
    },
    "approval_mode": {
      "enum": [
        "autonomous",
        "checkpointed",
        "interactive"
      ],
      "title": "Approval Mode",
      "type": "string"
    },
    "phases": {
      "items": {
        "enum": [
          "geometry",
          "material",
          "quality",
          "delivery",
          "terminal"
        ],
        "type": "string"
      },
      "title": "Phases",
      "type": "array"
    },
    "requested_delivery_profiles": {
      "items": {
        "enum": [
          "review_only",
          "portable_gltf",
          "portable_fbx"
        ],
        "type": "string"
      },
      "minItems": 1,
      "title": "Requested Delivery Profiles",
      "type": "array"
    },
    "controller_execution_mode": {
      "enum": [
        "desktop_in_session",
        "client_mediated"
      ],
      "title": "Controller Execution Mode",
      "type": "string"
    },
    "global_action_limit": {
      "maximum": 512,
      "minimum": 1,
      "title": "Global Action Limit",
      "type": "integer"
    },
    "only_waits_for_consolidated_escalation": {
      "title": "Only Waits For Consolidated Escalation",
      "type": "boolean"
    },
    "routine_approval_wait_allowed": {
      "title": "Routine Approval Wait Allowed",
      "type": "boolean"
    },
    "repository_creates_codex_task": {
      "const": false,
      "default": false,
      "title": "Repository Creates Codex Task",
      "type": "boolean"
    },
    "app_close_background_execution": {
      "const": false,
      "default": false,
      "title": "App Close Background Execution",
      "type": "boolean"
    },
    "resume_same_state_budget_assignment": {
      "const": true,
      "default": true,
      "title": "Resume Same State Budget Assignment",
      "type": "boolean"
    },
    "destination_project_write": {
      "const": false,
      "default": false,
      "title": "Destination Project Write",
      "type": "boolean"
    },
    "profile_status": {
      "const": "disabled_experimental",
      "default": "disabled_experimental",
      "title": "Profile Status",
      "type": "string"
    },
    "status": {
      "default": "planned",
      "enum": [
        "planned",
        "running",
        "cancelled"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "contract_id",
    "job_id",
    "workflow_id",
    "dispatch_id",
    "session_id",
    "root_authorization",
    "policy_profile",
    "approval_envelope",
    "producer",
    "created_at",
    "approval_count_effect",
    "approval_count_justification",
    "plan_id",
    "approval_budget",
    "base_autonomy_plan",
    "initial_autonomy_state",
    "approval_mode",
    "phases",
    "requested_delivery_profiles",
    "controller_execution_mode",
    "global_action_limit",
    "only_waits_for_consolidated_escalation",
    "routine_approval_wait_allowed"
  ],
  "title": "AQV2OnePromptRunPlan",
  "type": "object"
}
