{
  "$defs": {
    "ProducerIdentity": {
      "additionalProperties": false,
      "description": "Identify the exact component and implementation version that emitted evidence.",
      "properties": {
        "name": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Name",
          "type": "string"
        },
        "version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "ProducerIdentity",
      "type": "object"
    },
    "QualityArtifact": {
      "additionalProperties": false,
      "description": "Bind one immutable quality input to its relative path and exact digest.",
      "properties": {
        "artifact_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Kind",
          "type": "string"
        },
        "relative_path": {
          "title": "Relative Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "producer": {
          "$ref": "#/$defs/ProducerIdentity"
        },
        "produced_at": {
          "format": "date-time",
          "title": "Produced At",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "relative_path",
        "sha256",
        "producer",
        "produced_at"
      ],
      "title": "QualityArtifact",
      "type": "object"
    },
    "QualityProvenance": {
      "additionalProperties": false,
      "description": "Freeze the job, workflow, dispatch, source, and exact input artifact identities.",
      "properties": {
        "job_id": {
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
          "title": "Job Id",
          "type": "string"
        },
        "workflow_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Workflow Id",
          "type": "string"
        },
        "dispatch_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Dispatch Id",
          "type": "string"
        },
        "source_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Fingerprint",
          "type": "string"
        },
        "input_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Sha256",
          "type": "string"
        },
        "artifacts": {
          "items": {
            "$ref": "#/$defs/QualityArtifact"
          },
          "minItems": 1,
          "title": "Artifacts",
          "type": "array"
        }
      },
      "required": [
        "job_id",
        "workflow_id",
        "dispatch_id",
        "source_fingerprint",
        "input_sha256",
        "artifacts"
      ],
      "title": "QualityProvenance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Bind authoritative JSON and optional derived PDF to exact report provenance.",
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "report_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Report Id",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "workflow_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Workflow Id",
      "type": "string"
    },
    "dispatch_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Dispatch Id",
      "type": "string"
    },
    "input_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Sha256",
      "type": "string"
    },
    "source_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Fingerprint",
      "type": "string"
    },
    "json_path": {
      "title": "Json Path",
      "type": "string"
    },
    "json_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Json Sha256",
      "type": "string"
    },
    "pdf_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pdf Path"
    },
    "pdf_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pdf Sha256"
    },
    "provenance": {
      "$ref": "#/$defs/QualityProvenance"
    },
    "producer": {
      "$ref": "#/$defs/ProducerIdentity"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "report_id",
    "job_id",
    "workflow_id",
    "dispatch_id",
    "input_sha256",
    "source_fingerprint",
    "json_path",
    "json_sha256",
    "provenance",
    "producer",
    "created_at"
  ],
  "title": "IntegratedQualityReportManifest",
  "type": "object"
}
