    "adoption",
    "material_authoring_manifest",
    "material_authoring_receipt",
    "graph_compile_report",
    "material_validation",
    "neutral_preview",
    "neutral_preview_manifest",
    "neutral_preview_image",
    "canonical_material_snapshot",
    "canonical_scene_snapshot",
    "canonical_material_plan_sha256",
    "canonical_scene_spec_sha256"
