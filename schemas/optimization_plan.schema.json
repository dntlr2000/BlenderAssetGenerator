{
  "$defs": {
    "HashedArtifact": {
      "additionalProperties": false,
      "description": "Bind one stable artifact identity to a job-relative path and SHA-256 digest.",
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "scene_spec",
            "external_asset_manifest",
            "external_source",
            "external_dependency",
            "external_intake_plan",
            "external_intake_approval",
            "external_normalization_evidence",
            "blend",
            "geometry_payload",
            "material_plan",
            "texture_manifest",
            "asset_profile",
            "optimization_plan",
            "preflight_report",
            "lod_manifest",
            "collision_manifest",
            "uv_manifest",
            "asset_cost_report",
            "texture_pack_manifest",
            "lod_mesh",
            "collider_mesh",
            "uv_preview",
            "packed_texture",
            "package_manifest",
            "package_file",
            "roundtrip_inventory",
            "other"
          ],
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*//)[^\\u0000]+$",
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "path",
        "sha256"
      ],
      "title": "HashedArtifact",
      "type": "object"
    },
    "OptimizationDirective": {
      "additionalProperties": false,
      "description": "Apply explicit derived-asset policies to one stable semantic object family.",
      "properties": {
        "target_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Target Id",
          "type": "string"
        },
        "include": {
          "default": true,
          "title": "Include",
          "type": "boolean"
        },
        "lod_levels": {
          "items": {
            "type": "integer"
          },
          "title": "Lod Levels",
          "type": "array"
        },
        "collision_strategy": {
          "default": "inherit",
          "enum": [
            "inherit",
            "none",
            "box",
            "sphere",
            "capsule",
            "convex_hull",
            "compound",
            "mesh_proxy"
          ],
          "title": "Collision Strategy",
          "type": "string"
        },
        "preserve_semantic_id": {
          "const": true,
          "default": true,
          "title": "Preserve Semantic Id",
          "type": "boolean"
        },
        "preserve_material_ids": {
          "const": true,
          "default": true,
          "title": "Preserve Material Ids",
          "type": "boolean"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        }
      },
      "required": [
        "target_id"
      ],
      "title": "OptimizationDirective",
      "type": "object"
    },
    "SourceProvenance": {
      "additionalProperties": false,
      "description": "Freeze canonical geometry, build, material, and texture inputs for one V0.7 run.",
      "properties": {
        "source_kind": {
          "default": "scene_spec",
          "enum": [
            "scene_spec",
            "external_static_asset"
          ],
          "title": "Source Kind",
          "type": "string"
        },
        "scene_spec": {
          "anyOf": [
            {
              "$ref": "#/$defs/HashedArtifact"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "external_asset_manifest": {
          "anyOf": [
            {
              "$ref": "#/$defs/HashedArtifact"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "external_source_artifacts": {
          "items": {
            "$ref": "#/$defs/HashedArtifact"
          },
          "title": "External Source Artifacts",
          "type": "array"
        },
        "blend": {
          "$ref": "#/$defs/HashedArtifact"
        },
        "source_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Fingerprint",
          "type": "string"
        },
        "build_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Build Fingerprint",
          "type": "string"
        },
        "geometry_payloads": {
          "items": {
            "$ref": "#/$defs/HashedArtifact"
          },
          "title": "Geometry Payloads",
          "type": "array"
        },
        "material_plan": {
          "anyOf": [
            {
              "$ref": "#/$defs/HashedArtifact"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "texture_manifests": {
          "items": {
            "$ref": "#/$defs/HashedArtifact"
          },
          "title": "Texture Manifests",
          "type": "array"
        }
      },
      "required": [
        "blend",
        "source_fingerprint",
        "build_fingerprint"
      ],
      "title": "SourceProvenance",
      "type": "object"
    },
    "SourceQualitySummary": {
      "additionalProperties": false,
      "description": "Carry exact fast-preview quality warnings into the V0.7 approval boundary.",
      "properties": {
        "report_artifact": {
          "$ref": "#/$defs/HashedArtifact"
        },
        "quality_status": {
          "enum": [
            "passed",
            "needs_revision",
            "unscorable"
          ],
          "title": "Quality Status",
          "type": "string"
        },
        "overall_direct_score": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Overall Direct Score"
        },
        "primary_silhouette_score": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Primary Silhouette Score"
        },
        "primary_high_findings": {
          "items": {
            "type": "string"
          },
          "title": "Primary High Findings",
          "type": "array"
        },
        "supporting_high_findings": {
          "items": {
            "type": "string"
          },
          "title": "Supporting High Findings",
          "type": "array"
        },
        "decorative_warnings": {
          "items": {
            "type": "string"
          },
          "title": "Decorative Warnings",
          "type": "array"
        },
        "environment_findings": {
          "items": {
            "type": "string"
          },
          "title": "Environment Findings",
          "type": "array"
        },
        "standard_workflow_recommended": {
          "title": "Standard Workflow Recommended",
          "type": "boolean"
        },
        "qa_run_id": {
          "minLength": 1,
          "title": "Qa Run Id",
          "type": "string"
        },
        "source_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Fingerprint",
          "type": "string"
        },
        "build_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Build Fingerprint",
          "type": "string"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        }
      },
      "required": [
        "report_artifact",
        "quality_status",
        "standard_workflow_recommended",
        "qa_run_id",
        "source_fingerprint",
        "build_fingerprint"
      ],
      "title": "SourceQualitySummary",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Bind an approved derived-asset plan to immutable canonical provenance.",
  "properties": {
    "schema_version": {
      "const": "0.7.0",
      "default": "0.7.0",
      "title": "Schema Version",
      "type": "string"
    },
    "plan_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Plan Id",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "profile_id": {
      "enum": [
        "portable_gltf",
        "fbx_interchange",
        "obj_legacy"
      ],
      "title": "Profile Id",
      "type": "string"
    },
    "profile_artifact": {
      "$ref": "#/$defs/HashedArtifact"
    },
    "preflight_report": {
      "$ref": "#/$defs/HashedArtifact"
    },
    "source": {
      "$ref": "#/$defs/SourceProvenance"
    },
    "source_quality": {
      "anyOf": [
        {
          "$ref": "#/$defs/SourceQualitySummary"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "status": {
      "default": "draft",
      "enum": [
        "draft",
        "approved",
        "running",
        "complete",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "directives": {
      "items": {
        "$ref": "#/$defs/OptimizationDirective"
      },
      "title": "Directives",
      "type": "array"
    },
    "approved_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Approved At"
    },
    "completed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Completed At"
    },
    "output_manifests": {
      "items": {
        "$ref": "#/$defs/HashedArtifact"
      },
      "title": "Output Manifests",
      "type": "array"
    },
    "errors": {
      "items": {
        "type": "string"
      },
      "title": "Errors",
      "type": "array"
    },
    "notes": {
      "items": {
        "type": "string"
      },
      "title": "Notes",
      "type": "array"
    }
  },
  "required": [
    "plan_id",
    "job_id",
    "profile_id",
    "profile_artifact",
    "preflight_report",
    "source"
  ],
  "title": "OptimizationPlan",
  "type": "object"
}
