{
  "$defs": {
    "CodexImageArtifact": {
      "additionalProperties": false,
      "description": "Bind one non-empty job-contained file to exact bytes and media semantics.",
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "byte_size": {
          "exclusiveMinimum": 0,
          "title": "Byte Size",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "path",
        "sha256",
        "byte_size",
        "media_type"
      ],
      "title": "CodexImageArtifact",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Bind a fixed Blender material-swatch render to exact promoted source evidence.",
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "contract_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Contract Id",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "workflow_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Workflow Id",
      "type": "string"
    },
    "dispatch_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Dispatch Id",
      "type": "string"
    },
    "session_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Session Id",
      "type": "string"
    },
    "profile_id": {
      "const": "autonomous_static_prop_v2_codex_imagegen",
      "default": "autonomous_static_prop_v2_codex_imagegen",
      "title": "Profile Id",
      "type": "string"
    },
    "provider_id": {
      "const": "codex_builtin_gpt_image_v1",
      "default": "codex_builtin_gpt_image_v1",
      "title": "Provider Id",
      "type": "string"
    },
    "input_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Sha256",
      "type": "string"
    },
    "source_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Fingerprint",
      "type": "string"
    },
    "producer": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Producer",
      "type": "string"
    },
    "producer_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Producer Version",
      "type": "string"
    },
    "provenance": {
      "items": {
        "$ref": "#/$defs/CodexImageArtifact"
      },
      "minItems": 1,
      "title": "Provenance",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "immutable": {
      "const": true,
      "default": true,
      "title": "Immutable",
      "type": "boolean"
    },
    "material_phase_receipt": {
      "$ref": "#/$defs/CodexImageArtifact"
    },
    "authoring_blend": {
      "$ref": "#/$defs/CodexImageArtifact"
    },
    "renderer_script": {
      "$ref": "#/$defs/CodexImageArtifact"
    },
    "raw_swatch_manifest": {
      "$ref": "#/$defs/CodexImageArtifact"
    },
    "preview_image": {
      "$ref": "#/$defs/CodexImageArtifact"
    },
    "material_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Material Id",
      "type": "string"
    },
    "width": {
      "maximum": 8192,
      "minimum": 1,
      "title": "Width",
      "type": "integer"
    },
    "height": {
      "maximum": 8192,
      "minimum": 1,
      "title": "Height",
      "type": "integer"
    },
    "preview_image_path": {
      "title": "Preview Image Path",
      "type": "string"
    },
    "preview_image_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Preview Image Sha256",
      "type": "string"
    },
    "preview_image_byte_size": {
      "exclusiveMinimum": 0,
      "title": "Preview Image Byte Size",
      "type": "integer"
    },
    "renderer": {
      "const": "fixed_blender_material_swatch_v1",
      "default": "fixed_blender_material_swatch_v1",
      "title": "Renderer",
      "type": "string"
    },
    "actual_blender_rendered": {
      "const": true,
      "default": true,
      "title": "Actual Blender Rendered",
      "type": "boolean"
    },
    "human_reviewed": {
      "const": false,
      "default": false,
      "title": "Human Reviewed",
      "type": "boolean"
    },
    "reference_matched": {
      "const": false,
      "default": false,
      "title": "Reference Matched",
      "type": "boolean"
    },
    "canonical_write": {
      "const": false,
      "default": false,
      "title": "Canonical Write",
      "type": "boolean"
    }
  },
  "required": [
    "contract_id",
    "job_id",
    "workflow_id",
    "dispatch_id",
    "session_id",
    "input_sha256",
    "source_fingerprint",
    "producer",
    "provenance",
    "created_at",
    "material_phase_receipt",
    "authoring_blend",
    "renderer_script",
    "raw_swatch_manifest",
    "preview_image",
    "material_id",
    "width",
    "height",
    "preview_image_path",
    "preview_image_sha256",
    "preview_image_byte_size"
  ],
  "title": "ImageGeneratedMaterialNeutralPreview",
  "type": "object"
}
