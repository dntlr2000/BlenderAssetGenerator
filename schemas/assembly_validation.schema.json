{
  "$defs": {
    "AssemblyValidationCheck": {
      "additionalProperties": false,
      "description": "Record one prebuild or evaluated-bounds assembly consistency check.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "relation_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Relation Id"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "status": {
          "enum": [
            "passed",
            "warning",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "evidence_status": {
          "anyOf": [
            {
              "enum": [
                "observed",
                "inferred",
                "measured",
                "authored"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Status"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "subject_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subject Id"
        },
        "reference_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference Id"
        },
        "peer_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Peer Id"
        },
        "instance_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Instance Index"
        },
        "residual": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Residual"
        },
        "tolerance": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tolerance"
        },
        "tolerance_mode": {
          "anyOf": [
            {
              "enum": [
                "relative",
                "meters"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tolerance Mode"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "metrics": {
          "additionalProperties": true,
          "title": "Metrics",
          "type": "object"
        }
      },
      "required": [
        "id",
        "kind",
        "status",
        "message"
      ],
      "title": "AssemblyValidationCheck",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Summarize contract or evaluated-bounds assembly consistency evidence.",
  "properties": {
    "schema_version": {
      "const": "0.4.0",
      "default": "0.4.0",
      "title": "Schema Version",
      "type": "string"
    },
    "job_id": {
      "title": "Job Id",
      "type": "string"
    },
    "policy": {
      "enum": [
        "legacy_unbound",
        "spatial_v1"
      ],
      "title": "Policy",
      "type": "string"
    },
    "phase": {
      "enum": [
        "prebuild",
        "bounds"
      ],
      "title": "Phase",
      "type": "string"
    },
    "ok": {
      "title": "Ok",
      "type": "boolean"
    },
    "passed": {
      "minimum": 0,
      "title": "Passed",
      "type": "integer"
    },
    "warnings": {
      "minimum": 0,
      "title": "Warnings",
      "type": "integer"
    },
    "failed": {
      "minimum": 0,
      "title": "Failed",
      "type": "integer"
    },
    "checks": {
      "items": {
        "$ref": "#/$defs/AssemblyValidationCheck"
      },
      "title": "Checks",
      "type": "array"
    },
    "notes": {
      "items": {
        "type": "string"
      },
      "title": "Notes",
      "type": "array"
    }
  },
  "required": [
    "job_id",
    "policy",
    "phase",
    "ok",
    "passed",
    "warnings",
    "failed"
  ],
  "title": "AssemblyValidationReport",
  "type": "object"
}
