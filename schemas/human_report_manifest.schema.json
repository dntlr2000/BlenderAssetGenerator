{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HumanReportManifest",
  "description": "Record one derived human-readable PDF and every canonical source represented in it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "scope",
    "generated_at",
    "pdf_path",
    "pdf_sha256",
    "source_fingerprint",
    "qa_run_id",
    "interior_qa_run_id",
    "font",
    "sources",
    "warnings"
  ],
  "properties": {
    "schema_version": {
      "const": "0.6.0",
      "default": "0.6.0",
      "type": "string"
    },
    "job_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"
    },
    "scope": {
      "enum": ["build", "material", "qa", "export", "full"],
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "pdf_path": {
      "type": "string",
      "minLength": 1
    },
    "pdf_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "qa_run_id": {
      "anyOf": [
        {"type": "string", "minLength": 1},
        {"type": "null"}
      ]
    },
    "interior_qa_run_id": {
      "anyOf": [
        {"type": "string", "minLength": 1},
        {"type": "null"}
      ]
    },
    "optimization_run_id": {
      "anyOf": [
        {"type": "string", "minLength": 1},
        {"type": "null"}
      ]
    },
    "package_id": {
      "anyOf": [
        {"type": "string", "minLength": 1},
        {"type": "null"}
      ]
    },
    "font": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/report_source"
      }
    },
    "warnings": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "$defs": {
    "report_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "sha256", "size_bytes"],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![A-Za-z]:[\\\\/])(?!/).+"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
