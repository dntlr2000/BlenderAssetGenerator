{
  "$defs": {
    "ReportSource": {
      "additionalProperties": false,
      "description": "Record one immutable source file represented in a human-readable report.",
      "properties": {
        "kind": {
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "pattern": "^(?!/)(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:\\/|$))(?!.*//)(?!.*\\/$)[^:\\\\]+$",
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "path",
        "sha256",
        "size_bytes"
      ],
      "title": "ReportSource",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Describe one generated PDF and the machine-readable evidence used to create it.",
  "properties": {
    "schema_version": {
      "const": "0.6.0",
      "default": "0.6.0",
      "title": "Schema Version",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "scope": {
      "enum": [
        "build",
        "material",
        "qa",
        "export",
        "full"
      ],
      "title": "Scope",
      "type": "string"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "pdf_path": {
      "minLength": 1,
      "title": "Pdf Path",
      "type": "string"
    },
    "pdf_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Pdf Sha256",
      "type": "string"
    },
    "source_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Fingerprint",
      "type": "string"
    },
    "qa_run_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Qa Run Id"
    },
    "interior_qa_run_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Interior Qa Run Id"
    },
    "assembly_sanity_run_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Assembly Sanity Run Id"
    },
    "optimization_run_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Optimization Run Id"
    },
    "package_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Package Id"
    },
    "font": {
      "minLength": 1,
      "title": "Font",
      "type": "string"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/ReportSource"
      },
      "title": "Sources",
      "type": "array"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "job_id",
    "scope",
    "generated_at",
    "pdf_path",
    "pdf_sha256",
    "source_fingerprint",
    "font",
    "sources"
  ],
  "title": "HumanReportManifest",
  "type": "object"
}
