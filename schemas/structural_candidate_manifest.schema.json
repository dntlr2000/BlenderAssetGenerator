{
  "$defs": {
    "AutonomyArtifact": {
      "additionalProperties": false,
      "description": "Bind one contained artifact to its repository-relative path and exact bytes.",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "title": "AutonomyArtifact",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Bind one built candidate to its exact staging outputs and completion marker.",
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "contract_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Contract Id",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "workflow_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Workflow Id",
      "type": "string"
    },
    "dispatch_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Dispatch Id",
      "type": "string"
    },
    "input_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Sha256",
      "type": "string"
    },
    "source_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Fingerprint",
      "type": "string"
    },
    "producer": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Producer",
      "type": "string"
    },
    "producer_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Producer Version",
      "type": "string"
    },
    "provenance": {
      "items": {
        "$ref": "#/$defs/AutonomyArtifact"
      },
      "minItems": 1,
      "title": "Provenance",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "candidate_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Candidate Id",
      "type": "string"
    },
    "plan": {
      "$ref": "#/$defs/AutonomyArtifact"
    },
    "scene_spec": {
      "$ref": "#/$defs/AutonomyArtifact"
    },
    "scene_spec_v03_candidate": {
      "anyOf": [
        {
          "$ref": "#/$defs/AutonomyArtifact"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "compiled_scene_spec_candidate": {
      "anyOf": [
        {
          "$ref": "#/$defs/AutonomyArtifact"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "structural_recipes": {
      "items": {
        "$ref": "#/$defs/AutonomyArtifact"
      },
      "title": "Structural Recipes",
      "type": "array"
    },
    "structural_mesh_payloads": {
      "items": {
        "$ref": "#/$defs/AutonomyArtifact"
      },
      "title": "Structural Mesh Payloads",
      "type": "array"
    },
    "structural_materialization_receipts": {
      "items": {
        "$ref": "#/$defs/AutonomyArtifact"
      },
      "title": "Structural Materialization Receipts",
      "type": "array"
    },
    "completion_marker": {
      "$ref": "#/$defs/AutonomyArtifact"
    },
    "blend": {
      "$ref": "#/$defs/AutonomyArtifact"
    },
    "inventory": {
      "$ref": "#/$defs/AutonomyArtifact"
    },
    "validation": {
      "$ref": "#/$defs/AutonomyArtifact"
    },
    "low_resolution_renders": {
      "items": {
        "$ref": "#/$defs/AutonomyArtifact"
      },
      "minItems": 1,
      "title": "Low Resolution Renders",
      "type": "array"
    },
    "integrated_quality_report": {
      "$ref": "#/$defs/AutonomyArtifact"
    },
    "status": {
      "enum": [
        "evaluated",
        "invalid",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "canonical_promoted": {
      "const": false,
      "default": false,
      "title": "Canonical Promoted",
      "type": "boolean"
    }
  },
  "required": [
    "contract_id",
    "job_id",
    "workflow_id",
    "dispatch_id",
    "input_sha256",
    "source_fingerprint",
    "producer",
    "producer_version",
    "provenance",
    "created_at",
    "candidate_id",
    "plan",
    "scene_spec",
    "completion_marker",
    "blend",
    "inventory",
    "validation",
    "low_resolution_renders",
    "integrated_quality_report",
    "status"
  ],
  "title": "StructuralCandidateManifest",
  "type": "object"
}
