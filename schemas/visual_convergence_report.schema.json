{
  "$defs": {
    "HashBoundConvergenceArtifact": {
      "additionalProperties": false,
      "description": "Bind one job-relative convergence artifact to its exact content hash.",
      "properties": {
        "relative_path": {
          "title": "Relative Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "relative_path",
        "sha256"
      ],
      "title": "HashBoundConvergenceArtifact",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Summarize one terminal bounded session without replacing iteration evidence.",
  "properties": {
    "schema_version": {
      "const": "0.6.0",
      "default": "0.6.0",
      "title": "Schema Version",
      "type": "string"
    },
    "session_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$",
      "title": "Session Id",
      "type": "string"
    },
    "job_id": {
      "title": "Job Id",
      "type": "string"
    },
    "plan_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Plan Sha256",
      "type": "string"
    },
    "approval_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Approval Sha256",
      "type": "string"
    },
    "input_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Fingerprint",
      "type": "string"
    },
    "camera_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Camera Fingerprint",
      "type": "string"
    },
    "scoring_version": {
      "enum": [
        "legacy_bbox_v1",
        "semantic_bbox_v2"
      ],
      "title": "Scoring Version",
      "type": "string"
    },
    "initial_scene_spec_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Initial Scene Spec Sha256",
      "type": "string"
    },
    "initial_scene_spec_snapshot": {
      "anyOf": [
        {
          "$ref": "#/$defs/HashBoundConvergenceArtifact"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "final_scene_spec_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Final Scene Spec Sha256",
      "type": "string"
    },
    "final_scene_spec_snapshot": {
      "anyOf": [
        {
          "$ref": "#/$defs/HashBoundConvergenceArtifact"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "initial_qa_report_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Initial Qa Report Sha256",
      "type": "string"
    },
    "initial_candidates_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Initial Candidates Sha256"
    },
    "final_qa_report_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Final Qa Report Sha256",
      "type": "string"
    },
    "initial_build_fingerprint": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Initial Build Fingerprint"
    },
    "final_build_fingerprint": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Final Build Fingerprint"
    },
    "initial_build_provenance_snapshot": {
      "anyOf": [
        {
          "$ref": "#/$defs/HashBoundConvergenceArtifact"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "final_build_provenance_snapshot": {
      "anyOf": [
        {
          "$ref": "#/$defs/HashBoundConvergenceArtifact"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "initial_constraints_present": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Initial Constraints Present"
    },
    "initial_constraints_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Initial Constraints Sha256"
    },
    "cancellation_receipt": {
      "anyOf": [
        {
          "$ref": "#/$defs/HashBoundConvergenceArtifact"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "initial_direct_score": {
      "maximum": 1,
      "minimum": 0,
      "title": "Initial Direct Score",
      "type": "number"
    },
    "final_direct_score": {
      "maximum": 1,
      "minimum": 0,
      "title": "Final Direct Score",
      "type": "number"
    },
    "target_direct_score": {
      "maximum": 1,
      "minimum": 0,
      "title": "Target Direct Score",
      "type": "number"
    },
    "initial_silhouette_iou": {
      "maximum": 1,
      "minimum": 0,
      "title": "Initial Silhouette Iou",
      "type": "number"
    },
    "final_silhouette_iou": {
      "maximum": 1,
      "minimum": 0,
      "title": "Final Silhouette Iou",
      "type": "number"
    },
    "target_silhouette_iou": {
      "maximum": 1,
      "minimum": 0,
      "title": "Target Silhouette Iou",
      "type": "number"
    },
    "iteration_receipts": {
      "items": {
        "$ref": "#/$defs/HashBoundConvergenceArtifact"
      },
      "title": "Iteration Receipts",
      "type": "array"
    },
    "iteration_evidence": {
      "items": {
        "$ref": "#/$defs/HashBoundConvergenceArtifact"
      },
      "title": "Iteration Evidence",
      "type": "array"
    },
    "accepted_iterations": {
      "minimum": 0,
      "title": "Accepted Iterations",
      "type": "integer"
    },
    "rolled_back_iterations": {
      "minimum": 0,
      "title": "Rolled Back Iterations",
      "type": "integer"
    },
    "termination_reason": {
      "enum": [
        "target_reached",
        "plateau",
        "no_eligible_candidates",
        "manual_review_required",
        "iteration_budget_exhausted",
        "constraint_regression",
        "stale_or_tampered",
        "cancelled",
        "failed"
      ],
      "title": "Termination Reason",
      "type": "string"
    },
    "target_reached": {
      "title": "Target Reached",
      "type": "boolean"
    },
    "manual_review_required": {
      "title": "Manual Review Required",
      "type": "boolean"
    },
    "remaining_high_finding_ids": {
      "items": {
        "type": "string"
      },
      "title": "Remaining High Finding Ids",
      "type": "array"
    },
    "reasons": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Reasons",
      "type": "array"
    },
    "started_at": {
      "title": "Started At",
      "type": "string"
    },
    "completed_at": {
      "title": "Completed At",
      "type": "string"
    }
  },
  "required": [
    "session_id",
    "job_id",
    "plan_sha256",
    "approval_sha256",
    "input_fingerprint",
    "camera_fingerprint",
    "scoring_version",
    "initial_scene_spec_sha256",
    "final_scene_spec_sha256",
    "initial_qa_report_sha256",
    "final_qa_report_sha256",
    "initial_direct_score",
    "final_direct_score",
    "target_direct_score",
    "initial_silhouette_iou",
    "final_silhouette_iou",
    "target_silhouette_iou",
    "accepted_iterations",
    "rolled_back_iterations",
    "termination_reason",
    "target_reached",
    "manual_review_required",
    "reasons",
    "started_at",
    "completed_at"
  ],
  "title": "VisualConvergenceReport",
  "type": "object"
}
