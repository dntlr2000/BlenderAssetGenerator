{
  "$defs": {
    "ExactArtifact": {
      "additionalProperties": false,
      "description": "Bind one contained job-relative artifact by exact bytes and media type.",
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "pattern": "^[a-z][a-z0-9_]{1,95}$",
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "byte_size": {
          "minimum": 0,
          "title": "Byte Size",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 127,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "path",
        "sha256",
        "byte_size",
        "media_type"
      ],
      "title": "ExactArtifact",
      "type": "object"
    },
    "MaterialPreflightCheck": {
      "additionalProperties": false,
      "description": "Record one named material preflight or shadow-compile check.",
      "properties": {
        "check_id": {
          "pattern": "^[a-z][a-z0-9_]{1,95}$",
          "title": "Check Id",
          "type": "string"
        },
        "category": {
          "enum": [
            "contract",
            "dependency",
            "surface_detail",
            "budget",
            "rollback",
            "blender"
          ],
          "title": "Category",
          "type": "string"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "not_applicable"
          ],
          "title": "Status",
          "type": "string"
        },
        "message": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/ExactArtifact"
          },
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "check_id",
        "category",
        "status",
        "message"
      ],
      "title": "MaterialPreflightCheck",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Prove that every approval prerequisite passed for one immutable candidate.",
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "workflow_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Workflow Id",
      "type": "string"
    },
    "dispatch_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Dispatch Id",
      "type": "string"
    },
    "session_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Session Id",
      "type": "string"
    },
    "producer": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Producer",
      "type": "string"
    },
    "producer_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Producer Version",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "report_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Report Id",
      "type": "string"
    },
    "request": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "closure": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "closure_receipt": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "graph_rebinding_receipt": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "shadow_compile_receipt": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "neutral_preview_manifest": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "resource_receipt": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "status": {
      "const": "passed",
      "default": "passed",
      "title": "Status",
      "type": "string"
    },
    "checks": {
      "items": {
        "$ref": "#/$defs/MaterialPreflightCheck"
      },
      "minItems": 1,
      "title": "Checks",
      "type": "array"
    },
    "immutable_input_projection": {
      "additionalProperties": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "minProperties": 1,
      "title": "Immutable Input Projection",
      "type": "object"
    },
    "planned_output_projection": {
      "additionalProperties": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "minProperties": 2,
      "title": "Planned Output Projection",
      "type": "object"
    },
    "canonical_unchanged": {
      "const": true,
      "default": true,
      "title": "Canonical Unchanged",
      "type": "boolean"
    },
    "approval_may_be_requested": {
      "const": true,
      "default": true,
      "title": "Approval May Be Requested",
      "type": "boolean"
    },
    "controller_may_execute": {
      "const": false,
      "default": false,
      "title": "Controller May Execute",
      "type": "boolean"
    }
  },
  "required": [
    "job_id",
    "workflow_id",
    "dispatch_id",
    "session_id",
    "producer",
    "producer_version",
    "created_at",
    "report_id",
    "request",
    "closure",
    "closure_receipt",
    "graph_rebinding_receipt",
    "shadow_compile_receipt",
    "neutral_preview_manifest",
    "resource_receipt",
    "checks",
    "immutable_input_projection",
    "planned_output_projection"
  ],
  "title": "MaterialPromotionPreflightReport",
  "type": "object"
}
