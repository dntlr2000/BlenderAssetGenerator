{
  "$defs": {
    "AQV2Artifact": {
      "additionalProperties": false,
      "description": "Bind one immutable job-contained artifact to exact bytes and role.",
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "byte_size": {
          "exclusiveMinimum": 0,
          "title": "Byte Size",
          "type": "integer"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "path",
        "sha256",
        "byte_size"
      ],
      "title": "AQV2Artifact",
      "type": "object"
    },
    "DelegationBindingV01": {
      "additionalProperties": false,
      "description": "Bind the native budget to an exact workspace-owned parent reservation.",
      "properties": {
        "delegation_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Delegation Id",
          "type": "string"
        },
        "scope_sequence": {
          "minimum": 1,
          "title": "Scope Sequence",
          "type": "integer"
        },
        "contract_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Contract Sha256",
          "type": "string"
        },
        "scope_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Scope Sha256",
          "type": "string"
        }
      },
      "required": [
        "delegation_id",
        "scope_sequence",
        "contract_sha256",
        "scope_sha256"
      ],
      "title": "DelegationBindingV01",
      "type": "object"
    },
    "FidelityBudgetEpochV01": {
      "additionalProperties": false,
      "description": "Freeze one additive allowance with exact history, object counts and route costs.",
      "properties": {
        "schema_version": {
          "const": "0.1.0",
          "default": "0.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "contract_kind": {
          "const": "fidelity_budget_epoch",
          "default": "fidelity_budget_epoch",
          "title": "Contract Kind",
          "type": "string"
        },
        "profile_status": {
          "const": "disabled_experimental",
          "default": "disabled_experimental",
          "title": "Profile Status",
          "type": "string"
        },
        "epoch_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Epoch Id",
          "type": "string"
        },
        "job_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
          "title": "Job Id",
          "type": "string"
        },
        "reference_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Reference Sha256",
          "type": "string"
        },
        "prior_history": {
          "items": {
            "$ref": "#/$defs/FidelityHistoryEntryV01"
          },
          "title": "Prior History",
          "type": "array"
        },
        "prior_usage": {
          "$ref": "#/$defs/FidelityLifetimeUsageV01"
        },
        "initial_object_limit": {
          "maximum": 48,
          "minimum": 1,
          "title": "Initial Object Limit",
          "type": "integer"
        },
        "correction_object_limit": {
          "maximum": 48,
          "minimum": 1,
          "title": "Correction Object Limit",
          "type": "integer"
        },
        "structural_rounds": {
          "default": 3,
          "maximum": 3,
          "minimum": 0,
          "title": "Structural Rounds",
          "type": "integer"
        },
        "parametric_rounds": {
          "default": 0,
          "maximum": 2,
          "minimum": 0,
          "title": "Parametric Rounds",
          "type": "integer"
        },
        "material_corrections": {
          "default": 2,
          "maximum": 2,
          "minimum": 0,
          "title": "Material Corrections",
          "type": "integer"
        },
        "strategy_switch_limit": {
          "const": 1,
          "default": 1,
          "title": "Strategy Switch Limit",
          "type": "integer"
        },
        "same_input_technical_retries": {
          "const": 1,
          "default": 1,
          "title": "Same Input Technical Retries",
          "type": "integer"
        },
        "human_approval_authority": {
          "const": false,
          "default": false,
          "title": "Human Approval Authority",
          "type": "boolean"
        },
        "historical_budget_mutation": {
          "const": false,
          "default": false,
          "title": "Historical Budget Mutation",
          "type": "boolean"
        },
        "destination_write": {
          "const": false,
          "default": false,
          "title": "Destination Write",
          "type": "boolean"
        }
      },
      "required": [
        "epoch_id",
        "job_id",
        "reference_sha256",
        "prior_history",
        "prior_usage",
        "initial_object_limit",
        "correction_object_limit"
      ],
      "title": "FidelityBudgetEpochV01",
      "type": "object"
    },
    "FidelityHistoryEntryV01": {
      "additionalProperties": false,
      "description": "Bind the full session JSON inventory and validated counters without reopening it.",
      "properties": {
        "job_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
          "title": "Job Id",
          "type": "string"
        },
        "session_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Session Id",
          "type": "string"
        },
        "session_evidence_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Session Evidence Sha256",
          "type": "string"
        },
        "last_state_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Last State Sha256",
          "type": "string"
        },
        "budget_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Budget Sha256",
          "type": "string"
        },
        "status": {
          "minLength": 1,
          "title": "Status",
          "type": "string"
        },
        "next_action": {
          "minLength": 1,
          "title": "Next Action",
          "type": "string"
        },
        "funded_epoch": {
          "title": "Funded Epoch",
          "type": "boolean"
        },
        "epoch_id": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Epoch Id"
        },
        "usage": {
          "$ref": "#/$defs/FidelityLifetimeUsageV01"
        }
      },
      "required": [
        "job_id",
        "session_id",
        "session_evidence_sha256",
        "last_state_sha256",
        "budget_sha256",
        "status",
        "next_action",
        "funded_epoch",
        "usage"
      ],
      "title": "FidelityHistoryEntryV01",
      "type": "object"
    },
    "FidelityLifetimeUsageV01": {
      "additionalProperties": false,
      "description": "Keep observed or already reserved work visible across reference-identical sessions.",
      "properties": {
        "structural": {
          "default": 0,
          "minimum": 0,
          "title": "Structural",
          "type": "integer"
        },
        "local": {
          "default": 0,
          "minimum": 0,
          "title": "Local",
          "type": "integer"
        },
        "strategy_switches": {
          "default": 0,
          "minimum": 0,
          "title": "Strategy Switches",
          "type": "integer"
        },
        "blender_builds": {
          "default": 0,
          "minimum": 0,
          "title": "Blender Builds",
          "type": "integer"
        },
        "preflight_blender_runs": {
          "default": 0,
          "minimum": 0,
          "title": "Preflight Blender Runs",
          "type": "integer"
        },
        "quality_evaluations": {
          "default": 0,
          "minimum": 0,
          "title": "Quality Evaluations",
          "type": "integer"
        },
        "promotions": {
          "default": 0,
          "minimum": 0,
          "title": "Promotions",
          "type": "integer"
        }
      },
      "title": "FidelityLifetimeUsageV01",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Bind an unchanged finite funding epoch to its once-approved campaign reservation.",
  "properties": {
    "schema_version": {
      "const": "0.4.0",
      "default": "0.4.0",
      "title": "Schema Version",
      "type": "string"
    },
    "contract_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Contract Id",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "workflow_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Workflow Id",
      "type": "string"
    },
    "dispatch_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Dispatch Id",
      "type": "string"
    },
    "session_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Session Id",
      "type": "string"
    },
    "input_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Sha256",
      "type": "string"
    },
    "source_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Fingerprint",
      "type": "string"
    },
    "producer": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Producer",
      "type": "string"
    },
    "producer_version": {
      "const": "0.2.0",
      "default": "0.2.0",
      "title": "Producer Version",
      "type": "string"
    },
    "provenance": {
      "items": {
        "$ref": "#/$defs/AQV2Artifact"
      },
      "minItems": 1,
      "title": "Provenance",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "budget_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Budget Id",
      "type": "string"
    },
    "initial_candidates": {
      "default": 3,
      "maximum": 4,
      "minimum": 1,
      "title": "Initial Candidates",
      "type": "integer"
    },
    "structural_rounds": {
      "default": 2,
      "maximum": 3,
      "minimum": 0,
      "title": "Structural Rounds",
      "type": "integer"
    },
    "candidates_per_structural_round": {
      "default": 2,
      "maximum": 3,
      "minimum": 1,
      "title": "Candidates Per Structural Round",
      "type": "integer"
    },
    "parametric_convergence_iterations": {
      "default": 3,
      "maximum": 5,
      "minimum": 0,
      "title": "Parametric Convergence Iterations",
      "type": "integer"
    },
    "material_rounds": {
      "maximum": 6,
      "minimum": 1,
      "title": "Material Rounds",
      "type": "integer"
    },
    "total_blender_builds": {
      "maximum": 64,
      "minimum": 1,
      "title": "Total Blender Builds",
      "type": "integer"
    },
    "total_quality_evaluations": {
      "maximum": 18,
      "minimum": 1,
      "title": "Total Quality Evaluations",
      "type": "integer"
    },
    "controller_invocations": {
      "default": 16,
      "maximum": 32,
      "minimum": 1,
      "title": "Controller Invocations",
      "type": "integer"
    },
    "delivery_runs": {
      "default": 2,
      "maximum": 2,
      "minimum": 0,
      "title": "Delivery Runs",
      "type": "integer"
    },
    "canonical_promotions": {
      "maximum": 12,
      "minimum": 1,
      "title": "Canonical Promotions",
      "type": "integer"
    },
    "package_repairs": {
      "default": 1,
      "maximum": 2,
      "minimum": 0,
      "title": "Package Repairs",
      "type": "integer"
    },
    "global_action_limit": {
      "default": 72,
      "maximum": 128,
      "minimum": 1,
      "title": "Global Action Limit",
      "type": "integer"
    },
    "repeated_identical_failure_limit": {
      "const": 1,
      "default": 1,
      "title": "Repeated Identical Failure Limit",
      "type": "integer"
    },
    "transient_retry_limit": {
      "const": 1,
      "default": 1,
      "title": "Transient Retry Limit",
      "type": "integer"
    },
    "funding": {
      "$ref": "#/$defs/FidelityBudgetEpochV01"
    },
    "delegation": {
      "$ref": "#/$defs/DelegationBindingV01"
    }
  },
  "required": [
    "contract_id",
    "job_id",
    "workflow_id",
    "dispatch_id",
    "session_id",
    "input_sha256",
    "source_fingerprint",
    "producer",
    "provenance",
    "created_at",
    "budget_id",
    "material_rounds",
    "total_blender_builds",
    "total_quality_evaluations",
    "canonical_promotions",
    "funding",
    "delegation"
  ],
  "title": "AutonomyBudgetV04",
  "type": "object"
}
