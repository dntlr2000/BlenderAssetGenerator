{
  "$defs": {
    "FidelityArtifact": {
      "additionalProperties": false,
      "description": "Bind a contained artifact to its immutable bytes, not a mutable latest pointer.",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "title": "FidelityArtifact",
      "type": "object"
    }
  },
  "additionalProperties": false,
