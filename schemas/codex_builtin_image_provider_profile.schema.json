{
  "$defs": {
    "CodexImageArtifact": {
      "additionalProperties": false,
      "description": "Bind one non-empty job-contained file to exact bytes and media semantics.",
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "byte_size": {
          "exclusiveMinimum": 0,
          "title": "Byte Size",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "path",
        "sha256",
        "byte_size",
        "media_type"
      ],
      "title": "CodexImageArtifact",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Freeze the credential-free current-task provider boundary for one overlay session.",
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "contract_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Contract Id",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "workflow_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Workflow Id",
      "type": "string"
    },
    "dispatch_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Dispatch Id",
      "type": "string"
    },
    "session_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Session Id",
      "type": "string"
    },
    "profile_id": {
      "const": "autonomous_static_prop_v2_codex_imagegen",
      "default": "autonomous_static_prop_v2_codex_imagegen",
      "title": "Profile Id",
      "type": "string"
    },
    "provider_id": {
      "const": "codex_builtin_gpt_image_v1",
      "default": "codex_builtin_gpt_image_v1",
      "title": "Provider Id",
      "type": "string"
    },
    "input_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Sha256",
      "type": "string"
    },
    "source_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Fingerprint",
      "type": "string"
    },
    "producer": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Producer",
      "type": "string"
    },
    "producer_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Producer Version",
      "type": "string"
    },
    "provenance": {
      "items": {
        "$ref": "#/$defs/CodexImageArtifact"
      },
      "minItems": 1,
      "title": "Provenance",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "provider_profile_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Provider Profile Id",
      "type": "string"
    },
    "base_profile": {
      "const": "autonomous_static_prop_v2",
      "default": "autonomous_static_prop_v2",
      "title": "Base Profile",
      "type": "string"
    },
    "execution_mode": {
      "const": "controller_mediated",
      "default": "controller_mediated",
      "title": "Execution Mode",
      "type": "string"
    },
    "controller_mode": {
      "const": "desktop_in_session",
      "default": "desktop_in_session",
      "title": "Controller Mode",
      "type": "string"
    },
    "credential_scope": {
      "const": "none",
      "default": "none",
      "title": "Credential Scope",
      "type": "string"
    },
    "billing_scope": {
      "const": "codex_usage",
      "default": "codex_usage",
      "title": "Billing Scope",
      "type": "string"
    },
    "network_required": {
      "const": false,
      "default": false,
      "title": "Network Required",
      "type": "boolean"
    },
    "api_key_required": {
      "const": false,
      "default": false,
      "title": "Api Key Required",
      "type": "boolean"
    },
    "repository_can_spawn_codex_task": {
      "const": false,
      "default": false,
      "title": "Repository Can Spawn Codex Task",
      "type": "boolean"
    },
    "autonomous_daemon": {
      "const": false,
      "default": false,
      "title": "Autonomous Daemon",
      "type": "boolean"
    },
    "controller_required": {
      "const": true,
      "default": true,
      "title": "Controller Required",
      "type": "boolean"
    },
    "destination_project_write": {
      "const": false,
      "default": false,
      "title": "Destination Project Write",
      "type": "boolean"
    },
    "canonical_material_write": {
      "const": false,
      "default": false,
      "title": "Canonical Material Write",
      "type": "boolean"
    },
    "allowed_generation_intents": {
      "items": {
        "enum": [
          "generated_surface_swatch_v1",
          "generated_decal_art_v1",
          "generated_emission_pattern_v1",
          "reference_guided_texture_patch_v1",
          "generated_image_procedural_hybrid_v1"
        ],
        "type": "string"
      },
      "minItems": 1,
      "title": "Allowed Generation Intents",
      "type": "array"
    },
    "allowed_direct_output_roles": {
      "items": {
        "enum": [
          "base_color",
          "decal_rgb",
          "emission",
          "opacity_source"
        ],
        "type": "string"
      },
      "minItems": 1,
      "title": "Allowed Direct Output Roles",
      "type": "array"
    },
    "forbidden_direct_channels": {
      "items": {
        "enum": [
          "normal",
          "roughness",
          "metallic",
          "height",
          "displacement",
          "occlusion",
          "tangent_space_vectors"
        ],
        "type": "string"
      },
      "minItems": 1,
      "title": "Forbidden Direct Channels",
      "type": "array"
    },
    "status": {
      "const": "disabled_experimental",
      "default": "disabled_experimental",
      "title": "Status",
      "type": "string"
    },
    "activation_evidence": {
      "items": {
        "$ref": "#/$defs/CodexImageArtifact"
      },
      "maxItems": 0,
      "title": "Activation Evidence",
      "type": "array"
    }
  },
  "required": [
    "contract_id",
    "job_id",
    "workflow_id",
    "dispatch_id",
    "session_id",
    "input_sha256",
    "source_fingerprint",
    "producer",
    "provenance",
    "created_at",
    "provider_profile_id",
    "allowed_generation_intents",
    "allowed_direct_output_roles",
    "forbidden_direct_channels"
  ],
  "title": "CodexBuiltinImageProviderProfile",
  "type": "object"
}
