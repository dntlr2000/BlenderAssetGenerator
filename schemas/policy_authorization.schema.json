{
  "$defs": {
    "AutonomyArtifact": {
      "additionalProperties": false,
      "description": "Bind one contained artifact to its repository-relative path and exact bytes.",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "title": "AutonomyArtifact",
      "type": "object"
    },
    "BudgetUsage": {
      "additionalProperties": false,
      "description": "Count consumed actions without changing the authorized budget.",
      "properties": {
        "initial_candidates": {
          "default": 0,
          "minimum": 0,
          "title": "Initial Candidates",
          "type": "integer"
        },
        "structural_rounds": {
          "default": 0,
          "minimum": 0,
          "title": "Structural Rounds",
          "type": "integer"
        },
        "parametric_convergence_iterations": {
          "default": 0,
          "minimum": 0,
          "title": "Parametric Convergence Iterations",
          "type": "integer"
        },
        "material_rounds": {
          "default": 0,
          "minimum": 0,
          "title": "Material Rounds",
          "type": "integer"
        },
        "package_repairs": {
          "default": 0,
          "minimum": 0,
          "title": "Package Repairs",
          "type": "integer"
        },
        "total_blender_builds": {
          "default": 0,
          "minimum": 0,
          "title": "Total Blender Builds",
          "type": "integer"
        },
        "total_quality_evaluations": {
          "default": 0,
          "minimum": 0,
          "title": "Total Quality Evaluations",
          "type": "integer"
        },
        "canonical_promotions": {
          "default": 0,
          "minimum": 0,
          "title": "Canonical Promotions",
          "type": "integer"
        },
        "total_actions": {
          "default": 0,
          "minimum": 0,
          "title": "Total Actions",
          "type": "integer"
        }
      },
      "title": "BudgetUsage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Authorize one exact routine gate through policy rather than user approval.",
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "contract_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Contract Id",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "workflow_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Workflow Id",
      "type": "string"
    },
    "dispatch_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Dispatch Id",
      "type": "string"
    },
    "input_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Sha256",
      "type": "string"
    },
    "source_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Fingerprint",
      "type": "string"
    },
    "producer": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Producer",
      "type": "string"
    },
    "producer_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Producer Version",
      "type": "string"
    },
    "provenance": {
      "items": {
        "$ref": "#/$defs/AutonomyArtifact"
      },
      "minItems": 1,
      "title": "Provenance",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "authorization_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Authorization Id",
      "type": "string"
    },
    "authorization_source": {
      "const": "preauthorized_profile",
      "default": "preauthorized_profile",
      "title": "Authorization Source",
      "type": "string"
    },
    "decided_by": {
      "const": "autonomy_policy_engine",
      "default": "autonomy_policy_engine",
      "title": "Decided By",
      "type": "string"
    },
    "root_authorization": {
      "$ref": "#/$defs/AutonomyArtifact"
    },
    "root_authorization_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Root Authorization Sha256",
      "type": "string"
    },
    "profile": {
      "$ref": "#/$defs/AutonomyArtifact"
    },
    "profile_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Profile Sha256",
      "type": "string"
    },
    "budget": {
      "$ref": "#/$defs/AutonomyArtifact"
    },
    "workflow_step_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Workflow Step Id",
      "type": "string"
    },
    "workflow_input_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Workflow Input Fingerprint",
      "type": "string"
    },
    "gate_kind": {
      "enum": [
        "generic_proxy_review",
        "generic_detail_review",
        "material_swatch_acknowledgement",
        "structural_candidate_promotion",
        "bounded_convergence_plan",
        "bounded_convergence_candidate",
        "material_candidate_promotion",
        "qa_review_acknowledgement",
        "optimization_plan",
        "final_package_acknowledgement",
        "destination_handoff_envelope_plan"
      ],
      "title": "Gate Kind",
      "type": "string"
    },
    "gate_target": {
      "$ref": "#/$defs/AutonomyArtifact"
    },
    "target_artifact": {
      "$ref": "#/$defs/AutonomyArtifact"
    },
    "decision_reasons": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Decision Reasons",
      "type": "array"
    },
    "budget_before": {
      "$ref": "#/$defs/BudgetUsage"
    },
    "budget_after": {
      "$ref": "#/$defs/BudgetUsage"
    },
    "previous_authorization_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Previous Authorization Sha256"
    },
    "single_use": {
      "const": true,
      "default": true,
      "title": "Single Use",
      "type": "boolean"
    },
    "consumed": {
      "default": false,
      "title": "Consumed",
      "type": "boolean"
    },
    "consumed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Consumed At"
    }
  },
  "required": [
    "contract_id",
    "job_id",
    "workflow_id",
    "dispatch_id",
    "input_sha256",
    "source_fingerprint",
    "producer",
    "producer_version",
    "provenance",
    "created_at",
    "authorization_id",
    "root_authorization",
    "root_authorization_sha256",
    "profile",
    "profile_sha256",
    "budget",
    "workflow_step_id",
    "workflow_input_fingerprint",
    "gate_kind",
    "gate_target",
    "target_artifact",
    "decision_reasons",
    "budget_before",
    "budget_after"
  ],
  "title": "PolicyAuthorization",
  "type": "object"
}
