{
  "$defs": {
    "AutonomyArtifact": {
      "additionalProperties": false,
      "description": "Bind one contained artifact to its repository-relative path and exact bytes.",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "title": "AutonomyArtifact",
      "type": "object"
    },
    "BudgetUsage": {
      "additionalProperties": false,
      "description": "Count consumed actions without changing the authorized budget.",
      "properties": {
        "initial_candidates": {
          "default": 0,
          "minimum": 0,
          "title": "Initial Candidates",
          "type": "integer"
        },
        "structural_rounds": {
          "default": 0,
          "minimum": 0,
          "title": "Structural Rounds",
          "type": "integer"
        },
        "parametric_convergence_iterations": {
          "default": 0,
          "minimum": 0,
          "title": "Parametric Convergence Iterations",
          "type": "integer"
        },
        "material_rounds": {
          "default": 0,
          "minimum": 0,
          "title": "Material Rounds",
          "type": "integer"
        },
        "package_repairs": {
          "default": 0,
          "minimum": 0,
          "title": "Package Repairs",
          "type": "integer"
        },
        "total_blender_builds": {
          "default": 0,
          "minimum": 0,
          "title": "Total Blender Builds",
          "type": "integer"
        },
        "total_quality_evaluations": {
          "default": 0,
          "minimum": 0,
          "title": "Total Quality Evaluations",
          "type": "integer"
        },
        "canonical_promotions": {
          "default": 0,
          "minimum": 0,
          "title": "Canonical Promotions",
          "type": "integer"
        },
        "total_actions": {
          "default": 0,
          "minimum": 0,
          "title": "Total Actions",
          "type": "integer"
        }
      },
      "title": "BudgetUsage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Append one exact action transition to the immutable autonomy receipt chain.",
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "contract_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Contract Id",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "workflow_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Workflow Id",
      "type": "string"
    },
    "dispatch_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Dispatch Id",
      "type": "string"
    },
    "input_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Sha256",
      "type": "string"
    },
    "source_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Fingerprint",
      "type": "string"
    },
    "producer": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Producer",
      "type": "string"
    },
    "producer_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Producer Version",
      "type": "string"
    },
    "provenance": {
      "items": {
        "$ref": "#/$defs/AutonomyArtifact"
      },
      "minItems": 1,
      "title": "Provenance",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "receipt_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Receipt Id",
      "type": "string"
    },
    "session_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Session Id",
      "type": "string"
    },
    "sequence": {
      "minimum": 1,
      "title": "Sequence",
      "type": "integer"
    },
    "previous_receipt_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Previous Receipt Sha256"
    },
    "action": {
      "enum": [
        "collect_reference_evidence",
        "author_initial_candidate",
        "evaluate_candidate",
        "promote_best_candidate",
        "advance_production",
        "await_controller_output",
        "run_structural_round",
        "run_parametric_iteration",
        "run_material_round",
        "run_integrated_quality",
        "authorize_routine_gate",
        "run_optimization",
        "build_package",
        "build_review_bundle",
        "terminalize",
        "none"
      ],
      "title": "Action",
      "type": "string"
    },
    "state_before": {
      "$ref": "#/$defs/AutonomyArtifact"
    },
    "state_after": {
      "$ref": "#/$defs/AutonomyArtifact"
    },
    "budget_before": {
      "$ref": "#/$defs/BudgetUsage"
    },
    "budget_after": {
      "$ref": "#/$defs/BudgetUsage"
    },
    "candidate_evaluation": {
      "anyOf": [
        {
          "$ref": "#/$defs/AutonomyArtifact"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "policy_authorization": {
      "anyOf": [
        {
          "$ref": "#/$defs/AutonomyArtifact"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "candidate_promotion_receipt": {
      "anyOf": [
        {
          "$ref": "#/$defs/AutonomyArtifact"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "material_promotion_receipt": {
      "anyOf": [
        {
          "$ref": "#/$defs/AutonomyArtifact"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "host_attempt_evidence": {
      "items": {
        "$ref": "#/$defs/AutonomyArtifact"
      },
      "title": "Host Attempt Evidence",
      "type": "array"
    },
    "canonical_changed": {
      "default": false,
      "title": "Canonical Changed",
      "type": "boolean"
    },
    "rollback_performed": {
      "default": false,
      "title": "Rollback Performed",
      "type": "boolean"
    },
    "outcome": {
      "enum": [
        "advanced",
        "rolled_back",
        "terminal",
        "failed"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "failure_fingerprint": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failure Fingerprint"
    }
  },
  "required": [
    "contract_id",
    "job_id",
    "workflow_id",
    "dispatch_id",
    "input_sha256",
    "source_fingerprint",
    "producer",
    "producer_version",
    "provenance",
    "created_at",
    "receipt_id",
    "session_id",
    "sequence",
    "action",
    "state_before",
    "state_after",
    "budget_before",
    "budget_after",
    "outcome"
  ],
  "title": "AutonomyIterationReceipt",
  "type": "object"
}
