{
  "additionalProperties": false,
  "description": "Authorize one exact host-selected iteration under the active session envelope.",
  "properties": {
    "schema_version": {
      "const": "0.6.0",
      "default": "0.6.0",
      "title": "Schema Version",
      "type": "string"
    },
    "authorization_id": {
      "title": "Authorization Id",
      "type": "string"
    },
    "session_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$",
      "title": "Session Id",
      "type": "string"
    },
    "job_id": {
      "title": "Job Id",
      "type": "string"
    },
    "iteration_index": {
      "maximum": 5,
      "minimum": 1,
      "title": "Iteration Index",
      "type": "integer"
    },
    "plan_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Plan Sha256",
      "type": "string"
    },
    "approval_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Approval Sha256",
      "type": "string"
    },
    "base_scene_spec_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Base Scene Spec Sha256",
      "type": "string"
    },
    "source_qa_report_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Qa Report Sha256",
      "type": "string"
    },
    "candidates_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Candidates Sha256",
      "type": "string"
    },
    "source_build_fingerprint": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Build Fingerprint"
    },
    "selection_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Selection Sha256",
      "type": "string"
    },
    "compiled_plan_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Compiled Plan Sha256",
      "type": "string"
    },
    "selected_candidate_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Selected Candidate Ids",
      "type": "array"
    },
    "issued_by": {
      "const": "host_policy",
      "default": "host_policy",
      "title": "Issued By",
      "type": "string"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "authorization_id",
    "session_id",
    "job_id",
    "iteration_index",
    "plan_sha256",
    "approval_sha256",
    "base_scene_spec_sha256",
    "source_qa_report_sha256",
    "candidates_sha256",
    "selection_sha256",
    "compiled_plan_sha256",
    "selected_candidate_ids",
    "created_at"
  ],
  "title": "VisualConvergenceIterationAuthorization",
  "type": "object"
}
