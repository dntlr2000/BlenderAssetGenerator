{
  "$defs": {
    "ExactArtifact": {
      "additionalProperties": false,
      "description": "Bind one contained job-relative artifact by exact bytes and media type.",
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "pattern": "^[a-z][a-z0-9_]{1,95}$",
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "byte_size": {
          "minimum": 0,
          "title": "Byte Size",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 127,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "path",
        "sha256",
        "byte_size",
        "media_type"
      ],
      "title": "ExactArtifact",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Record one isolated Blender rebuild, inspect, and validate execution.",
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "workflow_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Workflow Id",
      "type": "string"
    },
    "dispatch_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Dispatch Id",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Run Id",
      "type": "string"
    },
    "producer": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Producer",
      "type": "string"
    },
    "producer_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Producer Version",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "receipt_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Receipt Id",
      "type": "string"
    },
    "request": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "status": {
      "enum": [
        "passed",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "blender_version": {
      "anyOf": [
        {
          "const": "5.0.1",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Blender Version"
    },
    "blender_executable_name": {
      "maxLength": 260,
      "minLength": 1,
      "title": "Blender Executable Name",
      "type": "string"
    },
    "blender_executable_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Blender Executable Sha256",
      "type": "string"
    },
    "blender_process_count": {
      "maximum": 3,
      "minimum": 0,
      "title": "Blender Process Count",
      "type": "integer"
    },
    "commands": {
      "items": {
        "type": "string"
      },
      "maxItems": 3,
      "title": "Commands",
      "type": "array"
    },
    "shadow_root": {
      "title": "Shadow Root",
      "type": "string"
    },
    "shadow_blend": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExactArtifact"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "shadow_scene_inventory": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExactArtifact"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "shadow_validation": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExactArtifact"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "material_binding_derivative": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExactArtifact"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "canonical_scene_spec_before": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "canonical_scene_spec_after": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "canonical_modeling_plan_before": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "canonical_modeling_plan_after": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "canonical_blend_before": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "canonical_blend_after": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "material_plan_absent_before": {
      "title": "Material Plan Absent Before",
      "type": "boolean"
    },
    "material_plan_absent_after": {
      "title": "Material Plan Absent After",
      "type": "boolean"
    },
    "canonical_unchanged": {
      "title": "Canonical Unchanged",
      "type": "boolean"
    }
  },
  "required": [
    "job_id",
    "workflow_id",
    "dispatch_id",
    "run_id",
    "producer",
    "producer_version",
    "created_at",
    "receipt_id",
    "request",
    "status",
    "blender_executable_name",
    "blender_executable_sha256",
    "blender_process_count",
    "commands",
    "shadow_root",
    "canonical_scene_spec_before",
    "canonical_scene_spec_after",
    "canonical_modeling_plan_before",
    "canonical_modeling_plan_after",
    "canonical_blend_before",
    "canonical_blend_after",
    "material_plan_absent_before",
    "material_plan_absent_after",
    "canonical_unchanged"
  ],
  "title": "MaterialIdentitySplitShadowBuildReceipt",
  "type": "object"
}
