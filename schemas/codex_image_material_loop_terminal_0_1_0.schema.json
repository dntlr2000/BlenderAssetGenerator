{
  "$defs": {
    "CodexImageArtifact": {
      "additionalProperties": false,
      "description": "Bind one non-empty job-contained file to exact bytes and media semantics.",
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "byte_size": {
          "exclusiveMinimum": 0,
          "title": "Byte Size",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "path",
        "sha256",
        "byte_size",
        "media_type"
      ],
      "title": "CodexImageArtifact",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Close only the companion material-adoption scope, never the whole AQ workflow.",
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "contract_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Contract Id",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "workflow_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Workflow Id",
      "type": "string"
    },
    "dispatch_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Dispatch Id",
      "type": "string"
    },
    "session_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Session Id",
      "type": "string"
    },
    "profile_id": {
      "const": "autonomous_static_prop_v2_codex_imagegen",
      "default": "autonomous_static_prop_v2_codex_imagegen",
      "title": "Profile Id",
      "type": "string"
    },
    "provider_id": {
      "const": "codex_builtin_gpt_image_v1",
      "default": "codex_builtin_gpt_image_v1",
      "title": "Provider Id",
      "type": "string"
    },
    "input_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Sha256",
      "type": "string"
    },
    "source_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Fingerprint",
      "type": "string"
    },
    "producer": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Producer",
      "type": "string"
    },
    "producer_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Producer Version",
      "type": "string"
    },
    "provenance": {
      "items": {
        "$ref": "#/$defs/CodexImageArtifact"
      },
      "minItems": 1,
      "title": "Provenance",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "immutable": {
      "const": true,
      "default": true,
      "title": "Immutable",
      "type": "boolean"
    },
    "bridge_plan": {
      "$ref": "#/$defs/CodexImageArtifact"
    },
    "latest_state": {
      "$ref": "#/$defs/CodexImageArtifact"
    },
    "base_state": {
      "$ref": "#/$defs/CodexImageArtifact"
    },
    "base_quality_terminal": {
      "anyOf": [
        {
          "$ref": "#/$defs/CodexImageArtifact"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "review_bundle": {
      "anyOf": [
        {
          "$ref": "#/$defs/CodexImageArtifact"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "promotion_receipt": {
      "anyOf": [
        {
          "$ref": "#/$defs/CodexImageArtifact"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "material_phase_receipt": {
      "anyOf": [
        {
          "$ref": "#/$defs/CodexImageArtifact"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "integrated_quality_report": {
      "anyOf": [
        {
          "$ref": "#/$defs/CodexImageArtifact"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "quality_freeze": {
      "anyOf": [
        {
          "$ref": "#/$defs/CodexImageArtifact"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "delivery_receipts": {
      "items": {
        "$ref": "#/$defs/CodexImageArtifact"
      },
      "title": "Delivery Receipts",
      "type": "array"
    },
    "status": {
      "enum": [
        "material_promoted",
        "waiting_for_quality",
        "quality_approved",
        "review_required",
        "blocked",
        "failed",
        "cancelled"
      ],
      "title": "Status",
      "type": "string"
    },
    "material_candidate_promoted": {
      "title": "Material Candidate Promoted",
      "type": "boolean"
    },
    "base_aq_completed": {
      "const": false,
      "default": false,
      "title": "Base Aq Completed",
      "type": "boolean"
    },
    "quality_passed": {
      "default": false,
      "title": "Quality Passed",
      "type": "boolean"
    },
    "packages_completed": {
      "default": false,
      "title": "Packages Completed",
      "type": "boolean"
    },
    "destination_runtime_parity_verified": {
      "const": false,
      "default": false,
      "title": "Destination Runtime Parity Verified",
      "type": "boolean"
    },
    "human_reviewed": {
      "const": false,
      "default": false,
      "title": "Human Reviewed",
      "type": "boolean"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    }
  },
  "required": [
    "contract_id",
    "job_id",
    "workflow_id",
    "dispatch_id",
    "session_id",
    "input_sha256",
    "source_fingerprint",
    "producer",
    "provenance",
    "created_at",
    "bridge_plan",
    "latest_state",
    "base_state",
    "status",
    "material_candidate_promoted"
  ],
  "title": "CodexImageMaterialLoopTerminal",
  "type": "object"
}
