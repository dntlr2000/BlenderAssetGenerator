{
  "$defs": {
    "CodexImageArtifact": {
      "additionalProperties": false,
      "description": "Bind one non-empty job-contained file to exact bytes and media semantics.",
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "byte_size": {
          "exclusiveMinimum": 0,
          "title": "Byte Size",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "path",
        "sha256",
        "byte_size",
        "media_type"
      ],
      "title": "CodexImageArtifact",
      "type": "object"
    },
    "DerivedChannelEvidence": {
      "additionalProperties": false,
      "description": "Bind one locally derived material channel to source, algorithm, and output bytes.",
      "properties": {
        "channel": {
          "enum": [
            "normal",
            "roughness",
            "metallic",
            "height",
            "displacement",
            "occlusion"
          ],
          "title": "Channel",
          "type": "string"
        },
        "algorithm_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Algorithm Id",
          "type": "string"
        },
        "source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "string"
              }
            ]
          },
          "title": "Parameters",
          "type": "object"
        },
        "parameters_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Parameters Sha256",
          "type": "string"
        },
        "output": {
          "$ref": "#/$defs/CodexImageArtifact"
        }
      },
      "required": [
        "channel",
        "algorithm_id",
        "source_sha256",
        "parameters",
        "parameters_sha256",
        "output"
      ],
      "title": "DerivedChannelEvidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Authorize one selected visual source for later local material authoring only.",
  "properties": {
    "schema_version": {
      "const": "0.2.0",
      "default": "0.2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "contract_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Contract Id",
      "type": "string"
    },
    "adoption_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Adoption Id",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "workflow_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Workflow Id",
      "type": "string"
    },
    "dispatch_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Dispatch Id",
      "type": "string"
    },
    "session_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Session Id",
      "type": "string"
    },
    "profile_id": {
      "const": "autonomous_static_prop_v2_codex_imagegen",
      "default": "autonomous_static_prop_v2_codex_imagegen",
      "title": "Profile Id",
      "type": "string"
    },
    "provider_id": {
      "const": "codex_builtin_gpt_image_v1",
      "default": "codex_builtin_gpt_image_v1",
      "title": "Provider Id",
      "type": "string"
    },
    "input_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Sha256",
      "type": "string"
    },
    "source_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Fingerprint",
      "type": "string"
    },
    "producer": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Producer",
      "type": "string"
    },
    "producer_version": {
      "const": "0.2.0",
      "default": "0.2.0",
      "title": "Producer Version",
      "type": "string"
    },
    "provenance": {
      "items": {
        "$ref": "#/$defs/CodexImageArtifact"
      },
      "minItems": 1,
      "title": "Provenance",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "selection": {
      "$ref": "#/$defs/CodexImageArtifact"
    },
    "selected_candidate": {
      "$ref": "#/$defs/CodexImageArtifact"
    },
    "generated_image_evidence": {
      "$ref": "#/$defs/CodexImageArtifact"
    },
    "quality_report": {
      "$ref": "#/$defs/CodexImageArtifact"
    },
    "selected_source_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Selected Source Sha256",
      "type": "string"
    },
    "target_material_ids": {
      "items": {
        "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Target Material Ids",
      "type": "array"
    },
    "material_strategy": {
      "enum": [
        "codex_generated_base_color_v1",
        "codex_generated_decal_v1",
        "codex_generated_emission_v1",
        "codex_generated_procedural_hybrid_v1"
      ],
      "title": "Material Strategy",
      "type": "string"
    },
    "direct_channels": {
      "items": {
        "enum": [
          "base_color",
          "decal_rgb",
          "emission",
          "opacity_source"
        ],
        "type": "string"
      },
      "minItems": 1,
      "title": "Direct Channels",
      "type": "array"
    },
    "derived_channels": {
      "items": {
        "$ref": "#/$defs/DerivedChannelEvidence"
      },
      "title": "Derived Channels",
      "type": "array"
    },
    "exact_text_composition": {
      "anyOf": [
        {
          "$ref": "#/$defs/CodexImageArtifact"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "complete_pbr_set": {
      "const": false,
      "default": false,
      "title": "Complete Pbr Set",
      "type": "boolean"
    },
    "provider_canonical_write": {
      "const": false,
      "default": false,
      "title": "Provider Canonical Write",
      "type": "boolean"
    },
    "canonical_write_performed": {
      "const": false,
      "default": false,
      "title": "Canonical Write Performed",
      "type": "boolean"
    },
    "destination_write_performed": {
      "const": false,
      "default": false,
      "title": "Destination Write Performed",
      "type": "boolean"
    }
  },
  "required": [
    "contract_id",
    "adoption_id",
    "job_id",
    "workflow_id",
    "dispatch_id",
    "session_id",
    "input_sha256",
    "source_fingerprint",
    "producer",
    "provenance",
    "created_at",
    "selection",
    "selected_candidate",
    "generated_image_evidence",
    "quality_report",
    "selected_source_sha256",
    "target_material_ids",
    "material_strategy",
    "direct_channels"
  ],
  "title": "ImageToMaterialAdoption",
  "type": "object"
}
