{
  "$defs": {
    "ProductionArtifact": {
      "additionalProperties": false,
      "description": "Bind one contained production artifact to a normalized path and exact digest.",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "title": "ProductionArtifact",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Declare the single-writer controller and bounded read-only delegation policy.",
  "properties": {
    "schema_version": {
      "const": "0.9.0",
      "default": "0.9.0",
      "title": "Schema Version",
      "type": "string"
    },
    "controller_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Controller Id",
      "type": "string"
    },
    "dispatch_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Dispatch Id",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "workflow_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Workflow Id",
      "type": "string"
    },
    "workflow_plan": {
      "$ref": "#/$defs/ProductionArtifact"
    },
    "canonical_writer": {
      "const": "controller_only",
      "default": "controller_only",
      "title": "Canonical Writer",
      "type": "string"
    },
    "subagent_mode": {
      "const": "read_only_advisory",
      "default": "read_only_advisory",
      "title": "Subagent Mode",
      "type": "string"
    },
    "max_parallel_read_only_advisors": {
      "default": 3,
      "maximum": 3,
      "minimum": 1,
      "title": "Max Parallel Read Only Advisors",
      "type": "integer"
    },
    "subagent_write_allowlist": {
      "items": {
        "type": "string"
      },
      "maxItems": 0,
      "title": "Subagent Write Allowlist",
      "type": "array"
    },
    "host_execution": {
      "const": "v08_resume_workflow",
      "default": "v08_resume_workflow",
      "title": "Host Execution",
      "type": "string"
    },
    "failed_retry_policy": {
      "const": "explicit_only",
      "default": "explicit_only",
      "title": "Failed Retry Policy",
      "type": "string"
    },
    "approval_boundaries": {
      "items": {
        "enum": [
          "generic_workflow_gate",
          "interior_scope",
          "interior_qa_plan",
          "visual_revision",
          "candidate_review_decision",
          "visual_convergence_plan",
          "optimization_plan",
          "destination_handoff_plan",
          "failed_step_retry"
        ],
        "type": "string"
      },
      "minItems": 1,
      "title": "Approval Boundaries",
      "type": "array"
    },
    "run_postflight_audit": {
      "const": true,
      "default": true,
      "title": "Run Postflight Audit",
      "type": "boolean"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "controller_id",
    "dispatch_id",
    "job_id",
    "workflow_id",
    "workflow_plan",
    "approval_boundaries",
    "created_at"
  ],
  "title": "DelegatedProductionControllerPlan",
  "type": "object"
}
