{
  "$defs": {
    "Artifact": {
      "additionalProperties": false,
      "description": "Identify one immutable contained input by exact path and digest.",
      "properties": {
        "path": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "title": "Artifact",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Consume the original specialized approval once, preserving decision bytes.",
  "properties": {
    "schema_version": {
      "const": "0.2.0",
      "default": "0.2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "profile": {
      "const": "authored_material_registered_solid_root_user_only",
      "default": "authored_material_registered_solid_root_user_only",
      "title": "Profile",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Run Id",
      "type": "string"
    },
    "apply_intent": {
      "$ref": "#/$defs/Artifact"
    },
    "approval": {
      "$ref": "#/$defs/Artifact"
    },
    "approval_request": {
      "$ref": "#/$defs/Artifact"
    },
    "user_decision": {
      "$ref": "#/$defs/Artifact"
    },
    "consumption_ordinal": {
      "const": 1,
      "default": 1,
      "title": "Consumption Ordinal",
      "type": "integer"
    },
    "consumed_once": {
      "const": true,
      "default": true,
      "title": "Consumed Once",
      "type": "boolean"
    }
  },
  "required": [
    "job_id",
    "run_id",
    "apply_intent",
    "approval",
    "approval_request",
    "user_decision"
  ],
  "title": "AuthoredMaterialIdentitySplitConsumptionV02",
  "type": "object"
}
