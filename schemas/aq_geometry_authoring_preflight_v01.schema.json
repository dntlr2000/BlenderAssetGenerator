{
  "$defs": {
    "AQV2Artifact": {
      "additionalProperties": false,
      "description": "Bind one immutable job-contained artifact to exact bytes and role.",
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "byte_size": {
          "exclusiveMinimum": 0,
          "title": "Byte Size",
          "type": "integer"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "path",
        "sha256",
        "byte_size"
      ],
      "title": "AQV2Artifact",
      "type": "object"
    },
    "BudgetUsageV2": {
      "additionalProperties": false,
      "description": "Count consumed AQ v2 work without mutating the immutable budget.",
      "properties": {
        "initial_candidates": {
          "default": 0,
          "minimum": 0,
          "title": "Initial Candidates",
          "type": "integer"
        },
        "structural_rounds": {
          "default": 0,
          "minimum": 0,
          "title": "Structural Rounds",
          "type": "integer"
        },
        "parametric_convergence_iterations": {
          "default": 0,
          "minimum": 0,
          "title": "Parametric Convergence Iterations",
          "type": "integer"
        },
        "material_rounds": {
          "default": 0,
          "minimum": 0,
          "title": "Material Rounds",
          "type": "integer"
        },
        "total_blender_builds": {
          "default": 0,
          "minimum": 0,
          "title": "Total Blender Builds",
          "type": "integer"
        },
        "total_quality_evaluations": {
          "default": 0,
          "minimum": 0,
          "title": "Total Quality Evaluations",
          "type": "integer"
        },
        "controller_invocations": {
          "default": 0,
          "minimum": 0,
          "title": "Controller Invocations",
          "type": "integer"
        },
        "delivery_runs": {
          "default": 0,
          "minimum": 0,
          "title": "Delivery Runs",
          "type": "integer"
        },
        "canonical_promotions": {
          "default": 0,
          "minimum": 0,
          "title": "Canonical Promotions",
          "type": "integer"
        },
        "package_repairs": {
          "default": 0,
          "minimum": 0,
          "title": "Package Repairs",
          "type": "integer"
        },
        "total_actions": {
          "default": 0,
          "minimum": 0,
          "title": "Total Actions",
          "type": "integer"
        }
      },
      "title": "BudgetUsageV2",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Bind one proposed candidate and its finite cost to the exact pre-controller state.",
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "contract_kind": {
      "const": "geometry_authoring_preflight",
      "default": "geometry_authoring_preflight",
      "title": "Contract Kind",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "session_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Session Id",
      "type": "string"
    },
    "current_state": {
      "$ref": "#/$defs/AQV2Artifact"
    },
    "root_authorization": {
      "$ref": "#/$defs/AQV2Artifact"
    },
    "budget": {
      "$ref": "#/$defs/AQV2Artifact"
    },
    "source_inputs": {
      "items": {
        "$ref": "#/$defs/AQV2Artifact"
      },
      "minItems": 4,
      "title": "Source Inputs",
      "type": "array"
    },
    "candidate_modeling_plan": {
      "$ref": "#/$defs/AQV2Artifact"
    },
    "candidate_scene_spec_v03": {
      "$ref": "#/$defs/AQV2Artifact"
    },
    "structure_authoring": {
      "anyOf": [
        {
          "$ref": "#/$defs/AQV2Artifact"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "outcome": {
      "enum": [
        "passed",
        "invalid_candidate",
        "budget_exhausted"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "issues": {
      "items": {
        "type": "string"
      },
      "title": "Issues",
      "type": "array"
    },
    "candidate_object_count": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Candidate Object Count"
    },
    "required_blender_builds": {
      "anyOf": [
        {
          "minimum": 2,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Required Blender Builds"
    },
    "budget_usage_after": {
      "anyOf": [
        {
          "$ref": "#/$defs/BudgetUsageV2"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "controller_execution_authority": {
      "const": false,
      "default": false,
      "title": "Controller Execution Authority",
      "type": "boolean"
    },
    "canonical_write_authority": {
      "const": false,
      "default": false,
      "title": "Canonical Write Authority",
      "type": "boolean"
    },
    "approval_authority": {
      "const": false,
      "default": false,
      "title": "Approval Authority",
      "type": "boolean"
    },
    "budget_consumed": {
      "const": false,
      "default": false,
      "title": "Budget Consumed",
      "type": "boolean"
    }
  },
  "required": [
    "job_id",
    "session_id",
    "current_state",
    "root_authorization",
    "budget",
    "source_inputs",
    "candidate_modeling_plan",
    "candidate_scene_spec_v03",
    "outcome",
    "issues"
  ],
  "title": "GeometryAuthoringPreflightV01",
  "type": "object"
}
