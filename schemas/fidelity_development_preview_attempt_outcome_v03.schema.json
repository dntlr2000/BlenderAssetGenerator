{
  "$defs": {
    "FidelityArtifact": {
      "additionalProperties": false,
      "description": "Bind a contained artifact to its immutable bytes, not a mutable latest pointer.",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "title": "FidelityArtifact",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Close the final technical retry added by the material-refinement extension.",
  "properties": {
    "schema_version": {
      "const": "0.3.0",
      "default": "0.3.0",
      "title": "Schema Version",
      "type": "string"
    },
    "contract_kind": {
      "const": "fidelity_development_preview_attempt_outcome",
      "default": "fidelity_development_preview_attempt_outcome",
      "title": "Contract Kind",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "attempt_index": {
      "const": 10,
      "title": "Attempt Index",
      "type": "integer"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Run Id",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/FidelityArtifact"
    },
    "outcome": {
      "enum": [
        "completed",
        "technical_failure"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "result": {
      "anyOf": [
        {
          "$ref": "#/$defs/FidelityArtifact"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "error_type": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Type"
    },
    "error_message": {
      "anyOf": [
        {
          "maxLength": 2048,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Message"
    },
    "scope_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Scope Sha256",
      "type": "string"
    },
    "canonical_write_authority": {
      "const": false,
      "default": false,
      "title": "Canonical Write Authority",
      "type": "boolean"
    },
    "human_quality_disposition": {
      "const": "not_recorded",
      "default": "not_recorded",
      "title": "Human Quality Disposition",
      "type": "string"
    },
    "activation_authority": {
      "const": false,
      "default": false,
      "title": "Activation Authority",
      "type": "boolean"
    }
  },
  "required": [
    "job_id",
    "attempt_index",
    "run_id",
    "source",
    "outcome",
    "scope_sha256"
  ],
  "title": "DevelopmentPreviewAttemptOutcomeV03",
  "type": "object"
}
