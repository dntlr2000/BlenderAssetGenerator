{
  "$defs": {
    "CodexImageArtifact": {
      "additionalProperties": false,
      "description": "Bind one non-empty job-contained file to exact bytes and media semantics.",
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "byte_size": {
          "exclusiveMinimum": 0,
          "title": "Byte Size",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "path",
        "sha256",
        "byte_size",
        "media_type"
      ],
      "title": "CodexImageArtifact",
      "type": "object"
    },
    "CodexImageGenerationBudgetUsage": {
      "additionalProperties": false,
      "description": "Record reconstructed budget use without mutating the immutable budget contract.",
      "properties": {
        "assignments": {
          "default": 0,
          "minimum": 0,
          "title": "Assignments",
          "type": "integer"
        },
        "total_generations": {
          "default": 0,
          "minimum": 0,
          "title": "Total Generations",
          "type": "integer"
        },
        "candidates": {
          "default": 0,
          "minimum": 0,
          "title": "Candidates",
          "type": "integer"
        },
        "edits_or_refinements": {
          "default": 0,
          "minimum": 0,
          "title": "Edits Or Refinements",
          "type": "integer"
        },
        "elapsed_seconds": {
          "default": 0,
          "minimum": 0,
          "title": "Elapsed Seconds",
          "type": "integer"
        }
      },
      "title": "CodexImageGenerationBudgetUsage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Represent one reconstructable companion state without changing base AQ v2.",
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "contract_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Contract Id",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "workflow_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Workflow Id",
      "type": "string"
    },
    "dispatch_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Dispatch Id",
      "type": "string"
    },
    "session_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Session Id",
      "type": "string"
    },
    "profile_id": {
      "const": "autonomous_static_prop_v2_codex_imagegen",
      "default": "autonomous_static_prop_v2_codex_imagegen",
      "title": "Profile Id",
      "type": "string"
    },
    "provider_id": {
      "const": "codex_builtin_gpt_image_v1",
      "default": "codex_builtin_gpt_image_v1",
      "title": "Provider Id",
      "type": "string"
    },
    "input_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Sha256",
      "type": "string"
    },
    "source_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Fingerprint",
      "type": "string"
    },
    "producer": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Producer",
      "type": "string"
    },
    "producer_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Producer Version",
      "type": "string"
    },
    "provenance": {
      "items": {
        "$ref": "#/$defs/CodexImageArtifact"
      },
      "minItems": 1,
      "title": "Provenance",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "overlay_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Overlay Id",
      "type": "string"
    },
    "base_profile": {
      "const": "autonomous_static_prop_v2",
      "default": "autonomous_static_prop_v2",
      "title": "Base Profile",
      "type": "string"
    },
    "profile_status": {
      "const": "disabled_experimental",
      "default": "disabled_experimental",
      "title": "Profile Status",
      "type": "string"
    },
    "execution_mode": {
      "const": "controller_mediated",
      "default": "controller_mediated",
      "title": "Execution Mode",
      "type": "string"
    },
    "controller_mode": {
      "const": "desktop_in_session",
      "default": "desktop_in_session",
      "title": "Controller Mode",
      "type": "string"
    },
    "codex_imagegen_allowed": {
      "const": true,
      "default": true,
      "title": "Codex Imagegen Allowed",
      "type": "boolean"
    },
    "controller_required": {
      "const": true,
      "default": true,
      "title": "Controller Required",
      "type": "boolean"
    },
    "repository_can_spawn_codex_task": {
      "const": false,
      "default": false,
      "title": "Repository Can Spawn Codex Task",
      "type": "boolean"
    },
    "autonomous_daemon": {
      "const": false,
      "default": false,
      "title": "Autonomous Daemon",
      "type": "boolean"
    },
    "continuation_after_app_exit": {
      "const": false,
      "default": false,
      "title": "Continuation After App Exit",
      "type": "boolean"
    },
    "destination_project_write": {
      "const": false,
      "default": false,
      "title": "Destination Project Write",
      "type": "boolean"
    },
    "canonical_material_write": {
      "const": false,
      "default": false,
      "title": "Canonical Material Write",
      "type": "boolean"
    },
    "generation_plan": {
      "$ref": "#/$defs/CodexImageArtifact"
    },
    "provider_profile": {
      "$ref": "#/$defs/CodexImageArtifact"
    },
    "budget": {
      "$ref": "#/$defs/CodexImageArtifact"
    },
    "sequence": {
      "minimum": 0,
      "title": "Sequence",
      "type": "integer"
    },
    "transition_event": {
      "enum": [
        "initialized",
        "assignment_published",
        "completion_adopted",
        "quality_completed",
        "candidate_selected",
        "material_adopted",
        "material_candidate_staged",
        "base_material_authoring_resumed",
        "local_procedural_fallback",
        "review_required",
        "user_image_required",
        "failed",
        "cancelled"
      ],
      "title": "Transition Event",
      "type": "string"
    },
    "phase": {
      "enum": [
        "planned",
        "controller",
        "completion",
        "quality",
        "selection",
        "adoption",
        "resume",
        "terminal"
      ],
      "title": "Phase",
      "type": "string"
    },
    "status": {
      "enum": [
        "planned",
        "waiting_for_controller",
        "completion_adopted",
        "quality_ready",
        "selected",
        "adopted",
        "completed",
        "local_procedural_fallback",
        "review_required",
        "user_image_required",
        "failed",
        "cancelled"
      ],
      "title": "Status",
      "type": "string"
    },
    "next_action": {
      "enum": [
        "publish_assignment",
        "adopt_completion",
        "evaluate_quality",
        "select_candidate",
        "adopt_material",
        "resume_base_material_authoring",
        "controller_promotion_required",
        "none"
      ],
      "title": "Next Action",
      "type": "string"
    },
    "budget_usage": {
      "$ref": "#/$defs/CodexImageGenerationBudgetUsage"
    },
    "assignment": {
      "anyOf": [
        {
          "$ref": "#/$defs/CodexImageArtifact"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "controller_request": {
      "anyOf": [
        {
          "$ref": "#/$defs/CodexImageArtifact"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "completion": {
      "anyOf": [
        {
          "$ref": "#/$defs/CodexImageArtifact"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "controller_result": {
      "anyOf": [
        {
          "$ref": "#/$defs/CodexImageArtifact"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "candidates": {
      "items": {
        "$ref": "#/$defs/CodexImageArtifact"
      },
      "maxItems": 3,
      "title": "Candidates",
      "type": "array"
    },
    "quality_reports": {
      "items": {
        "$ref": "#/$defs/CodexImageArtifact"
      },
      "maxItems": 3,
      "title": "Quality Reports",
      "type": "array"
    },
    "selection": {
      "anyOf": [
        {
          "$ref": "#/$defs/CodexImageArtifact"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "material_adoption": {
      "anyOf": [
        {
          "$ref": "#/$defs/CodexImageArtifact"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "material_authoring_receipt": {
      "anyOf": [
        {
          "$ref": "#/$defs/CodexImageArtifact"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "generation_terminal": {
      "anyOf": [
        {
          "$ref": "#/$defs/CodexImageArtifact"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "base_resume_state": {
      "anyOf": [
        {
          "$ref": "#/$defs/CodexImageArtifact"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "previous_state_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Previous State Sha256"
    },
    "terminal_reason": {
      "anyOf": [
        {
          "maxLength": 1024,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Terminal Reason"
    }
  },
  "required": [
    "contract_id",
    "job_id",
    "workflow_id",
    "dispatch_id",
    "session_id",
    "input_sha256",
    "source_fingerprint",
    "producer",
    "provenance",
    "created_at",
    "overlay_id",
    "generation_plan",
    "provider_profile",
    "budget",
    "sequence",
    "transition_event",
    "phase",
    "status",
    "next_action"
  ],
  "title": "AutonomyCodexImageOverlay",
  "type": "object"
}
