{
  "$defs": {
    "CodexGeneratedFile": {
      "additionalProperties": false,
      "description": "Describe one generated raster in the assignment-declared staging file set.",
      "properties": {
        "candidate_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Candidate Id",
          "type": "string"
        },
        "ordinal": {
          "maximum": 2,
          "minimum": 0,
          "title": "Ordinal",
          "type": "integer"
        },
        "output_role": {
          "enum": [
            "base_color",
            "decal_rgb",
            "emission",
            "opacity_source"
          ],
          "title": "Output Role",
          "type": "string"
        },
        "artifact": {
          "$ref": "#/$defs/CodexImageArtifact"
        },
        "width": {
          "maximum": 2048,
          "minimum": 64,
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "maximum": 2048,
          "minimum": 64,
          "title": "Height",
          "type": "integer"
        },
        "image_format": {
          "const": "png",
          "default": "png",
          "title": "Image Format",
          "type": "string"
        },
        "alpha_present": {
          "title": "Alpha Present",
          "type": "boolean"
        }
      },
      "required": [
        "candidate_id",
        "ordinal",
        "output_role",
        "artifact",
        "width",
        "height",
        "alpha_present"
      ],
      "title": "CodexGeneratedFile",
      "type": "object"
    },
    "CodexImageArtifact": {
      "additionalProperties": false,
      "description": "Bind one non-empty job-contained file to exact bytes and media semantics.",
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "byte_size": {
          "exclusiveMinimum": 0,
          "title": "Byte Size",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "path",
        "sha256",
        "byte_size",
        "media_type"
      ],
      "title": "CodexImageArtifact",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Describe generated pixels honestly as staged visual content, not a PBR set.",
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "contract_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Contract Id",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "workflow_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Workflow Id",
      "type": "string"
    },
    "dispatch_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Dispatch Id",
      "type": "string"
    },
    "session_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Session Id",
      "type": "string"
    },
    "profile_id": {
      "const": "autonomous_static_prop_v2_codex_imagegen",
      "default": "autonomous_static_prop_v2_codex_imagegen",
      "title": "Profile Id",
      "type": "string"
    },
    "provider_id": {
      "const": "codex_builtin_gpt_image_v1",
      "default": "codex_builtin_gpt_image_v1",
      "title": "Provider Id",
      "type": "string"
    },
    "input_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Sha256",
      "type": "string"
    },
    "source_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Fingerprint",
      "type": "string"
    },
    "producer": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Producer",
      "type": "string"
    },
    "producer_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Producer Version",
      "type": "string"
    },
    "provenance": {
      "items": {
        "$ref": "#/$defs/CodexImageArtifact"
      },
      "minItems": 1,
      "title": "Provenance",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "evidence_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Evidence Id",
      "type": "string"
    },
    "assignment": {
      "$ref": "#/$defs/CodexImageArtifact"
    },
    "completion": {
      "$ref": "#/$defs/CodexImageArtifact"
    },
    "controller_request": {
      "$ref": "#/$defs/CodexImageArtifact"
    },
    "controller_result": {
      "$ref": "#/$defs/CodexImageArtifact"
    },
    "candidate": {
      "$ref": "#/$defs/CodexImageArtifact"
    },
    "candidate_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Candidate Id",
      "type": "string"
    },
    "generated_file": {
      "$ref": "#/$defs/CodexGeneratedFile"
    },
    "target_material_ids": {
      "items": {
        "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Target Material Ids",
      "type": "array"
    },
    "semantic_roles": {
      "items": {
        "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Semantic Roles",
      "type": "array"
    },
    "generation_intent": {
      "enum": [
        "generated_surface_swatch_v1",
        "generated_decal_art_v1",
        "generated_emission_pattern_v1",
        "reference_guided_texture_patch_v1",
        "generated_image_procedural_hybrid_v1"
      ],
      "title": "Generation Intent",
      "type": "string"
    },
    "staging_only": {
      "const": true,
      "default": true,
      "title": "Staging Only",
      "type": "boolean"
    },
    "complete_pbr_set": {
      "const": false,
      "default": false,
      "title": "Complete Pbr Set",
      "type": "boolean"
    },
    "human_reviewed": {
      "const": false,
      "default": false,
      "title": "Human Reviewed",
      "type": "boolean"
    },
    "rights_scope": {
      "const": "project_generated_codex_usage",
      "default": "project_generated_codex_usage",
      "title": "Rights Scope",
      "type": "string"
    }
  },
  "required": [
    "contract_id",
    "job_id",
    "workflow_id",
    "dispatch_id",
    "session_id",
    "input_sha256",
    "source_fingerprint",
    "producer",
    "provenance",
    "created_at",
    "evidence_id",
    "assignment",
    "completion",
    "controller_request",
    "controller_result",
    "candidate",
    "candidate_id",
    "generated_file",
    "target_material_ids",
    "semantic_roles",
    "generation_intent"
  ],
  "title": "CodexGeneratedImageEvidence",
  "type": "object"
}
