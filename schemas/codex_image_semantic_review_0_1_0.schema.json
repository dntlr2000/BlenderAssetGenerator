{
  "$defs": {
    "CodexImageArtifact": {
      "additionalProperties": false,
      "description": "Bind one non-empty job-contained file to exact bytes and media semantics.",
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "byte_size": {
          "exclusiveMinimum": 0,
          "title": "Byte Size",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "path",
        "sha256",
        "byte_size",
        "media_type"
      ],
      "title": "CodexImageArtifact",
      "type": "object"
    },
    "CodexImageSemanticCheck": {
      "additionalProperties": false,
      "description": "Store one bounded visual observation without human-review or truth authority.",
      "properties": {
        "category": {
          "enum": [
            "unwanted_text",
            "unwanted_object_or_background",
            "material_family_suitability",
            "signage_or_decal_suitability",
            "wood_grain_naturalness",
            "decorative_pattern_asset_suitability",
            "crystal_or_energy_pattern_suitability",
            "reference_style_alignment",
            "repeat_or_tile_suitability",
            "lighting_hotspot",
            "perspective_distortion",
            "boundary_contamination"
          ],
          "title": "Category",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "passed",
            "review_required",
            "failed",
            "unavailable"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "rationale": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "explicit_forbidden_content": {
          "default": false,
          "title": "Explicit Forbidden Content",
          "type": "boolean"
        }
      },
      "required": [
        "category",
        "outcome",
        "confidence",
        "rationale"
      ],
      "title": "CodexImageSemanticCheck",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Record current-task visual observations as advisory, non-human evidence.",
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "contract_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Contract Id",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "workflow_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Workflow Id",
      "type": "string"
    },
    "dispatch_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Dispatch Id",
      "type": "string"
    },
    "session_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Session Id",
      "type": "string"
    },
    "profile_id": {
      "const": "autonomous_static_prop_v2_codex_imagegen",
      "default": "autonomous_static_prop_v2_codex_imagegen",
      "title": "Profile Id",
      "type": "string"
    },
    "provider_id": {
      "const": "codex_builtin_gpt_image_v1",
      "default": "codex_builtin_gpt_image_v1",
      "title": "Provider Id",
      "type": "string"
    },
    "input_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Sha256",
      "type": "string"
    },
    "source_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Fingerprint",
      "type": "string"
    },
    "producer": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Producer",
      "type": "string"
    },
    "producer_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Producer Version",
      "type": "string"
    },
    "provenance": {
      "items": {
        "$ref": "#/$defs/CodexImageArtifact"
      },
      "minItems": 1,
      "title": "Provenance",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "immutable": {
      "const": true,
      "default": true,
      "title": "Immutable",
      "type": "boolean"
    },
    "candidate_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Candidate Id",
      "type": "string"
    },
    "reviewed_image": {
      "$ref": "#/$defs/CodexImageArtifact"
    },
    "assignment": {
      "$ref": "#/$defs/CodexImageArtifact"
    },
    "deterministic_quality_report": {
      "$ref": "#/$defs/CodexImageArtifact"
    },
    "material_family": {
      "enum": [
        "wood",
        "signage_decal",
        "emissive",
        "crystal",
        "user_image_pbr",
        "planar_reference_patch"
      ],
      "title": "Material Family",
      "type": "string"
    },
    "checks": {
      "items": {
        "$ref": "#/$defs/CodexImageSemanticCheck"
      },
      "maxItems": 12,
      "minItems": 12,
      "title": "Checks",
      "type": "array"
    },
    "outcome": {
      "enum": [
        "passed",
        "review_required",
        "failed",
        "unavailable"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "human_reviewed": {
      "const": false,
      "default": false,
      "title": "Human Reviewed",
      "type": "boolean"
    },
    "observed_reference_truth": {
      "const": false,
      "default": false,
      "title": "Observed Reference Truth",
      "type": "boolean"
    },
    "deterministic_gates_replaced": {
      "const": false,
      "default": false,
      "title": "Deterministic Gates Replaced",
      "type": "boolean"
    },
    "selection_authority": {
      "const": "advisory_after_deterministic_gates",
      "default": "advisory_after_deterministic_gates",
      "title": "Selection Authority",
      "type": "string"
    }
  },
  "required": [
    "contract_id",
    "job_id",
    "workflow_id",
    "dispatch_id",
    "session_id",
    "input_sha256",
    "source_fingerprint",
    "producer",
    "provenance",
    "created_at",
    "candidate_id",
    "reviewed_image",
    "assignment",
    "deterministic_quality_report",
    "material_family",
    "checks",
    "outcome"
  ],
  "title": "CodexImageSemanticReview",
  "type": "object"
}
