{
  "$defs": {
    "ExactArtifact": {
      "additionalProperties": false,
      "description": "Bind one contained job-relative artifact by exact bytes and media type.",
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "pattern": "^[a-z][a-z0-9_]{1,95}$",
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "byte_size": {
          "minimum": 0,
          "title": "Byte Size",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 127,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "path",
        "sha256",
        "byte_size",
        "media_type"
      ],
      "title": "ExactArtifact",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Project append-only states without creating a mutable authoritative latest file.",
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "workflow_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Workflow Id",
      "type": "string"
    },
    "dispatch_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Dispatch Id",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Run Id",
      "type": "string"
    },
    "producer": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Producer",
      "type": "string"
    },
    "producer_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Producer Version",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "projection_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Projection Id",
      "type": "string"
    },
    "transaction_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Transaction Id",
      "type": "string"
    },
    "state_artifacts": {
      "items": {
        "$ref": "#/$defs/ExactArtifact"
      },
      "minItems": 1,
      "title": "State Artifacts",
      "type": "array"
    },
    "latest_state": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "latest_sequence": {
      "minimum": 0,
      "title": "Latest Sequence",
      "type": "integer"
    },
    "status": {
      "enum": [
        "planned",
        "preapproval_running",
        "preapproval_failed",
        "eligible_for_explicit_user_scope_approval",
        "approval_consumed",
        "archives_written",
        "scene_spec_replaced",
        "modeling_plan_replaced",
        "blender_rebuilt",
        "invariants_verified",
        "committed",
        "rollback_started",
        "rolled_back",
        "recovery_required"
      ],
      "title": "Status",
      "type": "string"
    },
    "framework_ready_for_explicit_scope_approval": {
      "title": "Framework Ready For Explicit Scope Approval",
      "type": "boolean"
    },
    "approval_request": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExactArtifact"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "actual_user_approval_count": {
      "minimum": 0,
      "title": "Actual User Approval Count",
      "type": "integer"
    },
    "approval_consumption_count": {
      "minimum": 0,
      "title": "Approval Consumption Count",
      "type": "integer"
    },
    "apply_intent_count": {
      "minimum": 0,
      "title": "Apply Intent Count",
      "type": "integer"
    },
    "canonical_write_count": {
      "minimum": 0,
      "title": "Canonical Write Count",
      "type": "integer"
    },
    "repair_session_count": {
      "minimum": 0,
      "title": "Repair Session Count",
      "type": "integer"
    },
    "controller_count": {
      "minimum": 0,
      "title": "Controller Count",
      "type": "integer"
    },
    "promotion_count": {
      "minimum": 0,
      "title": "Promotion Count",
      "type": "integer"
    },
    "material_phase_receipt_count": {
      "minimum": 0,
      "title": "Material Phase Receipt Count",
      "type": "integer"
    },
    "iq_count": {
      "minimum": 0,
      "title": "Iq Count",
      "type": "integer"
    },
    "package_count": {
      "minimum": 0,
      "title": "Package Count",
      "type": "integer"
    },
    "destination_write_count": {
      "minimum": 0,
      "title": "Destination Write Count",
      "type": "integer"
    }
  },
  "required": [
    "job_id",
    "workflow_id",
    "dispatch_id",
    "run_id",
    "producer",
    "producer_version",
    "created_at",
    "projection_id",
    "transaction_id",
    "state_artifacts",
    "latest_state",
    "latest_sequence",
    "status",
    "framework_ready_for_explicit_scope_approval",
    "actual_user_approval_count",
    "approval_consumption_count",
    "apply_intent_count",
    "canonical_write_count",
    "repair_session_count",
    "controller_count",
    "promotion_count",
    "material_phase_receipt_count",
    "iq_count",
    "package_count",
    "destination_write_count"
  ],
  "title": "MaterialIdentitySplitStatusProjection",
  "type": "object"
}
