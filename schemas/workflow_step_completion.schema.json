{
  "$defs": {
    "ArtifactFreshness": {
      "additionalProperties": false,
      "description": "Separate integrity, currency, and verification for one observed artifact.",
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z0-9][a-z0-9_.-]{0,95}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "integrity": {
          "enum": [
            "valid",
            "corrupt",
            "missing"
          ],
          "title": "Integrity",
          "type": "string"
        },
        "currency": {
          "enum": [
            "current",
            "superseded",
            "unknown"
          ],
          "title": "Currency",
          "type": "string"
        },
        "verification": {
          "enum": [
            "verified",
            "partially_verified",
            "unverified"
          ],
          "title": "Verification",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "path",
        "integrity",
        "currency",
        "verification",
        "reason"
      ],
      "title": "ArtifactFreshness",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Bind an agent/manual completion marker to exact current outputs.",
  "properties": {
    "schema_version": {
      "const": "0.8.0",
      "default": "0.8.0",
      "title": "Schema Version",
      "type": "string"
    },
    "completion_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Completion Id",
      "type": "string"
    },
    "workflow_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Workflow Id",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "step_id": {
      "pattern": "^[a-z0-9][a-z0-9_.-]{0,95}$",
      "title": "Step Id",
      "type": "string"
    },
    "plan_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Plan Sha256",
      "type": "string"
    },
    "input_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Fingerprint",
      "type": "string"
    },
    "output_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Output Fingerprint",
      "type": "string"
    },
    "output_artifacts": {
      "items": {
        "$ref": "#/$defs/ArtifactFreshness"
      },
      "title": "Output Artifacts",
      "type": "array"
    },
    "note": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Note",
      "type": "string"
    },
    "recorded_at": {
      "format": "date-time",
      "title": "Recorded At",
      "type": "string"
    }
  },
  "required": [
    "completion_id",
    "workflow_id",
    "job_id",
    "step_id",
    "plan_sha256",
    "input_fingerprint",
    "output_fingerprint",
    "output_artifacts",
    "note",
    "recorded_at"
  ],
  "title": "WorkflowStepCompletion",
  "type": "object"
}
