{
  "$defs": {
    "CodexImageV05BridgeChannel": {
      "additionalProperties": false,
      "description": "Bind one 0.2.1 channel to its byte-identical run-owned V0.5 dependency.",
      "properties": {
        "channel": {
          "enum": [
            "base_color",
            "roughness",
            "metallic",
            "normal",
            "height",
            "occlusion",
            "opacity",
            "emission"
          ],
          "title": "Channel",
          "type": "string"
        },
        "provenance_kind": {
          "enum": [
            "codex_generated_direct",
            "local_deterministic_derivation",
            "local_exact_text_composition",
            "local_constant"
          ],
          "title": "Provenance Kind",
          "type": "string"
        },
        "algorithm_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Algorithm Id",
          "type": "string"
        },
        "algorithm_version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Algorithm Version",
          "type": "string"
        },
        "source_sha256": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Sha256",
          "type": "array"
        },
        "source": {
          "$ref": "#/$defs/ExactArtifact"
        },
        "adapted": {
          "$ref": "#/$defs/ExactArtifact"
        },
        "width": {
          "maximum": 4096,
          "minimum": 1,
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "maximum": 4096,
          "minimum": 1,
          "title": "Height",
          "type": "integer"
        },
        "color_space": {
          "enum": [
            "srgb",
            "non_color"
          ],
          "title": "Color Space",
          "type": "string"
        },
        "normal_convention": {
          "anyOf": [
            {
              "const": "opengl_y_plus",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Normal Convention"
        },
        "v05_usage": {
          "enum": [
            "texture_manifest_and_graph",
            "material_graph_only"
          ],
          "title": "V05 Usage",
          "type": "string"
        }
      },
      "required": [
        "channel",
        "provenance_kind",
        "algorithm_id",
        "algorithm_version",
        "source_sha256",
        "source",
        "adapted",
        "width",
        "height",
        "color_space",
        "v05_usage"
      ],
      "title": "CodexImageV05BridgeChannel",
      "type": "object"
    },
    "CodexImageV05ControllerInput": {
      "additionalProperties": false,
      "description": "Alias one exact dependency to an existing material controller input role.",
      "properties": {
        "role": {
          "enum": [
            "scene",
            "material-baseline",
            "scale-context"
          ],
          "title": "Role",
          "type": "string"
        },
        "artifact": {
          "$ref": "#/$defs/ExactArtifact"
        }
      },
      "required": [
        "role",
        "artifact"
      ],
      "title": "CodexImageV05ControllerInput",
      "type": "object"
    },
    "CodexImageV05MappingRecipeOverride": {
      "additionalProperties": false,
      "description": "Bind one deterministic UV-mapping shader derivative to its stable material ID.",
      "properties": {
        "material_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Material Id",
          "type": "string"
        },
        "recipe": {
          "$ref": "#/$defs/ShaderRecipe"
        },
        "artifact": {
          "$ref": "#/$defs/ExactArtifact"
        }
      },
      "required": [
        "material_id",
        "recipe",
        "artifact"
      ],
      "title": "CodexImageV05MappingRecipeOverride",
      "type": "object"
    },
    "ExactArtifact": {
      "additionalProperties": false,
      "description": "Bind one non-empty job-contained file to its exact bytes and role.",
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "maxLength": 96,
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "byte_size": {
          "exclusiveMinimum": 0,
          "title": "Byte Size",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "path",
        "sha256",
        "byte_size",
        "media_type"
      ],
      "title": "ExactArtifact",
      "type": "object"
    },
    "MappingSpec": {
      "additionalProperties": false,
      "description": "Describe deterministic material coordinates and their physical scale.",
      "properties": {
        "mode": {
          "default": "object",
          "enum": [
            "uv",
            "object",
            "generated",
            "triplanar"
          ],
          "title": "Mode",
          "type": "string"
        },
        "uv_set": {
          "default": "UVMap",
          "title": "Uv Set",
          "type": "string"
        },
        "real_world_scale_m": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "title": "Real World Scale M",
          "type": "number"
        },
        "texel_density_px_m": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Texel Density Px M"
        }
      },
      "title": "MappingSpec",
      "type": "object"
    },
    "ShaderLayer": {
      "additionalProperties": false,
      "description": "Describe one whitelisted material layer and its optional mask.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "constant",
            "image",
            "noise",
            "gradient",
            "fresnel",
            "normal",
            "bump"
          ],
          "title": "Kind",
          "type": "string"
        },
        "channels": {
          "items": {
            "enum": [
              "base_color",
              "roughness",
              "metallic",
              "normal",
              "height",
              "opacity",
              "emission"
            ],
            "type": "string"
          },
          "title": "Channels",
          "type": "array"
        },
        "blend": {
          "default": "mix",
          "enum": [
            "replace",
            "mix",
            "multiply",
            "add",
            "screen",
            "overlay"
          ],
          "title": "Blend",
          "type": "string"
        },
        "factor": {
          "default": 1.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Factor",
          "type": "number"
        },
        "mask": {
          "default": "none",
          "enum": [
            "none",
            "height",
            "slope",
            "cavity",
            "noise",
            "fresnel"
          ],
          "title": "Mask",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "title": "ShaderLayer",
      "type": "object"
    },
    "ShaderRecipe": {
      "additionalProperties": false,
      "description": "Define a whitelisted, Blender-version-neutral shader recipe.",
      "properties": {
        "schema_version": {
          "const": "0.5.0",
          "default": "0.5.0",
          "title": "Schema Version",
          "type": "string"
        },
        "material_id": {
          "title": "Material Id",
          "type": "string"
        },
        "family": {
          "default": "standard_pbr",
          "enum": [
            "standard_pbr",
            "rock",
            "terrain",
            "water",
            "glass",
            "foliage",
            "lava",
            "cloud",
            "emissive"
          ],
          "title": "Family",
          "type": "string"
        },
        "surface": {
          "$ref": "#/$defs/SurfaceSpec"
        },
        "mapping": {
          "$ref": "#/$defs/MappingSpec"
        },
        "layers": {
          "items": {
            "$ref": "#/$defs/ShaderLayer"
          },
          "title": "Layers",
          "type": "array"
        },
        "texture_manifest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Texture Manifest"
        },
        "blender_master": {
          "default": true,
          "title": "Blender Master",
          "type": "boolean"
        },
        "bake_required": {
          "default": false,
          "title": "Bake Required",
          "type": "boolean"
        },
        "assumptions": {
          "items": {
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        }
      },
      "required": [
        "material_id"
      ],
      "title": "ShaderRecipe",
      "type": "object"
    },
    "SurfaceSpec": {
      "additionalProperties": false,
      "description": "Store portable Principled-style surface parameters by semantic name.",
      "properties": {
        "base_color": {
          "default": [
            0.8,
            0.8,
            0.8,
            1.0
          ],
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Base Color",
          "type": "array"
        },
        "metallic": {
          "default": 0.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Metallic",
          "type": "number"
        },
        "roughness": {
          "default": 0.5,
          "maximum": 1,
          "minimum": 0,
          "title": "Roughness",
          "type": "number"
        },
        "ior": {
          "default": 1.45,
          "maximum": 3.0,
          "minimum": 1.0,
          "title": "Ior",
          "type": "number"
        },
        "transmission_weight": {
          "default": 0.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Transmission Weight",
          "type": "number"
        },
        "alpha": {
          "default": 1.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Alpha",
          "type": "number"
        },
        "emission_color": {
          "default": [
            0.0,
            0.0,
            0.0,
            1.0
          ],
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Emission Color",
          "type": "array"
        },
        "emission_strength": {
          "default": 0.0,
          "minimum": 0,
          "title": "Emission Strength",
          "type": "number"
        },
        "coat_weight": {
          "default": 0.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Coat Weight",
          "type": "number"
        },
        "subsurface_weight": {
          "default": 0.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Subsurface Weight",
          "type": "number"
        },
        "anisotropic": {
          "default": 0.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Anisotropic",
          "type": "number"
        }
      },
      "title": "SurfaceSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Bind one published bridge run without claiming controller or Blender success.",
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "receipt_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Receipt Id",
      "type": "string"
    },
    "job_id": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Job Id",
      "type": "string"
    },
    "workflow_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Workflow Id",
      "type": "string"
    },
    "dispatch_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Dispatch Id",
      "type": "string"
    },
    "session_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Session Id",
      "type": "string"
    },
    "profile_id": {
      "const": "autonomous_static_prop_v2_codex_imagegen",
      "default": "autonomous_static_prop_v2_codex_imagegen",
      "title": "Profile Id",
      "type": "string"
    },
    "provider_id": {
      "const": "codex_builtin_gpt_image_v1",
      "default": "codex_builtin_gpt_image_v1",
      "title": "Provider Id",
      "type": "string"
    },
    "input_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Sha256",
      "type": "string"
    },
    "source_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Fingerprint",
      "type": "string"
    },
    "producer": {
      "const": "codex_blender_modeler.material_authoring.codex_image_v05_bridge",
      "default": "codex_blender_modeler.material_authoring.codex_image_v05_bridge",
      "title": "Producer",
      "type": "string"
    },
    "producer_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Producer Version",
      "type": "string"
    },
    "provenance": {
      "items": {
        "$ref": "#/$defs/ExactArtifact"
      },
      "minItems": 1,
      "title": "Provenance",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "bridge_run_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Bridge Run Id",
      "type": "string"
    },
    "target_material_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Target Material Id",
      "type": "string"
    },
    "mapping_overrides": {
      "additionalProperties": {
        "const": "uv",
        "type": "string"
      },
      "title": "Mapping Overrides",
      "type": "object"
    },
    "mapping_recipe_overrides": {
      "items": {
        "$ref": "#/$defs/CodexImageV05MappingRecipeOverride"
      },
      "title": "Mapping Recipe Overrides",
      "type": "array"
    },
    "material_family": {
      "enum": [
        "uniform_fallback",
        "user_image_pbr",
        "signage_decal",
        "planar_reference_patch",
        "wood",
        "metal",
        "emissive",
        "crystal"
      ],
      "title": "Material Family",
      "type": "string"
    },
    "source_authoring_receipt": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "source_authoring_request": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "source_authoring_manifest": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "source_scene_spec": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "source_material_plan": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "previous_canonical_material_plan": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExactArtifact"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "canonical_material_absence_evidence": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExactArtifact"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "baseline_material_plan_snapshot": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "scale_context": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "uv_identity": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "channels": {
      "items": {
        "$ref": "#/$defs/CodexImageV05BridgeChannel"
      },
      "minItems": 1,
      "title": "Channels",
      "type": "array"
    },
    "texture_manifest": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "shader_recipe": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "candidate_material_plan": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "candidate_material_graph": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "controller_inputs": {
      "items": {
        "$ref": "#/$defs/CodexImageV05ControllerInput"
      },
      "minItems": 1,
      "title": "Controller Inputs",
      "type": "array"
    },
    "expected_output_sha256": {
      "additionalProperties": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Expected Output Sha256",
      "type": "object"
    },
    "status": {
      "const": "controller_candidate_ready",
      "default": "controller_candidate_ready",
      "title": "Status",
      "type": "string"
    },
    "staging_only": {
      "const": true,
      "default": true,
      "title": "Staging Only",
      "type": "boolean"
    },
    "canonical_v05_unchanged": {
      "const": true,
      "default": true,
      "title": "Canonical V05 Unchanged",
      "type": "boolean"
    },
    "canonical_scene_unchanged": {
      "const": true,
      "default": true,
      "title": "Canonical Scene Unchanged",
      "type": "boolean"
    },
    "blender_compilation_status": {
      "const": "not_run",
      "default": "not_run",
      "title": "Blender Compilation Status",
      "type": "string"
    },
    "neutral_preview_status": {
      "const": "not_run",
      "default": "not_run",
      "title": "Neutral Preview Status",
      "type": "string"
    },
    "reference_preview_status": {
      "const": "not_run",
      "default": "not_run",
      "title": "Reference Preview Status",
      "type": "string"
    },
    "controller_result_created": {
      "const": false,
      "default": false,
      "title": "Controller Result Created",
      "type": "boolean"
    },
    "canonical_write_performed": {
      "const": false,
      "default": false,
      "title": "Canonical Write Performed",
      "type": "boolean"
    },
    "destination_write_performed": {
      "const": false,
      "default": false,
      "title": "Destination Write Performed",
      "type": "boolean"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Limitations",
      "type": "array"
    }
  },
  "required": [
    "receipt_id",
    "job_id",
    "workflow_id",
    "dispatch_id",
    "session_id",
    "input_sha256",
    "source_fingerprint",
    "provenance",
    "created_at",
    "bridge_run_id",
    "target_material_id",
    "material_family",
    "source_authoring_receipt",
    "source_authoring_request",
    "source_authoring_manifest",
    "source_scene_spec",
    "source_material_plan",
    "baseline_material_plan_snapshot",
    "scale_context",
    "uv_identity",
    "channels",
    "texture_manifest",
    "shader_recipe",
    "candidate_material_plan",
    "candidate_material_graph",
    "controller_inputs",
    "expected_output_sha256",
    "limitations"
  ],
  "title": "CodexImageV05BridgeReceipt",
  "type": "object"
}
