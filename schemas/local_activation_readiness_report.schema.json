{
  "$defs": {
    "ActivationArtifact": {
      "additionalProperties": false,
      "description": "Bind one repository-contained activation artifact to exact immutable bytes.",
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "byte_size": {
          "exclusiveMinimum": 0,
          "title": "Byte Size",
          "type": "integer"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "path",
        "sha256",
        "byte_size"
      ],
      "title": "ActivationArtifact",
      "type": "object"
    },
    "ActivationReadinessFinding": {
      "additionalProperties": false,
      "description": "Classify one local requirement, excluded capability, or future limitation.",
      "properties": {
        "finding_id": {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "title": "Finding Id",
          "type": "string"
        },
        "detail": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Detail",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/ActivationArtifact"
          },
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "finding_id",
        "detail"
      ],
      "title": "ActivationReadinessFinding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Project local AQ readiness without treating future client parity as a blocker.",
  "properties": {
    "schema_version": {
      "const": "0.2.0",
      "default": "0.2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "contract_status": {
      "const": "disabled_experimental",
      "default": "disabled_experimental",
      "title": "Contract Status",
      "type": "string"
    },
    "report_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Report Id",
      "type": "string"
    },
    "report_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Report Sha256",
      "type": "string"
    },
    "activation_scope": {
      "const": "local_desktop_in_session",
      "default": "local_desktop_in_session",
      "title": "Activation Scope",
      "type": "string"
    },
    "status": {
      "enum": [
        "validation_blocked",
        "ready_for_fresh_campaign",
        "campaign_in_progress",
        "ready_for_human_activation_acceptance",
        "ready_for_profile_publication"
      ],
      "title": "Status",
      "type": "string"
    },
    "source_manifest": {
      "$ref": "#/$defs/ActivationArtifact"
    },
    "activation_baseline": {
      "$ref": "#/$defs/ActivationArtifact"
    },
    "production_candidate_index": {
      "anyOf": [
        {
          "$ref": "#/$defs/ActivationArtifact"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "campaign_outcome_index": {
      "anyOf": [
        {
          "$ref": "#/$defs/ActivationArtifact"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "campaign_target_count": {
      "const": 5,
      "default": 5,
      "title": "Campaign Target Count",
      "type": "integer"
    },
    "distinct_campaign_outcome_count": {
      "minimum": 0,
      "title": "Distinct Campaign Outcome Count",
      "type": "integer"
    },
    "production_package_target_count": {
      "const": 1,
      "default": 1,
      "title": "Production Package Target Count",
      "type": "integer"
    },
    "production_package_count": {
      "minimum": 0,
      "title": "Production Package Count",
      "type": "integer"
    },
    "exact_human_activation_acceptance": {
      "anyOf": [
        {
          "$ref": "#/$defs/ActivationArtifact"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "validation_blockers": {
      "items": {
        "$ref": "#/$defs/ActivationReadinessFinding"
      },
      "title": "Validation Blockers",
      "type": "array"
    },
    "open_requirements": {
      "items": {
        "$ref": "#/$defs/ActivationReadinessFinding"
      },
      "title": "Open Requirements",
      "type": "array"
    },
    "excluded_capabilities": {
      "items": {
        "$ref": "#/$defs/ActivationReadinessFinding"
      },
      "title": "Excluded Capabilities",
      "type": "array"
    },
    "future_limitations": {
      "items": {
        "$ref": "#/$defs/ActivationReadinessFinding"
      },
      "title": "Future Limitations",
      "type": "array"
    },
    "profile_id": {
      "const": "autonomous_static_prop_v2",
      "default": "autonomous_static_prop_v2",
      "title": "Profile Id",
      "type": "string"
    },
    "profile_version": {
      "const": "0.2.0",
      "default": "0.2.0",
      "title": "Profile Version",
      "type": "string"
    },
    "profile_status": {
      "const": "disabled_experimental",
      "default": "disabled_experimental",
      "title": "Profile Status",
      "type": "string"
    },
    "sandbox_attested": {
      "const": false,
      "default": false,
      "title": "Sandbox Attested",
      "type": "boolean"
    },
    "client_mediated_verified": {
      "const": false,
      "default": false,
      "title": "Client Mediated Verified",
      "type": "boolean"
    },
    "destination_runtime_parity": {
      "const": false,
      "default": false,
      "title": "Destination Runtime Parity",
      "type": "boolean"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    }
  },
  "required": [
    "report_id",
    "report_sha256",
    "status",
    "source_manifest",
    "activation_baseline",
    "distinct_campaign_outcome_count",
    "production_package_count",
    "validation_blockers",
    "open_requirements",
    "excluded_capabilities",
    "future_limitations",
    "generated_at"
  ],
  "title": "LocalActivationReadinessReport",
  "type": "object"
}
