{
  "$defs": {
    "ExactArtifact": {
      "additionalProperties": false,
      "description": "Bind one contained job-relative artifact by exact bytes and media type.",
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "pattern": "^[a-z][a-z0-9_]{1,95}$",
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "byte_size": {
          "minimum": 0,
          "title": "Byte Size",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 127,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "path",
        "sha256",
        "byte_size",
        "media_type"
      ],
      "title": "ExactArtifact",
      "type": "object"
    },
    "MaterialResourceCounters": {
      "additionalProperties": false,
      "description": "Keep bounded material-resource limits and consumption in separate categories.",
      "properties": {
        "preflight_blender_runs": {
          "minimum": 0,
          "title": "Preflight Blender Runs",
          "type": "integer"
        },
        "controller_invocations": {
          "minimum": 0,
          "title": "Controller Invocations",
          "type": "integer"
        },
        "canonical_promotions": {
          "minimum": 0,
          "title": "Canonical Promotions",
          "type": "integer"
        },
        "appearance_revisions": {
          "minimum": 0,
          "title": "Appearance Revisions",
          "type": "integer"
        },
        "transient_controller_retries": {
          "default": 0,
          "minimum": 0,
          "title": "Transient Controller Retries",
          "type": "integer"
        }
      },
      "required": [
        "preflight_blender_runs",
        "controller_invocations",
        "canonical_promotions",
        "appearance_revisions"
      ],
      "title": "MaterialResourceCounters",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Record one executed or cache-adopted preflight resource accounting event.",
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "workflow_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Workflow Id",
      "type": "string"
    },
    "dispatch_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Dispatch Id",
      "type": "string"
    },
    "session_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Session Id",
      "type": "string"
    },
    "producer": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Producer",
      "type": "string"
    },
    "producer_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Producer Version",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "receipt_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Receipt Id",
      "type": "string"
    },
    "budget": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "closure_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Closure Sha256",
      "type": "string"
    },
    "preflight_input_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Preflight Input Sha256",
      "type": "string"
    },
    "action": {
      "enum": [
        "executed",
        "cache_adopted"
      ],
      "title": "Action",
      "type": "string"
    },
    "before": {
      "$ref": "#/$defs/MaterialResourceCounters"
    },
    "consumed_by_event": {
      "$ref": "#/$defs/MaterialResourceCounters"
    },
    "after": {
      "$ref": "#/$defs/MaterialResourceCounters"
    },
    "cache_source": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExactArtifact"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "cache_hash_reverified": {
      "title": "Cache Hash Reverified",
      "type": "boolean"
    }
  },
  "required": [
    "job_id",
    "workflow_id",
    "dispatch_id",
    "session_id",
    "producer",
    "producer_version",
    "created_at",
    "receipt_id",
    "budget",
    "closure_sha256",
    "preflight_input_sha256",
    "action",
    "before",
    "consumed_by_event",
    "after",
    "cache_hash_reverified"
  ],
  "title": "MaterialPreflightResourceReceipt",
  "type": "object"
}
