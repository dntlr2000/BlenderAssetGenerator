{
  "$defs": {
    "RuntimeArtifact": {
      "additionalProperties": false,
      "description": "Bind one run-owned compiler output to exact bytes.",
      "properties": {
        "role": {
          "enum": [
            "request",
            "normalized_plan",
            "dependency_manifest",
            "compiled_blend",
            "normalized_inventory",
            "portable_approximation",
            "neutral_preview_manifest",
            "reference_preview_manifest"
          ],
          "title": "Role",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "byte_size": {
          "minimum": 0,
          "title": "Byte Size",
          "type": "integer"
        }
      },
      "required": [
        "role",
        "path",
        "sha256",
        "byte_size"
      ],
      "title": "RuntimeArtifact",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Bind a reopened Blender compile to normalized deterministic evidence.",
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "report_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Report Id",
      "type": "string"
    },
    "request_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Request Id",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "workflow_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Workflow Id",
      "type": "string"
    },
    "dispatch_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Dispatch Id",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Run Id",
      "type": "string"
    },
    "graph_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Graph Id",
      "type": "string"
    },
    "material_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Material Id",
      "type": "string"
    },
    "status": {
      "const": "passed",
      "default": "passed",
      "title": "Status",
      "type": "string"
    },
    "ok": {
      "const": true,
      "default": true,
      "title": "Ok",
      "type": "boolean"
    },
    "blender_version": {
      "minLength": 1,
      "title": "Blender Version",
      "type": "string"
    },
    "blender_python_version": {
      "minLength": 1,
      "title": "Blender Python Version",
      "type": "string"
    },
    "registry_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Registry Sha256",
      "type": "string"
    },
    "normalized_plan_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Normalized Plan Sha256",
      "type": "string"
    },
    "normalized_inventory_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Normalized Inventory Sha256",
      "type": "string"
    },
    "artifacts": {
      "items": {
        "$ref": "#/$defs/RuntimeArtifact"
      },
      "minItems": 4,
      "title": "Artifacts",
      "type": "array"
    },
    "canonical_material_unchanged": {
      "const": true,
      "default": true,
      "title": "Canonical Material Unchanged",
      "type": "boolean"
    },
    "canonical_scene_unchanged": {
      "const": true,
      "default": true,
      "title": "Canonical Scene Unchanged",
      "type": "boolean"
    },
    "blend_bytes_deterministic": {
      "const": false,
      "default": false,
      "title": "Blend Bytes Deterministic",
      "type": "boolean"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "completed_at": {
      "format": "date-time",
      "title": "Completed At",
      "type": "string"
    }
  },
  "required": [
    "report_id",
    "request_id",
    "job_id",
    "workflow_id",
    "dispatch_id",
    "run_id",
    "graph_id",
    "material_id",
    "blender_version",
    "blender_python_version",
    "registry_sha256",
    "normalized_plan_sha256",
    "normalized_inventory_sha256",
    "artifacts",
    "completed_at"
  ],
  "title": "MaterialGraphCompileReport",
  "type": "object"
}
