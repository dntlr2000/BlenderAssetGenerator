{
  "$defs": {
    "CodexImageArtifact": {
      "additionalProperties": false,
      "description": "Bind one non-empty job-contained file to exact bytes and media semantics.",
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "byte_size": {
          "exclusiveMinimum": 0,
          "title": "Byte Size",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "path",
        "sha256",
        "byte_size",
        "media_type"
      ],
      "title": "CodexImageArtifact",
      "type": "object"
    },
    "CodexImageDimensions": {
      "additionalProperties": false,
      "description": "Describe one bounded raster size without assuming a provider-specific API shape.",
      "properties": {
        "width": {
          "maximum": 2048,
          "minimum": 64,
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "maximum": 2048,
          "minimum": 64,
          "title": "Height",
          "type": "integer"
        }
      },
      "required": [
        "width",
        "height"
      ],
      "title": "CodexImageDimensions",
      "type": "object"
    },
    "CodexImageGenerationPlanItem": {
      "additionalProperties": false,
      "description": "Describe one material-scoped generation opportunity or bounded fallback route.",
      "properties": {
        "plan_item_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Plan Item Id",
          "type": "string"
        },
        "target_material_ids": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Target Material Ids",
          "type": "array"
        },
        "semantic_roles": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Semantic Roles",
          "type": "array"
        },
        "generation_intent": {
          "enum": [
            "generated_surface_swatch_v1",
            "generated_decal_art_v1",
            "generated_emission_pattern_v1",
            "reference_guided_texture_patch_v1",
            "generated_image_procedural_hybrid_v1"
          ],
          "title": "Generation Intent",
          "type": "string"
        },
        "allowed_output_roles": {
          "items": {
            "enum": [
              "base_color",
              "decal_rgb",
              "emission",
              "opacity_source"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Allowed Output Roles",
          "type": "array"
        },
        "prompt_template_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Prompt Template Id",
          "type": "string"
        },
        "requested_candidate_count": {
          "default": 1,
          "maximum": 3,
          "minimum": 1,
          "title": "Requested Candidate Count",
          "type": "integer"
        },
        "quality_level": {
          "enum": [
            "low",
            "medium"
          ],
          "title": "Quality Level",
          "type": "string"
        },
        "image_size": {
          "$ref": "#/$defs/CodexImageDimensions"
        },
        "aspect_ratio": {
          "enum": [
            "square",
            "landscape",
            "portrait"
          ],
          "title": "Aspect Ratio",
          "type": "string"
        },
        "fallback": {
          "enum": [
            "local_procedural_fallback",
            "review_required",
            "user_image_required"
          ],
          "title": "Fallback",
          "type": "string"
        }
      },
      "required": [
        "plan_item_id",
        "target_material_ids",
        "semantic_roles",
        "generation_intent",
        "allowed_output_roles",
        "prompt_template_id",
        "quality_level",
        "image_size",
        "aspect_ratio",
        "fallback"
      ],
      "title": "CodexImageGenerationPlanItem",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Bind an explicit overlay opt-in to one base AQ plan, profile, and budget.",
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "contract_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Contract Id",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "workflow_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Workflow Id",
      "type": "string"
    },
    "dispatch_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Dispatch Id",
      "type": "string"
    },
    "session_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Session Id",
      "type": "string"
    },
    "profile_id": {
      "const": "autonomous_static_prop_v2_codex_imagegen",
      "default": "autonomous_static_prop_v2_codex_imagegen",
      "title": "Profile Id",
      "type": "string"
    },
    "provider_id": {
      "const": "codex_builtin_gpt_image_v1",
      "default": "codex_builtin_gpt_image_v1",
      "title": "Provider Id",
      "type": "string"
    },
    "input_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Sha256",
      "type": "string"
    },
    "source_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Fingerprint",
      "type": "string"
    },
    "producer": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Producer",
      "type": "string"
    },
    "producer_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Producer Version",
      "type": "string"
    },
    "provenance": {
      "items": {
        "$ref": "#/$defs/CodexImageArtifact"
      },
      "minItems": 1,
      "title": "Provenance",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "plan_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Plan Id",
      "type": "string"
    },
    "base_autonomy_plan": {
      "$ref": "#/$defs/CodexImageArtifact"
    },
    "base_root_authorization": {
      "$ref": "#/$defs/CodexImageArtifact"
    },
    "provider_profile": {
      "$ref": "#/$defs/CodexImageArtifact"
    },
    "budget": {
      "$ref": "#/$defs/CodexImageArtifact"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/CodexImageGenerationPlanItem"
      },
      "minItems": 1,
      "title": "Items",
      "type": "array"
    },
    "codex_imagegen_allowed": {
      "const": true,
      "default": true,
      "title": "Codex Imagegen Allowed",
      "type": "boolean"
    },
    "controller_required": {
      "const": true,
      "default": true,
      "title": "Controller Required",
      "type": "boolean"
    },
    "repository_can_spawn_codex_task": {
      "const": false,
      "default": false,
      "title": "Repository Can Spawn Codex Task",
      "type": "boolean"
    },
    "automatic_migration": {
      "const": false,
      "default": false,
      "title": "Automatic Migration",
      "type": "boolean"
    },
    "canonical_material_write": {
      "const": false,
      "default": false,
      "title": "Canonical Material Write",
      "type": "boolean"
    }
  },
  "required": [
    "contract_id",
    "job_id",
    "workflow_id",
    "dispatch_id",
    "session_id",
    "input_sha256",
    "source_fingerprint",
    "producer",
    "provenance",
    "created_at",
    "plan_id",
    "base_autonomy_plan",
    "base_root_authorization",
    "provider_profile",
    "budget",
    "items"
  ],
  "title": "CodexImageGenerationPlan",
  "type": "object"
}
