{
  "$defs": {
    "ExactArtifact": {
      "additionalProperties": false,
      "description": "Bind one contained job-relative artifact by exact bytes and media type.",
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "pattern": "^[a-z][a-z0-9_]{1,95}$",
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "byte_size": {
          "minimum": 0,
          "title": "Byte Size",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 127,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "path",
        "sha256",
        "byte_size",
        "media_type"
      ],
      "title": "ExactArtifact",
      "type": "object"
    },
    "MaterialAQBudgetObservation": {
      "additionalProperties": false,
      "description": "Record exact existing AQ v2 usage and immutable category limits at failure.",
      "properties": {
        "schema_version": {
          "const": "0.1.0",
          "default": "0.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "blender_builds_used": {
          "minimum": 0,
          "title": "Blender Builds Used",
          "type": "integer"
        },
        "blender_builds_limit": {
          "minimum": 0,
          "title": "Blender Builds Limit",
          "type": "integer"
        },
        "controller_invocations_used": {
          "minimum": 0,
          "title": "Controller Invocations Used",
          "type": "integer"
        },
        "controller_invocations_limit": {
          "minimum": 0,
          "title": "Controller Invocations Limit",
          "type": "integer"
        },
        "canonical_promotions_used": {
          "minimum": 0,
          "title": "Canonical Promotions Used",
          "type": "integer"
        },
        "canonical_promotions_limit": {
          "minimum": 0,
          "title": "Canonical Promotions Limit",
          "type": "integer"
        },
        "actions_used": {
          "minimum": 0,
          "title": "Actions Used",
          "type": "integer"
        },
        "actions_limit": {
          "minimum": 0,
          "title": "Actions Limit",
          "type": "integer"
        },
        "quality_evaluations_used": {
          "minimum": 0,
          "title": "Quality Evaluations Used",
          "type": "integer"
        },
        "quality_evaluations_limit": {
          "minimum": 0,
          "title": "Quality Evaluations Limit",
          "type": "integer"
        }
      },
      "required": [
        "blender_builds_used",
        "blender_builds_limit",
        "controller_invocations_used",
        "controller_invocations_limit",
        "canonical_promotions_used",
        "canonical_promotions_limit",
        "actions_used",
        "actions_limit",
        "quality_evaluations_used",
        "quality_evaluations_limit"
      ],
      "title": "MaterialAQBudgetObservation",
      "type": "object"
    },
    "MaterialCanonicalSnapshot": {
      "additionalProperties": false,
      "description": "Capture the exact canonical material baseline and latest lifecycle evidence.",
      "properties": {
        "schema_version": {
          "const": "0.1.0",
          "default": "0.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "job_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
          "title": "Job Id",
          "type": "string"
        },
        "workflow_id": {
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
          "title": "Workflow Id",
          "type": "string"
        },
        "dispatch_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Dispatch Id",
          "type": "string"
        },
        "session_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Session Id",
          "type": "string"
        },
        "producer": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Producer",
          "type": "string"
        },
        "producer_version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Producer Version",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "snapshot_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Snapshot Id",
          "type": "string"
        },
        "scene_spec": {
          "$ref": "#/$defs/ExactArtifact"
        },
        "modeling_plan": {
          "$ref": "#/$defs/ExactArtifact"
        },
        "material_plan": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExactArtifact"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "material_plan_absence": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExactArtifact"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "blend": {
          "$ref": "#/$defs/ExactArtifact"
        },
        "build_provenance": {
          "$ref": "#/$defs/ExactArtifact"
        },
        "build_provenance_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Build Provenance Fingerprint",
          "type": "string"
        },
        "latest_material_promotion_receipt": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExactArtifact"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "latest_rollback_receipt": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExactArtifact"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "active_candidate_closure": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExactArtifact"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "job_id",
        "workflow_id",
        "dispatch_id",
        "session_id",
        "producer",
        "producer_version",
        "created_at",
        "snapshot_id",
        "scene_spec",
        "modeling_plan",
        "blend",
        "build_provenance",
        "build_provenance_fingerprint"
      ],
      "title": "MaterialCanonicalSnapshot",
      "type": "object"
    },
    "MaterialClosureIssue": {
      "additionalProperties": false,
      "description": "Record one deterministic closure or preflight validation finding.",
      "properties": {
        "code": {
          "pattern": "^[A-Z][A-Z0-9_]{2,95}$",
          "title": "Code",
          "type": "string"
        },
        "message": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "entry_id": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entry Id"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "MaterialClosureIssue",
      "type": "object"
    },
    "MaterialResourceCounters": {
      "additionalProperties": false,
      "description": "Keep bounded material-resource limits and consumption in separate categories.",
      "properties": {
        "preflight_blender_runs": {
          "minimum": 0,
          "title": "Preflight Blender Runs",
          "type": "integer"
        },
        "controller_invocations": {
          "minimum": 0,
          "title": "Controller Invocations",
          "type": "integer"
        },
        "canonical_promotions": {
          "minimum": 0,
          "title": "Canonical Promotions",
          "type": "integer"
        },
        "appearance_revisions": {
          "minimum": 0,
          "title": "Appearance Revisions",
          "type": "integer"
        },
        "transient_controller_retries": {
          "default": 0,
          "minimum": 0,
          "title": "Transient Controller Retries",
          "type": "integer"
        }
      },
      "required": [
        "preflight_blender_runs",
        "controller_invocations",
        "canonical_promotions",
        "appearance_revisions"
      ],
      "title": "MaterialResourceCounters",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Separate framework wiring failure from asset-quality judgment and stop execution.",
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "workflow_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Workflow Id",
      "type": "string"
    },
    "dispatch_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Dispatch Id",
      "type": "string"
    },
    "session_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Session Id",
      "type": "string"
    },
    "producer": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Producer",
      "type": "string"
    },
    "producer_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Producer Version",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "report_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Report Id",
      "type": "string"
    },
    "state_sequence": {
      "minimum": 0,
      "title": "State Sequence",
      "type": "integer"
    },
    "current_state": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "canonical_snapshot": {
      "$ref": "#/$defs/MaterialCanonicalSnapshot"
    },
    "latest_successful_rollback_receipt": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExactArtifact"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "pending_retry_plan": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExactArtifact"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "pending_retry_approval": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExactArtifact"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "controller_execution_count": {
      "minimum": 0,
      "title": "Controller Execution Count",
      "type": "integer"
    },
    "rollback_count": {
      "minimum": 0,
      "title": "Rollback Count",
      "type": "integer"
    },
    "budget_usage": {
      "$ref": "#/$defs/MaterialResourceCounters"
    },
    "aq_budget_observation": {
      "$ref": "#/$defs/MaterialAQBudgetObservation"
    },
    "neutral_preview_present": {
      "title": "Neutral Preview Present",
      "type": "boolean"
    },
    "material_phase_receipt_present": {
      "title": "Material Phase Receipt Present",
      "type": "boolean"
    },
    "integrated_quality_entered": {
      "title": "Integrated Quality Entered",
      "type": "boolean"
    },
    "failure_categories": {
      "items": {
        "pattern": "^[a-z][a-z0-9_]{1,95}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Failure Categories",
      "type": "array"
    },
    "missing_or_invalid_dependencies": {
      "items": {
        "$ref": "#/$defs/MaterialClosureIssue"
      },
      "minItems": 1,
      "title": "Missing Or Invalid Dependencies",
      "type": "array"
    },
    "framework_failure": {
      "const": true,
      "default": true,
      "title": "Framework Failure",
      "type": "boolean"
    },
    "asset_quality_failure": {
      "enum": [
        false,
        "unknown"
      ],
      "title": "Asset Quality Failure"
    },
    "recommended_action": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Recommended Action",
      "type": "string"
    },
    "existing_retry_execution_forbidden": {
      "const": true,
      "default": true,
      "title": "Existing Retry Execution Forbidden",
      "type": "boolean"
    },
    "retry_forbidden_reason": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Retry Forbidden Reason",
      "type": "string"
    }
  },
  "required": [
    "job_id",
    "workflow_id",
    "dispatch_id",
    "session_id",
    "producer",
    "producer_version",
    "created_at",
    "report_id",
    "state_sequence",
    "current_state",
    "canonical_snapshot",
    "controller_execution_count",
    "rollback_count",
    "budget_usage",
    "aq_budget_observation",
    "neutral_preview_present",
    "material_phase_receipt_present",
    "integrated_quality_entered",
    "failure_categories",
    "missing_or_invalid_dependencies",
    "asset_quality_failure",
    "recommended_action",
    "retry_forbidden_reason"
  ],
  "title": "MaterialFrameworkFailureReport",
  "type": "object"
}
