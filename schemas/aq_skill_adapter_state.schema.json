{
  "$defs": {
    "SkillArtifact": {
      "additionalProperties": false,
      "description": "Bind one job-relative immutable artifact to its exact bytes.",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "title": "SkillArtifact",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Project an AQ One-Prompt state into one uniquely routed stage skill.",
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Run Id",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "session_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Session Id",
      "type": "string"
    },
    "plan": {
      "$ref": "#/$defs/SkillArtifact"
    },
    "status": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Status",
      "type": "string"
    },
    "current_stage_key": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Current Stage Key",
      "type": "string"
    },
    "current_skill_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Current Skill Id",
      "type": "string"
    },
    "source_state": {
      "$ref": "#/$defs/SkillArtifact"
    },
    "next_action": {
      "anyOf": [
        {
          "maxLength": 1000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Next Action"
    },
    "receipt_chain_head_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Receipt Chain Head Sha256"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "job_id",
    "session_id",
    "plan",
    "status",
    "current_stage_key",
    "current_skill_id",
    "source_state",
    "updated_at"
  ],
  "title": "AQSkillAdapterState",
  "type": "object"
}
