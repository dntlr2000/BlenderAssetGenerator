{
  "$defs": {
    "GeometryAuthoringOutputBindingV2": {
      "additionalProperties": false,
      "description": "Bind one controller-authored sibling output by fixed leaf name and exact bytes.",
      "properties": {
        "name": {
          "enum": [
            "modeling_plan.json",
            "scene_spec_v03.json"
          ],
          "title": "Name",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "byte_size": {
          "exclusiveMinimum": 0,
          "title": "Byte Size",
          "type": "integer"
        }
      },
      "required": [
        "name",
        "sha256",
        "byte_size"
      ],
      "title": "GeometryAuthoringOutputBindingV2",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Let a geometry controller close only its exact isolated output set.",
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "phase": {
      "const": "geometry_authoring",
      "default": "geometry_authoring",
      "title": "Phase",
      "type": "string"
    },
    "status": {
      "const": "completed",
      "default": "completed",
      "title": "Status",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "workflow_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Workflow Id",
      "type": "string"
    },
    "dispatch_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Dispatch Id",
      "type": "string"
    },
    "session_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Session Id",
      "type": "string"
    },
    "execution_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Execution Id",
      "type": "string"
    },
    "assignment_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Assignment Sha256",
      "type": "string"
    },
    "tool_profile_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Tool Profile Sha256",
      "type": "string"
    },
    "outputs": {
      "items": {
        "$ref": "#/$defs/GeometryAuthoringOutputBindingV2"
      },
      "maxItems": 2,
      "minItems": 2,
      "title": "Outputs",
      "type": "array"
    },
    "canonical_write_requested": {
      "const": false,
      "default": false,
      "title": "Canonical Write Requested",
      "type": "boolean"
    },
    "destination_project_write": {
      "const": false,
      "default": false,
      "title": "Destination Project Write",
      "type": "boolean"
    }
  },
  "required": [
    "job_id",
    "workflow_id",
    "dispatch_id",
    "session_id",
    "execution_id",
    "assignment_sha256",
    "tool_profile_sha256",
    "outputs"
  ],
  "title": "GeometryAuthoringCompletionV2",
  "type": "object"
}
