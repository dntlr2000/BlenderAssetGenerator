{
  "$defs": {
    "CodexImageArtifact": {
      "additionalProperties": false,
      "description": "Bind one non-empty job-contained file to exact bytes and media semantics.",
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "byte_size": {
          "exclusiveMinimum": 0,
          "title": "Byte Size",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "path",
        "sha256",
        "byte_size",
        "media_type"
      ],
      "title": "CodexImageArtifact",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Freeze one candidate's exact companion-profile semantic precedence inputs.",
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "contract_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Contract Id",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "workflow_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Workflow Id",
      "type": "string"
    },
    "dispatch_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Dispatch Id",
      "type": "string"
    },
    "session_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Session Id",
      "type": "string"
    },
    "profile_id": {
      "const": "autonomous_static_prop_v2_codex_imagegen",
      "default": "autonomous_static_prop_v2_codex_imagegen",
      "title": "Profile Id",
      "type": "string"
    },
    "provider_id": {
      "const": "codex_builtin_gpt_image_v1",
      "default": "codex_builtin_gpt_image_v1",
      "title": "Provider Id",
      "type": "string"
    },
    "input_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Sha256",
      "type": "string"
    },
    "source_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Fingerprint",
      "type": "string"
    },
    "producer": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Producer",
      "type": "string"
    },
    "producer_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Producer Version",
      "type": "string"
    },
    "provenance": {
      "items": {
        "$ref": "#/$defs/CodexImageArtifact"
      },
      "minItems": 1,
      "title": "Provenance",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "immutable": {
      "const": true,
      "default": true,
      "title": "Immutable",
      "type": "boolean"
    },
    "ranking_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Ranking Id",
      "type": "string"
    },
    "assignment": {
      "$ref": "#/$defs/CodexImageArtifact"
    },
    "completion": {
      "$ref": "#/$defs/CodexImageArtifact"
    },
    "candidate": {
      "$ref": "#/$defs/CodexImageArtifact"
    },
    "candidate_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Candidate Id",
      "type": "string"
    },
    "reviewed_image": {
      "$ref": "#/$defs/CodexImageArtifact"
    },
    "deterministic_quality_report": {
      "$ref": "#/$defs/CodexImageArtifact"
    },
    "semantic_review": {
      "$ref": "#/$defs/CodexImageArtifact"
    },
    "file_hard_gate_passed": {
      "title": "File Hard Gate Passed",
      "type": "boolean"
    },
    "deterministic_quality_outcome": {
      "enum": [
        "passed",
        "review_required",
        "failed",
        "unscorable"
      ],
      "title": "Deterministic Quality Outcome",
      "type": "string"
    },
    "deterministic_quality_score": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Deterministic Quality Score",
      "type": "number"
    },
    "semantic_outcome": {
      "enum": [
        "passed",
        "review_required",
        "failed",
        "unavailable"
      ],
      "title": "Semantic Outcome",
      "type": "string"
    },
    "material_role_suitability": {
      "enum": [
        "suitable",
        "unsuitable",
        "review_required"
      ],
      "title": "Material Role Suitability",
      "type": "string"
    },
    "repair_cost": {
      "maximum": 1000000.0,
      "minimum": 0.0,
      "title": "Repair Cost",
      "type": "number"
    },
    "precedence_key": {
      "maxItems": 7,
      "minItems": 7,
      "prefixItems": [
        {
          "type": "integer"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "integer"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        }
      ],
      "title": "Precedence Key",
      "type": "array"
    },
    "ranking_algorithm_id": {
      "const": "companion_semantic_precedence_v1",
      "default": "companion_semantic_precedence_v1",
      "title": "Ranking Algorithm Id",
      "type": "string"
    },
    "companion_profile_only": {
      "const": true,
      "default": true,
      "title": "Companion Profile Only",
      "type": "boolean"
    },
    "human_reviewed": {
      "const": false,
      "default": false,
      "title": "Human Reviewed",
      "type": "boolean"
    }
  },
  "required": [
    "contract_id",
    "job_id",
    "workflow_id",
    "dispatch_id",
    "session_id",
    "input_sha256",
    "source_fingerprint",
    "producer",
    "provenance",
    "created_at",
    "ranking_id",
    "assignment",
    "completion",
    "candidate",
    "candidate_id",
    "reviewed_image",
    "deterministic_quality_report",
    "semantic_review",
    "file_hard_gate_passed",
    "deterministic_quality_outcome",
    "deterministic_quality_score",
    "semantic_outcome",
    "material_role_suitability",
    "repair_cost",
    "precedence_key"
  ],
  "title": "CodexImageCandidateRankingEvidence",
  "type": "object"
}
