{
  "additionalProperties": false,
  "description": "Record one explicit, hash-bound, single-use user approval.",
  "properties": {
    "schema_version": {
      "const": "0.6.0",
      "default": "0.6.0",
      "title": "Schema Version",
      "type": "string"
    },
    "approval_id": {
      "title": "Approval Id",
      "type": "string"
    },
    "job_id": {
      "title": "Job Id",
      "type": "string"
    },
    "candidates_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Candidates Sha256",
      "type": "string"
    },
    "plan_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Plan Sha256",
      "type": "string"
    },
    "base_spec_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Base Spec Sha256",
      "type": "string"
    },
    "approved_candidate_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Approved Candidate Ids",
      "type": "array"
    },
    "approved_by": {
      "const": "user",
      "default": "user",
      "title": "Approved By",
      "type": "string"
    },
    "approved_at": {
      "title": "Approved At",
      "type": "string"
    },
    "one_time": {
      "const": true,
      "default": true,
      "title": "One Time",
      "type": "boolean"
    },
    "used": {
      "default": false,
      "title": "Used",
      "type": "boolean"
    },
    "used_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Used At"
    }
  },
  "required": [
    "approval_id",
    "job_id",
    "candidates_sha256",
    "plan_sha256",
    "base_spec_sha256",
    "approved_candidate_ids",
    "approved_at"
  ],
  "title": "RevisionApproval",
  "type": "object"
}
