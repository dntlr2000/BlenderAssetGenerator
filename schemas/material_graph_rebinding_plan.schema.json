{
  "$defs": {
    "ExactArtifact": {
      "additionalProperties": false,
      "description": "Bind one contained job-relative artifact by exact bytes and media type.",
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "pattern": "^[a-z][a-z0-9_]{1,95}$",
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "byte_size": {
          "minimum": 0,
          "title": "Byte Size",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 127,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "path",
        "sha256",
        "byte_size",
        "media_type"
      ],
      "title": "ExactArtifact",
      "type": "object"
    },
    "MaterialGraphRebindingChange": {
      "additionalProperties": false,
      "description": "Describe one paired provenance path/hash replacement by JSON pointer.",
      "properties": {
        "dependency_role": {
          "pattern": "^[a-z][a-z0-9_]{1,95}$",
          "title": "Dependency Role",
          "type": "string"
        },
        "path_pointer": {
          "pattern": "^/(?:[^/~]|~[01])+(?:/(?:[^/~]|~[01])+)*$",
          "title": "Path Pointer",
          "type": "string"
        },
        "hash_pointer": {
          "pattern": "^/(?:[^/~]|~[01])+(?:/(?:[^/~]|~[01])+)*$",
          "title": "Hash Pointer",
          "type": "string"
        },
        "before_path": {
          "title": "Before Path",
          "type": "string"
        },
        "before_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Before Sha256",
          "type": "string"
        },
        "after_path": {
          "title": "After Path",
          "type": "string"
        },
        "after_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "After Sha256",
          "type": "string"
        }
      },
      "required": [
        "dependency_role",
        "path_pointer",
        "hash_pointer",
        "before_path",
        "before_sha256",
        "after_path",
        "after_sha256"
      ],
      "title": "MaterialGraphRebindingChange",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Authorize only declared path/hash provenance changes to a graph derivative.",
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "workflow_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Workflow Id",
      "type": "string"
    },
    "dispatch_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Dispatch Id",
      "type": "string"
    },
    "session_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Session Id",
      "type": "string"
    },
    "producer": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Producer",
      "type": "string"
    },
    "producer_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Producer Version",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "plan_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Plan Id",
      "type": "string"
    },
    "source_binding": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "source_graph": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "candidate_material_plan": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "output_path": {
      "title": "Output Path",
      "type": "string"
    },
    "expected_rebound_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Expected Rebound Sha256",
      "type": "string"
    },
    "changes": {
      "items": {
        "$ref": "#/$defs/MaterialGraphRebindingChange"
      },
      "minItems": 1,
      "title": "Changes",
      "type": "array"
    },
    "source_graph_immutable": {
      "const": true,
      "default": true,
      "title": "Source Graph Immutable",
      "type": "boolean"
    },
    "semantics_may_change": {
      "const": false,
      "default": false,
      "title": "Semantics May Change",
      "type": "boolean"
    }
  },
  "required": [
    "job_id",
    "workflow_id",
    "dispatch_id",
    "session_id",
    "producer",
    "producer_version",
    "created_at",
    "plan_id",
    "source_binding",
    "source_graph",
    "candidate_material_plan",
    "output_path",
    "expected_rebound_sha256",
    "changes"
  ],
  "title": "MaterialGraphRebindingPlan",
  "type": "object"
}
