{
  "$defs": {
    "AQV2Artifact": {
      "additionalProperties": false,
      "description": "Bind one immutable job-contained artifact to exact bytes and role.",
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "byte_size": {
          "exclusiveMinimum": 0,
          "title": "Byte Size",
          "type": "integer"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "path",
        "sha256",
        "byte_size"
      ],
      "title": "AQV2Artifact",
      "type": "object"
    },
    "BudgetUsageV2": {
      "additionalProperties": false,
      "description": "Count consumed AQ v2 work without mutating the immutable budget.",
      "properties": {
        "initial_candidates": {
          "default": 0,
          "minimum": 0,
          "title": "Initial Candidates",
          "type": "integer"
        },
        "structural_rounds": {
          "default": 0,
          "minimum": 0,
          "title": "Structural Rounds",
          "type": "integer"
        },
        "parametric_convergence_iterations": {
          "default": 0,
          "minimum": 0,
          "title": "Parametric Convergence Iterations",
          "type": "integer"
        },
        "material_rounds": {
          "default": 0,
          "minimum": 0,
          "title": "Material Rounds",
          "type": "integer"
        },
        "total_blender_builds": {
          "default": 0,
          "minimum": 0,
          "title": "Total Blender Builds",
          "type": "integer"
        },
        "total_quality_evaluations": {
          "default": 0,
          "minimum": 0,
          "title": "Total Quality Evaluations",
          "type": "integer"
        },
        "controller_invocations": {
          "default": 0,
          "minimum": 0,
          "title": "Controller Invocations",
          "type": "integer"
        },
        "delivery_runs": {
          "default": 0,
          "minimum": 0,
          "title": "Delivery Runs",
          "type": "integer"
        },
        "canonical_promotions": {
          "default": 0,
          "minimum": 0,
          "title": "Canonical Promotions",
          "type": "integer"
        },
        "package_repairs": {
          "default": 0,
          "minimum": 0,
          "title": "Package Repairs",
          "type": "integer"
        },
        "total_actions": {
          "default": 0,
          "minimum": 0,
          "title": "Total Actions",
          "type": "integer"
        }
      },
      "title": "BudgetUsageV2",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Bind one host-only validated candidate and its atomic canonical promotion.",
  "properties": {
    "schema_version": {
      "const": "0.2.0",
      "default": "0.2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "contract_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Contract Id",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "workflow_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Workflow Id",
      "type": "string"
    },
    "dispatch_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Dispatch Id",
      "type": "string"
    },
    "session_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Session Id",
      "type": "string"
    },
    "input_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Sha256",
      "type": "string"
    },
    "source_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Fingerprint",
      "type": "string"
    },
    "producer": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Producer",
      "type": "string"
    },
    "producer_version": {
      "const": "0.2.0",
      "default": "0.2.0",
      "title": "Producer Version",
      "type": "string"
    },
    "provenance": {
      "items": {
        "$ref": "#/$defs/AQV2Artifact"
      },
      "minItems": 1,
      "title": "Provenance",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "receipt_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Receipt Id",
      "type": "string"
    },
    "root_authorization": {
      "$ref": "#/$defs/AQV2Artifact"
    },
    "controller_result": {
      "$ref": "#/$defs/AQV2Artifact"
    },
    "controller_request": {
      "$ref": "#/$defs/AQV2Artifact"
    },
    "phase_tool_profile": {
      "$ref": "#/$defs/AQV2Artifact"
    },
    "controller_completion": {
      "$ref": "#/$defs/AQV2Artifact"
    },
    "candidate_modeling_plan": {
      "$ref": "#/$defs/AQV2Artifact"
    },
    "candidate_scene_spec_v03": {
      "$ref": "#/$defs/AQV2Artifact"
    },
    "compiled_scene_spec": {
      "$ref": "#/$defs/AQV2Artifact"
    },
    "structural_recipes": {
      "items": {
        "$ref": "#/$defs/AQV2Artifact"
      },
      "minItems": 1,
      "title": "Structural Recipes",
      "type": "array"
    },
    "mesh_payloads_v02": {
      "items": {
        "$ref": "#/$defs/AQV2Artifact"
      },
      "minItems": 1,
      "title": "Mesh Payloads V02",
      "type": "array"
    },
    "materialization_receipts": {
      "items": {
        "$ref": "#/$defs/AQV2Artifact"
      },
      "minItems": 1,
      "title": "Materialization Receipts",
      "type": "array"
    },
    "materialization_blends": {
      "items": {
        "$ref": "#/$defs/AQV2Artifact"
      },
      "minItems": 1,
      "title": "Materialization Blends",
      "type": "array"
    },
    "candidate_build_provenance": {
      "$ref": "#/$defs/AQV2Artifact"
    },
    "candidate_blend": {
      "$ref": "#/$defs/AQV2Artifact"
    },
    "candidate_inventory": {
      "$ref": "#/$defs/AQV2Artifact"
    },
    "candidate_validation": {
      "$ref": "#/$defs/AQV2Artifact"
    },
    "candidate_geometry_snapshot": {
      "$ref": "#/$defs/AQV2Artifact"
    },
    "previous_modeling_plan_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Previous Modeling Plan Sha256"
    },
    "previous_scene_spec_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Previous Scene Spec Sha256"
    },
    "previous_blend_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Previous Blend Sha256"
    },
    "canonical_archives": {
      "items": {
        "$ref": "#/$defs/AQV2Artifact"
      },
      "title": "Canonical Archives",
      "type": "array"
    },
    "canonical_modeling_plan": {
      "$ref": "#/$defs/AQV2Artifact"
    },
    "canonical_scene_spec": {
      "$ref": "#/$defs/AQV2Artifact"
    },
    "canonical_blend": {
      "$ref": "#/$defs/AQV2Artifact"
    },
    "canonical_geometry_snapshot": {
      "$ref": "#/$defs/AQV2Artifact"
    },
    "geometry_intent_survival": {
      "$ref": "#/$defs/AQV2Artifact"
    },
    "reference_content_scope": {
      "const": "primary_object_only",
      "default": "primary_object_only",
      "title": "Reference Content Scope",
      "type": "string"
    },
    "target_subject": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Target Subject",
      "type": "string"
    },
    "budget_usage_after": {
      "$ref": "#/$defs/BudgetUsageV2"
    },
    "status": {
      "const": "passed",
      "default": "passed",
      "title": "Status",
      "type": "string"
    },
    "canonical_writer": {
      "const": "supervisor_host",
      "default": "supervisor_host",
      "title": "Canonical Writer",
      "type": "string"
    },
    "controller_canonical_write": {
      "const": false,
      "default": false,
      "title": "Controller Canonical Write",
      "type": "boolean"
    },
    "destination_project_write": {
      "const": false,
      "default": false,
      "title": "Destination Project Write",
      "type": "boolean"
    }
  },
  "required": [
    "contract_id",
    "job_id",
    "workflow_id",
    "dispatch_id",
    "session_id",
    "input_sha256",
    "source_fingerprint",
    "producer",
    "provenance",
    "created_at",
    "receipt_id",
    "root_authorization",
    "controller_result",
    "controller_request",
    "phase_tool_profile",
    "controller_completion",
    "candidate_modeling_plan",
    "candidate_scene_spec_v03",
    "compiled_scene_spec",
    "structural_recipes",
    "mesh_payloads_v02",
    "materialization_receipts",
    "materialization_blends",
    "candidate_build_provenance",
    "candidate_blend",
    "candidate_inventory",
    "candidate_validation",
    "candidate_geometry_snapshot",
    "previous_modeling_plan_sha256",
    "previous_scene_spec_sha256",
    "previous_blend_sha256",
    "canonical_archives",
    "canonical_modeling_plan",
    "canonical_scene_spec",
    "canonical_blend",
    "canonical_geometry_snapshot",
    "geometry_intent_survival",
    "target_subject",
    "budget_usage_after"
  ],
  "title": "GeometryCandidateValidationReceiptV2",
  "type": "object"
}
