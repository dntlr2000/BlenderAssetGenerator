{
  "$defs": {
    "ExactArtifact": {
      "additionalProperties": false,
      "description": "Bind one non-empty job-contained file to its exact bytes and role.",
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "maxLength": 96,
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "byte_size": {
          "exclusiveMinimum": 0,
          "title": "Byte Size",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "path",
        "sha256",
        "byte_size",
        "media_type"
      ],
      "title": "ExactArtifact",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Bind one atomically published staging run to request, manifest, and raw channels.",
  "properties": {
    "schema_version": {
      "const": "0.2.1",
      "default": "0.2.1",
      "title": "Schema Version",
      "type": "string"
    },
    "receipt_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Receipt Id",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "workflow_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Workflow Id",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Run Id",
      "type": "string"
    },
    "request": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "manifest": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "outputs": {
      "items": {
        "$ref": "#/$defs/ExactArtifact"
      },
      "minItems": 1,
      "title": "Outputs",
      "type": "array"
    },
    "output_bundle_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Output Bundle Sha256",
      "type": "string"
    },
    "status": {
      "const": "published_to_staging",
      "default": "published_to_staging",
      "title": "Status",
      "type": "string"
    },
    "staging_only": {
      "const": true,
      "default": true,
      "title": "Staging Only",
      "type": "boolean"
    },
    "canonical_write_performed": {
      "const": false,
      "default": false,
      "title": "Canonical Write Performed",
      "type": "boolean"
    },
    "destination_write_performed": {
      "const": false,
      "default": false,
      "title": "Destination Write Performed",
      "type": "boolean"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "receipt_id",
    "job_id",
    "workflow_id",
    "run_id",
    "request",
    "manifest",
    "outputs",
    "output_bundle_sha256",
    "created_at"
  ],
  "title": "CodexImageMaterialAuthoringReceiptV021",
  "type": "object"
}
