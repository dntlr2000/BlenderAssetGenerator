{
  "$defs": {
    "AQV2Artifact": {
      "additionalProperties": false,
      "description": "Bind one immutable job-contained artifact to exact bytes and role.",
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "byte_size": {
          "exclusiveMinimum": 0,
          "title": "Byte Size",
          "type": "integer"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "path",
        "sha256",
        "byte_size"
      ],
      "title": "AQV2Artifact",
      "type": "object"
    },
    "DeliveryResult": {
      "additionalProperties": false,
      "description": "Record one format-specific result without changing another delivery outcome.",
      "properties": {
        "delivery_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Delivery Id",
          "type": "string"
        },
        "profile_id": {
          "enum": [
            "review_only",
            "portable_gltf",
            "portable_fbx"
          ],
          "title": "Profile Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "completed",
            "failed",
            "review_only"
          ],
          "title": "Status",
          "type": "string"
        },
        "source_freeze_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Freeze Sha256",
          "type": "string"
        },
        "optimization_plan": {
          "anyOf": [
            {
              "$ref": "#/$defs/AQV2Artifact"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "optimization_approval": {
          "anyOf": [
            {
              "$ref": "#/$defs/AQV2Artifact"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "package_manifest": {
          "anyOf": [
            {
              "$ref": "#/$defs/AQV2Artifact"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "roundtrip_validation": {
          "anyOf": [
            {
              "$ref": "#/$defs/AQV2Artifact"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "material_loss_report": {
          "anyOf": [
            {
              "$ref": "#/$defs/AQV2Artifact"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "geometry_survival_report": {
          "anyOf": [
            {
              "$ref": "#/$defs/AQV2Artifact"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "handoff_manifest": {
          "anyOf": [
            {
              "$ref": "#/$defs/AQV2Artifact"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "production_ready": {
          "title": "Production Ready",
          "type": "boolean"
        },
        "known_losses": {
          "items": {
            "type": "string"
          },
          "title": "Known Losses",
          "type": "array"
        },
        "errors": {
          "items": {
            "type": "string"
          },
          "title": "Errors",
          "type": "array"
        }
      },
      "required": [
        "delivery_id",
        "profile_id",
        "status",
        "source_freeze_sha256",
        "production_ready"
      ],
      "title": "DeliveryResult",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Summarize independent format outcomes after an immutable quality source freeze.",
  "properties": {
    "schema_version": {
      "const": "0.2.0",
      "default": "0.2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "contract_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Contract Id",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "workflow_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Workflow Id",
      "type": "string"
    },
    "dispatch_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Dispatch Id",
      "type": "string"
    },
    "session_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Session Id",
      "type": "string"
    },
    "input_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Sha256",
      "type": "string"
    },
    "source_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Fingerprint",
      "type": "string"
    },
    "producer": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Producer",
      "type": "string"
    },
    "producer_version": {
      "const": "0.2.0",
      "default": "0.2.0",
      "title": "Producer Version",
      "type": "string"
    },
    "provenance": {
      "items": {
        "$ref": "#/$defs/AQV2Artifact"
      },
      "minItems": 1,
      "title": "Provenance",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "terminal_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Terminal Id",
      "type": "string"
    },
    "quality_terminal": {
      "$ref": "#/$defs/AQV2Artifact"
    },
    "source_freeze": {
      "$ref": "#/$defs/AQV2Artifact"
    },
    "delivery_plan": {
      "$ref": "#/$defs/AQV2Artifact"
    },
    "delivery_review": {
      "anyOf": [
        {
          "$ref": "#/$defs/AQV2Artifact"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "outcome": {
      "enum": [
        "completed",
        "partial",
        "failed",
        "review_only"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "results": {
      "items": {
        "$ref": "#/$defs/DeliveryResult"
      },
      "minItems": 1,
      "title": "Results",
      "type": "array"
    },
    "destination_runtime_parity": {
      "const": false,
      "default": false,
      "title": "Destination Runtime Parity",
      "type": "boolean"
    },
    "canonical_unchanged": {
      "const": true,
      "default": true,
      "title": "Canonical Unchanged",
      "type": "boolean"
    }
  },
  "required": [
    "contract_id",
    "job_id",
    "workflow_id",
    "dispatch_id",
    "session_id",
    "input_sha256",
    "source_fingerprint",
    "producer",
    "provenance",
    "created_at",
    "terminal_id",
    "quality_terminal",
    "source_freeze",
    "delivery_plan",
    "outcome",
    "results"
  ],
  "title": "DeliveryTerminalV2",
  "type": "object"
}
