{
  "$defs": {
    "CodexImageArtifact": {
      "additionalProperties": false,
      "description": "Bind one non-empty job-contained file to exact bytes and media semantics.",
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "byte_size": {
          "exclusiveMinimum": 0,
          "title": "Byte Size",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "path",
        "sha256",
        "byte_size",
        "media_type"
      ],
      "title": "CodexImageArtifact",
      "type": "object"
    },
    "MaterialLoopRasterSize": {
      "additionalProperties": false,
      "description": "Describe one bounded native or material raster size.",
      "properties": {
        "width": {
          "maximum": 8192,
          "minimum": 1,
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "maximum": 8192,
          "minimum": 1,
          "title": "Height",
          "type": "integer"
        }
      },
      "required": [
        "width",
        "height"
      ],
      "title": "MaterialLoopRasterSize",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Bind one native original through normalization to selected core 0.1 evidence.",
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "contract_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Contract Id",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "workflow_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Workflow Id",
      "type": "string"
    },
    "dispatch_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Dispatch Id",
      "type": "string"
    },
    "session_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Session Id",
      "type": "string"
    },
    "profile_id": {
      "const": "autonomous_static_prop_v2_codex_imagegen",
      "default": "autonomous_static_prop_v2_codex_imagegen",
      "title": "Profile Id",
      "type": "string"
    },
    "provider_id": {
      "const": "codex_builtin_gpt_image_v1",
      "default": "codex_builtin_gpt_image_v1",
      "title": "Provider Id",
      "type": "string"
    },
    "input_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Sha256",
      "type": "string"
    },
    "source_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Fingerprint",
      "type": "string"
    },
    "producer": {
      "const": "codex_blender_modeler.codex_imagegen.native_core_preparation",
      "default": "codex_blender_modeler.codex_imagegen.native_core_preparation",
      "title": "Producer",
      "type": "string"
    },
    "producer_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Producer Version",
      "type": "string"
    },
    "provenance": {
      "items": {
        "$ref": "#/$defs/CodexImageArtifact"
      },
      "minItems": 1,
      "title": "Provenance",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "immutable": {
      "const": true,
      "default": true,
      "title": "Immutable",
      "type": "boolean"
    },
    "preparation_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Preparation Id",
      "type": "string"
    },
    "assignment_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Assignment Id",
      "type": "string"
    },
    "candidate_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Candidate Id",
      "type": "string"
    },
    "assignment": {
      "$ref": "#/$defs/CodexImageArtifact"
    },
    "native_output_adoption_receipt": {
      "$ref": "#/$defs/CodexImageArtifact"
    },
    "native_original_image": {
      "$ref": "#/$defs/CodexImageArtifact"
    },
    "normalization_plan": {
      "$ref": "#/$defs/CodexImageArtifact"
    },
    "normalization_receipt": {
      "$ref": "#/$defs/CodexImageArtifact"
    },
    "normalized_image": {
      "$ref": "#/$defs/CodexImageArtifact"
    },
    "core_completion": {
      "$ref": "#/$defs/CodexImageArtifact"
    },
    "core_candidate": {
      "$ref": "#/$defs/CodexImageArtifact"
    },
    "core_generated_image_evidence": {
      "$ref": "#/$defs/CodexImageArtifact"
    },
    "core_quality_report": {
      "$ref": "#/$defs/CodexImageArtifact"
    },
    "core_selection": {
      "$ref": "#/$defs/CodexImageArtifact"
    },
    "core_generated_image": {
      "$ref": "#/$defs/CodexImageArtifact"
    },
    "ordinal": {
      "maximum": 2,
      "minimum": 0,
      "title": "Ordinal",
      "type": "integer"
    },
    "output_role": {
      "enum": [
        "base_color",
        "decal_rgb",
        "emission",
        "opacity_source"
      ],
      "title": "Output Role",
      "type": "string"
    },
    "target_size": {
      "$ref": "#/$defs/MaterialLoopRasterSize"
    },
    "status": {
      "const": "prepared",
      "default": "prepared",
      "title": "Status",
      "type": "string"
    },
    "exact_normalized_bytes_copied_to_core": {
      "const": true,
      "default": true,
      "title": "Exact Normalized Bytes Copied To Core",
      "type": "boolean"
    },
    "core_contracts_modified": {
      "const": false,
      "default": false,
      "title": "Core Contracts Modified",
      "type": "boolean"
    },
    "canonical_write_performed": {
      "const": false,
      "default": false,
      "title": "Canonical Write Performed",
      "type": "boolean"
    },
    "destination_write_performed": {
      "const": false,
      "default": false,
      "title": "Destination Write Performed",
      "type": "boolean"
    }
  },
  "required": [
    "contract_id",
    "job_id",
    "workflow_id",
    "dispatch_id",
    "session_id",
    "input_sha256",
    "source_fingerprint",
    "provenance",
    "created_at",
    "preparation_id",
    "assignment_id",
    "candidate_id",
    "assignment",
    "native_output_adoption_receipt",
    "native_original_image",
    "normalization_plan",
    "normalization_receipt",
    "normalized_image",
    "core_completion",
    "core_candidate",
    "core_generated_image_evidence",
    "core_quality_report",
    "core_selection",
    "core_generated_image",
    "ordinal",
    "output_role",
    "target_size"
  ],
  "title": "CodexImageNativeCorePreparationReceipt",
  "type": "object"
}
