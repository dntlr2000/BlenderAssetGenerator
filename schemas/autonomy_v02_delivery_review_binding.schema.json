{
  "$defs": {
    "AQV2Artifact": {
      "additionalProperties": false,
      "description": "Bind one immutable job-contained artifact to exact bytes and role.",
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "byte_size": {
          "exclusiveMinimum": 0,
          "title": "Byte Size",
          "type": "integer"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "path",
        "sha256",
        "byte_size"
      ],
      "title": "AQV2Artifact",
      "type": "object"
    },
    "DeliveryReviewEntry": {
      "additionalProperties": false,
      "description": "Bind one V0.7 review boundary for an independently planned delivery format.",
      "properties": {
        "delivery_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Delivery Id",
          "type": "string"
        },
        "profile_id": {
          "enum": [
            "portable_gltf",
            "portable_fbx"
          ],
          "title": "Profile Id",
          "type": "string"
        },
        "asset_profile_id": {
          "enum": [
            "portable_gltf",
            "fbx_interchange"
          ],
          "title": "Asset Profile Id",
          "type": "string"
        },
        "run_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Run Id",
          "type": "string"
        },
        "package_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Package Id",
          "type": "string"
        },
        "asset_profile": {
          "$ref": "#/$defs/AQV2Artifact"
        },
        "optimization_plan": {
          "$ref": "#/$defs/AQV2Artifact"
        },
        "optimization_review": {
          "$ref": "#/$defs/AQV2Artifact"
        },
        "exact_plan_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Exact Plan Sha256",
          "type": "string"
        },
        "next_action": {
          "const": "request_exact_v07_optimization_approval",
          "default": "request_exact_v07_optimization_approval",
          "title": "Next Action",
          "type": "string"
        },
        "user_approval_required": {
          "const": true,
          "default": true,
          "title": "User Approval Required",
          "type": "boolean"
        }
      },
      "required": [
        "delivery_id",
        "profile_id",
        "asset_profile_id",
        "run_id",
        "package_id",
        "asset_profile",
        "optimization_plan",
        "optimization_review",
        "exact_plan_sha256"
      ],
      "title": "DeliveryReviewEntry",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Record format-specific V0.7 review plans without synthesizing their approvals.",
  "properties": {
    "schema_version": {
      "const": "0.2.0",
      "default": "0.2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "contract_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Contract Id",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "workflow_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Workflow Id",
      "type": "string"
    },
    "dispatch_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Dispatch Id",
      "type": "string"
    },
    "session_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Session Id",
      "type": "string"
    },
    "input_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Sha256",
      "type": "string"
    },
    "source_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Fingerprint",
      "type": "string"
    },
    "producer": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Producer",
      "type": "string"
    },
    "producer_version": {
      "const": "0.2.0",
      "default": "0.2.0",
      "title": "Producer Version",
      "type": "string"
    },
    "provenance": {
      "items": {
        "$ref": "#/$defs/AQV2Artifact"
      },
      "minItems": 1,
      "title": "Provenance",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "binding_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Binding Id",
      "type": "string"
    },
    "delivery_plan": {
      "$ref": "#/$defs/AQV2Artifact"
    },
    "source_freeze": {
      "$ref": "#/$defs/AQV2Artifact"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/DeliveryReviewEntry"
      },
      "minItems": 1,
      "title": "Entries",
      "type": "array"
    },
    "generic_authorization_consumed_as_v07_approval": {
      "const": false,
      "default": false,
      "title": "Generic Authorization Consumed As V07 Approval",
      "type": "boolean"
    }
  },
  "required": [
    "contract_id",
    "job_id",
    "workflow_id",
    "dispatch_id",
    "session_id",
    "input_sha256",
    "source_fingerprint",
    "producer",
    "provenance",
    "created_at",
    "binding_id",
    "delivery_plan",
    "source_freeze",
    "entries"
  ],
  "title": "DeliveryReviewBinding",
  "type": "object"
}
