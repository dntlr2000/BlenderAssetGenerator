{
  "$defs": {
    "ExactArtifact": {
      "additionalProperties": false,
      "description": "Bind one contained job-relative artifact by exact bytes and media type.",
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "pattern": "^[a-z][a-z0-9_]{1,95}$",
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "byte_size": {
          "minimum": 0,
          "title": "Byte Size",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 127,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "path",
        "sha256",
        "byte_size",
        "media_type"
      ],
      "title": "ExactArtifact",
      "type": "object"
    },
    "MaterialClosureIssue": {
      "additionalProperties": false,
      "description": "Record one deterministic closure or preflight validation finding.",
      "properties": {
        "code": {
          "pattern": "^[A-Z][A-Z0-9_]{2,95}$",
          "title": "Code",
          "type": "string"
        },
        "message": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "entry_id": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entry Id"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "MaterialClosureIssue",
      "type": "object"
    },
    "MaterialPreflightCheck": {
      "additionalProperties": false,
      "description": "Record one named material preflight or shadow-compile check.",
      "properties": {
        "check_id": {
          "pattern": "^[a-z][a-z0-9_]{1,95}$",
          "title": "Check Id",
          "type": "string"
        },
        "category": {
          "enum": [
            "contract",
            "dependency",
            "surface_detail",
            "budget",
            "rollback",
            "blender"
          ],
          "title": "Category",
          "type": "string"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "not_applicable"
          ],
          "title": "Status",
          "type": "string"
        },
        "message": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/ExactArtifact"
          },
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "check_id",
        "category",
        "status",
        "message"
      ],
      "title": "MaterialPreflightCheck",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Attest an isolated Blender material compile without canonical mutation.",
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "workflow_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Workflow Id",
      "type": "string"
    },
    "dispatch_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Dispatch Id",
      "type": "string"
    },
    "session_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Session Id",
      "type": "string"
    },
    "producer": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Producer",
      "type": "string"
    },
    "producer_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Producer Version",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "receipt_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Receipt Id",
      "type": "string"
    },
    "preflight_request": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "closure": {
      "$ref": "#/$defs/ExactArtifact"
    },
    "status": {
      "enum": [
        "passed",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "blender_version": {
      "anyOf": [
        {
          "maxLength": 64,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Blender Version"
    },
    "blender_executable_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Blender Executable Sha256"
    },
    "shadow_root": {
      "title": "Shadow Root",
      "type": "string"
    },
    "checks": {
      "items": {
        "$ref": "#/$defs/MaterialPreflightCheck"
      },
      "minItems": 1,
      "title": "Checks",
      "type": "array"
    },
    "outputs": {
      "items": {
        "$ref": "#/$defs/ExactArtifact"
      },
      "title": "Outputs",
      "type": "array"
    },
    "canonical_unchanged": {
      "const": true,
      "default": true,
      "title": "Canonical Unchanged",
      "type": "boolean"
    },
    "issues": {
      "items": {
        "$ref": "#/$defs/MaterialClosureIssue"
      },
      "title": "Issues",
      "type": "array"
    }
  },
  "required": [
    "job_id",
    "workflow_id",
    "dispatch_id",
    "session_id",
    "producer",
    "producer_version",
    "created_at",
    "receipt_id",
    "preflight_request",
    "closure",
    "status",
    "shadow_root",
    "checks"
  ],
  "title": "MaterialShadowCompileReceipt",
  "type": "object"
}
