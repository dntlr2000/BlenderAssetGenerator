{
  "$defs": {
    "CodexImageArtifact": {
      "additionalProperties": false,
      "description": "Bind one non-empty job-contained file to exact bytes and media semantics.",
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "byte_size": {
          "exclusiveMinimum": 0,
          "title": "Byte Size",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "path",
        "sha256",
        "byte_size",
        "media_type"
      ],
      "title": "CodexImageArtifact",
      "type": "object"
    },
    "CodexImageQualityCheck": {
      "additionalProperties": false,
      "description": "Record one deterministic, advisory, or unavailable candidate quality check.",
      "properties": {
        "check_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Check Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "unscorable",
            "advisory"
          ],
          "title": "Status",
          "type": "string"
        },
        "score": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        },
        "threshold": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Threshold"
        },
        "hard_gate": {
          "title": "Hard Gate",
          "type": "boolean"
        },
        "algorithm_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Algorithm Id",
          "type": "string"
        },
        "message": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "check_id",
        "status",
        "hard_gate",
        "algorithm_id",
        "message"
      ],
      "title": "CodexImageQualityCheck",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Aggregate one candidate's hard gates and advisory content observations.",
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "contract_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Contract Id",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "workflow_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Workflow Id",
      "type": "string"
    },
    "dispatch_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Dispatch Id",
      "type": "string"
    },
    "session_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Session Id",
      "type": "string"
    },
    "profile_id": {
      "const": "autonomous_static_prop_v2_codex_imagegen",
      "default": "autonomous_static_prop_v2_codex_imagegen",
      "title": "Profile Id",
      "type": "string"
    },
    "provider_id": {
      "const": "codex_builtin_gpt_image_v1",
      "default": "codex_builtin_gpt_image_v1",
      "title": "Provider Id",
      "type": "string"
    },
    "input_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Sha256",
      "type": "string"
    },
    "source_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Fingerprint",
      "type": "string"
    },
    "producer": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Producer",
      "type": "string"
    },
    "producer_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Producer Version",
      "type": "string"
    },
    "provenance": {
      "items": {
        "$ref": "#/$defs/CodexImageArtifact"
      },
      "minItems": 1,
      "title": "Provenance",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "report_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Report Id",
      "type": "string"
    },
    "assignment": {
      "$ref": "#/$defs/CodexImageArtifact"
    },
    "completion": {
      "$ref": "#/$defs/CodexImageArtifact"
    },
    "candidate": {
      "$ref": "#/$defs/CodexImageArtifact"
    },
    "generated_image_evidence": {
      "$ref": "#/$defs/CodexImageArtifact"
    },
    "checks": {
      "items": {
        "$ref": "#/$defs/CodexImageQualityCheck"
      },
      "minItems": 1,
      "title": "Checks",
      "type": "array"
    },
    "deterministic_score": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Deterministic Score",
      "type": "number"
    },
    "outcome": {
      "enum": [
        "passed",
        "failed",
        "review_required",
        "unscorable"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "selection_eligible": {
      "title": "Selection Eligible",
      "type": "boolean"
    },
    "human_reviewed": {
      "default": false,
      "title": "Human Reviewed",
      "type": "boolean"
    },
    "human_review_evidence": {
      "anyOf": [
        {
          "$ref": "#/$defs/CodexImageArtifact"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "contract_id",
    "job_id",
    "workflow_id",
    "dispatch_id",
    "session_id",
    "input_sha256",
    "source_fingerprint",
    "producer",
    "provenance",
    "created_at",
    "report_id",
    "assignment",
    "completion",
    "candidate",
    "generated_image_evidence",
    "checks",
    "deterministic_score",
    "outcome",
    "selection_eligible"
  ],
  "title": "CodexImageGenerationQualityReport",
  "type": "object"
}
