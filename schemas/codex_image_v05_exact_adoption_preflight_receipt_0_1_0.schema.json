{
  "$defs": {
    "CodexImageArtifact": {
      "additionalProperties": false,
      "description": "Bind one non-empty job-contained file to exact bytes and media semantics.",
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "byte_size": {
          "exclusiveMinimum": 0,
          "title": "Byte Size",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "path",
        "sha256",
        "byte_size",
        "media_type"
      ],
      "title": "CodexImageArtifact",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Bind an actual Blender compile of exact V0.5 graph bytes in an isolated shadow.",
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "contract_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Contract Id",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "workflow_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Workflow Id",
      "type": "string"
    },
    "dispatch_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Dispatch Id",
      "type": "string"
    },
    "session_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Session Id",
      "type": "string"
    },
    "profile_id": {
      "const": "autonomous_static_prop_v2_codex_imagegen",
      "default": "autonomous_static_prop_v2_codex_imagegen",
      "title": "Profile Id",
      "type": "string"
    },
    "provider_id": {
      "const": "codex_builtin_gpt_image_v1",
      "default": "codex_builtin_gpt_image_v1",
      "title": "Provider Id",
      "type": "string"
    },
    "input_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Sha256",
      "type": "string"
    },
    "source_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Fingerprint",
      "type": "string"
    },
    "producer": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Producer",
      "type": "string"
    },
    "producer_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Producer Version",
      "type": "string"
    },
    "provenance": {
      "items": {
        "$ref": "#/$defs/CodexImageArtifact"
      },
      "minItems": 1,
      "title": "Provenance",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "immutable": {
      "const": true,
      "default": true,
      "title": "Immutable",
      "type": "boolean"
    },
    "preflight_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Preflight Id",
      "type": "string"
    },
    "v05_bridge_receipt": {
      "$ref": "#/$defs/CodexImageArtifact"
    },
    "candidate_material_plan": {
      "$ref": "#/$defs/CodexImageArtifact"
    },
    "material_graph_spec": {
      "$ref": "#/$defs/CodexImageArtifact"
    },
    "shadow_root": {
      "title": "Shadow Root",
      "type": "string"
    },
    "shadow_candidate_material_plan": {
      "$ref": "#/$defs/CodexImageArtifact"
    },
    "shadow_material_graph_spec": {
      "$ref": "#/$defs/CodexImageArtifact"
    },
    "compile_run_root": {
      "title": "Compile Run Root",
      "type": "string"
    },
    "graph_compile_report": {
      "$ref": "#/$defs/CodexImageArtifact"
    },
    "compile_artifacts": {
      "items": {
        "$ref": "#/$defs/CodexImageArtifact"
      },
      "maxItems": 8,
      "minItems": 8,
      "title": "Compile Artifacts",
      "type": "array"
    },
    "material_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Material Id",
      "type": "string"
    },
    "graph_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "title": "Graph Id",
      "type": "string"
    },
    "status": {
      "const": "passed",
      "default": "passed",
      "title": "Status",
      "type": "string"
    },
    "actual_blender_compiled": {
      "const": true,
      "default": true,
      "title": "Actual Blender Compiled",
      "type": "boolean"
    },
    "exact_graph_bytes_compiled": {
      "const": true,
      "default": true,
      "title": "Exact Graph Bytes Compiled",
      "type": "boolean"
    },
    "candidate_material_bytes_shadowed": {
      "const": true,
      "default": true,
      "title": "Candidate Material Bytes Shadowed",
      "type": "boolean"
    },
    "staging_receipt_reinterpreted": {
      "const": false,
      "default": false,
      "title": "Staging Receipt Reinterpreted",
      "type": "boolean"
    },
    "controller_result_created": {
      "const": false,
      "default": false,
      "title": "Controller Result Created",
      "type": "boolean"
    },
    "canonical_write_performed": {
      "const": false,
      "default": false,
      "title": "Canonical Write Performed",
      "type": "boolean"
    },
    "destination_write_performed": {
      "const": false,
      "default": false,
      "title": "Destination Write Performed",
      "type": "boolean"
    }
  },
  "required": [
    "contract_id",
    "job_id",
    "workflow_id",
    "dispatch_id",
    "session_id",
    "input_sha256",
    "source_fingerprint",
    "producer",
    "provenance",
    "created_at",
    "preflight_id",
    "v05_bridge_receipt",
    "candidate_material_plan",
    "material_graph_spec",
    "shadow_root",
    "shadow_candidate_material_plan",
    "shadow_material_graph_spec",
    "compile_run_root",
    "graph_compile_report",
    "compile_artifacts",
    "material_id",
    "graph_id"
  ],
  "title": "CodexImageV05ExactAdoptionPreflightReceipt",
  "type": "object"
}
