# Absolute path is safest. Examples:
# macOS: /Applications/Blender.app/Contents/MacOS/Blender
# Windows: C:\Program Files\Blender Foundation\Blender 5.0\blender.exe
# Linux: /usr/bin/blender
BLENDER_BIN=blender

# Optional. Defaults to <repo>/workspaces
CBM_WORKSPACE_ROOT=

# Blender background job timeout in seconds
CBM_BLENDER_TIMEOUT=900

# Codex executable name/path
CODEX_BIN=codex
